@model IEnumerable<HawassaUnifiedCampusEventManagementSystem.Models.Event>

@{
    ViewData["Title"] = "Campus Events Directory | HUCEMS";
}

@section Styles {
    <link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />
}

<div class="container py-5">
    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-1 rounded-pill mb-2">
                <i class="bi bi-calendar2-range me-1"></i> Hawassa University Activities
            </span>
            <h1 class="h2 fw-bold text-dark mb-1">Campus Events Directory</h1>
            <p class="text-muted small mb-0">Explore academic conferences, workshops, sports tournaments, and student club activities.</p>
        </div>

        <div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Events" asp-action="Create" class="btn btn-primary px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>Create Event</span>
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Events/Create" class="btn btn-outline-primary px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Sign In to Create Event</span>
                </a>
            }
        </div>
    </div>

    <!-- SUCCESS ALERT -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4 rounded-3 p-3 d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill fs-4 text-success"></i>
            <span class="small fw-semibold">@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- FILTER BAR -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <form asp-controller="Events" asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="search" name="search" value="@ViewBag.Search" class="form-control border-start-0" placeholder="Search events by title, keyword, or venue..." />
                </div>
            </div>

            <div class="col-md-3">
                <select name="category" class="form-select">
                    <option value="">All Categories</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in (IEnumerable<HawassaUnifiedCampusEventManagementSystem.Models.event_category>)ViewBag.Categories)
                        {
                            var isSelected = string.Equals(ViewBag.SelectedCategory as string, cat.slug, StringComparison.OrdinalIgnoreCase) ||
                                             string.Equals(ViewBag.SelectedCategory as string, cat.name, StringComparison.OrdinalIgnoreCase);
                            <option value="@cat.slug" selected="@(isSelected ? "selected" : null)">@cat.name</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary fw-semibold flex-grow-1">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>
                <a asp-controller="Events" asp-action="Index" class="btn btn-outline-secondary">
                    Reset
                </a>
            </div>
        </form>
    </div>

    <!-- EVENTS RESULT COUNT -->
    <div class="d-flex justify-content-between align-items-center mb-3 text-muted small">
        <span>Showing <strong>@Model.Count()</strong> scheduled events</span>
        <span>Hawassa University Main, IoT & Health Campuses</span>
    </div>

    <!-- EVENTS GRID -->
    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                var catClass = "general";
                var catIcon = "bi-calendar-event";
                if (!string.IsNullOrEmpty(item.Category))
                {
                    var catLower = item.Category.ToLower();
                    if (catLower.Contains("tech")) { catClass = "tech"; catIcon = "bi-laptop"; }
                    else if (catLower.Contains("cult") || catLower.Contains("art")) { catClass = "culture"; catIcon = "bi-palette"; }
                    else if (catLower.Contains("sport") || catLower.Contains("athlet")) { catClass = "sports"; catIcon = "bi-trophy"; }
                    else if (catLower.Contains("work") || catLower.Contains("train")) { catClass = "workshop"; catIcon = "bi-journal-text"; }
                    else if (catLower.Contains("acad") || catLower.Contains("conf")) { catClass = "academic"; catIcon = "bi-mortarboard"; }
                }

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="event-card-modern">
                        <!-- EVENT IMAGE & FLOATING BADGES -->
                        <div class="event-card-img-wrapper">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                            }
                            else
                            {
                                <div class="event-fallback-thumbnail @catClass">
                                    <i class="bi @catIcon fs-1 mb-1"></i>
                                    <span class="small fw-semibold text-white text-opacity-90">@(item.Category ?? "Campus Event")</span>
                                </div>
                            }

                            <!-- Date Pill (Top Left) -->
                            <div class="event-date-pill">
                                <span class="day">@item.EventDate.Day</span>
                                <span class="month">@item.EventDate.ToString("MMM")</span>
                            </div>

                            <!-- Category Pill (Top Right) -->
                            @if (!string.IsNullOrEmpty(item.Category))
                            {
                                <div class="event-category-pill">
                                    @item.Category
                                </div>
                            }
                        </div>

                        <!-- EVENT BODY -->
                        <div class="event-card-body">
                            <h5 class="event-card-title">
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@item.Id">
                                    @item.Title
                                </a>
                            </h5>

                            <p class="event-card-desc">
                                @(string.IsNullOrEmpty(item.ShortDescription) ? (item.Description != null && item.Description.Length > 110 ? item.Description.Substring(0, 110) + "..." : item.Description) : item.ShortDescription)
                            </p>

                            <!-- METADATA SPECS -->
                            <div class="event-specs-list">
                                <div class="event-spec-row">
                                    <i class="bi bi-geo-alt-fill text-danger flex-shrink-0"></i>
                                    <span class="text-truncate">@(string.IsNullOrEmpty(item.Venue) ? "Main Campus Hall" : item.Venue)</span>
                                </div>
                                <div class="event-spec-row">
                                    <i class="bi bi-clock-fill text-primary flex-shrink-0"></i>
                                    <span>@item.StartTime.ToString(@"hh\:mm") @(item.EndTime.HasValue ? "- " + item.EndTime.Value.ToString(@"hh\:mm") : "")</span>
                                </div>
                            </div>

                            <!-- EVENT FOOTER & CTA -->
                            <div class="event-card-footer">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 11px;">
                                        <i class="bi bi-tag me-1"></i>Free
                                    </span>
                                    <span class="small text-muted" style="font-size: 11px;">
                                        &bull; @item.RegisteredCount / @(item.Capacity.HasValue ? item.Capacity.Value.ToString() : "Open")
                                    </span>
                                </div>
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">
                                    View Details &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-white rounded-4 border p-5 shadow-sm">
            <i class="bi bi-calendar-x fs-1 text-muted mb-3 d-block"></i>
            <h4 class="fw-bold text-dark">No Events Found</h4>
            <p class="text-muted small mx-auto" style="max-width: 420px;">
                No scheduled activities match your search criteria. Try selecting a different category or clearing filters.
            </p>
            <a asp-controller="Events" asp-action="Index" class="btn btn-outline-primary btn-sm mt-2 rounded-pill px-4">
                Reset Filter Criteria
            </a>
        </div>
    }
</div>