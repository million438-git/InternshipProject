@model HawassaUnifiedCampusEventManagementSystem.Models.CampusMapViewModel
@{
    ViewData["Title"] = "Hawassa University Official Campus Map & Facility Guide | HUCEMS";
    var activeCampusInfo = Model.Campuses.FirstOrDefault(c => c.Id == Model.ActiveCampus) ?? Model.Campuses.First();
    var filteredVenues = Model.Venues.Where(v => v.Campus == Model.ActiveCampus).ToList();
    if (!filteredVenues.Any())
    {
        filteredVenues = Model.Venues;
    }
}

@section Styles {
    <style>
        .campus-nav-tab.active {
            background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 100%) !important;
            color: #ffffff !important;
            box-shadow: 0 8px 20px rgba(30, 58, 138, 0.3) !important;
            border-color: #1e3a8a !important;
        }

        .map-frame-wrapper {
            position: relative;
            width: 100%;
            height: 620px;
            border-radius: 1.5rem;
            overflow: hidden;
            border: 2px solid #e2e8f0;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.12);
            background: #0f172a;
        }

        #googleCampusIframe {
            width: 100%;
            height: 100%;
            border: 0;
        }

        .landmark-floating-strip {
            position: absolute;
            top: 16px;
            left: 16px;
            right: 16px;
            z-index: 10;
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding: 8px 12px;
            background: rgba(15, 23, 42, 0.88);
            backdrop-filter: blur(12px);
            border-radius: 40px;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .landmark-pill-btn {
            background: rgba(255, 255, 255, 0.15);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.25);
            padding: 6px 14px;
            border-radius: 25px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .landmark-pill-btn:hover, .landmark-pill-btn.active {
            background: #f59e0b;
            color: #0f172a;
            border-color: #f59e0b;
            box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
            font-weight: 700;
        }

        .venue-details-sidebar {
            border-radius: 1.5rem;
            border: 1px solid #e2e8f0;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.06);
            background: #ffffff;
        }

        .facility-visual-card {
            border-radius: 1.25rem;
            border: 1px solid #e2e8f0;
            transition: all 0.25s ease;
            cursor: pointer;
        }
        .facility-visual-card:hover {
            transform: translateY(-4px);
            border-color: #2563eb;
            box-shadow: 0 12px 25px rgba(37, 99, 235, 0.12) !important;
        }

        .building-badge-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: #eff6ff;
            color: #1d4ed8;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
        }
    </style>
}

<div class="container-fluid px-lg-5 py-4">

    <!-- TOP HEADER -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill small fw-bold">
                    <i class="bi bi-geo-alt-fill text-danger me-1"></i> Hawassa University Real Geographic Navigator
                </span>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small fw-semibold">
                    ● Ultra-HD Satellite & Vector Mode
                </span>
            </div>
            <h1 class="h2 fw-bold text-dark mb-1">Hawassa University Campus Map & Facility Guide</h1>
            <p class="text-muted small mb-0">Explore auditoriums, lecture theatres, engineering labs, and athletic stadiums across all 4 university campuses in crystal-clear high definition.</p>
        </div>

        <!-- RIGHT: ACTIONS -->
        <div class="d-flex align-items-center gap-2">
            <a href="#facilityDirectorySection" class="btn btn-outline-primary rounded-pill px-3 shadow-sm btn-sm">
                <i class="bi bi-card-list me-1"></i> All Facilities Directory
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-action="Create" class="btn btn-primary rounded-pill px-3 shadow-sm btn-sm d-inline-flex align-items-center gap-1">
                    <i class="bi bi-calendar-plus-fill"></i>
                    <span>Reserve Facility</span>
                </a>
            }
        </div>
    </div>

    <!-- 4 CAMPUS TABS -->
    <div class="row g-2 mb-4">
        @foreach (var campus in Model.Campuses)
        {
            var isActive = campus.Id == Model.ActiveCampus;
            <div class="col-6 col-md-3">
                <div onclick="selectCampusMap('@campus.Id')" 
                     id="tab-@campus.Id"
                     class="card border h-100 p-3 rounded-4 transition campus-nav-tab @(isActive ? "active shadow" : "bg-white shadow-sm text-dark")"
                     style="cursor: pointer;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge @(isActive ? "bg-white text-primary" : "bg-primary-subtle text-primary") rounded-pill px-2 py-1 small fw-bold">
                            @campus.VenueCount Facilities
                        </span>
                        <i class="bi bi-compass @(isActive ? "text-white" : "text-primary") fs-5"></i>
                    </div>
                    <strong class="d-block mb-1 @(isActive ? "text-white" : "text-dark")">@campus.ShortName</strong>
                    <small class="d-block @(isActive ? "text-white-50" : "text-muted")" style="font-size: 11px;">@campus.LocationTag</small>
                </div>
            </div>
        }
    </div>

    <!-- MAIN INTERACTIVE SECTION: MAP + LIVE DRAWER -->
    <div class="row g-4 mb-5">

        <!-- LEFT: ULTRA-HD LIVE MAP FRAME -->
        <div class="col-lg-8">
            <div class="map-frame-wrapper">
                
                <!-- TOP FLOATING LANDMARKS TOOLBAR -->
                <div class="landmark-floating-strip" id="landmarksStrip">
                    <!-- Populated dynamically based on active campus -->
                </div>

                <!-- REAL ULTRA-HD GOOGLE MAP EMBED (100% CLEAR, SHARP, SATELLITE & ROADS) -->
                <iframe id="googleCampusIframe"
                        src="https://maps.google.com/maps?q=Hawassa%20University%20Main%20Campus,%20Hawassa,%20Ethiopia&t=k&z=17&ie=UTF8&iwloc=&output=embed"
                        loading="lazy"
                        allowfullscreen>
                </iframe>
            </div>

            <!-- MAP HELPER BAR -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2 px-2">
                <div class="d-flex align-items-center gap-3 small text-muted">
                    <span><i class="bi bi-check-circle-fill text-success me-1"></i> Real Satellite & 3D Building Imagery</span>
                    <span><i class="bi bi-mouse me-1"></i> Drag to pan, scroll wheel to zoom</span>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-xs btn-sm btn-outline-secondary rounded-pill px-3" onclick="toggleMapMode('satellite')">
                        <i class="bi bi-globe me-1 text-warning"></i> Satellite HD
                    </button>
                    <button type="button" class="btn btn-xs btn-sm btn-outline-secondary rounded-pill px-3" onclick="toggleMapMode('street')">
                        <i class="bi bi-map me-1 text-primary"></i> Street HD
                    </button>
                </div>
            </div>
        </div>

        <!-- RIGHT: SELECTED FACILITY INSPECTION DRAWER & LIVE SCHEDULE -->
        <div class="col-lg-4">
            <div class="card venue-details-sidebar h-100 p-4 d-flex flex-column" id="venueDetailCard">
                
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold" id="drawerStatusBadge">
                        ● Available for Booking
                    </span>
                    <span class="badge bg-light text-secondary border rounded-pill px-2 py-1 small" id="drawerCapacityBadge">
                        <i class="bi bi-people-fill me-1"></i> Cap: 600
                    </span>
                </div>

                <h3 class="h4 fw-bold text-dark mb-1" id="drawerVenueName">Africa Hall Executive Center</h3>
                <p class="text-muted small mb-2" id="drawerLocation">
                    <i class="bi bi-geo-alt-fill text-danger me-1"></i> Hawassa Main Campus • Executive Conference Wing
                </p>

                <p class="text-secondary small mb-3" id="drawerDescription" style="line-height: 1.6;">
                    Flagship executive hall for university symposiums, graduation conferences, and high-level academic summits. Equipped with digital projection, surround sound audio systems, and central climate control.
                </p>

                <!-- INSTALLED HARDWARE AMENITIES -->
                <div class="mb-3">
                    <label class="small fw-bold text-dark d-block mb-2">Installed Hardware & Amenities:</label>
                    <div class="d-flex flex-wrap gap-1" id="drawerEquipment">
                        <span class="badge bg-light text-dark border small"><i class="bi bi-check2 text-primary me-1"></i>HD Projector</span>
                        <span class="badge bg-light text-dark border small"><i class="bi bi-check2 text-primary me-1"></i>PA Sound System</span>
                        <span class="badge bg-light text-dark border small"><i class="bi bi-check2 text-primary me-1"></i>Campus Wi-Fi</span>
                        <span class="badge bg-light text-dark border small"><i class="bi bi-check2 text-primary me-1"></i>Air Conditioning</span>
                    </div>
                </div>

                <hr class="my-3 opacity-25" />

                <!-- UPCOMING EVENTS SCHEDULE -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="small fw-bold text-dark mb-0">Upcoming Facility Schedule:</label>
                        <span class="badge bg-primary-subtle text-primary rounded-pill small" id="drawerEventsCountBadge">Live Schedule</span>
                    </div>

                    <div class="p-3 bg-light rounded-3 border" id="drawerUpcomingBox">
                        <p class="small text-muted mb-0"><i class="bi bi-calendar-check text-primary me-1"></i> No immediate scheduling collisions. Venue is open for reservations.</p>
                    </div>
                </div>

                <!-- ACTION BUTTONS -->
                <div class="d-grid gap-2 mt-auto">
                    <a id="drawerDirectionsBtn" href="https://maps.google.com/maps?daddr=Hawassa+University+Main+Campus" target="_blank" class="btn btn-outline-primary rounded-pill py-2 small fw-semibold">
                        <i class="bi bi-signpost-2-fill me-1 text-danger"></i> Open Real GPS Walking Directions &rarr;
                    </a>
                    <a asp-action="Create" class="btn btn-primary rounded-pill py-2 fw-semibold">
                        <i class="bi bi-calendar-plus me-1"></i> Reserve This Facility
                    </a>
                </div>

            </div>
        </div>
    </div>

    <!-- COMPLETE CAMPUS FACILITIES DIRECTORY CARDS -->
    <div id="facilityDirectorySection" class="pt-4 border-top">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="h4 fw-bold text-dark mb-1">Campus Facilities & Halls Directory</h3>
                <p class="text-muted small mb-0">Click any facility below to inspect on the high-definition map above.</p>
            </div>
            <span class="badge bg-primary rounded-pill px-3 py-2">
                @Model.TotalVenuesCount Total Facilities Registered
            </span>
        </div>

        <div class="row g-4" id="facilitiesGrid">
            <!-- Rendered dynamically -->
        </div>
    </div>

</div>

@section Scripts {
    <script>
        const venuesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Venues));
        let activeCampusId = "@Model.ActiveCampus";
        let currentMapType = "k"; // 'k' = satellite, 'm' = street

        // Real Hawassa University Campus Map Embed Queries
        const campusMapUrls = {
            "MAIN": "Hawassa%20University%20Main%20Campus,%20Hawassa,%20Ethiopia",
            "IOT": "Hawassa%20University%20Institute%20of%20Technology,%20Hawassa,%20Ethiopia",
            "CMHS": "Hawassa%20University%20Comprehensive%20Specialized%20Hospital,%20Hawassa,%20Ethiopia",
            "WONDO": "Wondo%20Genet%20College%20of%20Forestry%20and%20Natural%20Resources,%20Ethiopia"
        };

        // Real Detailed Landmarks per Campus
        const campusLandmarks = {
            "MAIN": [
                { id: "L1", name: "Africa Hall Executive Center", query: "Africa%20Hall,%20Hawassa%20University", cap: 600, building: "Executive Conference Wing", desc: "Flagship executive hall for university symposiums, graduation conferences, and high-level academic summits.", equip: ["HD Digital Projector", "PA Surround Audio", "Campus Wi-Fi", "Executive Podium", "Climate Control"] },
                { id: "L2", name: "Senate Hall Auditorium", query: "Central%20Administration,%20Hawassa%20University", cap: 450, building: "Central Administration Building", desc: "Central administration auditorium equipped with digital voting, executive audio, and climate control.", equip: ["HD Projector", "PA Sound System", "Campus Wi-Fi", "Air Conditioning"] },
                { id: "L3", name: "Central Library Amphitheater", query: "Library,%20Hawassa%20University", cap: 350, building: "Central Library Quadrangle", desc: "Open-air acoustic amphitheater for student academic debates, book fairs, and research symposiums.", equip: ["Acoustic Shell", "Stage Lighting", "Campus Wi-Fi"] },
                { id: "L4", name: "Main University Auditorium", query: "Main%20Auditorium,%20Hawassa%20University", cap: 1200, building: "Main Assembly Hall", desc: "Hawassa University grand assembly auditorium for orientation, cultural festivals, and large-scale summits.", equip: ["Dual HD Laser Projectors", "Concert Sound System", "Central Climate Control"] },
                { id: "L5", name: "Natural Sciences Lecture Complex", query: "College%20of%20Natural%20Sciences,%20Hawassa%20University", cap: 280, building: "Block 104 • College of Science", desc: "Tiered lecture theatre equipped with dual HD laser projectors and physics/chemistry demonstration podium.", equip: ["Dual HD Projectors", "Lapel Microphones", "Campus Wi-Fi"] },
                { id: "L6", name: "Hawassa Main Stadium Pavilion", query: "Stadium,%20Hawassa%20University", cap: 3500, building: "Campus Sports Center", desc: "Outdoor athletic track, covered grandstand pavilion, and sports tournament festival grounds.", equip: ["Stadium Floodlights", "Public Address System", "Scoreboard"] }
            ],
            "IOT": [
                { id: "L101", name: "IoT Grand Auditorium 101", query: "Institute%20of%20Technology,%20Hawassa%20University", cap: 500, building: "Computing Block A", desc: "State-of-the-art tech auditorium for software hackathons, engineering summits, and robotics exhibitions.", equip: ["Dual 4K Laser Displays", "Dolby Sound", "Gigabit Fiber Ethernet", "Climate Control"] },
                { id: "L102", name: "Computing Innovation & AI Lab", query: "Computer%20Science,%20Hawassa%20University%20IoT", cap: 120, building: "Innovation Hub • 3rd Floor", desc: "High-performance computing cluster, high-speed fiber connectivity, and smart collaboration pods.", equip: ["AI GPU Cluster Access", "Smart Board", "High-Speed Wi-Fi 6"] },
                { id: "L103", name: "Civil & Mechanical Lecture Theatre", query: "Engineering%20Complex,%20Hawassa%20University%20IoT", cap: 320, building: "Engineering Complex B", desc: "Acoustically treated engineering theatre with CAD projection and structural demonstration stages.", equip: ["CAD Ultra-Wide Projector", "PA Audio", "Tiered Seating"] },
                { id: "L104", name: "Electrical & Hardware Labs", query: "Electrical%20Engineering,%20Hawassa%20University%20IoT", cap: 150, building: "Technical Workshop Wing", desc: "Modern electronics workstation benches, oscilloscopes, and IoT prototyping equipment.", equip: ["Oscilloscopes", "Soldering Stations", "Component Vault"] }
            ],
            "CMHS": [
                { id: "L201", name: "Medical Grand Amphitheater", query: "College%20of%20Medicine,%20Hawassa%20University", cap: 420, building: "Clinical Science Complex", desc: "Medical surgical projection auditorium with live telemedicine link to Hawassa Referral Hospital operating theatres.", equip: ["Telemedicine Video Link", "4K Surgical Display", "Surround Sound"] },
                { id: "L202", name: "Referral Hospital Conference Center", query: "Hawassa%20Comprehensive%20Specialized%20Hospital", cap: 300, building: "Comprehensive Hospital Wing", desc: "Executive clinical conference room for international healthcare symposiums and medical board meetings.", equip: ["Executive Video Conferencing", "PA Audio", "Air Conditioning"] },
                { id: "L203", name: "Clinical Skills Simulation Hall", query: "Health%20Sciences,%20Hawassa%20University", cap: 180, building: "Health Sciences Block C", desc: "Simulation mannequins, emergency room mock-up stations, and interactive clinical demonstration pods.", equip: ["Emergency Simulation Pods", "HD Recording Camera", "Medical Monitoring Display"] }
            ],
            "WONDO": [
                { id: "L301", name: "Forestry Research Amphitheater", query: "Wondo%20Genet%20College%20of%20Forestry", cap: 350, building: "Natural Resources Complex", desc: "Eco-friendly timber architecture amphitheater surrounded by Wondo Genet botanical gardens.", equip: ["HD Projector", "Acoustic Timber Shell", "Eco Climate Ventilation"] },
                { id: "L302", name: "Botanical Innovation Complex", query: "Wondo%20Genet%20Botanical%20Garden", cap: 220, building: "Agri Research Wing", desc: "Agroforestry research center with greenhouse display screens and environmental climate stations.", equip: ["Microscope Displays", "Climate Sensors", "Smart Projection"] }
            ]
        };

        function selectCampusMap(campusId) {
            activeCampusId = campusId;

            // Update Tab UI
            document.querySelectorAll('.campus-nav-tab').forEach(tab => {
                tab.classList.remove('active', 'shadow');
                tab.classList.add('bg-white', 'text-dark');
            });
            const selectedTab = document.getElementById(`tab-${campusId}`);
            if (selectedTab) {
                selectedTab.classList.add('active', 'shadow');
                selectedTab.classList.remove('bg-white', 'text-dark');
            }

            // Update Real HD Map Iframe
            const campusQuery = campusMapUrls[campusId] || campusMapUrls["MAIN"];
            const iframe = document.getElementById('googleCampusIframe');
            iframe.src = `https://maps.google.com/maps?q=${campusQuery}&t=${currentMapType}&z=17&ie=UTF8&iwloc=&output=embed`;

            renderLandmarksToolbar(campusId);
            renderFacilitiesGrid(campusId);
        }

        function toggleMapMode(mode) {
            currentMapType = mode === 'satellite' ? 'k' : 'm';
            const campusQuery = campusMapUrls[activeCampusId] || campusMapUrls["MAIN"];
            const iframe = document.getElementById('googleCampusIframe');
            iframe.src = `https://maps.google.com/maps?q=${campusQuery}&t=${currentMapType}&z=17&ie=UTF8&iwloc=&output=embed`;
        }

        function renderLandmarksToolbar(campusId) {
            const strip = document.getElementById('landmarksStrip');
            strip.innerHTML = '';

            const landmarks = campusLandmarks[campusId] || campusLandmarks["MAIN"];
            landmarks.forEach((item, index) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = `landmark-pill-btn ${index === 0 ? 'active' : ''}`;
                btn.id = `pill-${item.id}`;
                btn.innerHTML = `<i class="bi bi-building"></i> ${item.name} (${item.cap})`;
                btn.onclick = () => selectLandmark(item);
                strip.appendChild(btn);
            });

            if (landmarks.length > 0) {
                selectLandmark(landmarks[0]);
            }
        }

        function selectLandmark(item) {
            document.querySelectorAll('.landmark-pill-btn').forEach(b => b.classList.remove('active'));
            const activeBtn = document.getElementById(`pill-${item.id}`);
            if (activeBtn) activeBtn.classList.add('active');

            // Pan map to landmark query
            const iframe = document.getElementById('googleCampusIframe');
            iframe.src = `https://maps.google.com/maps?q=${item.query}&t=${currentMapType}&z=18&ie=UTF8&iwloc=&output=embed`;

            // Update Drawer
            document.getElementById('drawerVenueName').innerText = item.name;
            document.getElementById('drawerLocation').innerHTML = `<i class="bi bi-geo-alt-fill text-danger me-1"></i> ${item.building}`;
            document.getElementById('drawerCapacityBadge').innerHTML = `<i class="bi bi-people-fill me-1"></i> Cap: ${item.cap}`;
            document.getElementById('drawerDescription').innerText = item.desc;

            // Render equipment badges
            const equipBox = document.getElementById('drawerEquipment');
            equipBox.innerHTML = '';
            item.equip.forEach(eq => {
                equipBox.innerHTML += `<span class="badge bg-light text-dark border small"><i class="bi bi-check2 text-primary me-1"></i>${eq}</span> `;
            });

            // Directions Link
            document.getElementById('drawerDirectionsBtn').href = `https://maps.google.com/maps?daddr=${item.query}`;
        }

        function renderFacilitiesGrid(campusId) {
            const grid = document.getElementById('facilitiesGrid');
            grid.innerHTML = '';

            const landmarks = campusLandmarks[campusId] || campusLandmarks["MAIN"];
            landmarks.forEach(item => {
                const col = document.createElement('div');
                col.className = 'col-md-6 col-lg-4';
                col.innerHTML = `
                    <div class="card facility-visual-card h-100 p-4 bg-white shadow-sm" onclick="selectLandmarkById('${item.id}')">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="building-badge-icon">
                                <i class="bi bi-building"></i>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 small fw-bold">
                                ● Available
                            </span>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">${item.name}</h5>
                        <p class="small text-muted mb-2"><i class="bi bi-geo-alt-fill text-danger me-1"></i> ${item.building}</p>
                        <p class="small text-secondary mb-3">${item.desc}</p>
                        <div class="d-flex flex-wrap gap-1 mb-3">
                            ${item.equip.slice(0, 3).map(e => `<span class="badge bg-light text-secondary border small" style="font-size: 10px;">${e}</span>`).join('')}
                        </div>
                        <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                            <span class="badge bg-light text-dark border rounded-pill px-2 py-1 small">
                                <i class="bi bi-people-fill me-1"></i> Cap: ${item.cap}
                            </span>
                            <span class="text-primary small fw-semibold">View on Map &rarr;</span>
                        </div>
                    </div>
                `;
                grid.appendChild(col);
            });
        }

        function selectLandmarkById(id) {
            const landmarks = campusLandmarks[activeCampusId] || campusLandmarks["MAIN"];
            const item = landmarks.find(l => l.id === id);
            if (item) {
                selectLandmark(item);
                window.scrollTo({ top: 120, behavior: 'smooth' });
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            selectCampusMap(activeCampusId);
        });
    </script>
}
