@model IEnumerable<HawassaUnifiedCampusEventManagementSystem.Models.Venue>
@{
    ViewData["Title"] = "Campus Venues & Facilities | HUCEMS";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">
                Campus Venues & Facilities
            </h1>
            <p class="text-muted mb-0">
                Explore auditoriums, lecture halls, and event spaces across Hawassa University campuses.
            </p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-3">
                <i class="bi bi-calendar-event me-1"></i> Browse Events
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-action="Create" class="btn btn-primary rounded-pill px-3">
                    <i class="bi bi-plus-circle me-1"></i> Book Venue / Host Event
                </a>
            }
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 bg-light rounded-4 my-4">
            <div class="display-4 text-muted mb-3"><i class="bi bi-building"></i></div>
            <h4 class="fw-bold text-secondary">No Venues Found</h4>
            <p class="text-muted">Campus venue listings are currently being updated.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var venue in Model)
            {
                var isAvailable = venue.status == "AVAILABLE" || string.IsNullOrEmpty(venue.status);

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-column hover-shadow transition">
                        <div class="p-4 flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge @(isAvailable ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") rounded-pill px-2 py-1 small fw-semibold">
                                    @(isAvailable ? "● Available" : "● Under Maintenance")
                                </span>
                                @if (venue.capacity > 0)
                                {
                                    <span class="badge bg-light text-secondary border rounded-pill px-2 py-1 small">
                                        <i class="bi bi-people-fill me-1"></i> Cap: @venue.capacity
                                    </span>
                                }
                            </div>

                            <h5 class="fw-bold text-dark mt-2 mb-1">@venue.name</h5>
                            @if (!string.IsNullOrEmpty(venue.building_name))
                            {
                                <p class="small text-muted mb-2">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                    @venue.building_name @(string.IsNullOrEmpty(venue.room_number) ? "" : $"• Room {venue.room_number}")
                                </p>
                            }

                            @if (!string.IsNullOrEmpty(venue.description))
                            {
                                <p class="text-secondary small mb-3 line-clamp-2">
                                    @venue.description
                                </p>
                            }

                            @if (!string.IsNullOrEmpty(venue.amenities))
                            {
                                <div class="mb-3">
                                    <small class="text-muted fw-semibold d-block mb-1">Amenities & Equipment:</small>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var item in venue.amenities.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                        {
                                            <span class="badge bg-light text-dark border small" style="font-size: 11px;">
                                                <i class="bi bi-check2 text-primary me-1"></i>@item
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="card-footer bg-light border-0 px-4 py-3 d-flex justify-content-between align-items-center">
                            <span class="badge bg-white text-secondary border small">
                                <i class="bi bi-building me-1"></i>@(venue.venue_type ?? "Facility")
                            </span>
                            <a asp-action="Search" asp-route-q="@venue.name" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                View Events &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.08) !important;
        transition: all 0.25s ease-in-out;
    }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
