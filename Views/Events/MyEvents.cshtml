@model HawassaUnifiedCampusEventManagementSystem.Models.MyEventsPageViewModel

@{
    ViewData["Title"] = "My Events & Campus Passes";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />
}

<div class="events-page py-4">
    <div class="container">

        <!-- HEADER SECTION -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
            <div>
                <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-semibold mb-2">
                    <i class="bi bi-person-badge-fill me-1"></i> ATTENDEE & ORGANIZER HUB
                </span>
                <h1 class="display-6 fw-bold text-dark mb-1">My Campus Activity & Passes</h1>
                <p class="text-muted mb-0">Access your digital event passes, QR check-in tickets, and manage events you organize.</p>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Events" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-compass me-1"></i> Browse Events
                </a>
                <a asp-controller="Events" asp-action="Create" class="btn btn-primary btn-sm px-3 fw-semibold">
                    <i class="bi bi-plus-circle me-1"></i> Host Event
                </a>
            </div>
        </div>

        <!-- NAVIGATION TABS -->
        <ul class="nav nav-pills mb-4 gap-2 border-bottom pb-3" id="myEventsTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active rounded-pill px-4 py-2 fw-semibold d-flex align-items-center gap-2" id="tickets-tab" data-bs-toggle="pill" data-bs-target="#tickets-pane" type="button" role="tab">
                    <i class="bi bi-ticket-perforated-fill"></i>
                    <span>Registered Passes & Tickets</span>
                    <span class="badge bg-white text-primary rounded-pill ms-1">@Model.RegisteredEvents.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill px-4 py-2 fw-semibold d-flex align-items-center gap-2" id="organized-tab" data-bs-toggle="pill" data-bs-target="#organized-pane" type="button" role="tab">
                    <i class="bi bi-calendar-check-fill"></i>
                    <span>Events I Organize</span>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill ms-1">@Model.OrganizedEvents.Count</span>
                </button>
            </li>
        </ul>

        <!-- TAB CONTENT -->
        <div class="tab-content" id="myEventsTabContent">

            <!-- =========================================================
                 TAB 1: REGISTERED TICKETS & DIGITAL PASSES
                 ========================================================= -->
            <div class="tab-pane fade show active" id="tickets-pane" role="tabpanel">
                @if (Model.RegisteredEvents.Any())
                {
                    <div class="row g-4">
                        @foreach (var ticket in Model.RegisteredEvents)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                                    <div class="bg-primary bg-gradient p-3 text-white d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="badge bg-white bg-opacity-25 text-white rounded-pill px-2 py-1 small">
                                                @ticket.Category
                                            </span>
                                        </div>
                                        <span class="badge @(ticket.Status == "REGISTERED" ? "bg-success" : ticket.Status == "WAITLISTED" ? "bg-warning text-dark" : "bg-secondary") rounded-pill px-2 py-1 small">
                                            @(ticket.Status == "REGISTERED" ? "✓ CONFIRMED PASS" : ticket.Status)
                                        </span>
                                    </div>

                                    <div class="card-body p-4 d-flex flex-column">
                                        <h5 class="fw-bold text-dark mb-2">@ticket.Title</h5>

                                        <div class="text-muted small d-flex flex-column gap-2 mb-3">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-calendar-event text-primary"></i>
                                                <span>@ticket.EventDate.ToString("ddd, MMM dd, yyyy") at @(ticket.StartTime.ToString(@"hh\:mm"))</span>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-geo-alt text-danger"></i>
                                                <span>@ticket.Venue</span>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-person-badge text-info"></i>
                                                <span>Host: @ticket.OrganizerName</span>
                                            </div>
                                        </div>

                                        <!-- TICKET CODE PILL -->
                                        <div class="bg-light p-3 rounded-3 text-center mb-3 border border-secondary border-opacity-10">
                                            <small class="text-muted text-uppercase fw-semibold d-block" style="font-size: 10px; letter-spacing: 0.8px;">PASS IDENTIFIER</small>
                                            <code class="fs-6 fw-bold text-primary">@ticket.RegistrationCode</code>
                                            <small class="text-muted d-block mt-1" style="font-size: 11px;">Booked: @ticket.RegisteredAt.ToString("MMM dd, yyyy")</small>
                                        </div>

                                        <div class="mt-auto d-flex gap-2">
                                            <button type="button" class="btn btn-primary btn-sm w-100 fw-semibold d-flex align-items-center justify-content-center gap-1" onclick="openTicketModal(@ticket.EventId)">
                                                <i class="bi bi-qr-code"></i> View Pass
                                            </button>
                                            <a asp-controller="Events" asp-action="ExportIcs" asp-route-id="@ticket.EventId" class="btn btn-outline-secondary btn-sm" title="Download Calendar Invite">
                                                <i class="bi bi-calendar-plus"></i>
                                            </a>
                                            <a asp-controller="Events" asp-action="Details" asp-route-id="@ticket.EventId" class="btn btn-outline-secondary btn-sm" title="View Event Page">
                                                <i class="bi bi-arrow-up-right"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 bg-light rounded-4 p-5">
                        <div class="bg-white p-4 rounded-circle d-inline-block text-muted shadow-sm mb-3" style="width: 80px; height: 80px;">
                            <i class="bi bi-ticket-detailed fs-1 text-secondary"></i>
                        </div>
                        <h3 class="h5 fw-bold text-dark mb-1">No Active Event Passes</h3>
                        <p class="text-muted small mb-3">You have not registered for any upcoming campus events yet.</p>
                        <a asp-controller="Events" asp-action="Index" class="btn btn-primary btn-sm rounded-pill px-4 fw-semibold">
                            Explore Upcoming Events
                        </a>
                    </div>
                }
            </div>

            <!-- =========================================================
                 TAB 2: EVENTS I ORGANIZE & HOST
                 ========================================================= -->
            <div class="tab-pane fade" id="organized-pane" role="tabpanel">
                @if (Model.OrganizedEvents.Any())
                {
                    <div class="row g-4">
                        @foreach (var item in Model.OrganizedEvents)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                                    <div class="card-body p-4 d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1 small">
                                                @item.Category
                                            </span>
                                            <span class="badge @(item.ApprovalStatus == "APPROVED" ? "bg-success" : item.ApprovalStatus == "PENDING" ? "bg-warning text-dark" : "bg-danger") rounded-pill px-2 py-1 small">
                                                @item.ApprovalStatus
                                            </span>
                                        </div>

                                        <h5 class="fw-bold text-dark mb-2">@item.Title</h5>

                                        <div class="text-muted small d-flex flex-column gap-1 mb-3">
                                            <div><i class="bi bi-calendar me-1 text-primary"></i>@item.EventDate.ToString("ddd, MMM dd, yyyy")</div>
                                            <div><i class="bi bi-geo-alt me-1 text-danger"></i>@item.Venue</div>
                                            <div><i class="bi bi-people me-1 text-info"></i>@item.RegisteredCount @(item.Capacity.HasValue ? $"/ {item.Capacity.Value} capacity" : "registered")</div>
                                        </div>

                                        <div class="mt-auto d-flex gap-2 pt-2 border-top">
                                            <a asp-controller="Events" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm w-100">
                                                View Page
                                            </a>
                                            <a asp-controller="Events" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm" title="Edit Event">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 bg-light rounded-4 p-5">
                        <div class="bg-white p-4 rounded-circle d-inline-block text-muted shadow-sm mb-3" style="width: 80px; height: 80px;">
                            <i class="bi bi-calendar-plus fs-1 text-secondary"></i>
                        </div>
                        <h3 class="h5 fw-bold text-dark mb-1">No Hosted Events</h3>
                        <p class="text-muted small mb-3">You have not created or hosted any events on the campus portal yet.</p>
                        <a asp-controller="Events" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-4 fw-semibold">
                            Create Your First Event
                        </a>
                    </div>
                }
            </div>

        </div>

    </div>
</div>

<!-- =========================================================
     DIGITAL CAMPUS TICKET & PASS MODAL
     ========================================================= -->
<div class="modal fade" id="ticketModal" tabindex="-1" aria-labelledby="ticketModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header bg-primary bg-gradient text-white border-0 py-3">
                <h5 class="modal-title fw-bold fs-6" id="ticketModalLabel">
                    <i class="bi bi-shield-check me-2"></i>Hawassa University Digital Campus Pass
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center" id="ticketModalBody">
                <div class="spinner-border text-primary my-4" role="status">
                    <span class="visually-hidden">Loading ticket...</span>
                </div>
            </div>
            <div class="modal-footer bg-light border-0 py-2 justify-content-between">
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i>Print Pass
                </button>
                <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function openTicketModal(eventId) {
            const modalEl = document.getElementById('ticketModal');
            const modal = new bootstrap.Modal(modalEl);
            modal.show();

            const body = document.getElementById('ticketModalBody');
            body.innerHTML = `
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted small mt-2">Generating secure pass verification...</p>
                </div>`;

            try {
                const res = await fetch(`/Events/GetTicket/${eventId}`);
                const data = await res.json();

                if (!data.success || !data.ticket) {
                    body.innerHTML = `<div class="alert alert-danger">Could not load ticket information.</div>`;
                    return;
                }

                const t = data.ticket;
                const qrSvg = generateQrSvg(t.registrationCode);

                body.innerHTML = `
                    <div class="card border-0 bg-light rounded-4 p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary text-white rounded-pill px-2 py-1 small">${t.category}</span>
                            <span class="badge bg-success text-white rounded-pill px-2 py-1 small">✓ VERIFIED</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">${t.eventTitle}</h5>
                        <p class="text-muted small mb-2"><i class="bi bi-calendar me-1 text-primary"></i>${t.eventDate} • ${t.eventTime}</p>
                        <p class="text-muted small mb-0"><i class="bi bi-geo-alt me-1 text-danger"></i>${t.venue} (Room: ${t.room})</p>
                    </div>

                    <div class="my-3 p-3 bg-white rounded-3 border d-inline-block shadow-sm">
                        ${qrSvg}
                        <div class="mt-2">
                            <small class="text-muted text-uppercase fw-semibold" style="font-size: 10px;">CODE</small>
                            <div class="fw-bold text-primary font-monospace fs-6">${t.registrationCode}</div>
                        </div>
                    </div>

                    <div class="text-start small bg-white p-3 rounded-3 border border-secondary border-opacity-10 mt-3">
                        <div class="row g-2">
                            <div class="col-6 text-muted">Attendee:</div>
                            <div class="col-6 fw-semibold text-end text-dark">${t.attendeeName}</div>
                            <div class="col-6 text-muted">Campus ID:</div>
                            <div class="col-6 fw-semibold text-end text-dark">${t.studentId || t.employeeId || 'Verified Member'}</div>
                            <div class="col-6 text-muted">Check-In Status:</div>
                            <div class="col-6 fw-semibold text-end ${t.checkedInAt ? 'text-success' : 'text-warning'}">${t.checkedInAt ? '✓ Checked In' : 'Pending Entry'}</div>
                        </div>
                    </div>
                `;
            } catch (err) {
                body.innerHTML = `<div class="alert alert-danger">Error retrieving pass. Please try again.</div>`;
            }
        }

        function generateQrSvg(code) {
            // High quality fallback SVG QR representation
            return `
                <svg width="150" height="150" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" class="img-fluid">
                    <rect width="100" height="100" fill="#ffffff"/>
                    <!-- Position Detection Patterns -->
                    <rect x="5" y="5" width="28" height="28" fill="#0f172a" rx="3"/>
                    <rect x="9" y="9" width="20" height="20" fill="#ffffff" rx="2"/>
                    <rect x="13" y="13" width="12" height="12" fill="#0284c7" rx="1"/>

                    <rect x="67" y="5" width="28" height="28" fill="#0f172a" rx="3"/>
                    <rect x="71" y="9" width="20" height="20" fill="#ffffff" rx="2"/>
                    <rect x="75" y="13" width="12" height="12" fill="#0284c7" rx="1"/>

                    <rect x="5" y="67" width="28" height="28" fill="#0f172a" rx="3"/>
                    <rect x="9" y="71" width="20" height="20" fill="#ffffff" rx="2"/>
                    <rect x="13" y="75" width="12" height="12" fill="#0284c7" rx="1"/>

                    <!-- Data Blocks -->
                    <rect x="38" y="10" width="6" height="6" fill="#0f172a"/>
                    <rect x="48" y="10" width="6" height="6" fill="#0f172a"/>
                    <rect x="40" y="24" width="6" height="6" fill="#0284c7"/>
                    <rect x="50" y="24" width="6" height="6" fill="#0f172a"/>
                    <rect x="10" y="42" width="6" height="6" fill="#0f172a"/>
                    <rect x="22" y="42" width="6" height="6" fill="#0284c7"/>
                    <rect x="36" y="42" width="6" height="6" fill="#0f172a"/>
                    <rect x="48" y="42" width="6" height="6" fill="#0f172a"/>
                    <rect x="60" y="42" width="6" height="6" fill="#0284c7"/>
                    <rect x="72" y="42" width="6" height="6" fill="#0f172a"/>
                    <rect x="84" y="42" width="6" height="6" fill="#0f172a"/>
                    <rect x="38" y="56" width="6" height="6" fill="#0284c7"/>
                    <rect x="52" y="56" width="6" height="6" fill="#0f172a"/>
                    <rect x="66" y="56" width="6" height="6" fill="#0f172a"/>
                    <rect x="38" y="70" width="6" height="6" fill="#0f172a"/>
                    <rect x="48" y="70" width="6" height="6" fill="#0284c7"/>
                    <rect x="60" y="70" width="6" height="6" fill="#0f172a"/>
                    <rect x="74" y="70" width="6" height="6" fill="#0f172a"/>
                    <rect x="86" y="70" width="6" height="6" fill="#0284c7"/>
                    <rect x="40" y="84" width="6" height="6" fill="#0f172a"/>
                    <rect x="54" y="84" width="6" height="6" fill="#0284c7"/>
                    <rect x="68" y="84" width="6" height="6" fill="#0f172a"/>
                    <rect x="80" y="84" width="6" height="6" fill="#0f172a"/>
                </svg>
            `;
        }
    </script>
}