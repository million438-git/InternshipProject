@model IEnumerable<HawassaUnifiedCampusEventManagementSystem.Models.Event>

@{
    ViewData["Title"] = "My Events";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />
}

<div class="events-page py-4">
    <div class="container">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
            <div>
                <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-semibold mb-2">
                    <i class="bi bi-calendar-event me-1"></i> EVENT MANAGEMENT
                </span>
                <h1 class="display-6 fw-bold text-dark mb-1">Events I Manage</h1>
                <p class="text-muted mb-0">Review, manage, and coordinate events hosted by you or your department.</p>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Events" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-compass me-1"></i> Explore All Events
                </a>
                <a asp-controller="Events" asp-action="Create" class="btn btn-primary btn-sm px-3 fw-semibold">
                    <i class="bi bi-plus-circle me-1"></i> Create New Event
                </a>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                            <div class="card-body p-4 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1 small">
                                        @item.Category
                                    </span>
                                    <span class="badge @(item.ApprovalStatus == "APPROVED" ? "bg-success" : item.ApprovalStatus == "PENDING" ? "bg-warning text-dark" : "bg-danger") rounded-pill px-2 py-1 small">
                                        @item.ApprovalStatus
                                    </span>
                                </div>

                                <h5 class="fw-bold text-dark mb-2">@item.Title</h5>

                                <div class="text-muted small d-flex flex-column gap-1 mb-3">
                                    <div><i class="bi bi-calendar me-1 text-primary"></i>@item.EventDate.ToString("ddd, MMM dd, yyyy")</div>
                                    <div><i class="bi bi-geo-alt me-1 text-danger"></i>@item.Venue</div>
                                    <div><i class="bi bi-people me-1 text-info"></i>@item.RegisteredCount @(item.Capacity.HasValue ? $"/ {item.Capacity.Value} capacity" : "registered")</div>
                                </div>

                                <div class="mt-auto d-flex gap-2 pt-2 border-top">
                                    <a asp-controller="Events" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm w-100">
                                        View Page
                                    </a>
                                    <a asp-controller="Events" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm" title="Edit Event">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 bg-light rounded-4 p-5">
                <div class="bg-white p-4 rounded-circle d-inline-block text-muted shadow-sm mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-calendar-plus fs-1 text-secondary"></i>
                </div>
                <h3 class="h5 fw-bold text-dark mb-1">No Hosted Events Found</h3>
                <p class="text-muted small mb-3">You haven't created any campus events yet.</p>
                <a asp-controller="Events" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-4 fw-semibold">
                    Create Your First Event
                </a>
            </div>
        }

    </div>
</div>