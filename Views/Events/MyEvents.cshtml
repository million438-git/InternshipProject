@model HawassaUnifiedCampusEventManagementSystem.Models.StudentMyEventsViewModel

@{
    ViewData["Title"] = "My Events & Passes | HUCEMS";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />
}

<div class="events-page py-4">
    <div class="container">

        <!-- HEADER -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
            <div>
                <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-semibold mb-2">
                    <i class="bi bi-person-badge me-1"></i> STUDENT & ATTENDEE PORTAL
                </span>
                <h1 class="display-6 fw-bold text-dark mb-1">My Campus Events & Schedule</h1>
                <p class="text-muted mb-0">Manage your event registrations, attendee passes, and organized campus activities.</p>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Events" asp-action="Index" class="btn btn-outline-primary btn-sm px-3">
                    <i class="bi bi-compass me-1"></i> Explore All Events
                </a>
                <a asp-controller="Calendar" asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
                    <i class="bi bi-calendar3 me-1"></i> Interactive Calendar
                </a>
                <a asp-controller="Events" asp-action="Create" class="btn btn-primary btn-sm px-3 fw-semibold">
                    <i class="bi bi-plus-circle me-1"></i> Propose Event
                </a>
            </div>
        </div>

        <!-- QUICK STATS CARDS -->
        <div class="row g-3 mb-4">
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 bg-primary-subtle text-primary rounded-3 fs-4">
                            <i class="bi bi-ticket-perforated-fill"></i>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Registered Passes</span>
                            <h3 class="fw-bold mb-0 text-dark">@Model.TotalRegisteredCount</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 bg-success-subtle text-success rounded-3 fs-4">
                            <i class="bi bi-calendar-check-fill"></i>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Events I Host</span>
                            <h3 class="fw-bold mb-0 text-dark">@Model.TotalOrganizedCount</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 bg-warning-subtle text-warning-emphasis rounded-3 fs-4">
                            <i class="bi bi-award-fill"></i>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Hawassa Campus</span>
                            <h5 class="fw-bold mb-0 text-dark">Main / IoT / CIC</h5>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 bg-info-subtle text-info rounded-3 fs-4">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Account Role</span>
                            <h5 class="fw-bold mb-0 text-dark">Student Member</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 1: REGISTERED CAMPUS EVENTS (RSVPS) -->
        <div class="card border-0 shadow-sm rounded-4 mb-5 overflow-hidden">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-ticket-detailed-fill text-primary fs-5"></i>
                    <h2 class="h5 fw-bold mb-0 text-dark">My Registered Events (Attending)</h2>
                </div>
                <span class="badge bg-primary rounded-pill px-3 py-2">@Model.TotalRegisteredCount Enrolled</span>
            </div>

            <div class="card-body p-4">
                @if (Model.RegisteredEvents.Any())
                {
                    <div class="row g-4">
                        @foreach (var item in Model.RegisteredEvents)
                        {
                            var catClass = "general";
                            var catIcon = "bi-calendar-event";
                            if (!string.IsNullOrEmpty(item.Category))
                            {
                                var catLower = item.Category.ToLower();
                                if (catLower.Contains("tech")) { catClass = "tech"; catIcon = "bi-laptop"; }
                                else if (catLower.Contains("cult") || catLower.Contains("art")) { catClass = "culture"; catIcon = "bi-palette"; }
                                else if (catLower.Contains("sport") || catLower.Contains("athlet")) { catClass = "sports"; catIcon = "bi-trophy"; }
                                else if (catLower.Contains("work") || catLower.Contains("train")) { catClass = "workshop"; catIcon = "bi-journal-text"; }
                                else if (catLower.Contains("acad") || catLower.Contains("conf")) { catClass = "academic"; catIcon = "bi-mortarboard"; }
                            }

                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="event-card-modern">
                                    <div class="event-card-img-wrapper" style="height: 160px;">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="event-fallback-thumbnail @catClass">
                                                <i class="bi @catIcon fs-2 mb-1"></i>
                                                <span class="small fw-semibold text-white">@(item.Category ?? "Event")</span>
                                            </div>
                                        }
                                        <div class="event-date-pill">
                                            <span class="day">@item.EventDate.Day</span>
                                            <span class="month">@item.EventDate.ToString("MMM")</span>
                                        </div>
                                        <span class="event-category-pill bg-success text-white">
                                            <i class="bi bi-check-circle me-1"></i> Confirmed Pass
                                        </span>
                                    </div>

                                    <div class="event-card-body p-3">
                                        <h5 class="event-card-title fs-6 mb-2">
                                            <a asp-controller="Events" asp-action="Details" asp-route-id="@item.Id">
                                                @item.Title
                                            </a>
                                        </h5>

                                        <div class="event-specs-list small mb-3">
                                            <div class="event-spec-row">
                                                <i class="bi bi-geo-alt-fill text-danger flex-shrink-0"></i>
                                                <span class="text-truncate">@item.Venue</span>
                                            </div>
                                            <div class="event-spec-row">
                                                <i class="bi bi-clock-fill text-primary flex-shrink-0"></i>
                                                <span>@item.StartTime.ToString(@"hh\:mm") @(item.EndTime.HasValue ? "- " + item.EndTime.Value.ToString(@"hh\:mm") : "")</span>
                                            </div>
                                        </div>

                                        <div class="event-card-footer pt-2 d-flex gap-1">
                                            <a asp-controller="Events" asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm flex-grow-1 rounded-pill">
                                                <i class="bi bi-ticket-perforated me-1"></i> Pass
                                            </a>
                                            <a asp-controller="Events" asp-action="Certificate" asp-route-id="@item.Id" class="btn btn-warning btn-sm rounded-pill px-2 fw-semibold text-dark" title="Download Verified Certificate">
                                                <i class="bi bi-award-fill me-1"></i> Certificate
                                            </a>
                                            <form asp-controller="Events" asp-action="CancelRegistration" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel your registration for this event?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle p-2" title="Cancel Registration" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                                                    <i class="bi bi-x-lg" style="font-size: 11px;"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 bg-light rounded-3 p-4">
                        <div class="bg-white p-3 rounded-circle d-inline-block text-muted shadow-sm mb-3" style="width: 70px; height: 70px;">
                            <i class="bi bi-ticket-perforated fs-1 text-primary"></i>
                        </div>
                        <h4 class="h5 fw-bold text-dark mb-1">No Active Event Registrations</h4>
                        <p class="text-muted small mb-3">You haven't reserved tickets for any upcoming events yet.</p>
                        <a asp-controller="Events" asp-action="Index" class="btn btn-primary btn-sm rounded-pill px-4 fw-semibold">
                            <i class="bi bi-compass me-1"></i> Browse & Register for Events
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- SECTION 2: EVENTS I MANAGE (ORGANIZED EVENTS) -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-kanban-fill text-success fs-5"></i>
                    <h2 class="h5 fw-bold mb-0 text-dark">Events I Manage (Organizer)</h2>
                </div>
                @if (Model.OrganizedEvents.Any())
                {
                    <span class="badge bg-success rounded-pill px-3 py-2">@Model.TotalOrganizedCount Hosted</span>
                }
            </div>

            <div class="card-body p-4">
                @if (Model.OrganizedEvents.Any())
                {
                    <div class="row g-4">
                        @foreach (var item in Model.OrganizedEvents)
                        {
                            var catClass = "general";
                            var catIcon = "bi-calendar-event";
                            if (!string.IsNullOrEmpty(item.Category))
                            {
                                var catLower = item.Category.ToLower();
                                if (catLower.Contains("tech")) { catClass = "tech"; catIcon = "bi-laptop"; }
                                else if (catLower.Contains("cult") || catLower.Contains("art")) { catClass = "culture"; catIcon = "bi-palette"; }
                                else if (catLower.Contains("sport") || catLower.Contains("athlet")) { catClass = "sports"; catIcon = "bi-trophy"; }
                                else if (catLower.Contains("work") || catLower.Contains("train")) { catClass = "workshop"; catIcon = "bi-journal-text"; }
                                else if (catLower.Contains("acad") || catLower.Contains("conf")) { catClass = "academic"; catIcon = "bi-mortarboard"; }
                            }

                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="event-card-modern">
                                    <div class="event-card-img-wrapper" style="height: 160px;">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="event-fallback-thumbnail @catClass">
                                                <i class="bi @catIcon fs-2 mb-1"></i>
                                                <span class="small fw-semibold text-white">@(item.Category ?? "Event")</span>
                                            </div>
                                        }
                                        <div class="event-date-pill">
                                            <span class="day">@item.EventDate.Day</span>
                                            <span class="month">@item.EventDate.ToString("MMM")</span>
                                        </div>
                                        <span class="event-category-pill @(item.ApprovalStatus == "APPROVED" ? "bg-success" : item.ApprovalStatus == "PENDING" ? "bg-warning text-dark" : "bg-danger")">
                                            @item.ApprovalStatus
                                        </span>
                                    </div>

                                    <div class="event-card-body p-3">
                                        <h5 class="event-card-title fs-6 mb-2">
                                            <a asp-controller="Events" asp-action="Details" asp-route-id="@item.Id">
                                                @item.Title
                                            </a>
                                        </h5>

                                        <div class="event-specs-list small mb-3">
                                            <div class="event-spec-row">
                                                <i class="bi bi-geo-alt-fill text-danger flex-shrink-0"></i>
                                                <span class="text-truncate">@item.Venue</span>
                                            </div>
                                            <div class="event-spec-row">
                                                <i class="bi bi-people-fill text-info flex-shrink-0"></i>
                                                <span>@item.RegisteredCount @(item.Capacity.HasValue ? $"/ {item.Capacity.Value} capacity" : "registered")</span>
                                            </div>
                                        </div>

                                        <div class="event-card-footer pt-2 d-flex gap-1">
                                            <a asp-controller="Events" asp-action="CheckIn" asp-route-id="@item.Id" class="btn btn-success btn-sm rounded-pill px-2 fw-semibold" title="Launch Live Door Check-In Scanner">
                                                <i class="bi bi-qr-code-scan me-1"></i> Check-In
                                            </a>
                                            <a asp-controller="Events" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm flex-grow-1 rounded-pill">
                                                View Page
                                            </a>
                                            <a asp-controller="Events" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm rounded-circle p-2" title="Edit Event" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                                                <i class="bi bi-pencil" style="font-size: 11px;"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 bg-light rounded-3 p-4">
                        <p class="text-muted small mb-2">You have not created or submitted any hosted events yet.</p>
                        <a asp-controller="Events" asp-action="Create" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                            <i class="bi bi-plus-circle me-1"></i> Propose a New Campus Event
                        </a>
                    </div>
                }
            </div>
        </div>

    </div>
</div>