@model HawassaUnifiedCampusEventManagementSystem.Models.Event

@{
    ViewData["Title"] = Model.Title + " | Hawassa University Events";
}

<div class="container py-5">
    <!-- BACK LINK & BREADCRUMB -->
    <div class="mb-4">
        <a asp-controller="Events" asp-action="Index" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i>
            <span>Back to All Events</span>
        </a>
    </div>

    <!-- MAIN EVENT CONTAINER -->
    <div class="row g-4">
        <!-- LEFT: EVENT MAIN DETAILS, DESCRIPTION & DISCUSSIONS -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4" style="border: 1px solid #e2e8f0 !important;">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div style="max-height: 420px; overflow: hidden; background: #0f172a; position: relative;">
                        <img src="@Model.ImageUrl" alt="@Model.Title" class="w-100 h-100 object-fit-cover" style="max-height: 420px;" />
                    </div>
                }
                else
                {
                    var catClass = "general";
                    var catIcon = "bi-calendar-event";
                    if (!string.IsNullOrEmpty(Model.Category))
                    {
                        var catLower = Model.Category.ToLower();
                        if (catLower.Contains("tech")) { catClass = "tech"; catIcon = "bi-laptop"; }
                        else if (catLower.Contains("cult") || catLower.Contains("art")) { catClass = "culture"; catIcon = "bi-palette"; }
                        else if (catLower.Contains("sport") || catLower.Contains("athlet")) { catClass = "sports"; catIcon = "bi-trophy"; }
                        else if (catLower.Contains("work") || catLower.Contains("train")) { catClass = "workshop"; catIcon = "bi-journal-text"; }
                        else if (catLower.Contains("acad") || catLower.Contains("conf")) { catClass = "academic"; catIcon = "bi-mortarboard"; }
                    }
                    <div class="event-fallback-thumbnail @catClass py-5 text-center" style="min-height: 220px;">
                        <i class="bi @catIcon display-3 text-white mb-2"></i>
                        <span class="fs-5 fw-bold text-white">@(Model.Category ?? "Campus Event")</span>
                    </div>
                }

                <div class="card-body p-4 p-md-5">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-1 rounded-pill">
                            @(string.IsNullOrEmpty(Model.Category) ? "Campus Activity" : Model.Category)
                        </span>
                        <span class="badge bg-light text-muted border">
                            <i class="bi bi-geo-alt me-1 text-danger"></i> @(string.IsNullOrEmpty(Model.Venue) ? "Main Campus Hall" : Model.Venue)
                        </span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">
                            <i class="bi bi-tag me-1"></i> Free Admission
                        </span>
                    </div>

                    <h1 class="h2 fw-bold text-dark mb-4">@Model.Title</h1>

                    <div class="mb-4">
                        <h5 class="fw-bold text-dark mb-2">About This Event</h5>
                        <p class="text-secondary" style="line-height: 1.7; font-size: 1.02rem; white-space: pre-line;">
                            @Model.Description
                        </p>
                    </div>

                    <!-- ORGANIZER ACTION BAR (IF AUTHORIZED) -->
                    @{
                        var currentUserIdStr = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                        ulong? currentUserId = null;
                        if (!string.IsNullOrEmpty(currentUserIdStr) && ulong.TryParse(currentUserIdStr, out ulong uid)) currentUserId = uid;
                        var canManageEvent = (currentUserId.HasValue && Model.OrganizerId == currentUserId.Value) ||
                                             User.IsInRole("Admin") || User.IsInRole("SuperAdmin") ||
                                             User.IsInRole("ADMIN") || User.IsInRole("SUPERADMIN");
                    }

                    @if (canManageEvent)
                    {
                        <div class="p-3 bg-light rounded-3 border d-flex flex-wrap align-items-center justify-content-between gap-2 mt-4">
                            <span class="small fw-semibold text-muted"><i class="bi bi-gear me-1"></i> Organizer Controls</span>
                            <div class="d-flex gap-2">
                                <a asp-controller="Events" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>
                                <form asp-controller="Events" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this event?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash me-1"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- ATTENDEE REVIEWS & RATINGS -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white" style="border: 1px solid #e2e8f0 !important;">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-star-fill text-warning me-2"></i>Ratings & Feedback</h5>
                    @if (Model.TotalRatings > 0)
                    {
                        <span class="badge bg-warning-subtle text-warning-emphasis border px-3 py-1">
                            ★ @Model.AverageRating.ToString("F1") / 5.0 (@Model.TotalRatings reviews)
                        </span>
                    }
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Events" asp-action="AddFeedback" method="post" class="p-3 bg-light rounded-3 border mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="eventId" value="@Model.Id" />
                        <div class="row g-2 align-items-center">
                            <div class="col-md-3">
                                <select name="rating" class="form-select form-select-sm" required>
                                    <option value="5">★★★★★ (5 - Great)</option>
                                    <option value="4">★★★★☆ (4 - Good)</option>
                                    <option value="3">★★★☆☆ (3 - Average)</option>
                                    <option value="2">★★☆☆☆ (2 - Fair)</option>
                                    <option value="1">★☆☆☆☆ (1 - Poor)</option>
                                </select>
                            </div>
                            <div class="col-md-7">
                                <input type="text" name="comment" class="form-control form-control-sm" placeholder="Write feedback or review..." />
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-sm btn-primary w-100">Submit</button>
                            </div>
                        </div>
                    </form>
                }

                @if (Model.Feedbacks != null && Model.Feedbacks.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var fb in Model.Feedbacks)
                        {
                            <div class="list-group-item px-0 py-2 border-bottom">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small fw-bold text-dark">@(fb.IsAnonymous ? "Campus Attendee" : "Verified Attendee")</span>
                                    <span class="text-warning small">@string.Concat(Enumerable.Repeat("★", fb.Rating))</span>
                                </div>
                                @if (!string.IsNullOrEmpty(fb.Comment))
                                {
                                    <p class="small text-muted mb-0">@fb.Comment</p>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="small text-muted mb-0">No attendee reviews yet for this event.</p>
                }
            </div>

            <!-- DISCUSSION BOARD -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white" style="border: 1px solid #e2e8f0 !important;">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-chat-left-text me-2 text-primary"></i>Event Discussion</h5>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Events" asp-action="AddComment" method="post" class="mb-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="eventId" value="@Model.Id" />
                        <div class="input-group">
                            <input type="text" name="comment" class="form-control" placeholder="Ask a question or post a message..." required />
                            <button type="submit" class="btn btn-primary px-3 fw-semibold">Post</button>
                        </div>
                    </form>
                }

                @if (Model.Comments != null && Model.Comments.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var c in Model.Comments)
                        {
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="small text-dark">@c.UserName</strong>
                                    <small class="text-muted">@c.CreatedAt.ToString("MMM dd, hh:mm tt")</small>
                                </div>
                                <p class="small text-secondary mb-0">@c.CommentText</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="small text-muted mb-0">No comments posted yet.</p>
                }
            </div>
        </div>

        <!-- RIGHT: DATE/TIME, RSVP ACTION, VENUE & ORGANIZER CARDS -->
        <div class="col-lg-4">
            <!-- RSVP BOX -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white border-start border-primary border-4" style="border: 1px solid #e2e8f0 !important; border-left: 4px solid #1e40af !important;">
                <h5 class="fw-bold text-dark mb-2">Event Registration</h5>
                <div class="d-flex justify-content-between align-items-center text-muted small mb-3">
                    <span>Capacity Status:</span>
                    <strong class="text-dark">@Model.RegisteredCount / @(Model.Capacity.HasValue ? Model.Capacity.Value.ToString() : "Unlimited")</strong>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (Model.IsUserRegistered)
                    {
                        <div class="alert alert-success py-2 px-3 mb-3 small rounded-3 d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            <div><strong>Registered!</strong> Your seat is confirmed.</div>
                        </div>
                        <form asp-controller="Events" asp-action="CancelRegistration" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Cancel your event reservation?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger w-100 btn-sm">
                                Cancel Registration
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Events" asp-action="RegisterEvent" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm">
                                <i class="bi bi-ticket-perforated me-1"></i> Register for Event
                            </button>
                        </form>
                    }
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Events", new { id = Model.Id })" class="btn btn-primary w-100 py-2 fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Register
                    </a>
                }
            </div>

            <!-- EVENT SCHEDULE & LOCATION -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white" style="border: 1px solid #e2e8f0 !important;">
                <h5 class="fw-bold text-dark mb-3">Schedule & Venue</h5>

                <div class="d-flex align-items-start gap-3 mb-3 pb-3 border-bottom">
                    <div class="bg-primary-subtle text-primary rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-calendar3 fs-5"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block">Date</small>
                        <strong class="text-dark">@Model.EventDate.ToString("dddd, MMMM dd, yyyy")</strong>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-3 mb-3 pb-3 border-bottom">
                    <div class="bg-info-subtle text-info-emphasis rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-clock fs-5"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block">Time</small>
                        <strong class="text-dark">@Model.StartTime.ToString(@"hh\:mm") @(Model.EndTime.HasValue ? "- " + Model.EndTime.Value.ToString(@"hh\:mm") : "")</strong>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-3">
                    <div class="bg-danger-subtle text-danger rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-geo-alt fs-5"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block">Location</small>
                        <strong class="text-dark">@(string.IsNullOrEmpty(Model.Venue) ? "Main Campus Hall" : Model.Venue)</strong>
                    </div>
                </div>
            </div>

            <!-- ORGANIZER INFORMATION -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-light" style="border: 1px solid #e2e8f0 !important;">
                <h5 class="fw-bold text-dark mb-3">Hosted By</h5>
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 44px; height: 44px;">
                        @(!string.IsNullOrEmpty(Model.Organizer) ? Model.Organizer.Substring(0, 1) : "H")
                    </div>
                    <div>
                        <strong class="d-block text-dark">@(string.IsNullOrEmpty(Model.Organizer) ? "Hawassa University" : Model.Organizer)</strong>
                        <span class="small text-muted">Campus Event Host</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>