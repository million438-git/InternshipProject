@model HawassaUnifiedCampusEventManagementSystem.Models.Event

@{
    ViewData["Title"] = "Edit Event";
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/events.css"
          asp-append-version="true" />

}

<div class="event-form-page">

    <div class="container event-form-container">

        <div class="event-form-header">

            <span class="events-eyebrow">
                HUCEMS EVENTS
            </span>

            <h1>
                Edit Event
            </h1>

            <p>
                Update the information for this campus event.
            </p>

        </div>


        <form asp-controller="Events"
              asp-action="Edit"
              asp-route-id="@Model.Id"
              method="post"
              enctype="multipart/form-data"
              class="event-form">

            @Html.AntiForgeryToken()

            <input asp-for="Id"
                   type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>


            <!-- EVENT INFORMATION -->

            <div class="event-form-section">

                <h2>

                    <i class="bi bi-pencil-square"></i>

                    Event Information

                </h2>


                <div class="event-form-grid">

                    <div class="event-form-field full">

                        <label asp-for="Title">
                            Event Title
                        </label>

                        <input asp-for="Title" />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="event-form-field full">
                        <label asp-for="ShortDescription">
                            Short Summary (Displayed on event cards)
                        </label>
                        <input asp-for="ShortDescription"
                               placeholder="Brief 1-2 sentence overview of the event..." />
                        <span asp-validation-for="ShortDescription" class="text-danger"></span>
                    </div>

                    <div class="event-form-field">
                        <label asp-for="Category">
                            Category
                        </label>
                        <select asp-for="Category" class="form-select">
                            <option value="">Select category</option>
                            @if (ViewBag.Categories != null)
                            {
                                foreach (var cat in (IEnumerable<HawassaUnifiedCampusEventManagementSystem.Models.event_category>)ViewBag.Categories)
                                {
                                    <option value="@cat.name" selected="@(Model.Category == cat.name)">@cat.name</option>
                                }
                            }
                            else
                            {
                                <option value="Academic">Academic</option>
                                <option value="Technology">Technology</option>
                                <option value="Culture">Culture</option>
                                <option value="Sports">Sports</option>
                            }
                        </select>
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>


                    <div class="event-form-field">

                        <label asp-for="Capacity">
                            Capacity
                        </label>

                        <input asp-for="Capacity"
                               type="number"
                               min="1" />

                    </div>


                    <div class="event-form-field full">

                        <label asp-for="Description">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  rows="6"></textarea>

                    </div>

                </div>

            </div>

            <!-- EVENT COVER IMAGE MANAGEMENT -->
            <div class="event-form-section">
                <h2>
                    <i class="bi bi-image"></i>
                    Event Cover Image
                </h2>
                <p class="text-muted small mb-3">Update or replace the cover banner for this event card and details page. (Supported: JPG, PNG, WebP up to 5 MB)</p>

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div id="currentImageContainer" class="mb-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="small fw-bold text-dark"><i class="bi bi-image-fill text-primary me-1"></i> Current Banner Image</span>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="RemoveImage" id="removeImageCheckbox" />
                                <label class="form-check-label small text-danger fw-semibold" for="removeImageCheckbox">
                                    Remove Current Image
                                </label>
                            </div>
                        </div>
                        <div class="image-preview-container" id="currentImagePreviewBox">
                            <img src="@Model.ImageUrl" alt="@Model.Title" />
                        </div>
                    </div>
                }

                <div class="image-upload-zone mt-2" id="imageUploadZone" onclick="document.getElementById('eventImageFileInput').click();">
                    <input type="file" asp-for="ImageFile" id="eventImageFileInput" class="d-none" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                    <div id="uploadPrompt" class="d-flex flex-column align-items-center justify-content-center py-2">
                        <i class="bi bi-cloud-arrow-up fs-1 text-primary mb-2"></i>
                        <span class="fw-bold text-dark fs-6">@(string.IsNullOrEmpty(Model.ImageUrl) ? "Click or drag & drop event banner image here" : "Click to select a new replacement banner image")</span>
                        <small class="text-muted mt-1">Recommended resolution: 1200 x 675 (16:9 ratio)</small>
                    </div>
                </div>

                <div id="imagePreviewWrapper" class="mt-3 d-none">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="small fw-bold text-dark"><i class="bi bi-check-circle-fill text-success me-1"></i> New Replacement Image Preview</span>
                        <button type="button" class="btn btn-sm btn-outline-danger" id="clearImageBtn">
                            <i class="bi bi-trash me-1"></i> Cancel Replacement
                        </button>
                    </div>
                    <div class="image-preview-container">
                        <img id="imagePreviewElement" src="#" alt="New Event Preview" />
                    </div>
                </div>
                <span asp-validation-for="ImageFile" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- DATE -->

            <div class="event-form-section">

                <h2>

                    <i class="bi bi-calendar-event"></i>

                    Date, Time & Location

                </h2>


                <div class="event-form-grid">

                    <div class="event-form-field">

                        <label asp-for="EventDate">
                            Event Date
                        </label>

                        <input asp-for="EventDate"
                               type="date" />

                    </div>


                    <div class="event-form-field">
                        <label asp-for="Venue">
                            Venue / Campus Hall
                        </label>
                        <select asp-for="Venue" class="form-select">
                            <option value="">Select venue</option>
                            @if (ViewBag.Venues != null)
                            {
                                foreach (var v in (IEnumerable<HawassaUnifiedCampusEventManagementSystem.Models.Venue>)ViewBag.Venues)
                                {
                                    <option value="@v.name" selected="@(Model.Venue == v.name)">@v.name (@v.capacity capacity)</option>
                                }
                            }
                            else
                            {
                                <option value="Main Campus Auditorium">Main Campus Auditorium</option>
                                <option value="Technology Amphitheater">Technology Amphitheater</option>
                                <option value="Campus Sports Stadium">Campus Sports Stadium</option>
                            }
                        </select>
                        <span asp-validation-for="Venue" class="text-danger"></span>
                    </div>


                    <div class="event-form-field">

                        <label asp-for="StartTime">
                            Start Time
                        </label>

                        <input asp-for="StartTime"
                               type="time" />

                    </div>


                    <div class="event-form-field">

                        <label asp-for="EndTime">
                            End Time
                        </label>

                        <input asp-for="EndTime"
                               type="time" />

                    </div>

                </div>

            </div>


            <!-- ORGANIZER -->

            <div class="event-form-section">

                <h2>

                    <i class="bi bi-person-badge"></i>

                    Organizer

                </h2>


                <div class="event-form-grid">

                    <div class="event-form-field">

                        <label asp-for="Organizer">
                            Organizer
                        </label>

                        <input asp-for="Organizer" />

                    </div>


                    <div class="event-form-field">

                        <label asp-for="OrganizerEmail">
                            Email
                        </label>

                        <input asp-for="OrganizerEmail"
                               type="email" />

                    </div>


                    <div class="event-form-field">

                        <label asp-for="ContactPhone">
                            Phone
                        </label>

                        <input asp-for="ContactPhone"
                               type="tel" />

                    </div>


                    <div class="event-form-field">

                        <label class="event-checkbox">

                            <input asp-for="IsPublished" />

                            <span>
                                Published
                            </span>

                        </label>

                    </div>

                </div>

            </div>


            <!-- ACTIONS -->

            <div class="event-form-actions">

                <a asp-controller="Events"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="event-cancel-button">

                    Cancel

                </a>


                <button type="submit"
                        class="event-save-button">

                    <i class="bi bi-check-lg"></i>

                    Save Changes

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const fileInput = document.getElementById("eventImageFileInput");
            const zone = document.getElementById("imageUploadZone");
            const previewWrapper = document.getElementById("imagePreviewWrapper");
            const previewImg = document.getElementById("imagePreviewElement");
            const clearBtn = document.getElementById("clearImageBtn");
            const removeCheckbox = document.getElementById("removeImageCheckbox");
            const currentPreviewBox = document.getElementById("currentImagePreviewBox");

            if (removeCheckbox && currentPreviewBox) {
                removeCheckbox.addEventListener("change", function () {
                    if (this.checked) {
                        currentPreviewBox.style.opacity = "0.3";
                    } else {
                        currentPreviewBox.style.opacity = "1";
                    }
                });
            }

            if (!fileInput || !zone) return;

            // Drag & drop support
            ['dragenter', 'dragover'].forEach(eventName => {
                zone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    zone.classList.add('dragover');
                }, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                zone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    zone.classList.remove('dragover');
                }, false);
            });

            zone.addEventListener('drop', (e) => {
                if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                    fileInput.files = e.dataTransfer.files;
                    handleFileSelect(fileInput.files[0]);
                }
            });

            fileInput.addEventListener("change", function () {
                if (this.files && this.files[0]) {
                    handleFileSelect(this.files[0]);
                }
            });

            function handleFileSelect(file) {
                if (!file.type.match('image.*')) {
                    alert("Please select a valid image file (JPG, PNG, WebP).");
                    return;
                }
                if (file.size > 5 * 1024 * 1024) {
                    alert("File is too large. Maximum size is 5 MB.");
                    return;
                }
                const reader = new FileReader();
                reader.onload = function (e) {
                    previewImg.src = e.target.result;
                    previewWrapper.classList.remove("d-none");
                    if (removeCheckbox) removeCheckbox.checked = false;
                    if (currentPreviewBox) currentPreviewBox.style.opacity = "1";
                };
                reader.readAsDataURL(file);
            }

            if (clearBtn) {
                clearBtn.addEventListener("click", function (e) {
                    e.stopPropagation();
                    fileInput.value = "";
                    previewImg.src = "#";
                    previewWrapper.classList.add("d-none");
                });
            }
        });
    </script>

}