@model HawassaUnifiedCampusEventManagementSystem.Models.Event

@{
    ViewData["Title"] = "Create Event";
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/events.css"
          asp-append-version="true" />

}

<div class="event-form-page">

    <div class="container event-form-container">

        <div class="event-form-header">

            <span class="events-eyebrow">
                HUCEMS EVENTS
            </span>

            <h1>
                Create a New Event
            </h1>

            <p>
                Share an activity, workshop, seminar or event
                with the campus community.
            </p>

        </div>


        <form asp-controller="Events"
              asp-action="Create"
              method="post"
              enctype="multipart/form-data"
              class="event-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>


            <!-- BASIC INFORMATION -->

            <div class="event-form-section">

                <h2>
                    <i class="bi bi-info-circle"></i>
                    Event Information
                </h2>


                <div class="event-form-grid">

                    <div class="event-form-field full">

                        <label asp-for="Title">
                            Event Title
                        </label>

                        <input asp-for="Title"
                               placeholder="Enter event title..." />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="event-form-field full">
                        <label asp-for="ShortDescription">
                            Short Summary (Displayed on event cards)
                        </label>
                        <input asp-for="ShortDescription"
                               placeholder="Brief 1-2 sentence overview of the event..." />
                        <span asp-validation-for="ShortDescription" class="text-danger"></span>
                    </div>

                    <div class="event-form-field">
                        <label asp-for="Category">
                            Category
                        </label>
                        <select asp-for="Category" class="form-select">
                            <option value="">Select category</option>
                            @if (ViewBag.Categories != null)
                            {
                                foreach (var cat in (IEnumerable<HawassaUnifiedCampusEventManagementSystem.Models.event_category>)ViewBag.Categories)
                                {
                                    <option value="@cat.name">@cat.name</option>
                                }
                            }
                            else
                            {
                                <option>Academic</option>
                                <option>Technology</option>
                                <option>Culture</option>
                                <option>Sports</option>
                            }
                        </select>
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>

                    <div class="event-form-field">
                        <label asp-for="Capacity">
                            Maximum Capacity
                        </label>
                        <input asp-for="Capacity" type="number" min="1" placeholder="Example: 100" />
                    </div>

                    <div class="event-form-field full">
                        <label asp-for="Description">
                            Full Description & Agenda
                        </label>
                        <textarea asp-for="Description" rows="6" placeholder="Detailed schedule, speakers, requirements, and information..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                </div>

            </div>

            <!-- EVENT IMAGE UPLOAD SECTION -->
            <div class="event-form-section">
                <h2>
                    <i class="bi bi-image"></i>
                    Event Cover Image
                </h2>
                <p class="text-muted small mb-3">Upload a banner or cover photo for your event card and details header. (Supported: JPG, PNG, WebP up to 5 MB)</p>

                <div class="image-upload-zone" id="imageUploadZone" onclick="document.getElementById('eventImageFileInput').click();">
                    <input type="file" asp-for="ImageFile" id="eventImageFileInput" class="d-none" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                    <div id="uploadPrompt" class="d-flex flex-column align-items-center justify-content-center py-2">
                        <i class="bi bi-cloud-arrow-up fs-1 text-primary mb-2"></i>
                        <span class="fw-bold text-dark fs-6">Click or drag & drop event banner image here</span>
                        <small class="text-muted mt-1">Recommended resolution: 1200 x 675 (16:9 ratio)</small>
                    </div>
                </div>

                <div id="imagePreviewWrapper" class="mt-3 d-none">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="small fw-bold text-dark"><i class="bi bi-check-circle-fill text-success me-1"></i> Selected Image Preview</span>
                        <button type="button" class="btn btn-sm btn-outline-danger" id="clearImageBtn">
                            <i class="bi bi-trash me-1"></i> Remove
                        </button>
                    </div>
                    <div class="image-preview-container">
                        <img id="imagePreviewElement" src="#" alt="Event Preview" />
                    </div>
                </div>
                <span asp-validation-for="ImageFile" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- DATE AND LOCATION -->
            <div class="event-form-section">
                <h2>
                    <i class="bi bi-calendar-event"></i>
                    Date, Time & Location
                </h2>

                <div class="event-form-grid">
                    <div class="event-form-field">
                        <label asp-for="EventDate">
                            Event Date
                        </label>
                        <input asp-for="EventDate" type="date" />
                    </div>

                    <div class="event-form-field">
                        <label asp-for="Venue">
                            Venue / Campus Hall
                        </label>
                        <select asp-for="Venue" class="form-select">
                            <option value="">Select venue</option>
                            @if (ViewBag.Venues != null)
                            {
                                foreach (var v in (IEnumerable<HawassaUnifiedCampusEventManagementSystem.Models.Venue>)ViewBag.Venues)
                                {
                                    <option value="@v.name">@v.name (@v.capacity capacity)</option>
                                }
                            }
                            else
                            {
                                <option>Main Campus Auditorium</option>
                                <option>Technology Amphitheater</option>
                                <option>Campus Sports Stadium</option>
                            }
                        </select>
                    </div>


                    <div class="event-form-field">

                        <label asp-for="StartTime">
                            Start Time
                        </label>

                        <input asp-for="StartTime"
                               type="time" />

                    </div>


                    <div class="event-form-field">

                        <label asp-for="EndTime">
                            End Time
                        </label>

                        <input asp-for="EndTime"
                               type="time" />

                    </div>

                </div>

            </div>


            <!-- ORGANIZER -->

            <div class="event-form-section">

                <h2>
                    <i class="bi bi-person-badge"></i>
                    Organizer Information
                </h2>


                <div class="event-form-grid">

                    <div class="event-form-field">

                        <label asp-for="Organizer">
                            Organizer
                        </label>

                        <input asp-for="Organizer"
                               placeholder="Club, department or organization" />

                    </div>


                    <div class="event-form-field">

                        <label asp-for="OrganizerEmail">
                            Email
                        </label>

                        <input asp-for="OrganizerEmail"
                               type="email"
                               placeholder="organizer@example.com" />

                    </div>


                    <div class="event-form-field">

                        <label asp-for="ContactPhone">
                            Phone
                        </label>

                        <input asp-for="ContactPhone"
                               type="tel"
                               placeholder="+251..." />

                    </div>


                    <div class="event-form-field">

                        <label>
                            Publishing
                        </label>

                        <label class="event-checkbox">

                            <input asp-for="IsPublished" />

                            <span>
                                Publish this event
                            </span>

                        </label>

                    </div>

                </div>

            </div>


            <!-- ACTIONS -->

            <div class="event-form-actions">

                <a asp-controller="Events"
                   asp-action="Index"
                   class="event-cancel-button">

                    Cancel

                </a>


                <button type="submit"
                        class="event-save-button">

                    <i class="bi bi-check-lg"></i>

                    Create Event

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const fileInput = document.getElementById("eventImageFileInput");
            const zone = document.getElementById("imageUploadZone");
            const previewWrapper = document.getElementById("imagePreviewWrapper");
            const previewImg = document.getElementById("imagePreviewElement");
            const clearBtn = document.getElementById("clearImageBtn");

            if (!fileInput || !zone) return;

            // Drag & drop support
            ['dragenter', 'dragover'].forEach(eventName => {
                zone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    zone.classList.add('dragover');
                }, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                zone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    zone.classList.remove('dragover');
                }, false);
            });

            zone.addEventListener('drop', (e) => {
                if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                    fileInput.files = e.dataTransfer.files;
                    handleFileSelect(fileInput.files[0]);
                }
            });

            fileInput.addEventListener("change", function () {
                if (this.files && this.files[0]) {
                    handleFileSelect(this.files[0]);
                }
            });

            function handleFileSelect(file) {
                if (!file.type.match('image.*')) {
                    alert("Please select a valid image file (JPG, PNG, WebP).");
                    return;
                }
                if (file.size > 5 * 1024 * 1024) {
                    alert("File is too large. Maximum size is 5 MB.");
                    return;
                }
                const reader = new FileReader();
                reader.onload = function (e) {
                    previewImg.src = e.target.result;
                    previewWrapper.classList.remove("d-none");
                };
                reader.readAsDataURL(file);
            }

            if (clearBtn) {
                clearBtn.addEventListener("click", function (e) {
                    e.stopPropagation();
                    fileInput.value = "";
                    previewImg.src = "#";
                    previewWrapper.classList.add("d-none");
                });
            }
        });
    </script>

}