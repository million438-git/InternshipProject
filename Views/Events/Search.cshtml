@model IEnumerable<HawassaUnifiedCampusEventManagementSystem.Models.Event>

@{
    ViewData["Title"] = "Search Campus Events | HUCEMS";
    var query = ViewBag.Query as string ?? "";
    var currentUserIdStr = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    bool isPrivileged = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
}

<div class="container py-5">

    <!-- PAGE HEADER -->
    <div class="text-center mb-5">
        <div class="mb-3">
            <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-semibold">
                <i class="bi bi-search me-1"></i> Campus Discovery
            </span>
        </div>
        <h1 class="display-6 fw-bold text-dark mb-2">Search Campus Events</h1>
        <p class="text-muted lead mx-auto" style="max-width: 600px;">
            Find academic symposiums, department workshops, student club activities, and campus seminars across Hawassa University.
        </p>
    </div>

    <!-- SEARCH BOX -->
    <div class="card border-0 shadow-sm mb-5 rounded-4 overflow-hidden">
        <div class="card-body p-4 bg-light">
            <form asp-controller="Events" asp-action="Search" method="get">
                <div class="row g-3 align-items-center">
                    <div class="col-lg-9 col-md-8">
                        <label class="form-label fw-semibold small text-muted mb-1">Search Keywords</label>
                        <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden border">
                            <span class="input-group-text bg-white border-0 ps-4">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="search"
                                   name="query"
                                   value="@query"
                                   class="form-control border-0"
                                   placeholder="Search by event title, agenda, topic, or venue..." />
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-4 d-flex align-items-end pt-md-4">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill w-100 fw-semibold shadow-sm">
                            <i class="bi bi-search me-1"></i> Search
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- SEARCH RESULTS -->
    @if (!string.IsNullOrWhiteSpace(query))
    {
        if (Model != null && Model.Any())
        {
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <h4 class="fw-bold text-dark mb-0">
                    Results for <span class="text-primary">"@query"</span>
                </h4>
                <span class="badge bg-primary rounded-pill px-3 py-2">
                    @Model.Count() @(Model.Count() == 1 ? "event found" : "events found")
                </span>
            </div>

            <div class="row g-4">
                @foreach (var item in Model)
                {
                    bool canEdit = isPrivileged || (item.OrganizerId.HasValue && item.OrganizerId.ToString() == currentUserIdStr);

                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden d-flex flex-column">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 180px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="height: 140px;">
                                    <i class="bi bi-calendar-event display-4"></i>
                                </div>
                            }

                            <div class="card-body p-4 d-flex flex-column">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="badge bg-light text-primary border rounded-pill px-3 py-1 fw-semibold">
                                        <i class="bi bi-tag me-1"></i>@(item.Category ?? "Campus Event")
                                    </span>
                                    @if (item.EventDate >= DateTime.Today)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                                            Upcoming
                                        </span>
                                    }
                                </div>

                                <h5 class="card-title fw-bold text-dark mb-2">
                                    @item.Title
                                </h5>

                                <p class="text-muted small mb-3" style="line-height: 1.5; flex-grow: 1;">
                                    @(item.ShortDescription ?? (item.Description != null && item.Description.Length > 120 ? item.Description.Substring(0, 120) + "..." : item.Description ?? "No description provided."))
                                </p>

                                <div class="small text-muted mb-2 d-flex align-items-center gap-2">
                                    <i class="bi bi-calendar-event text-primary"></i>
                                    <span>@item.EventDate.ToString("dddd, MMM d, yyyy")</span>
                                </div>

                                <div class="small text-muted mb-3 d-flex align-items-center gap-2">
                                    <i class="bi bi-geo-alt-fill text-danger"></i>
                                    <span>@(item.Venue ?? "Hawassa University Campus")</span>
                                </div>

                                <div class="d-flex gap-2 pt-2 border-top mt-auto">
                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-primary btn-sm rounded-pill flex-grow-1">
                                        <i class="bi bi-eye me-1"></i> View Details
                                    </a>

                                    @if (canEdit)
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-secondary btn-sm rounded-pill px-3"
                                           title="Edit Event (Authorized)">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="d-inline-flex p-4 rounded-circle bg-light text-muted mb-3">
                    <i class="bi bi-search display-5"></i>
                </div>
                <h3 class="fw-bold text-dark">No Events Found</h3>
                <p class="text-muted mx-auto" style="max-width: 480px;">
                    We couldn't find any events matching "<strong>@query</strong>". Try searching with different keywords or check out our complete campus events calendar.
                </p>
                <div class="d-flex justify-content-center gap-2 mt-3">
                    <a asp-action="Index" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-calendar2-week me-1"></i> Browse All Events
                    </a>
                    <a asp-controller="Calendar" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-calendar-event me-1"></i> Academic Calendar
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-4">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="p-4 bg-light rounded-4 border">
                        <h5 class="fw-bold text-dark mb-2">Explore University Activities</h5>
                        <p class="text-muted small mb-3">
                            Type a keyword in the search box above to find events by department, topic, or venue, or jump directly into the full directory.
                        </p>
                        <a asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-4">
                            <i class="bi bi-arrow-right-circle me-1"></i> Browse All Campus Events
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

</div>