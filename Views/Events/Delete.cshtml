@model HawassaUnifiedCampusEventManagementSystem.Models.Event
@{
    ViewData["Title"] = "Delete Event | HUCEMS";
}

@section Styles {
    <link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-danger text-white py-3 px-4 d-flex align-items-center gap-2">
                    <i class="bi bi-trash3-fill fs-5"></i>
                    <h3 class="h5 mb-0 fw-bold">Delete Event Confirmation</h3>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="alert alert-warning d-flex align-items-center gap-3 p-3 rounded-3 mb-4">
                        <i class="bi bi-exclamation-triangle-fill fs-3 text-warning flex-shrink-0"></i>
                        <div>
                            <strong>Warning: Permanent Deletion</strong><br />
                            Are you sure you want to delete this campus event? This will remove the event record, registrations, attendee tickets, and discussion threads.
                        </div>
                    </div>

                    <!-- EVENT INFORMATION -->
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <h4 class="h6 fw-bold text-dark mb-3 border-bottom pb-2">
                            <i class="bi bi-info-circle me-1 text-primary"></i> Event Summary
                        </h4>

                        <div class="row g-3">
                            <div class="col-md-12">
                                <span class="text-muted small d-block">Event Title</span>
                                <strong class="fs-6 text-dark">@Model.Title</strong>
                            </div>

                            <div class="col-sm-6">
                                <span class="text-muted small d-block">Category</span>
                                <span class="badge bg-primary-subtle text-primary fw-semibold">@(Model.Category ?? "General")</span>
                            </div>

                            <div class="col-sm-6">
                                <span class="text-muted small d-block">Scheduled Date</span>
                                <strong class="text-dark">@Model.EventDate.ToString("MMMM dd, yyyy")</strong>
                            </div>

                            <div class="col-sm-6">
                                <span class="text-muted small d-block">Venue / Location</span>
                                <strong class="text-dark">@(Model.Venue ?? "Main Campus")</strong>
                            </div>

                            <div class="col-sm-6">
                                <span class="text-muted small d-block">Organizer</span>
                                <strong class="text-dark">@(Model.Organizer ?? "Campus Coordinator")</strong>
                            </div>
                        </div>
                    </div>

                    <!-- DELETE FORM -->
                    <form asp-controller="Events" asp-action="Delete" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="d-flex flex-wrap gap-2 justify-content-end pt-2">
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-4 rounded-pill">
                                <i class="bi bi-arrow-left me-1"></i> Cancel
                            </a>

                            <button type="submit" class="btn btn-danger px-4 rounded-pill fw-semibold">
                                <i class="bi bi-trash3 me-1"></i> Permanently Delete Event
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>