@model HawassaUnifiedCampusEventManagementSystem.Models.AdminCommentsFeedbackViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Community Moderation & Feedback";
}

<!-- =======================================================
     PAGE HEADER & TOP ACTION TOOLBAR
     ======================================================= -->
<div class="admin-page-header d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-decoration-none">Admin Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Comments & Moderation</li>
            </ol>
        </nav>
        <h1 class="h3 fw-bold text-dark mb-1">💬 Community Feedback & Content Moderation</h1>
        <p class="text-muted small mb-0">Oversee campus event discussions, monitor attendee sentiment and star ratings, and moderate inappropriate submissions.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Admin" asp-action="ExportCommentsCsv" 
           asp-route-tab="@Model.Tab"
           asp-route-search="@Model.SearchTerm"
           asp-route-rating="@Model.RatingFilter"
           class="btn btn-outline-success btn-sm d-inline-flex align-items-center gap-1 shadow-sm px-3"
           title="Export current moderation records to CSV">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>
            <span>Export CSV</span>
        </a>
        <a asp-controller="Admin" asp-action="Reports" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1">
            <i class="bi bi-graph-up me-1"></i>Campus Analytics
        </a>
    </div>
</div>

<!-- =======================================================
     METRICS SUMMARY CARDS
     ======================================================= -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-primary-subtle text-primary"><i class="bi bi-chat-left-dots-fill"></i></div>
            <div>
                <div class="stat-num">@Model.TotalComments.ToString("N0")</div>
                <div class="stat-desc">Discussion Comments</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-info-subtle text-info"><i class="bi bi-card-checklist"></i></div>
            <div>
                <div class="stat-num">@Model.TotalFeedbacks.ToString("N0")</div>
                <div class="stat-desc">Feedback Reviews</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-warning-subtle text-warning-emphasis"><i class="bi bi-star-fill"></i></div>
            <div>
                <div class="stat-num">@Model.AverageRating.ToString("F1") / 5.0</div>
                <div class="stat-desc">Avg Attendee Rating</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-danger-subtle text-danger"><i class="bi bi-exclamation-diamond-fill"></i></div>
            <div>
                <div class="stat-num">@Model.CriticalFeedbackCount</div>
                <div class="stat-desc">Low Ratings (1-2 Stars)</div>
            </div>
        </div>
    </div>
</div>

<!-- =======================================================
     TAB SELECTION & FILTERS TOOLBAR
     ======================================================= -->
<div class="admin-card p-3 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-2 border-bottom">
        <div class="btn-group btn-group-sm" role="group">
            <a asp-controller="Admin" asp-action="Comments" asp-route-tab="COMMENTS" 
               class="btn @(Model.Tab == "COMMENTS" ? "btn-primary fw-bold" : "btn-light border") px-3">
                <i class="bi bi-chat-quote me-1"></i>Event Comments (@Model.TotalComments)
            </a>
            <a asp-controller="Admin" asp-action="Comments" asp-route-tab="FEEDBACK" 
               class="btn @(Model.Tab == "FEEDBACK" ? "btn-primary fw-bold" : "btn-light border") px-3">
                <i class="bi bi-star-half me-1"></i>Star Feedback & Reviews (@Model.TotalFeedbacks)
            </a>
        </div>
    </div>

    <form method="get" class="row g-2 align-items-center">
        <input type="hidden" name="tab" value="@Model.Tab" />

        <div class="col-12 col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="search" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search event title, attendee name, email, text..." />
            </div>
        </div>

        @if (Model.Tab == "FEEDBACK")
        {
            <div class="col-6 col-md-3">
                <select name="rating" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="ALL" selected="@(Model.RatingFilter == null || Model.RatingFilter == "ALL")">All Star Ratings</option>
                    <option value="5" selected="@(Model.RatingFilter == "5")">⭐⭐⭐⭐⭐ 5 Stars</option>
                    <option value="4" selected="@(Model.RatingFilter == "4")">⭐⭐⭐⭐ 4 Stars</option>
                    <option value="3" selected="@(Model.RatingFilter == "3")">⭐⭐⭐ 3 Stars</option>
                    <option value="CRITICAL" selected="@(Model.RatingFilter == "CRITICAL")">⚠️ 1-2 Stars (Critical)</option>
                </select>
            </div>
        }

        <div class="col-6 @(Model.Tab == "FEEDBACK" ? "col-md-2" : "col-md-4")">
            <select name="pageSize" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="20" selected="@(Model.PageSize == 20)">20 per page</option>
                <option value="50" selected="@(Model.PageSize == 50)">50 per page</option>
                <option value="100" selected="@(Model.PageSize == 100)">100 per page</option>
            </select>
        </div>

        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary flex-grow-1">Filter</button>
            <a asp-controller="Admin" asp-action="Comments" asp-route-tab="@Model.Tab" class="btn btn-sm btn-light border" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<!-- =======================================================
     MODERATION DATA TABLE
     ======================================================= -->
<div class="admin-card overflow-hidden">
    @if (Model.Tab == "COMMENTS")
    {
        <div class="table-responsive">
            <table class="table admin-table align-middle mb-0" id="commentsTable">
                <thead>
                    <tr>
                        <th>Target Event</th>
                        <th>Commenter</th>
                        <th>Comment Text</th>
                        <th>Posted Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Comments.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-chat-square-dots fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <h5 class="fw-bold text-dark mb-1">No Comments Found</h5>
                                <p class="small text-muted mb-0">No discussion comments match your filter criteria.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var c in Model.Comments)
                    {
                        <tr>
                            <td style="max-width: 220px;">
                                <a asp-controller="Admin" asp-action="Events" asp-route-search="@c.EventTitle" class="fw-bold text-dark text-decoration-none text-truncate d-block" title="@c.EventTitle">
                                    <i class="bi bi-calendar-event me-1 text-primary"></i>@c.EventTitle
                                </a>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark small">@c.UserName</div>
                                @if (!string.IsNullOrEmpty(c.UserEmail))
                                {
                                    <small class="text-muted font-monospace" style="font-size: 11px;">@c.UserEmail</small>
                                }
                            </td>
                            <td style="max-width: 380px;">
                                <div class="small text-dark p-2 bg-light rounded border text-break">
                                    @c.CommentText
                                </div>
                                @if (c.IsEdited)
                                {
                                    <small class="text-muted fst-italic" style="font-size: 10px;">(edited by user)</small>
                                }
                            </td>
                            <td>
                                <div class="small text-dark">@c.CreatedAt.ToString("yyyy-MM-dd")</div>
                                <small class="text-muted">@c.CreatedAt.ToString("HH:mm")</small>
                            </td>
                            <td class="text-end">
                                <form asp-controller="Admin" asp-action="CommentDelete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Prune this comment from event discussions?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-light border text-danger py-1 px-2" title="Delete Comment">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table align-middle mb-0" id="feedbackTable">
                <thead>
                    <tr>
                        <th>Target Event</th>
                        <th>Attendee</th>
                        <th>Rating</th>
                        <th>Feedback Review</th>
                        <th>Submitted Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Feedbacks.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-star-slash fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <h5 class="fw-bold text-dark mb-1">No Feedback Submissions Found</h5>
                                <p class="small text-muted mb-0">No event reviews match your filter criteria.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var f in Model.Feedbacks)
                    {
                        <tr>
                            <td style="max-width: 220px;">
                                <a asp-controller="Admin" asp-action="Events" asp-route-search="@f.EventTitle" class="fw-bold text-dark text-decoration-none text-truncate d-block" title="@f.EventTitle">
                                    <i class="bi bi-calendar-event me-1 text-primary"></i>@f.EventTitle
                                </a>
                            </td>
                            <td>
                                @if (f.IsAnonymous)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border rounded-pill">
                                        <i class="bi bi-incognito me-1"></i>Anonymous
                                    </span>
                                }
                                else
                                {
                                    <div class="fw-semibold text-dark small">@f.UserName</div>
                                    @if (!string.IsNullOrEmpty(f.UserEmail))
                                    {
                                        <small class="text-muted font-monospace" style="font-size: 11px;">@f.UserEmail</small>
                                    }
                                }
                            </td>
                            <td>
                                <span class="badge @f.RatingBadgeClass px-2 py-1">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= f.Rating ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                                    }
                                    <span class="ms-1 fw-bold">@f.Rating.0</span>
                                </span>
                            </td>
                            <td style="max-width: 360px;">
                                <div class="small text-dark text-break">
                                    @(string.IsNullOrWhiteSpace(f.FeedbackText) ? "(No written review provided)" : f.FeedbackText)
                                </div>
                            </td>
                            <td>
                                <div class="small text-dark">@f.CreatedAt.ToString("yyyy-MM-dd")</div>
                                <small class="text-muted">@f.CreatedAt.ToString("HH:mm")</small>
                            </td>
                            <td class="text-end">
                                <form asp-controller="Admin" asp-action="FeedbackDelete" asp-route-id="@f.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this feedback review?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-light border text-danger py-1 px-2" title="Delete Feedback">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- =======================================================
         PAGINATION BAR
         ======================================================= -->
    @if (Model.TotalFilteredCount > 0)
    {
        <div class="p-3 bg-light border-top d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="small text-muted">
                Showing <strong>@(((Model.CurrentPage - 1) * Model.PageSize) + 1)</strong> to <strong>@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalFilteredCount))</strong> of <strong>@Model.TotalFilteredCount</strong> entries
            </div>
            
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Moderation Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Comments" 
                               asp-route-tab="@Model.Tab"
                               asp-route-page="@(Model.CurrentPage - 1)" 
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-search="@Model.SearchTerm" 
                               asp-route-rating="@Model.RatingFilter">Previous</a>
                        </li>

                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            if (p == 1 || p == Model.TotalPages || (p >= Model.CurrentPage - 2 && p <= Model.CurrentPage + 2))
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Comments" 
                                       asp-route-tab="@Model.Tab"
                                       asp-route-page="@p" 
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-search="@Model.SearchTerm" 
                                       asp-route-rating="@Model.RatingFilter">@p</a>
                                </li>
                            }
                            else if (p == Model.CurrentPage - 3 || p == Model.CurrentPage + 3)
                            {
                                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                            }
                        }

                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Comments" 
                               asp-route-tab="@Model.Tab"
                               asp-route-page="@(Model.CurrentPage + 1)" 
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-search="@Model.SearchTerm" 
                               asp-route-rating="@Model.RatingFilter">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
</div>
