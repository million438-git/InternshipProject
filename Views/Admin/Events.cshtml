@model HawassaUnifiedCampusEventManagementSystem.Models.AdminEventsViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Campus Event Moderation & Schedules";
}

<!-- =======================================================
     PAGE HEADER & TOP ACTION TOOLBAR
     ======================================================= -->
<div class="admin-page-header d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-decoration-none">Admin Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Event Management</li>
            </ol>
        </nav>
        <h1 class="h3 fw-bold text-dark mb-1">📅 Campus Event Management & Moderation</h1>
        <p class="text-muted small mb-0">Control campus event schedules, review departmental submissions, manage venue assignments, and publish live listings.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Events" asp-action="Create" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 shadow-sm px-3">
            <i class="bi bi-plus-lg"></i>
            <span>Create New Event</span>
        </a>
        <a asp-controller="Admin" asp-action="ExportEventsCsv" 
           asp-route-search="@Model.SearchTerm" 
           asp-route-status="@Model.StatusFilter"
           asp-route-categoryId="@Model.CategoryId"
           asp-route-venueId="@Model.VenueId"
           asp-route-timeframe="@Model.Timeframe"
           class="btn btn-outline-success btn-sm d-inline-flex align-items-center gap-1 shadow-sm px-3"
           title="Export current event list to CSV spreadsheet">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>
            <span>Export CSV</span>
        </a>
        <a asp-controller="Admin" asp-action="Calendar" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
            <i class="bi bi-calendar3 me-1"></i>Master Calendar
        </a>
    </div>
</div>

<!-- =======================================================
     METRICS CARDS
     ======================================================= -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-primary-subtle text-primary"><i class="bi bi-calendar-event"></i></div>
            <div>
                <div class="stat-num">@Model.TotalEvents</div>
                <div class="stat-desc">Total Campus Events</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Admin" asp-action="Events" asp-route-status="PENDING" class="text-decoration-none">
            <div class="admin-stat-card border border-warning h-100 @(Model.PendingApprovalCount > 0 ? "shadow-sm bg-warning-subtle bg-opacity-25" : "")">
                <div class="stat-icon-box bg-warning-subtle text-warning"><i class="bi bi-hourglass-split"></i></div>
                <div>
                    <div class="stat-num text-warning-emphasis">
                        @Model.PendingApprovalCount
                        @if (Model.PendingApprovalCount > 0)
                        {
                            <span class="badge bg-danger text-white fs-6 py-0 px-2 align-middle ms-1">Review</span>
                        }
                    </div>
                    <div class="stat-desc fw-semibold text-warning-emphasis">Pending Moderation</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-success-subtle text-success"><i class="bi bi-check-circle"></i></div>
            <div>
                <div class="stat-num">@Model.PublishedCount</div>
                <div class="stat-desc">Published Live</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-info-subtle text-info"><i class="bi bi-clock-history"></i></div>
            <div>
                <div class="stat-num">@Model.UpcomingCount</div>
                <div class="stat-desc">Upcoming & Today (@Model.TodayCount Today)</div>
            </div>
        </div>
    </div>
</div>

<!-- =======================================================
     FILTERS, TIMEFRAMES & ADVANCED SEARCH
     ======================================================= -->
<div class="admin-card p-3 mb-4">
    <!-- TIMEFRAME QUICK TABS -->
    <div class="d-flex flex-wrap gap-2 mb-3 pb-2 border-bottom">
        <a asp-controller="Admin" asp-action="Events" class="btn btn-sm @(string.IsNullOrEmpty(Model.Timeframe) || Model.Timeframe == "ALL" ? "btn-dark" : "btn-light border")">
            All Timeframes (@Model.TotalEvents)
        </a>
        <a asp-controller="Admin" asp-action="Events" asp-route-status="PENDING" class="btn btn-sm @(Model.StatusFilter == "PENDING" ? "btn-warning text-dark fw-bold" : "btn-light border")">
            <i class="bi bi-hourglass-split me-1"></i>Pending Approvals (@Model.PendingApprovalCount)
        </a>
        <a asp-controller="Admin" asp-action="Events" asp-route-timeframe="UPCOMING" class="btn btn-sm @(Model.Timeframe == "UPCOMING" ? "btn-primary" : "btn-light border")">
            <i class="bi bi-calendar-check me-1"></i>Upcoming (@Model.UpcomingCount)
        </a>
        <a asp-controller="Admin" asp-action="Events" asp-route-timeframe="TODAY" class="btn btn-sm @(Model.Timeframe == "TODAY" ? "btn-success" : "btn-light border")">
            <i class="bi bi-broadcast me-1"></i>Happening Today (@Model.TodayCount)
        </a>
        <a asp-controller="Admin" asp-action="Events" asp-route-timeframe="PAST" class="btn btn-sm @(Model.Timeframe == "PAST" ? "btn-secondary" : "btn-light border")">
            <i class="bi bi-archive me-1"></i>Past Events
        </a>
    </div>

    <!-- ADVANCED FILTER FORM -->
    <form method="get" class="row g-2 align-items-center">
        <input type="hidden" name="timeframe" value="@Model.Timeframe" />

        <div class="col-12 col-md-3">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="search" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search title or description..." />
            </div>
        </div>

        <div class="col-6 col-md-2">
            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="ALL" selected="@(Model.StatusFilter == null || Model.StatusFilter == "ALL")">All Statuses</option>
                <option value="PENDING" selected="@(Model.StatusFilter == "PENDING")">⏳ Pending Approval</option>
                <option value="PUBLISHED" selected="@(Model.StatusFilter == "PUBLISHED")">🟢 Published</option>
                <option value="DRAFT" selected="@(Model.StatusFilter == "DRAFT")">📝 Draft</option>
                <option value="CANCELLED" selected="@(Model.StatusFilter == "CANCELLED")">🔴 Cancelled</option>
            </select>
        </div>

        <div class="col-6 col-md-2">
            <select name="categoryId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Categories</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.id" selected="@(Model.CategoryId == cat.id)">@cat.name</option>
                }
            </select>
        </div>

        <div class="col-6 col-md-2">
            <select name="venueId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Venues</option>
                @foreach (var ven in Model.Venues)
                {
                    <option value="@ven.id" selected="@(Model.VenueId == ven.id)">@ven.name</option>
                }
            </select>
        </div>

        <div class="col-6 col-md-2">
            <select name="sortBy" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="newest" selected="@(Model.SortBy == "newest" || string.IsNullOrEmpty(Model.SortBy))">Newest Added</option>
                <option value="event_date_asc" selected="@(Model.SortBy == "event_date_asc")">Event Date (Earliest)</option>
                <option value="event_date_desc" selected="@(Model.SortBy == "event_date_desc")">Event Date (Latest)</option>
                <option value="registrations_desc" selected="@(Model.SortBy == "registrations_desc")">Most Registrations</option>
                <option value="title_asc" selected="@(Model.SortBy == "title_asc")">Title (A-Z)</option>
            </select>
        </div>

        <div class="col-12 col-md-1 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-primary flex-grow-1">Filter</button>
            <a asp-controller="Admin" asp-action="Events" class="btn btn-sm btn-light border" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<!-- =======================================================
     BATCH MODERATION STRIP & EVENTS TABLE
     ======================================================= -->
<div class="admin-card overflow-hidden">
    <form asp-controller="Admin" asp-action="BatchApproveEvents" method="post" id="batchEventsForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

        <!-- BULK ACTIONS STRIP -->
        <div class="bg-light border-bottom p-3 d-flex flex-wrap align-items-center justify-content-between gap-3" id="batchActionBar">
            <div class="d-flex align-items-center gap-3">
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="selectAllCheckbox" onchange="toggleSelectAllEvents(this)" />
                    <label class="form-check-label small fw-semibold text-dark cursor-pointer" for="selectAllCheckbox">
                        Select All (<span id="selectedCountDisplay">0</span>)
                    </label>
                </div>
                <span class="text-muted small">Select pending event proposals to moderate simultaneously.</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="submit" class="btn btn-success btn-sm fw-semibold shadow-sm" id="batchApproveBtn" disabled onclick="return confirm('Approve and publish all selected events to the campus portal?');">
                    <i class="bi bi-check-circle me-1"></i> Approve Selected (<span class="batchCountText">0</span>)
                </button>
                <button type="button" class="btn btn-outline-danger btn-sm fw-semibold shadow-sm" id="batchRejectBtn" disabled onclick="openBatchRejectModal()">
                    <i class="bi bi-x-circle me-1"></i> Reject Selected (<span class="batchCountText">0</span>)
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table admin-table align-middle mb-0" id="eventsTable">
                <thead>
                    <tr>
                        <th style="width: 40px;"></th>
                        <th>Event & Visibility</th>
                        <th>Category & Venue</th>
                        <th>Organizer / Unit</th>
                        <th>Schedule & Lifecycle</th>
                        <th>Registration Demand</th>
                        <th>Approval</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Events.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <h5 class="fw-bold text-dark mb-1">No Events Found</h5>
                                <p class="small text-muted mb-3">No campus events match your selected filters and search query.</p>
                                <a asp-controller="Admin" asp-action="Events" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Filters
                                </a>
                            </td>
                        </tr>
                    }
                    @foreach (var evt in Model.Events)
                    {
                        var isPending = evt.ApprovalStatus == "PENDING";
                        <tr class="@(isPending ? "table-warning bg-opacity-25" : "")" id="event-row-@evt.Id">
                            <td>
                                <input type="checkbox" name="eventIds" value="@evt.Id" class="form-check-input event-select-chk" onchange="updateEventBatchState()" />
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @if (evt.IsFeatured)
                                    {
                                        <i class="bi bi-star-fill text-warning fs-5" title="Featured Event"></i>
                                    }
                                    <div>
                                        <div class="fw-bold text-dark fs-6">@evt.Title</div>
                                        <div class="d-flex align-items-center gap-2 mt-1">
                                            <span class="badge @(evt.IsPublic ? "bg-info-subtle text-info" : "bg-secondary-subtle text-secondary") border" style="font-size: 10px;">
                                                @(evt.IsPublic ? "Public Event" : "Internal Event")
                                            </span>
                                            <span class="text-muted small font-monospace" style="font-size: 11px;">#@evt.Id</span>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-dark border mb-1 fw-semibold">@evt.CategoryName</span>
                                <div class="small text-muted"><i class="bi bi-geo-alt me-1 text-danger"></i>@evt.VenueName</div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark small"><i class="bi bi-person-circle me-1 text-primary"></i>@evt.OrganizerName</div>
                                @if (!string.IsNullOrEmpty(evt.OrganizationName))
                                {
                                    <small class="badge bg-light text-secondary border mt-1">@evt.OrganizationName</small>
                                }
                            </td>
                            <td>
                                <div class="small fw-semibold text-dark">@evt.StartAt.ToString("MMM dd, yyyy")</div>
                                <div class="small text-muted">@evt.StartAt.ToString("hh:mm tt") - @evt.EndAt.ToString("hh:mm tt")</div>
                                <div class="mt-1">
                                    @if (evt.TimeStatus == "Live Now")
                                    {
                                        <span class="badge bg-success text-white animate-pulse" style="font-size: 10px;">● Live Now</span>
                                    }
                                    else if (evt.TimeStatus == "Today")
                                    {
                                        <span class="badge bg-warning text-dark" style="font-size: 10px;">● Today</span>
                                    }
                                    else if (evt.TimeStatus == "Past")
                                    {
                                        <span class="badge bg-light text-muted border" style="font-size: 10px;">Past Event</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary border" style="font-size: 10px;">@evt.TimeStatus</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="small fw-bold text-dark d-flex justify-content-between mb-1">
                                    <span>@evt.RegistrationCount / @(evt.Capacity.HasValue ? evt.Capacity.ToString() : "∞")</span>
                                    <span class="text-muted">@evt.CapacityPercentage%</span>
                                </div>
                                <div class="progress" style="height: 6px; width: 100px;">
                                    <div class="progress-bar @(evt.CapacityPercentage >= 90 ? "bg-danger" : evt.CapacityPercentage >= 70 ? "bg-warning" : "bg-primary")" 
                                         role="progressbar" 
                                         style="width: @(evt.CapacityPercentage)%"></div>
                                </div>
                            </td>
                            <td>
                                @if (evt.ApprovalStatus == "APPROVED")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle py-1 px-2 rounded-pill">
                                        <i class="bi bi-check-circle-fill me-1"></i>Approved
                                    </span>
                                }
                                else if (isPending)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning py-1 px-2 rounded-pill">
                                        <i class="bi bi-hourglass-split me-1"></i>Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle py-1 px-2 rounded-pill">
                                        @evt.ApprovalStatus
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex align-items-center gap-1">
                                    @if (isPending)
                                    {
                                        <form asp-controller="Admin" asp-action="EventApprove" asp-route-id="@evt.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success py-1 px-2 fw-semibold shadow-sm" title="Approve & Publish Live">
                                                <i class="bi bi-check-lg me-1"></i>Approve
                                            </button>
                                        </form>
                                    }
                                    <a asp-controller="Events" asp-action="Details" asp-route-id="@evt.Id" class="btn btn-sm btn-light border py-1 px-2" title="View Details" target="_blank">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <div class="dropdown d-inline-block">
                                        <button class="btn btn-sm btn-light border dropdown-toggle py-1 px-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                            <li>
                                                <a asp-controller="Events" asp-action="Edit" asp-route-id="@evt.Id" class="dropdown-item">
                                                    <i class="bi bi-pencil me-2 text-primary"></i>Edit Event
                                                </a>
                                            </li>
                                            <li>
                                                <form asp-controller="Admin" asp-action="EventToggleFeature" asp-route-id="@evt.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item">
                                                        <i class="bi @(evt.IsFeatured ? "bi-star text-muted" : "bi-star-fill text-warning") me-2"></i>@(evt.IsFeatured ? "Remove from Featured" : "Highlight as Featured")
                                                    </button>
                                                </form>
                                            </li>
                                            @if (isPending)
                                            {
                                                <li>
                                                    <form asp-controller="Admin" asp-action="EventReject" asp-route-id="@evt.Id" method="post" onsubmit="return confirm('Reject this submitted event?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="dropdown-item text-warning"><i class="bi bi-x-circle me-2"></i>Reject Submission</button>
                                                    </form>
                                                </li>
                                            }
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <form asp-controller="Admin" asp-action="EventDelete" asp-route-id="@evt.Id" method="post" onsubmit="return confirm('Permanently delete event: @evt.Title?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Delete Event</button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- =======================================================
             PAGINATION & RANGE SUMMARY
             ======================================================= -->
        @if (Model.TotalFilteredCount > 0)
        {
            <div class="p-3 bg-light border-top d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="small text-muted">
                    Showing <strong>@(((Model.CurrentPage - 1) * Model.PageSize) + 1)</strong> to <strong>@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalFilteredCount))</strong> of <strong>@Model.TotalFilteredCount</strong> events
                </div>
                
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Events Page navigation">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Events" 
                                   asp-route-page="@(Model.CurrentPage - 1)" 
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-search="@Model.SearchTerm" 
                                   asp-route-status="@Model.StatusFilter" 
                                   asp-route-categoryId="@Model.CategoryId"
                                   asp-route-venueId="@Model.VenueId"
                                   asp-route-timeframe="@Model.Timeframe"
                                   asp-route-sortBy="@Model.SortBy">Previous</a>
                            </li>

                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                if (p == 1 || p == Model.TotalPages || (p >= Model.CurrentPage - 2 && p <= Model.CurrentPage + 2))
                                {
                                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-action="Events" 
                                           asp-route-page="@p" 
                                           asp-route-pageSize="@Model.PageSize"
                                           asp-route-search="@Model.SearchTerm" 
                                           asp-route-status="@Model.StatusFilter" 
                                           asp-route-categoryId="@Model.CategoryId"
                                           asp-route-venueId="@Model.VenueId"
                                           asp-route-timeframe="@Model.Timeframe"
                                           asp-route-sortBy="@Model.SortBy">@p</a>
                                    </li>
                                }
                                else if (p == Model.CurrentPage - 3 || p == Model.CurrentPage + 3)
                                {
                                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                }
                            }

                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Events" 
                                   asp-route-page="@(Model.CurrentPage + 1)" 
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-search="@Model.SearchTerm" 
                                   asp-route-status="@Model.StatusFilter" 
                                   asp-route-categoryId="@Model.CategoryId"
                                   asp-route-venueId="@Model.VenueId"
                                   asp-route-timeframe="@Model.Timeframe"
                                   asp-route-sortBy="@Model.SortBy">Next</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        }
    </form>
</div>

<!-- =======================================================
     BATCH REJECT EVENTS MODAL
     ======================================================= -->
<div class="modal fade" id="batchRejectEventsModal" tabindex="-1" aria-labelledby="batchRejectEventsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <form asp-controller="Admin" asp-action="BatchRejectEvents" method="post" id="batchRejectEventsForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <div id="batchRejectEventIdsContainer"></div>

                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="batchRejectEventsModalLabel">
                        <i class="bi bi-x-circle-fill me-2"></i>Reject Selected Event Proposals
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-dark mb-2">
                        You are about to reject <strong><span id="batchRejectEventsCountDisplay">0</span></strong> submitted event proposals.
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Reason / Administrative Note (Sent to organizers):</label>
                        <textarea name="reason" class="form-control rounded-3" rows="3" placeholder="e.g. Schedule conflicts with graduation week or venue capacity exceeded."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm px-3 fw-semibold">
                        Confirm Rejection
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleSelectAllEvents(master) {
            const checkboxes = document.querySelectorAll('.event-select-chk');
            checkboxes.forEach(c => {
                c.checked = master.checked;
                highlightEventRow(c);
            });
            updateEventBatchState();
        }

        function highlightEventRow(checkbox) {
            const row = checkbox.closest('tr');
            if (row) {
                if (checkbox.checked) {
                    row.classList.add('table-warning', 'bg-opacity-50');
                } else {
                    row.classList.remove('table-warning', 'bg-opacity-50');
                }
            }
        }

        function updateEventBatchState() {
            const checkedBoxes = document.querySelectorAll('.event-select-chk:checked');
            const count = checkedBoxes.length;
            
            document.querySelectorAll('.event-select-chk').forEach(c => highlightEventRow(c));

            document.getElementById('selectedCountDisplay').innerText = count;
            document.querySelectorAll('.batchCountText').forEach(el => el.innerText = count);
            
            const approveBtn = document.getElementById('batchApproveBtn');
            const rejectBtn = document.getElementById('batchRejectBtn');
            
            if (approveBtn) approveBtn.disabled = count === 0;
            if (rejectBtn) rejectBtn.disabled = count === 0;
        }

        function openBatchRejectModal() {
            const checkedBoxes = document.querySelectorAll('.event-select-chk:checked');
            const count = checkedBoxes.length;
            if (count === 0) return;

            document.getElementById('batchRejectEventsCountDisplay').innerText = count;
            const container = document.getElementById('batchRejectEventIdsContainer');
            container.innerHTML = '';
            
            checkedBoxes.forEach(c => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'eventIds';
                input.value = c.value;
                container.appendChild(input);
            });

            var modal = new bootstrap.Modal(document.getElementById('batchRejectEventsModal'));
            modal.show();
        }
    </script>
}
