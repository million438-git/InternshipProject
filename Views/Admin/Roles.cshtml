@model HawassaUnifiedCampusEventManagementSystem.Models.AdminRolesPermissionsViewModel

@{
    Layout = "_SuperAdminLayout";
    ViewData["Title"] = "Roles & RBAC Privileges Matrix";
}

<!-- =======================================================
     PAGE HEADER & TOP ACTION TOOLBAR
     ======================================================= -->
<div class="admin-page-header d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-decoration-none">SuperAdmin Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Roles & Permissions</li>
            </ol>
        </nav>
        <h1 class="h3 fw-bold text-dark mb-1">🔐 Roles & RBAC Privilege Matrix</h1>
        <p class="text-muted small mb-0">Role-Based Access Control matrix governing administrative authority and feature authorizations across university portals.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 shadow-sm px-3" data-bs-toggle="modal" data-bs-target="#newRoleModal">
            <i class="bi bi-plus-lg"></i>
            <span>Create Security Role</span>
        </button>
        <a asp-controller="Admin" asp-action="ExportRolesCsv" 
           class="btn btn-outline-success btn-sm d-inline-flex align-items-center gap-1 shadow-sm px-3"
           title="Export system security matrix to CSV">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>
            <span>Export RBAC Matrix CSV</span>
        </a>
    </div>
</div>

<!-- =======================================================
     METRICS SUMMARY CARDS
     ======================================================= -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-primary-subtle text-primary"><i class="bi bi-shield-lock-fill"></i></div>
            <div>
                <div class="stat-num">@Model.TotalRolesCount</div>
                <div class="stat-desc">Security Roles</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-info-subtle text-info"><i class="bi bi-key-fill"></i></div>
            <div>
                <div class="stat-num">@Model.TotalPermissionsCount</div>
                <div class="stat-desc">System Privileges</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-success-subtle text-success"><i class="bi bi-person-check-fill"></i></div>
            <div>
                <div class="stat-num">@Model.TotalRoleBindingsCount.ToString("N0")</div>
                <div class="stat-desc">Active Role Bindings</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-warning-subtle text-warning-emphasis"><i class="bi bi-shield-shaded"></i></div>
            <div>
                <div class="stat-num">@Model.TotalAdminAccountsCount</div>
                <div class="stat-desc">Privileged Accounts</div>
            </div>
        </div>
    </div>
</div>

<!-- =======================================================
     ROLE HIERARCHY CARDS GRID
     ======================================================= -->
<div class="row g-4 mb-4">
    @foreach (var role in Model.Roles)
    {
        <div class="col-md-6 col-xl-4">
            <div class="admin-card p-4 h-100 shadow-sm d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="stat-icon-box @(role.Name.Contains("Super") ? "bg-danger-subtle text-danger" : role.Name.Contains("Admin") ? "bg-primary-subtle text-primary" : "bg-info-subtle text-info")" style="width: 42px; height: 42px; font-size: 18px;">
                                <i class="bi @(role.Name.Contains("Super") ? "bi-shield-shaded" : role.Name.Contains("Admin") ? "bi-shield-lock" : "bi-person-badge")"></i>
                            </div>
                            <div>
                                <h2 class="h6 fw-bold text-dark mb-0">@role.Name</h2>
                                @if (role.IsSystemRole)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border rounded-pill" style="font-size: 10px;">System Core</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary border rounded-pill" style="font-size: 10px;">Custom Role</span>
                                }
                            </div>
                        </div>
                        <a asp-controller="Admin" asp-action="Users" asp-route-role="@role.Name" 
                           class="badge bg-light text-dark border text-decoration-none py-1 px-2" title="View users enrolled in this role">
                            <i class="bi bi-people me-1 text-primary"></i>@role.UserCount Users
                        </a>
                    </div>

                    <p class="small text-muted mb-3" style="min-height: 38px;">
                        @(role.Description ?? "Platform access role governing system capabilities.")
                    </p>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-semibold text-dark">Assigned Privileges</span>
                            <span class="badge bg-light text-secondary border">@role.AssignedPermissions.Count / @Model.AllPermissions.Count</span>
                        </div>
                        <div class="d-flex flex-wrap gap-1" style="max-height: 120px; overflow-y: auto;">
                            @if (!role.AssignedPermissions.Any())
                            {
                                <span class="text-muted small fst-italic">No explicit privileges assigned.</span>
                            }
                            @foreach (var perm in role.AssignedPermissions)
                            {
                                <span class="badge bg-light text-dark border small" style="font-size: 11px;">
                                    <i class="bi bi-check2 text-success me-1"></i>@perm
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="pt-3 border-top d-flex justify-content-between align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-primary flex-grow-1" 
                            onclick="openPermissionsModal('@role.Id', '@role.Name', [@string.Join(",", role.AssignedPermissionIds)])">
                        <i class="bi bi-sliders me-1"></i>Configure Privileges
                    </button>
                    <button type="button" class="btn btn-sm btn-light border text-secondary" 
                            onclick="openEditRoleModal('@role.Id', '@role.Name', '@(role.Description ?? "")')" title="Edit Role Details">
                        <i class="bi bi-pencil"></i>
                    </button>
                    @if (!role.IsSystemRole)
                    {
                        <form asp-controller="Admin" asp-action="RoleDelete" asp-route-id="@role.Id" method="post" class="d-inline" onsubmit="return confirm('Delete custom role \'@role.Name\'?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-light border text-danger" title="Delete Custom Role">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- =======================================================
     CREATE NEW ROLE MODAL
     ======================================================= -->
<div class="modal fade" id="newRoleModal" tabindex="-1" aria-labelledby="newRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="newRoleModalLabel"><i class="bi bi-shield-plus me-2"></i>Create Custom Security Role</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Admin" asp-action="RoleCreate" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Role Name *</label>
                            <input type="text" name="name" class="form-control form-control-sm" required placeholder="e.g. Dean of Students" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Description</label>
                            <input type="text" name="description" class="form-control form-control-sm" placeholder="Institutional role scope..." />
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-dark">Initial Privilege Grants</label>
                        <div class="row g-3 p-3 bg-light rounded border" style="max-height: 260px; overflow-y: auto;">
                            @foreach (var perm in Model.AllPermissions)
                            {
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="permissionIds" value="@perm.id" id="new_perm_@perm.id" />
                                        <label class="form-check-label small text-dark" for="new_perm_@perm.id">
                                            <strong>@perm.name</strong>
                                            @if (!string.IsNullOrEmpty(perm.description))
                                            {
                                                <div class="text-muted" style="font-size: 10px;">@perm.description</div>
                                            }
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-3 fw-semibold">Save Role</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- =======================================================
     EDIT ROLE DETAILS MODAL
     ======================================================= -->
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-labelledby="editRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="editRoleModalLabel"><i class="bi bi-pencil-square me-2"></i>Edit Role Information</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Admin" asp-action="RoleEdit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editRoleId" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Role Name *</label>
                        <input type="text" name="name" id="editRoleName" class="form-control form-control-sm" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Description</label>
                        <textarea name="description" id="editRoleDescription" class="form-control form-control-sm" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-3 fw-semibold">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- =======================================================
     CONFIGURE ROLE PERMISSIONS MODAL
     ======================================================= -->
<div class="modal fade" id="permissionsModal" tabindex="-1" aria-labelledby="permissionsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="permissionsModalLabel">
                    <i class="bi bi-sliders me-2"></i>Configure RBAC Privileges: <span id="permModalRoleName" class="text-warning"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Admin" asp-action="RoleUpdatePermissions" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="roleId" id="permModalRoleId" />
                <div class="modal-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <p class="small text-muted mb-0">Select the privileges granted to users assigned to this role:</p>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2" style="font-size: 11px;" onclick="toggleAllPermissions(true)">Select All</button>
                            <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2" style="font-size: 11px;" onclick="toggleAllPermissions(false)">Clear All</button>
                        </div>
                    </div>

                    <div class="row g-3 p-3 bg-light rounded border" style="max-height: 380px; overflow-y: auto;">
                        @foreach (var perm in Model.AllPermissions)
                        {
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input role-perm-chk" type="checkbox" name="permissionIds" value="@perm.id" id="perm_chk_@perm.id" />
                                    <label class="form-check-label small text-dark" for="perm_chk_@perm.id">
                                        <strong>@perm.name</strong>
                                        <div class="text-muted" style="font-size: 11px;">@(perm.description ?? perm.module ?? "System privilege")</div>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-3 fw-semibold">Save Privileges Matrix</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditRoleModal(id, name, desc) {
            document.getElementById('editRoleId').value = id;
            document.getElementById('editRoleName').value = name;
            document.getElementById('editRoleDescription').value = desc;
            var modal = new bootstrap.Modal(document.getElementById('editRoleModal'));
            modal.show();
        }

        function openPermissionsModal(roleId, roleName, assignedIds) {
            document.getElementById('permModalRoleId').value = roleId;
            document.getElementById('permModalRoleName').innerText = roleName;

            const checkboxes = document.querySelectorAll('.role-perm-chk');
            checkboxes.forEach(chk => {
                const pid = parseInt(chk.value);
                chk.checked = assignedIds.includes(pid);
            });

            var modal = new bootstrap.Modal(document.getElementById('permissionsModal'));
            modal.show();
        }

        function toggleAllPermissions(check) {
            document.querySelectorAll('.role-perm-chk').forEach(chk => chk.checked = check);
        }
    </script>
}
