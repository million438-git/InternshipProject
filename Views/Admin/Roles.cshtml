@model HawassaUnifiedCampusEventManagementSystem.Models.AdminRolesPermissionsViewModel

@{
    Layout = "_SuperAdminLayout";
    ViewData["Title"] = "Roles & RBAC Permissions";
}

<div class="admin-page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1"><i class="bi bi-shield-lock text-warning me-2"></i>Roles & RBAC Permissions</h1>
        <p class="text-muted small mb-0">Role-based access control matrix (RBAC) governing system privileges across campus.</p>
    </div>
</div>

<!-- =======================================================
     ROLE HIERARCHY CARDS
     ======================================================= -->
<div class="row g-3 mb-4">
    @foreach (var role in Model.Roles)
    {
        <div class="col-md-6 col-lg-4">
            <div class="admin-card p-4 h-100 shadow-sm">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <div class="stat-icon-box bg-primary-subtle text-primary" style="width: 40px; height: 40px; font-size: 18px;">
                            <i class="bi bi-shield-lock"></i>
                        </div>
                        <div>
                            <h2 class="h6 fw-bold text-dark mb-0">@role.Name</h2>
                            <small class="text-muted">@role.UserCount Users</small>
                        </div>
                    </div>
                </div>
                <p class="small text-secondary mb-3">@(role.Description ?? "Campus role governing platform privileges.")</p>
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var perm in role.AssignedPermissions)
                    {
                        <span class="badge bg-light text-dark border small" style="font-size: 11px;">
                            <i class="bi bi-check2 text-success me-1"></i>@perm
                        </span>
                    }
                </div>
            </div>
        </div>
    }
</div>
