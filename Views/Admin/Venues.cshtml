@model HawassaUnifiedCampusEventManagementSystem.Models.AdminVenuesViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Venue Management";
}

<div class="admin-page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">Venue & Facility Management</h1>
        <p class="text-muted small mb-0">Manage campus auditoriums, lecture halls, conference facilities, and outdoor event spaces.</p>
    </div>
    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#newVenueModal">
        <i class="bi bi-plus-lg"></i>
        <span>Add Venue</span>
    </button>
</div>

<!-- =======================================================
     METRICS
     ======================================================= -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="admin-stat-card">
            <div class="stat-icon-box bg-primary-subtle text-primary"><i class="bi bi-geo-alt"></i></div>
            <div>
                <div class="stat-num">@Model.TotalCount</div>
                <div class="stat-desc">Total Campus Venues</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-stat-card">
            <div class="stat-icon-box bg-success-subtle text-success"><i class="bi bi-check-circle"></i></div>
            <div>
                <div class="stat-num">@Model.AvailableCount</div>
                <div class="stat-desc">Available for Booking</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-stat-card">
            <div class="stat-icon-box bg-warning-subtle text-warning"><i class="bi bi-tools"></i></div>
            <div>
                <div class="stat-num">@Model.MaintenanceCount</div>
                <div class="stat-desc">Under Maintenance</div>
            </div>
        </div>
    </div>
</div>

<!-- =======================================================
     VENUES TABLE
     ======================================================= -->
<div class="admin-card overflow-hidden">
    <div class="table-responsive">
        <table class="table admin-table" id="venuesTable">
            <thead>
                <tr>
                    <th>Venue Name</th>
                    <th>Location / Building</th>
                    <th>Type</th>
                    <th>Capacity</th>
                    <th>Bookings</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model.Venues)
                {
                    <tr>
                        <td class="fw-bold text-dark">@v.Name</td>
                        <td>
                            <div>@(v.BuildingName ?? "Main Campus")</div>
                            <small class="text-muted">Room: @(v.RoomNumber ?? "Main Hall")</small>
                        </td>
                        <td><span class="badge bg-secondary-subtle text-secondary">@v.VenueType</span></td>
                        <td>
                            <span class="badge bg-info-subtle text-info border">@v.Capacity seats</span>
                        </td>
                        <td>
                            <small class="text-muted"><i class="bi bi-calendar-check me-1"></i>@v.ScheduledEventsCount events</small>
                        </td>
                        <td>
                            @if (v.Status == "AVAILABLE")
                            {
                                <span class="badge-status badge-active">Available</span>
                            }
                            else if (v.Status == "MAINTENANCE")
                            {
                                <span class="badge-status badge-pending">Maintenance</span>
                            }
                            else
                            {
                                <span class="badge-status badge-suspended">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <button type="button" 
                                    class="btn btn-sm btn-light border text-primary py-1 px-2 me-1" 
                                    data-bs-toggle="modal" 
                                    data-bs-target="#editVenueModal_@v.Id" 
                                    title="Edit Venue">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <form asp-controller="Admin" asp-action="VenueDelete" asp-route-id="@v.Id" method="post" class="d-inline" onsubmit="return confirm('Delete venue \'@v.Name\'? Associated events will be safely unlinked.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-light border text-danger py-1 px-2" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>

                            <!-- EDIT VENUE MODAL -->
                            <div class="modal fade text-start" id="editVenueModal_@v.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow">
                                        <div class="modal-header">
                                            <h5 class="modal-title fw-bold"><i class="bi bi-pencil me-1 text-primary"></i>Edit Venue / Facility</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <form asp-controller="Admin" asp-action="VenueEdit" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@v.Id" />
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Venue Name</label>
                                                    <input type="text" name="name" class="form-control form-control-sm" required value="@v.Name" />
                                                </div>
                                                <div class="row g-2 mb-3">
                                                    <div class="col-6">
                                                        <label class="form-label small fw-semibold">Building Name</label>
                                                        <input type="text" name="buildingName" class="form-control form-control-sm" value="@v.BuildingName" />
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label small fw-semibold">Room Number</label>
                                                        <input type="text" name="roomNumber" class="form-control form-control-sm" value="@v.RoomNumber" />
                                                    </div>
                                                </div>
                                                <div class="row g-2 mb-3">
                                                    <div class="col-6">
                                                        <label class="form-label small fw-semibold">Max Capacity</label>
                                                        <input type="number" name="capacity" class="form-control form-control-sm" required min="1" value="@v.Capacity" />
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label small fw-semibold">Venue Type</label>
                                                        <select name="venueType" class="form-select form-select-sm">
                                                            <option value="AUDITORIUM" selected="@(v.VenueType == "AUDITORIUM")">Auditorium</option>
                                                            <option value="HALL" selected="@(v.VenueType == "HALL")">Lecture Hall</option>
                                                            <option value="LAB" selected="@(v.VenueType == "LAB")">Computer Lab</option>
                                                            <option value="OUTDOOR" selected="@(v.VenueType == "OUTDOOR")">Outdoor Stadium</option>
                                                            <option value="CONFERENCE" selected="@(v.VenueType == "CONFERENCE")">Conference Room</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Operational Status</label>
                                                    <select name="status" class="form-select form-select-sm">
                                                        <option value="AVAILABLE" selected="@(v.Status == "AVAILABLE")">Available</option>
                                                        <option value="MAINTENANCE" selected="@(v.Status == "MAINTENANCE")">Under Maintenance</option>
                                                        <option value="INACTIVE" selected="@(v.Status == "INACTIVE")">Inactive</option>
                                                    </select>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Amenities & Equipment</label>
                                                    <input type="text" name="amenities" class="form-control form-control-sm" value="@v.Amenities" placeholder="e.g. Projector, Sound System, Wi-Fi" />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Description</label>
                                                    <textarea name="description" class="form-control form-control-sm" rows="2">@v.Description</textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-sm btn-primary px-3">Save Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- =======================================================
     ADD VENUE MODAL
     ======================================================= -->
<div class="modal fade" id="newVenueModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-geo-alt me-1 text-primary"></i>Add Campus Venue</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Admin" asp-action="VenueCreate" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Venue Name</label>
                        <input type="text" name="name" class="form-control form-control-sm" required placeholder="e.g. Main African Hall Auditorium" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Building Name</label>
                            <input type="text" name="buildingName" class="form-control form-control-sm" placeholder="e.g. Administration Complex" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Room / Number</label>
                            <input type="text" name="roomNumber" class="form-control form-control-sm" placeholder="e.g. Hall A-101" />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Capacity (Seats)</label>
                            <input type="number" name="capacity" class="form-control form-control-sm" required value="250" min="1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Venue Type</label>
                            <select name="venueType" class="form-select form-select-sm">
                                <option value="AUDITORIUM">Auditorium</option>
                                <option value="LECTURE_HALL">Lecture Hall</option>
                                <option value="CLASSROOM">Classroom</option>
                                <option value="LAB">Computer Lab</option>
                                <option value="SPORTS_FIELD">Sports Field</option>
                                <option value="OUTDOOR">Outdoor Ground</option>
                                <option value="MEETING_ROOM">Meeting Room</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Initial Status</label>
                        <select name="status" class="form-select form-select-sm">
                            <option value="AVAILABLE">Available</option>
                            <option value="MAINTENANCE">Maintenance</option>
                            <option value="INACTIVE">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary px-3">Save Venue</button>
                </div>
            </form>
        </div>
    </div>
</div>
