@model HawassaUnifiedCampusEventManagementSystem.Models.AdminUsersViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User Management & Access Control";
}

<!-- =======================================================
     PAGE HEADER & TOP ACTION TOOLBAR
     ======================================================= -->
<div class="admin-page-header d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-decoration-none">Admin Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Users Directory</li>
            </ol>
        </nav>
        <h1 class="h3 fw-bold text-dark mb-1">User Directory & Access Control</h1>
        <p class="text-muted small mb-0">Manage campus accounts, role assignments, department affiliations, credentials, and governance status.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.IsSuperAdmin)
        {
            <a asp-controller="Admin" asp-action="UserApprovals" class="btn btn-warning btn-sm d-inline-flex align-items-center gap-1 shadow-sm px-3 fw-semibold text-dark">
                <i class="bi bi-clock-history"></i>
                <span>Approvals Queue (@Model.PendingApprovalCount)</span>
            </a>
        }
        <a asp-controller="Admin" asp-action="ExportUsersCsv" 
           asp-route-search="@Model.SearchTerm" 
           asp-route-role="@Model.RoleFilter" 
           asp-route-status="@Model.StatusFilter"
           asp-route-departmentId="@Model.DepartmentFilter"
           class="btn btn-outline-success btn-sm d-inline-flex align-items-center gap-1 shadow-sm px-3"
           title="Export user directory to CSV spreadsheet">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>
            <span>Export CSV</span>
        </a>
        <a asp-controller="Admin" asp-action="RegisterUser" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 shadow-sm px-3">
            <i class="bi bi-person-plus-fill"></i>
            <span>Register New User</span>
        </a>
        <button type="button" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1 shadow-sm px-3" data-bs-toggle="modal" data-bs-target="#registerUserModal">
            <i class="bi bi-lightning-charge"></i>
            <span>Quick Register</span>
        </button>
    </div>
</div>

<!-- =======================================================
     SUMMARY METRICS
     ======================================================= -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-primary-subtle text-primary"><i class="bi bi-people"></i></div>
            <div>
                <div class="stat-num">@Model.TotalCount</div>
                <div class="stat-desc">Total Campus Users</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-success-subtle text-success"><i class="bi bi-check2-circle"></i></div>
            <div>
                <div class="stat-num">@Model.ActiveCount</div>
                <div class="stat-desc">Active Accounts</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-danger-subtle text-danger"><i class="bi bi-slash-circle"></i></div>
            <div>
                <div class="stat-num">@Model.SuspendedCount</div>
                <div class="stat-desc">Suspended Accounts</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Admin" asp-action="Users" asp-route-status="PENDING" class="text-decoration-none">
            <div class="admin-stat-card border border-warning h-100 @(Model.PendingApprovalCount > 0 ? "shadow-sm bg-warning-subtle bg-opacity-25" : "")">
                <div class="stat-icon-box bg-warning-subtle text-warning"><i class="bi bi-clock-history"></i></div>
                <div>
                    <div class="stat-num text-warning-emphasis">
                        @Model.PendingApprovalCount
                        @if (Model.PendingApprovalCount > 0 && Model.IsSuperAdmin)
                        {
                            <span class="badge bg-danger text-white fs-6 py-0 px-2 align-middle ms-1">Review</span>
                        }
                    </div>
                    <div class="stat-desc fw-semibold text-warning-emphasis">Pending SuperAdmin Approval</div>
                </div>
            </div>
        </a>
    </div>
</div>

@if (Model.PendingApprovalCount > 0)
{
    <div class="alert alert-warning border-warning-subtle d-flex align-items-center justify-content-between flex-wrap gap-3 p-3 rounded-3 shadow-sm mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-warning text-dark rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">
                <i class="bi bi-hourglass-split fs-5"></i>
            </div>
            <div>
                <h6 class="fw-bold text-dark mb-0">@Model.PendingApprovalCount User Accounts Pending SuperAdmin Clearance</h6>
                <span class="text-muted small">Registered by Campus Administrators. SuperAdmin activation is required before users can log in.</span>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Admin" asp-action="UserApprovals" class="btn btn-warning btn-sm fw-semibold shadow-sm px-3">
                <i class="bi bi-shield-check me-1"></i>Dedicated Approvals Hub
            </a>
            @if (Model.IsSuperAdmin)
            {
                <form asp-controller="Admin" asp-action="ApproveAllPending" method="post" class="d-inline" onsubmit="return confirm('Approve and activate ALL @Model.PendingApprovalCount pending accounts at once?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <button type="submit" class="btn btn-success btn-sm fw-semibold shadow-sm px-3">
                        <i class="bi bi-check-all me-1"></i>Approve All Pending
                    </button>
                </form>
            }
        </div>
    </div>
}

<!-- =======================================================
     FILTERS & ADVANCED SEARCH BAR
     ======================================================= -->
<div class="admin-card p-3 mb-4">
    <div class="d-flex flex-wrap gap-2 mb-3 pb-2 border-bottom">
        <a asp-controller="Admin" asp-action="Users" class="btn btn-sm @(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "ALL" ? "btn-dark" : "btn-light border")">
            All Users (@Model.TotalCount)
        </a>
        <a asp-controller="Admin" asp-action="Users" asp-route-status="ACTIVE" class="btn btn-sm @(Model.StatusFilter == "ACTIVE" ? "btn-success" : "btn-light border")">
            <i class="bi bi-check-circle me-1"></i>Active (@Model.ActiveCount)
        </a>
        <a asp-controller="Admin" asp-action="Users" asp-route-status="PENDING" class="btn btn-sm @(Model.StatusFilter == "PENDING" ? "btn-warning text-dark fw-bold" : "btn-light border")">
            <i class="bi bi-hourglass-split me-1"></i>Pending Approvals (@Model.PendingApprovalCount)
        </a>
        <a asp-controller="Admin" asp-action="Users" asp-route-status="SUSPENDED" class="btn btn-sm @(Model.StatusFilter == "SUSPENDED" ? "btn-danger" : "btn-light border")">
            <i class="bi bi-slash-circle me-1"></i>Suspended (@Model.SuspendedCount)
        </a>
    </div>

    <form method="get" class="row g-2 align-items-center">
        <input type="hidden" name="status" value="@Model.StatusFilter" />

        <div class="col-12 col-md-3">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="search" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search by name, email, ID..." />
            </div>
        </div>

        <div class="col-6 col-md-2">
            <select name="role" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="ALL" selected="@(Model.RoleFilter == null || Model.RoleFilter == "ALL")">All Roles</option>
                <option value="STUDENT" selected="@(Model.RoleFilter == "STUDENT")">Students</option>
                <option value="FACULTY" selected="@(Model.RoleFilter == "FACULTY")">Faculty</option>
                <option value="STAFF" selected="@(Model.RoleFilter == "STAFF")">Staff</option>
                <option value="ORGANIZATION" selected="@(Model.RoleFilter == "ORGANIZATION")">Clubs & Orgs</option>
                <option value="ADMIN" selected="@(Model.RoleFilter == "ADMIN")">Admins</option>
                <option value="SUPERADMIN" selected="@(Model.RoleFilter == "SUPERADMIN")">SuperAdmins</option>
            </select>
        </div>

        <div class="col-6 col-md-3">
            <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Departments</option>
                @foreach (var dept in Model.Departments)
                {
                    <option value="@dept.id" selected="@(Model.DepartmentFilter == dept.id)">@dept.name</option>
                }
            </select>
        </div>

        <div class="col-6 col-md-2">
            <select name="sortBy" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="newest" selected="@(Model.SortBy == "newest" || string.IsNullOrEmpty(Model.SortBy))">Newest Registered</option>
                <option value="oldest" selected="@(Model.SortBy == "oldest")">Oldest Registered</option>
                <option value="name_asc" selected="@(Model.SortBy == "name_asc")">Name (A-Z)</option>
                <option value="name_desc" selected="@(Model.SortBy == "name_desc")">Name (Z-A)</option>
                <option value="role" selected="@(Model.SortBy == "role")">Group by Role</option>
                <option value="department" selected="@(Model.SortBy == "department")">By Department</option>
            </select>
        </div>

        <div class="col-6 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary flex-grow-1">Filter</button>
            <a asp-controller="Admin" asp-action="Users" class="btn btn-sm btn-light border" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<!-- =======================================================
     USERS TABLE
     ======================================================= -->
<div class="admin-card overflow-hidden">
    <div class="table-responsive">
        <table class="table admin-table align-middle mb-0" id="usersTable">
            <thead>
                <tr>
                    <th>User & Identity</th>
                    <th>Email / Phone</th>
                    <th>Department</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Activity</th>
                    <th>Registered</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Users.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            <h5 class="fw-bold text-dark mb-1">No Accounts Found</h5>
                            <p class="small text-muted mb-3">No user records matched the selected filters and search term.</p>
                            <a asp-controller="Admin" asp-action="Users" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Filters
                            </a>
                        </td>
                    </tr>
                }
                @foreach (var user in Model.Users)
                {
                    var isPending = user.Status == "PENDING" || user.Status == "PENDING_APPROVAL";
                    <tr class="@(isPending ? "table-warning bg-opacity-25" : "")">
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="admin-avatar @(isPending ? "bg-warning text-dark fw-bold" : "bg-primary text-white") rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; font-size: 14px;">
                                    @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                                </div>
                                <div>
                                    <div class="fw-semibold text-dark">
                                        @user.FullName
                                        @if (isPending)
                                        {
                                            <span class="badge bg-warning text-dark ms-1" style="font-size: 10px;">Pending Approval</span>
                                        }
                                    </div>
                                    <div class="small text-muted d-flex align-items-center flex-wrap gap-2">
                                        <span class="font-monospace">@@@user.Username</span>
                                        @if (!string.IsNullOrEmpty(user.StudentId))
                                        {
                                            <span class="badge bg-light text-primary border" style="font-size: 10px;"><i class="bi bi-card-text me-1"></i>ID: @user.StudentId</span>
                                        }
                                        else if (!string.IsNullOrEmpty(user.EmployeeId))
                                        {
                                            <span class="badge bg-light text-secondary border" style="font-size: 10px;"><i class="bi bi-badge-ad me-1"></i>EMP: @user.EmployeeId</span>
                                        }
                                        @if (!string.IsNullOrEmpty(user.RegisteredByAdminName))
                                        {
                                            <span class="text-primary small" style="font-size: 10px;"><i class="bi bi-person-gear me-1"></i>Reg by: @user.RegisteredByAdminName</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="small fw-semibold text-dark">@user.Email</div>
                            <small class="text-muted">@(user.Phone ?? "No phone")</small>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@user.DepartmentName</span>
                        </td>
                        <td>
                            <span class="badge @(user.AccountType == "STUDENT" ? "bg-primary-subtle text-primary" : user.AccountType == "FACULTY" ? "bg-success-subtle text-success" : user.AccountType == "STAFF" ? "bg-info-subtle text-info" : user.AccountType == "ADMIN" || user.AccountType == "SUPERADMIN" ? "bg-dark text-white" : "bg-warning-subtle text-warning-emphasis") border fw-semibold">
                                @user.AccountType
                            </span>
                        </td>
                        <td>
                            @if (user.Status == "ACTIVE")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle py-1 px-2 rounded-pill">
                                    <i class="bi bi-check-circle-fill me-1"></i>Active
                                </span>
                            }
                            else if (isPending)
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning py-1 px-2 rounded-pill">
                                    <i class="bi bi-hourglass-split me-1"></i>Pending SuperAdmin
                                </span>
                            }
                            else if (user.Status == "SUSPENDED")
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle py-1 px-2 rounded-pill">
                                    <i class="bi bi-slash-circle me-1"></i>Suspended
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary py-1 px-2 rounded-pill">
                                    @user.Status
                                </span>
                            }
                        </td>
                        <td>
                            <div class="small text-muted">
                                <div><i class="bi bi-calendar-event me-1 text-primary"></i>@user.EventCount Events</div>
                                <div><i class="bi bi-ticket-perforated me-1 text-success"></i>@user.RegistrationCount Registrations</div>
                            </div>
                        </td>
                        <td class="small text-muted">
                            @user.CreatedAt.ToString("MMM dd, yyyy")
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex align-items-center gap-1">
                                @if (isPending && Model.IsSuperAdmin)
                                {
                                    <!-- SUPERADMIN QUICK APPROVE -->
                                    <form asp-controller="Admin" asp-action="UserApprove" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="btn btn-sm btn-success py-1 px-2 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm" title="Approve & Activate User">
                                            <i class="bi bi-check-lg"></i>
                                            <span class="d-none d-md-inline">Approve</span>
                                        </button>
                                    </form>
                                }

                                <!-- MANAGE DROPDOWN -->
                                <div class="dropdown d-inline-block">
                                    <button class="btn btn-sm btn-light border dropdown-toggle py-1 px-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Manage
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        @if (isPending && Model.IsSuperAdmin)
                                        {
                                            <li class="dropdown-header text-warning">SuperAdmin Actions</li>
                                            <li>
                                                <form asp-controller="Admin" asp-action="UserApprove" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                    <button type="submit" class="dropdown-item text-success fw-semibold"><i class="bi bi-check-circle me-2"></i>Approve & Activate</button>
                                                </form>
                                            </li>
                                            <li>
                                                <form asp-controller="Admin" asp-action="UserReject" method="post" onsubmit="return confirm('Reject this registration?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-x-circle me-2"></i>Reject Registration</button>
                                                </form>
                                            </li>
                                            <li><hr class="dropdown-divider" /></li>
                                        }

                                        <li class="dropdown-header">Change Status</li>
                                        <li>
                                            <form asp-controller="Admin" asp-action="UserToggleStatus" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <input type="hidden" name="status" value="ACTIVE" />
                                                <button type="submit" class="dropdown-item text-success"><i class="bi bi-check-circle me-2"></i>Set Active</button>
                                            </form>
                                        </li>
                                        <li>
                                            <form asp-controller="Admin" asp-action="UserToggleStatus" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <input type="hidden" name="status" value="SUSPENDED" />
                                                <button type="submit" class="dropdown-item text-warning"><i class="bi bi-pause-circle me-2"></i>Suspend Account</button>
                                            </form>
                                        </li>

                                        <li><hr class="dropdown-divider" /></li>
                                        <li class="dropdown-header">Credentials & Security</li>
                                        <li>
                                            <button type="button" class="dropdown-item text-primary" onclick="openResetPasswordModal(@user.Id, '@user.FullName', '@user.Username')">
                                                <i class="bi bi-key me-2"></i>Reset Password
                                            </button>
                                        </li>

                                        @if (Model.IsSuperAdmin)
                                        {
                                            <li><hr class="dropdown-divider" /></li>
                                            <li class="dropdown-header">Assign Role (SuperAdmin)</li>
                                            <li>
                                                <form asp-controller="Admin" asp-action="UserChangeRole" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <input type="hidden" name="role" value="ADMIN" />
                                                    <button type="submit" class="dropdown-item"><i class="bi bi-shield-lock me-2"></i>Make Admin</button>
                                                </form>
                                            </li>
                                            <li>
                                                <form asp-controller="Admin" asp-action="UserChangeRole" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <input type="hidden" name="role" value="FACULTY" />
                                                    <button type="submit" class="dropdown-item"><i class="bi bi-person-badge me-2"></i>Make Faculty</button>
                                                </form>
                                            </li>
                                            <li>
                                                <form asp-controller="Admin" asp-action="UserChangeRole" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <input type="hidden" name="role" value="STAFF" />
                                                    <button type="submit" class="dropdown-item"><i class="bi bi-briefcase me-2"></i>Make Staff</button>
                                                </form>
                                            </li>
                                            <li>
                                                <form asp-controller="Admin" asp-action="UserChangeRole" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <input type="hidden" name="role" value="STUDENT" />
                                                    <button type="submit" class="dropdown-item"><i class="bi bi-mortarboard me-2"></i>Make Student</button>
                                                </form>
                                            </li>
                                        }

                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form asp-controller="Admin" asp-action="UserDelete" method="post" onsubmit="return confirm('Are you sure you want to permanently delete user @user.Username?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Delete User</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- =======================================================
         PAGINATION & RANGE SUMMARY
         ======================================================= -->
    @if (Model.TotalFilteredCount > 0)
    {
        <div class="p-3 bg-light border-top d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="small text-muted">
                Showing <strong>@(((Model.CurrentPage - 1) * Model.PageSize) + 1)</strong> to <strong>@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalFilteredCount))</strong> of <strong>@Model.TotalFilteredCount</strong> user accounts
            </div>
            
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Users Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Users" 
                               asp-route-page="@(Model.CurrentPage - 1)" 
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-search="@Model.SearchTerm" 
                               asp-route-role="@Model.RoleFilter" 
                               asp-route-status="@Model.StatusFilter"
                               asp-route-departmentId="@Model.DepartmentFilter"
                               asp-route-sortBy="@Model.SortBy">Previous</a>
                        </li>

                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            if (p == 1 || p == Model.TotalPages || (p >= Model.CurrentPage - 2 && p <= Model.CurrentPage + 2))
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Users" 
                                       asp-route-page="@p" 
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-search="@Model.SearchTerm" 
                                       asp-route-role="@Model.RoleFilter" 
                                       asp-route-status="@Model.StatusFilter"
                                       asp-route-departmentId="@Model.DepartmentFilter"
                                       asp-route-sortBy="@Model.SortBy">@p</a>
                                </li>
                            }
                            else if (p == Model.CurrentPage - 3 || p == Model.CurrentPage + 3)
                            {
                                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                            }
                        }

                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Users" 
                               asp-route-page="@(Model.CurrentPage + 1)" 
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-search="@Model.SearchTerm" 
                               asp-route-role="@Model.RoleFilter" 
                               asp-route-status="@Model.StatusFilter"
                               asp-route-departmentId="@Model.DepartmentFilter"
                               asp-route-sortBy="@Model.SortBy">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
</div>

<!-- =======================================================
     PASSWORD RESET MODAL
     ======================================================= -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <form asp-controller="Admin" asp-action="UserResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="resetPasswordUserIdInput" />

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="resetPasswordModalLabel">
                        <i class="bi bi-key-fill me-2"></i>Reset User Credentials
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-dark mb-3">
                        You are resetting the password for <strong id="resetPasswordUserNameDisplay"></strong> (<span id="resetPasswordUserHandleDisplay" class="font-monospace text-primary"></span>).
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Custom Temporary Password (Optional):</label>
                        <input type="text" name="newPassword" class="form-control font-monospace" placeholder="Leave empty to auto-generate secure password..." />
                        <small class="text-muted">If left blank, an auto-generated password (e.g. <code>Hawassa@@123456</code>) will be generated and emailed to the user.</small>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-3 fw-semibold">
                        Confirm Reset
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- =======================================================
     REGISTER USER MODAL (ADMIN & SUPERADMIN)
     ======================================================= -->
<div class="modal fade" id="registerUserModal" tabindex="-1" aria-labelledby="registerUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-plus-fill fs-5"></i>
                    <h5 class="modal-title fw-bold mb-0" id="registerUserModalLabel">Quick Register Campus Account</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-controller="Admin" asp-action="UserCreate" method="post" id="adminRegisterForm">
                @Html.AntiForgeryToken()

                <div class="modal-body p-4">
                    <!-- ROLE POLICY NOTICE -->
                    <div class="alert @(Model.IsSuperAdmin ? "alert-info" : "alert-warning") d-flex align-items-center gap-2 py-2 px-3 mb-4 rounded-3 small">
                        <i class="bi @(Model.IsSuperAdmin ? "bi-shield-check" : "bi-exclamation-triangle-fill") fs-5 flex-shrink-0"></i>
                        <div>
                            @if (Model.IsSuperAdmin)
                            {
                                <span><strong>SuperAdmin Provisioning:</strong> Accounts you create can be activated immediately or placed in pending status.</span>
                            }
                            else
                            {
                                <span><strong>Admin Registration Policy:</strong> Accounts created by Campus Administrators are placed in <strong>PENDING</strong> status and require SuperAdmin approval before login is enabled.</span>
                            }
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- FULL NAME -->
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Full Legal Name *</label>
                            <input type="text" name="fullName" class="form-control form-control-sm" required placeholder="e.g. Abebe Kebede" />
                        </div>

                        <!-- USERNAME -->
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Username *</label>
                            <input type="text" name="username" class="form-control form-control-sm" required placeholder="e.g. abebe.k" />
                        </div>

                        <!-- EMAIL -->
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Official Email *</label>
                            <input type="email" name="email" class="form-control form-control-sm" required placeholder="user@hawassa.edu.et" />
                        </div>

                        <!-- PHONE -->
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Phone Number</label>
                            <input type="tel" name="phone" class="form-control form-control-sm" placeholder="+251 91 234 5678" />
                        </div>

                        <!-- ROLE -->
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Account Role / Type *</label>
                            <select name="role" class="form-select form-select-sm" required id="modalUserRoleSelect">
                                <option value="STUDENT">Student</option>
                                <option value="FACULTY">Faculty / Academic Staff</option>
                                <option value="STAFF">Administrative Staff</option>
                                <option value="ORGANIZATION">Club / Campus Organization</option>
                                @if (Model.IsSuperAdmin)
                                {
                                    <option value="ADMIN">Campus Administrator</option>
                                }
                            </select>
                        </div>

                        <!-- DEPARTMENT -->
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Academic Department</label>
                            <select name="departmentId" class="form-select form-select-sm">
                                <option value="">-- General Campus / Non-Affiliated --</option>
                                @foreach (var dept in Model.Departments)
                                {
                                    <option value="@dept.id">@dept.name</option>
                                }
                            </select>
                        </div>

                        <!-- STUDENT / EMPLOYEE ID -->
                        <div class="col-md-6" id="modalStudentIdBox">
                            <label class="form-label small fw-semibold text-dark">Student ID Number</label>
                            <input type="text" name="studentId" class="form-control form-control-sm" placeholder="e.g. HU/1234/15" />
                        </div>

                        <div class="col-md-6" id="modalEmployeeIdBox">
                            <label class="form-label small fw-semibold text-dark">Employee ID Number</label>
                            <input type="text" name="employeeId" class="form-control form-control-sm" placeholder="e.g. EMP-9821" />
                        </div>

                        <!-- PASSWORD -->
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Initial Password *</label>
                            <input type="password" name="password" class="form-control form-control-sm" required placeholder="Min 6 characters" />
                        </div>

                        <!-- STATUS (SuperAdmin Only) -->
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Initial Account Status</label>
                            <select name="initialStatus" class="form-select form-select-sm" @(!Model.IsSuperAdmin ? "disabled" : "")>
                                <option value="PENDING" selected="@(!Model.IsSuperAdmin)">Pending SuperAdmin Approval</option>
                                @if (Model.IsSuperAdmin)
                                {
                                    <option value="ACTIVE" selected>Active & Ready to Sign In</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-3 fw-semibold">
                        <i class="bi bi-person-check me-1"></i>Provision Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openResetPasswordModal(id, name, username) {
            document.getElementById('resetPasswordUserIdInput').value = id;
            document.getElementById('resetPasswordUserNameDisplay').innerText = name;
            document.getElementById('resetPasswordUserHandleDisplay').innerText = '@@' + username;
            var modal = new bootstrap.Modal(document.getElementById('resetPasswordModal'));
            modal.show();
        }
    </script>
}
