@model HawassaUnifiedCampusEventManagementSystem.Models.AdminDatabaseManagementViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Database Management & Snapshots";
}

<div class="admin-page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill fw-semibold mb-2">
            <i class="bi bi-shield-lock-fill me-1"></i> SUPERADMIN INFRASTRUCTURE
        </span>
        <h1 class="h3 fw-bold text-dark mb-1">🗄️ Database Management & Telemetry</h1>
        <p class="text-muted small mb-0">MySQL server health, active relational tables inventory, snapshot generators, and archive vaults.</p>
    </div>

    <!-- TRIGGER SNAPSHOT MODAL BUTTON -->
    <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#snapshotModal">
        <i class="bi bi-cloud-arrow-down-fill me-1"></i> Generate Database Snapshot
    </button>
</div>

<!-- TELEMETRY KPI METRICS -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="admin-card p-3 d-flex align-items-center gap-3">
            <div class="p-3 bg-success-subtle text-success rounded-3 fs-4">
                <i class="bi bi-hdd-network-fill"></i>
            </div>
            <div>
                <span class="text-muted small text-uppercase fw-semibold">Database Status</span>
                <h2 class="h5 fw-bold mb-0 text-success">@Model.ConnectionStatus</h2>
                <small class="text-muted">@Model.DatabaseName</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="admin-card p-3 d-flex align-items-center gap-3">
            <div class="p-3 bg-primary-subtle text-primary rounded-3 fs-4">
                <i class="bi bi-table"></i>
            </div>
            <div>
                <span class="text-muted small text-uppercase fw-semibold">Managed Tables</span>
                <h2 class="h5 fw-bold mb-0 text-dark">@Model.TableStats.Count Tables</h2>
                <small class="text-muted">41 Relational Entities</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="admin-card p-3 d-flex align-items-center gap-3">
            <div class="p-3 bg-warning-subtle text-warning-emphasis rounded-3 fs-4">
                <i class="bi bi-layers-fill"></i>
            </div>
            <div>
                <span class="text-muted small text-uppercase fw-semibold">Active Records</span>
                <h2 class="h5 fw-bold mb-0 text-dark">@Model.EstimatedTotalRows.ToString("N0") Rows</h2>
                <small class="text-muted">Indexed & Audited</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="admin-card p-3 d-flex align-items-center gap-3">
            <div class="p-3 bg-info-subtle text-info-emphasis rounded-3 fs-4">
                <i class="bi bi-archive-fill"></i>
            </div>
            <div>
                <span class="text-muted small text-uppercase fw-semibold">Vaulted Backups</span>
                <h2 class="h5 fw-bold mb-0 text-dark">@Model.BackupFiles.Count Snapshots</h2>
                <small class="text-muted">@(Model.LastBackupTimestamp.HasValue ? Model.LastBackupTimestamp.Value.ToString("MMM dd, yyyy") : "None Vaulted")</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- TABLE INVENTORY SECTION -->
    <div class="col-lg-7">
        <div class="admin-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h6 fw-bold text-dark mb-0"><i class="bi bi-database-check me-2 text-primary"></i>Core Schema Table Registry</h2>
                <span class="badge bg-light text-muted border">MySQL 8.0 InnoDB</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle small">
                    <thead class="table-light">
                        <tr>
                            <th>Table Name</th>
                            <th>Description</th>
                            <th>Engine</th>
                            <th class="text-end">Verified Rows</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.TableStats)
                        {
                            <tr>
                                <td class="fw-bold text-dark"><code>@t.TableName</code></td>
                                <td class="text-muted">@t.Description</td>
                                <td><span class="badge bg-secondary-subtle text-secondary small">@t.Engine</span></td>
                                <td class="text-end fw-semibold">@t.RowCount.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- BACKUP ARCHIVE VAULT SECTION -->
    <div class="col-lg-5">
        <div class="admin-card p-4 h-100 d-flex flex-column">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h6 fw-bold text-dark mb-0"><i class="bi bi-safe2-fill me-2 text-success"></i>Snapshot Archive Vault</h2>
                <span class="badge bg-success-subtle text-success">Secure Storage</span>
            </div>

            <p class="small text-muted mb-3">Timestamped database snapshots vaulted in isolated application storage with SHA256 integrity checksums.</p>

            @if (!Model.BackupFiles.Any())
            {
                <div class="text-center py-5 my-auto bg-light rounded-3">
                    <i class="bi bi-cloud-arrow-down fs-2 text-muted mb-2 d-block"></i>
                    <h3 class="h6 fw-bold text-dark mb-1">No Snapshots Generated Yet</h3>
                    <p class="small text-muted mb-3">Click the button below to generate the initial full database snapshot.</p>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#snapshotModal">
                        <i class="bi bi-plus-lg me-1"></i>Create First Snapshot
                    </button>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush flex-grow-1 overflow-auto" style="max-height: 480px;">
                    @foreach (var f in Model.BackupFiles)
                    {
                        <div class="list-group-item px-0 py-3 border-bottom">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <div>
                                    <div class="fw-bold text-dark small"><i class="bi bi-filetype-sql text-primary me-1"></i>@f.FileName</div>
                                    <small class="text-muted">@f.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC &bull; @f.FileSizeBytes</small>
                                </div>
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-sm btn-outline-danger px-2 py-1" title="Restore Snapshot" onclick="openRestoreModal('@f.FileName')">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </button>
                                    <a asp-controller="Admin" asp-action="DownloadBackup" asp-route-fileName="@f.FileName" class="btn btn-sm btn-outline-secondary px-2 py-1" title="Download Snapshot Archive">
                                        <i class="bi bi-download"></i>
                                    </a>
                                    <form asp-controller="Admin" asp-action="DeleteBackup" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to permanently delete backup snapshot @f.FileName?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="fileName" value="@f.FileName" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger px-2 py-1" title="Delete Snapshot File">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <div class="small text-muted font-monospace" style="font-size: 0.75rem;">
                                SHA256: @f.Checksum...
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- SNAPSHOT MODAL -->
<div class="modal fade" id="snapshotModal" tabindex="-1" aria-labelledby="snapshotModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form asp-controller="Admin" asp-action="DatabaseBackup" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom">
                    <h2 class="modal-title h5 fw-bold" id="snapshotModalLabel"><i class="bi bi-cloud-arrow-down-fill text-primary me-2"></i>Trigger Database Snapshot</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info border-0 small mb-3">
                        <i class="bi bi-info-circle-fill me-1"></i> This will generate a complete UTF-8 SQL snapshot of table structures, relational schemas, and data rows into the secure application vault.
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Snapshot Notes / Operator Memo</label>
                        <input type="text" name="notes" class="form-control form-control-sm" placeholder="e.g. Scheduled pre-maintenance snapshot" />
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm fw-semibold"><i class="bi bi-shield-check me-1"></i>Generate & Vault Snapshot</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- RESTORE SNAPSHOT MODAL -->
<div class="modal fade" id="restoreModal" tabindex="-1" aria-labelledby="restoreModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form asp-controller="Admin" asp-action="DatabaseRestoreSnapshot" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="fileName" id="restoreFileName" value="" />
                <div class="modal-header border-bottom bg-danger-subtle">
                    <h2 class="modal-title h5 fw-bold text-danger" id="restoreModalLabel"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Database Restoration</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning small mb-3">
                        <strong>Security Safeguard:</strong> Restoring a snapshot verifies table schema and row telemetry from the archive: <code id="restoreFileNameDisplay"></code>.
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">SuperAdmin Master Password</label>
                        <input type="password" name="superAdminPassword" class="form-control form-control-sm" placeholder="Enter SuperAdmin password to authorize" required />
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm fw-semibold"><i class="bi bi-arrow-counterclockwise me-1"></i>Authorize & Restore</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openRestoreModal(fileName) {
            document.getElementById('restoreFileName').value = fileName;
            document.getElementById('restoreFileNameDisplay').textContent = fileName;
            const modal = new bootstrap.Modal(document.getElementById('restoreModal'));
            modal.show();
        }
    </script>
}
