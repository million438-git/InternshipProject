@model HawassaUnifiedCampusEventManagementSystem.Models.AdminDepartmentsViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Department Management";
}

<div class="admin-page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Department Management</h1>
        <p class="text-muted small mb-0">Oversee academic departments, assign faculty parent bodies, and track department users.</p>
    </div>
    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#newDeptModal">
        <i class="bi bi-plus-lg"></i>
        <span>Add Department</span>
    </button>
</div>

<!-- =======================================================
     DEPARTMENTS TABLE
     ======================================================= -->
<div class="admin-card overflow-hidden">
    <div class="table-responsive">
        <table class="table admin-table" id="departmentsTable">
            <thead>
                <tr>
                    <th>Department Name</th>
                    <th>Code</th>
                    <th>Parent Faculty</th>
                    <th>Department Head</th>
                    <th>Enrolled Users</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Departments.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-diagram-3 fs-2 d-block mb-2 text-secondary opacity-50"></i>
                            <span class="fw-semibold">No academic departments registered yet.</span>
                            <div class="mt-2">
                                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#newDeptModal">
                                    <i class="bi bi-plus-lg me-1"></i>Add First Department
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var d in Model.Departments)
                    {
                        <tr>
                            <td class="fw-bold">@d.Name</td>
                            <td><span class="badge bg-secondary-subtle text-secondary font-monospace">@(d.Code ?? "N/A")</span></td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@d.FacultyName</span>
                            </td>
                            <td>@(d.HeadName ?? "Not Assigned")</td>
                            <td>
                                <small class="text-muted"><i class="bi bi-person me-1"></i>@d.StudentCount Members</small>
                            </td>
                            <td>
                                @if (d.IsActive)
                                {
                                    <span class="badge-status badge-active">Active</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-suspended">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <button type="button" 
                                        class="btn btn-sm btn-light border text-primary py-1 px-2 me-1" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#editDeptModal_@d.Id" 
                                        title="Edit Department"
                                        aria-label="Edit department @d.Name">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form asp-controller="Admin" asp-action="DepartmentDelete" asp-route-id="@d.Id" method="post" class="d-inline"
                                      data-confirm="Permanently delete academic department '@d.Name'? Associated enrolled student records will be safely unlinked."
                                      data-confirm-title="Confirm Department Deletion"
                                      data-confirm-btn="Delete Department">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-light border text-danger py-1 px-2" title="Delete" aria-label="Delete department @d.Name">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- =======================================================
     EDIT DEPARTMENT MODALS (SEMANTIC CONTAINER OUTSIDE TABLE)
     ======================================================= -->
@foreach (var d in Model.Departments)
{
    <div class="modal fade text-start" id="editDeptModal_@d.Id" tabindex="-1" aria-labelledby="editDeptModalTitle_@d.Id" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="editDeptModalTitle_@d.Id">
                        <i class="bi bi-pencil me-1 text-primary"></i>Edit Academic Department
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close dialog"></button>
                </div>
                <form asp-controller="Admin" asp-action="DepartmentEdit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@d.Id" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="edit_dept_name_@d.Id" class="form-label small fw-semibold">Department Name</label>
                            <input type="text" id="edit_dept_name_@d.Id" name="name" class="form-control form-control-sm" required value="@d.Name" />
                        </div>
                        <div class="mb-3">
                            <label for="edit_dept_code_@d.Id" class="form-label small fw-semibold">Department Code</label>
                            <input type="text" id="edit_dept_code_@d.Id" name="code" class="form-control form-control-sm" value="@d.Code" />
                        </div>
                        <div class="mb-3">
                            <label for="edit_dept_faculty_@d.Id" class="form-label small fw-semibold">Parent Faculty</label>
                            <select id="edit_dept_faculty_@d.Id" name="facultyId" class="form-select form-select-sm" required>
                                @foreach (var fac in Model.Faculties)
                                {
                                    <option value="@fac.id" selected="@(fac.id == d.FacultyId)">@fac.name</option>
                                }
                            </select>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label for="edit_dept_head_@d.Id" class="form-label small fw-semibold">Department Head</label>
                                <input type="text" id="edit_dept_head_@d.Id" name="headName" class="form-control form-control-sm" value="@d.HeadName" />
                            </div>
                            <div class="col-6">
                                <label for="edit_dept_email_@d.Id" class="form-label small fw-semibold">Email</label>
                                <input type="email" id="edit_dept_email_@d.Id" name="email" class="form-control form-control-sm" value="@d.Email" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="edit_dept_status_@d.Id" class="form-label small fw-semibold">Status</label>
                            <select id="edit_dept_status_@d.Id" name="isActive" class="form-select form-select-sm">
                                <option value="true" selected="@(d.IsActive)">Active</option>
                                <option value="false" selected="@(!d.IsActive)">Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-sm btn-primary px-3">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- =======================================================
     ADD DEPARTMENT MODAL
     ======================================================= -->
<div class="modal fade" id="newDeptModal" tabindex="-1" aria-labelledby="newDeptModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="newDeptModalTitle"><i class="bi bi-mortarboard me-1 text-primary"></i>Add Academic Department</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close dialog"></button>
            </div>
            <form asp-controller="Admin" asp-action="DepartmentCreate" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="new_dept_name" class="form-label small fw-semibold">Department Name</label>
                        <input type="text" id="new_dept_name" name="name" class="form-control form-control-sm" required placeholder="e.g. Computer Science & Software Engineering" />
                    </div>
                    <div class="mb-3">
                        <label for="new_dept_code" class="form-label small fw-semibold">Department Code</label>
                        <input type="text" id="new_dept_code" name="code" class="form-control form-control-sm" placeholder="e.g. CS" />
                    </div>
                    <div class="mb-3">
                        <label for="new_dept_faculty" class="form-label small fw-semibold">Parent Faculty</label>
                        <select id="new_dept_faculty" name="facultyId" class="form-select form-select-sm" required>
                            @foreach (var fac in Model.Faculties)
                            {
                                <option value="@fac.id">@fac.name</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label for="new_dept_head" class="form-label small fw-semibold">Department Head</label>
                            <input type="text" id="new_dept_head" name="headName" class="form-control form-control-sm" placeholder="e.g. Chala Gemeda" />
                        </div>
                        <div class="col-6">
                            <label for="new_dept_email" class="form-label small fw-semibold">Email</label>
                            <input type="email" id="new_dept_email" name="email" class="form-control form-control-sm" placeholder="cs.dept@hawassa.edu.et" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary px-3">Add Department</button>
                </div>
            </form>
        </div>
    </div>
</div>
