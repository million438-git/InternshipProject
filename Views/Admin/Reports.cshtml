@model HawassaUnifiedCampusEventManagementSystem.Models.AdminReportsViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reports & Analytics";
}

<div class="admin-page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">Reports & Campus Analytics</h1>
        <p class="text-muted small mb-0">Campus engagement metrics, attendee participation trends, and event analytics.</p>
    </div>
    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
        <i class="bi bi-printer me-1"></i>Print Report
    </button>
</div>

<!-- =======================================================
     METRICS
     ======================================================= -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card">
            <div class="stat-icon-box bg-primary-subtle text-primary"><i class="bi bi-people"></i></div>
            <div>
                <div class="stat-num">@Model.TotalUsers.ToString("N0")</div>
                <div class="stat-desc">+@Model.NewUsersThisMonth this month</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card">
            <div class="stat-icon-box bg-success-subtle text-success"><i class="bi bi-calendar2-check"></i></div>
            <div>
                <div class="stat-num">@Model.TotalEvents.ToString("N0")</div>
                <div class="stat-desc">+@Model.EventsThisMonth this month</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card">
            <div class="stat-icon-box bg-info-subtle text-info"><i class="bi bi-ticket-perforated"></i></div>
            <div>
                <div class="stat-num">@Model.TotalRegistrations.ToString("N0")</div>
                <div class="stat-desc">+@Model.RegistrationsThisMonth this month</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card">
            <div class="stat-icon-box bg-warning-subtle text-warning"><i class="bi bi-building"></i></div>
            <div>
                <div class="stat-num">@Model.TotalOrganizations.ToString("N0")</div>
                <div class="stat-desc">Active Campus Bodies</div>
            </div>
        </div>
    </div>
</div>

<!-- =======================================================
     CHARTS ROW
     ======================================================= -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="admin-card p-4 h-100">
            <h2 class="h6 fw-bold text-dark mb-3"><i class="bi bi-graph-up-arrow text-primary me-2"></i>Campus Growth Trends (Events vs Attendee Registrations)</h2>
            <div style="height: 300px;">
                <canvas id="monthlyGrowthChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="admin-card p-4 h-100">
            <h2 class="h6 fw-bold text-dark mb-3"><i class="bi bi-pie-chart-fill text-success me-2"></i>Activity Categories</h2>
            <div style="height: 300px;">
                <canvas id="categoryReportChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- =======================================================
     TOP EVENTS TABLE
     ======================================================= -->
<div class="admin-card p-4">
    <h2 class="h6 fw-bold text-dark mb-3"><i class="bi bi-trophy text-warning me-2"></i>Most Popular Campus Events by Engagement</h2>
    <div class="table-responsive">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>Event Title</th>
                    <th>Category</th>
                    <th>Registrations</th>
                    <th>Capacity</th>
                    <th>Fill Rate</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var evt in Model.TopEvents)
                {
                    <tr>
                        <td class="fw-bold text-dark">@evt.Title</td>
                        <td><span class="badge bg-secondary-subtle text-secondary">@evt.Category</span></td>
                        <td class="fw-semibold text-primary">@evt.Registrations registrations</td>
                        <td>@(evt.Capacity.HasValue ? $"{evt.Capacity} seats" : "Unlimited")</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 6px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: @(evt.FillRate)%"></div>
                                </div>
                                <span class="small fw-semibold text-dark">@evt.FillRate.ToString("F0")%</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const ctxGrowth = document.getElementById('monthlyGrowthChart');
            if (ctxGrowth) {
                new Chart(ctxGrowth, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyLabels)),
                        datasets: [
                            {
                                label: 'Registrations',
                                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRegCounts)),
                                backgroundColor: 'rgba(37, 99, 235, 0.8)',
                                borderRadius: 6
                            },
                            {
                                label: 'Events Hosted',
                                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyEventCounts)),
                                backgroundColor: 'rgba(16, 185, 129, 0.8)',
                                borderRadius: 6
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'top' } }
                    }
                });
            }

            const ctxCat = document.getElementById('categoryReportChart');
            if (ctxCat) {
                new Chart(ctxCat, {
                    type: 'polarArea',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryLabels)),
                        datasets: [{
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryCounts)),
                            backgroundColor: ['#2563eb', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899', '#06b6d4', '#64748b']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } } }
                    }
                });
            }
        });
    </script>
}
