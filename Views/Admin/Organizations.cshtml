@model HawassaUnifiedCampusEventManagementSystem.Models.AdminOrganizationsViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Organization Management";
}

<div class="admin-page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Organization & Club Management</h1>
        <p class="text-muted small mb-0">Oversee student associations, academic clubs, campus unions, and event organizing bodies.</p>
    </div>
    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#newOrgModal">
        <i class="bi bi-plus-lg"></i>
        <span>Register Organization</span>
    </button>
</div>

<!-- =======================================================
     METRICS
     ======================================================= -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="admin-stat-card">
            <div class="stat-icon-box bg-primary-subtle text-primary"><i class="bi bi-building"></i></div>
            <div>
                <div class="stat-num">@Model.TotalCount</div>
                <div class="stat-desc">Total Organizations</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-stat-card">
            <div class="stat-icon-box bg-success-subtle text-success"><i class="bi bi-check-circle"></i></div>
            <div>
                <div class="stat-num">@Model.ActiveCount</div>
                <div class="stat-desc">Active Clubs & Orgs</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-stat-card">
            <div class="stat-icon-box bg-warning-subtle text-warning"><i class="bi bi-hourglass"></i></div>
            <div>
                <div class="stat-num">@Model.PendingCount</div>
                <div class="stat-desc">Pending Verification</div>
            </div>
        </div>
    </div>
</div>

<!-- =======================================================
     ORGANIZATIONS TABLE
     ======================================================= -->
<div class="admin-card overflow-hidden">
    <div class="table-responsive">
        <table class="table admin-table" id="organizationsTable">
            <thead>
                <tr>
                    <th>Organization Name</th>
                    <th>Type</th>
                    <th>Associated Department</th>
                    <th>Contact</th>
                    <th>Engagement</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Organizations.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-building fs-2 d-block mb-2 text-secondary opacity-50"></i>
                            <span class="fw-semibold">No campus organizations registered yet.</span>
                            <div class="mt-2">
                                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#newOrgModal">
                                    <i class="bi bi-plus-lg me-1"></i>Register First Organization
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var org in Model.Organizations)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@org.Name</div>
                                @if (!string.IsNullOrEmpty(org.ShortName))
                                {
                                    <small class="badge bg-light text-secondary border">@org.ShortName</small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@org.OrganizationType</span>
                            </td>
                            <td>
                                <span class="small text-muted">@org.DepartmentName</span>
                            </td>
                            <td>
                                <div class="small">@(org.Email ?? "No email")</div>
                            </td>
                            <td>
                                <small class="d-block text-muted"><i class="bi bi-people me-1"></i>@org.MemberCount members</small>
                                <small class="d-block text-muted"><i class="bi bi-calendar me-1"></i>@org.EventCount events</small>
                            </td>
                            <td>
                                @if (org.Status == "ACTIVE")
                                {
                                    <span class="badge-status badge-active">Active</span>
                                }
                                else if (org.Status == "SUSPENDED")
                                {
                                    <span class="badge-status badge-suspended">Suspended</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-pending">@org.Status</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="dropdown d-inline-block">
                                    <button class="btn btn-sm btn-light border dropdown-toggle py-1 px-2" type="button" data-bs-toggle="dropdown" aria-label="Manage organization @org.Name" aria-expanded="false">
                                        Manage
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li>
                                            <form asp-controller="Admin" asp-action="OrganizationToggleStatus" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@org.Id" />
                                                <input type="hidden" name="status" value="ACTIVE" />
                                                <button type="submit" class="dropdown-item text-success"><i class="bi bi-check-circle me-2"></i>Set Active</button>
                                            </form>
                                        </li>
                                        <li>
                                            <form asp-controller="Admin" asp-action="OrganizationToggleStatus" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@org.Id" />
                                                <input type="hidden" name="status" value="SUSPENDED" />
                                                <button type="submit" class="dropdown-item text-warning"><i class="bi bi-pause-circle me-2"></i>Suspend</button>
                                            </form>
                                        </li>
                                        <li>
                                            <button type="button" class="dropdown-item text-primary" data-bs-toggle="modal" data-bs-target="#editOrgModal_@org.Id">
                                                <i class="bi bi-pencil me-2"></i>Edit
                                            </button>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form asp-controller="Admin" asp-action="OrganizationDelete" method="post"
                                                  data-confirm="Permanently delete campus organization '@org.Name'? Associated event and membership records will be safely unlinked."
                                                  data-confirm-title="Confirm Organization Deletion"
                                                  data-confirm-btn="Delete Organization">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@org.Id" />
                                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Delete</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- =======================================================
     EDIT ORGANIZATION MODALS (SEMANTIC CONTAINER OUTSIDE TABLE)
     ======================================================= -->
@foreach (var org in Model.Organizations)
{
    <div class="modal fade text-start" id="editOrgModal_@org.Id" tabindex="-1" aria-labelledby="editOrgModalTitle_@org.Id" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="editOrgModalTitle_@org.Id"><i class="bi bi-pencil me-1 text-primary"></i>Edit Campus Organization</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close dialog"></button>
                </div>
                <form asp-controller="Admin" asp-action="OrganizationEdit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@org.Id" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="edit_org_name_@org.Id" class="form-label small fw-semibold">Organization Name</label>
                            <input type="text" id="edit_org_name_@org.Id" name="name" class="form-control form-control-sm" required value="@org.Name" />
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label for="edit_org_short_@org.Id" class="form-label small fw-semibold">Short Name / Acronym</label>
                                <input type="text" id="edit_org_short_@org.Id" name="shortName" class="form-control form-control-sm" value="@org.ShortName" />
                            </div>
                            <div class="col-6">
                                <label for="edit_org_type_@org.Id" class="form-label small fw-semibold">Organization Type</label>
                                <select id="edit_org_type_@org.Id" name="organizationType" class="form-select form-select-sm">
                                    <option value="CLUB" selected="@(org.OrganizationType == "CLUB")">Student Club</option>
                                    <option value="SOCIETY" selected="@(org.OrganizationType == "SOCIETY")">Academic Society</option>
                                    <option value="ASSOCIATION" selected="@(org.OrganizationType == "ASSOCIATION")">Student Association</option>
                                    <option value="DEPARTMENT" selected="@(org.OrganizationType == "DEPARTMENT")">Department Board</option>
                                </select>
                            </div>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label for="edit_org_email_@org.Id" class="form-label small fw-semibold">Contact Email</label>
                                <input type="email" id="edit_org_email_@org.Id" name="email" class="form-control form-control-sm" value="@org.Email" />
                            </div>
                            <div class="col-6">
                                <label for="edit_org_status_@org.Id" class="form-label small fw-semibold">Status</label>
                                <select id="edit_org_status_@org.Id" name="status" class="form-select form-select-sm">
                                    <option value="ACTIVE" selected="@(org.Status == "ACTIVE")">Active</option>
                                    <option value="SUSPENDED" selected="@(org.Status == "SUSPENDED")">Suspended</option>
                                    <option value="PENDING" selected="@(org.Status == "PENDING")">Pending Review</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-sm btn-primary px-3">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- =======================================================
     REGISTER ORGANIZATION MODAL
     ======================================================= -->
<div class="modal fade" id="newOrgModal" tabindex="-1" aria-labelledby="newOrgModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="newOrgModalTitle"><i class="bi bi-building me-1 text-primary"></i>Register Campus Organization</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close dialog"></button>
            </div>
            <form asp-controller="Admin" asp-action="OrganizationCreate" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="new_org_name" class="form-label small fw-semibold">Organization Name</label>
                        <input type="text" id="new_org_name" name="name" class="form-control form-control-sm" required placeholder="e.g. Hawassa Tech & Innovation Club" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label for="new_org_short" class="form-label small fw-semibold">Short Acronym</label>
                            <input type="text" id="new_org_short" name="shortName" class="form-control form-control-sm" placeholder="e.g. HTIC" />
                        </div>
                        <div class="col-6">
                            <label for="new_org_type" class="form-label small fw-semibold">Organization Type</label>
                            <select id="new_org_type" name="organizationType" class="form-select form-select-sm">
                                <option value="CLUB">Club</option>
                                <option value="ASSOCIATION">Association</option>
                                <option value="STUDENT_UNION">Student Union</option>
                                <option value="OFFICE">Office</option>
                                <option value="OTHER">Other</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="new_org_email" class="form-label small fw-semibold">Official Contact Email</label>
                        <input type="email" id="new_org_email" name="email" class="form-control form-control-sm" placeholder="club@hawassa.edu.et" />
                    </div>
                    <div class="mb-3">
                        <label for="new_org_phone" class="form-label small fw-semibold">Contact Phone Number</label>
                        <input type="tel" id="new_org_phone" name="phone" class="form-control form-control-sm" placeholder="+251 9XX XXX XXX" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary px-3">Register Organization</button>
                </div>
            </form>
        </div>
    </div>
</div>
