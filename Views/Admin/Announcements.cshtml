@model HawassaUnifiedCampusEventManagementSystem.Models.AdminAnnouncementsViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Announcement Management";
}

<div class="admin-page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">Announcement & Bulletin Management</h1>
        <p class="text-muted small mb-0">Publish official campus notices, pin important updates, and archive old bulletins.</p>
    </div>
    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#newAnnouncementModal">
        <i class="bi bi-plus-lg"></i>
        <span>New Announcement</span>
    </button>
</div>

<!-- =======================================================
     METRICS
     ======================================================= -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="admin-stat-card">
            <div class="stat-icon-box bg-primary-subtle text-primary"><i class="bi bi-megaphone"></i></div>
            <div>
                <div class="stat-num">@Model.TotalCount</div>
                <div class="stat-desc">Total Announcements</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-stat-card">
            <div class="stat-icon-box bg-warning-subtle text-warning"><i class="bi bi-pin-angle"></i></div>
            <div>
                <div class="stat-num">@Model.PinnedCount</div>
                <div class="stat-desc">Pinned Bulletins</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-stat-card">
            <div class="stat-icon-box bg-success-subtle text-success"><i class="bi bi-check2-circle"></i></div>
            <div>
                <div class="stat-num">@Model.PublishedCount</div>
                <div class="stat-desc">Active / Published</div>
            </div>
        </div>
    </div>
</div>

<!-- =======================================================
     ANNOUNCEMENTS LIST
     ======================================================= -->
<div class="admin-card overflow-hidden">
    <div class="table-responsive">
        <table class="table admin-table" id="announcementsTable">
            <thead>
                <tr>
                    <th>Title & Content</th>
                    <th>Author / Scope</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Date Published</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Announcements)
                {
                    <tr>
                        <td style="max-width: 320px;">
                            <div class="d-flex align-items-center gap-2">
                                @if (item.IsPinned)
                                {
                                    <i class="bi bi-pin-angle-fill text-warning" title="Pinned Announcement"></i>
                                }
                                <div>
                                    <div class="fw-bold text-dark">@item.Title</div>
                                    <small class="text-muted text-truncate d-block" style="max-width: 300px;">@item.Content</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="small fw-semibold text-dark">@item.AuthorName</div>
                            <small class="text-muted">@item.DepartmentName</small>
                        </td>
                        <td>
                            @if (item.Priority == "URGENT" || item.Priority == "HIGH")
                            {
                                <span class="badge bg-danger-subtle text-danger">@item.Priority</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">@item.Priority</span>
                            }
                        </td>
                        <td>
                            <span class="badge-status badge-published">@item.Status</span>
                        </td>
                        <td class="small text-muted">
                            @item.CreatedAt.ToString("MMM dd, yyyy")
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <form asp-controller="Admin" asp-action="AnnouncementTogglePin" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-light border py-1 px-2" title="Toggle Pin">
                                        <i class="bi bi-pin-angle"></i>
                                    </button>
                                </form>
                                <form asp-controller="Admin" asp-action="AnnouncementDelete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete announcement?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-light border text-danger py-1 px-2" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- =======================================================
     CREATE ANNOUNCEMENT MODAL
     ======================================================= -->
<div class="modal fade" id="newAnnouncementModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-megaphone me-1 text-primary"></i>Publish Campus Announcement & Alerts</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Admin" asp-action="AnnouncementCreate" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Title</label>
                        <input type="text" name="title" class="form-control form-control-sm" required placeholder="e.g. Campus Wi-Fi Maintenance Window / Graduation Rehearsal Schedule" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Announcement Content & Details</label>
                        <textarea name="content" rows="4" class="form-control form-control-sm" required placeholder="Type full details of the announcement..."></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Target Audience</label>
                            <select name="targetAudience" class="form-select form-select-sm" id="annAudienceSelect" onchange="toggleAnnDeptSelect(this.value)">
                                <option value="ALL">All Campus Members (Broadcast)</option>
                                <option value="STUDENTS">Students Only</option>
                                <option value="FACULTY">Faculty & Staff Only</option>
                                <option value="ORGANIZERS">Club Leaders & Organizers</option>
                                <option value="DEPARTMENT">Specific Academic Department</option>
                            </select>
                        </div>
                        <div class="col-md-6" id="annDeptGroup" style="display: none;">
                            <label class="form-label small fw-semibold">Specific Department</label>
                            <select name="departmentId" class="form-select form-select-sm">
                                <option value="">-- Choose Target Department --</option>
                                @foreach (var d in Model.Departments)
                                {
                                    <option value="@d.id">@d.name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Announcement Type</label>
                            <select name="announcementType" class="form-select form-select-sm">
                                <option value="GENERAL">General Notice</option>
                                <option value="NEWS">Campus News</option>
                                <option value="ALERT">Safety / Urgent Alert</option>
                                <option value="ACADEMIC">Academic Bulletin</option>
                                <option value="CLOSURE">Facility Closure</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Priority</label>
                            <select name="priority" class="form-select form-select-sm">
                                <option value="NORMAL">Normal Priority</option>
                                <option value="HIGH">High Priority</option>
                                <option value="URGENT">Urgent Priority (Critical)</option>
                            </select>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 border">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" name="sendNotificationAlert" value="true" id="sendAlertCheck" checked />
                            <label class="form-check-label small fw-semibold text-dark" for="sendAlertCheck">
                                <i class="bi bi-bell-fill text-warning me-1"></i> Send Instant In-App Notification Alert to All Target Users
                            </label>
                            <div class="text-muted" style="font-size: 11px;">Targeted recipients will receive an alert popup and in-app notification in their personal Notification Center.</div>
                        </div>

                        <div class="form-check">
                            <input type="checkbox" name="isPinned" value="true" class="form-check-input" id="isPinnedCheck" />
                            <label class="form-check-label small fw-semibold" for="isPinnedCheck">
                                <i class="bi bi-pin-angle-fill text-warning me-1"></i> Pin Bulletin to Top of Feeds
                            </label>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary px-3">
                        <i class="bi bi-send me-1"></i> Publish & Dispatch Alerts
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function toggleAnnDeptSelect(val) {
        var group = document.getElementById('annDeptGroup');
        if (group) {
            group.style.display = val === 'DEPARTMENT' ? 'block' : 'none';
        }
    }
</script>
