@model HawassaUnifiedCampusEventManagementSystem.Models.DatabaseRecordsViewModel

@{
    ViewData["Title"] = "Database Records CRUD Grid | HUCEMS Admin";
    Layout = "_AdminLayout";
}

@section Styles {
    <style>
        .crud-grid-container {
            background-color: var(--bg-card, #ffffff);
            border: 1px solid var(--border-color, #e2e8f0);
            border-radius: 18px;
            box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);
            overflow: hidden;
            width: 100%;
            max-width: 100%;
            box-sizing: border-box;
        }

        [data-theme="dark"] .crud-grid-container {
            background-color: #121c32;
            border-color: #1e2e4f;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
        }

        .grid-toolbar {
            padding: 14px 18px;
            background: var(--bg-surface-alt, #f8fafc);
            border-bottom: 1px solid var(--border-color, #e2e8f0);
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            width: 100%;
            max-width: 100%;
            box-sizing: border-box;
        }

        [data-theme="dark"] .grid-toolbar {
            background: #172339;
            border-color: #1e2e4f;
        }

        .table-tabs-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            padding: 12px 18px;
            background: var(--bg-card, #ffffff);
            border-bottom: 1px solid var(--border-color, #e2e8f0);
            width: 100%;
            max-width: 100%;
            box-sizing: border-box;
        }

        [data-theme="dark"] .table-tabs-bar {
            background: #121c32;
            border-color: #1e2e4f;
        }

        .table-pill-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 16px;
            border-radius: 30px;
            border: 1px solid var(--border-color, #e2e8f0);
            background: var(--bg-surface-alt, #f8fafc);
            color: var(--text-body, #334155);
            font-size: 0.86rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.15s ease;
            white-space: nowrap;
        }

        [data-theme="dark"] .table-pill-btn {
            background: #172339;
            border-color: #1e2e4f;
            color: #cbd5e1;
        }

        .table-pill-btn:hover {
            border-color: #4f46e5;
            color: #4f46e5;
            background: rgba(79, 70, 229, 0.06);
        }

        .table-pill-btn.active {
            background: #4f46e5 !important;
            color: #ffffff !important;
            border-color: #4f46e5 !important;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
        }

        .table-pill-count {
            padding: 2px 7px;
            border-radius: 12px;
            background: rgba(0, 0, 0, 0.08);
            font-size: 0.75rem;
            font-weight: 700;
        }

        .table-pill-btn.active .table-pill-count {
            background: rgba(255, 255, 255, 0.25);
            color: #ffffff;
        }

        .grid-table-wrapper {
            position: relative;
            max-height: 620px;
            overflow: auto;
        }

        .crud-table {
            margin-bottom: 0;
            font-size: 0.88rem;
            width: 100%;
        }

        .crud-table thead th {
            position: sticky;
            top: 0;
            background: var(--bg-surface-alt, #f1f5f9);
            color: var(--text-heading, #0f172a);
            font-size: 0.78rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 12px 14px;
            border-bottom: 2px solid var(--border-color, #cbd5e1);
            z-index: 2;
            white-space: nowrap;
        }

        [data-theme="dark"] .crud-table thead th {
            background: #172339;
            color: #f8fafc;
            border-bottom-color: #1e2e4f;
        }

        .crud-table tbody tr {
            transition: background-color 0.12s ease;
            cursor: pointer;
        }

        .crud-table tbody tr:hover {
            background-color: rgba(79, 70, 229, 0.04);
        }

        [data-theme="dark"] .crud-table tbody tr:hover {
            background-color: rgba(99, 102, 241, 0.08);
        }

        .crud-table tbody tr.row-selected {
            background-color: rgba(79, 70, 229, 0.12) !important;
        }

        .crud-table tbody td {
            padding: 10px 14px;
            vertical-align: middle;
            border-bottom: 1px solid var(--border-color, #f1f5f9);
            color: var(--text-body, #334155);
            white-space: nowrap;
            max-width: 260px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        [data-theme="dark"] .crud-table tbody td {
            border-bottom-color: #16223b;
            color: #cbd5e1;
        }

        .pk-badge {
            background: #e0e7ff;
            color: #4338ca;
            padding: 2px 6px;
            border-radius: 6px;
            font-size: 0.72rem;
            font-weight: 800;
            margin-left: 4px;
        }

        [data-theme="dark"] .pk-badge {
            background: rgba(99, 102, 241, 0.25);
            color: #a5b4fc;
        }

        .status-badge {
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.76rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            display: inline-block;
        }

        .status-published, .status-active, .status-approved, .status-attended {
            background: #dcfce7;
            color: #15803d;
        }

        .status-pending, .status-pending_approval, .status-maintenance {
            background: #fef3c7;
            color: #b45309;
        }

        .status-draft, .status-inactive, .status-cancelled {
            background: #f1f5f9;
            color: #475569;
        }

        .status-rejected, .status-suspended, .status-deactivated {
            background: #fee2e2;
            color: #b91c1c;
        }

        [data-theme="dark"] .status-published, [data-theme="dark"] .status-active, [data-theme="dark"] .status-approved {
            background: rgba(34, 197, 94, 0.18);
            color: #4ade80;
        }

        [data-theme="dark"] .status-pending, [data-theme="dark"] .status-pending_approval {
            background: rgba(245, 158, 11, 0.18);
            color: #fbbf24;
        }

        [data-theme="dark"] .status-rejected, [data-theme="dark"] .status-suspended {
            background: rgba(239, 68, 68, 0.18);
            color: #f87171;
        }

        .action-icon-btn {
            width: 30px;
            height: 30px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            border: 1px solid var(--border-color, #e2e8f0);
            background: var(--bg-card, #ffffff);
            color: var(--text-muted, #64748b);
            transition: all 0.15s ease;
        }

        .action-icon-btn:hover {
            color: #4f46e5;
            border-color: #4f46e5;
            background: rgba(79, 70, 229, 0.08);
        }

        .action-icon-btn.btn-delete:hover {
            color: #ef4444;
            border-color: #ef4444;
            background: rgba(239, 68, 68, 0.08);
        }

        .grid-footer {
            padding: 14px 20px;
            background: var(--bg-surface-alt, #f8fafc);
            border-top: 1px solid var(--border-color, #e2e8f0);
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            font-size: 0.88rem;
        }

        [data-theme="dark"] .grid-footer {
            background: #172339;
            border-color: #1e2e4f;
        }
    </style>
}

<div class="container-fluid py-4">

    <!-- PAGE TITLE & DATABASE HEADER -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-bold" style="font-size: 0.8rem;">
                    <i class="bi bi-database-check me-1"></i> LIVE MYSQL ENGINE
                </span>
                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-bold" style="font-size: 0.8rem;">
                    <i class="bi bi-shield-lock-fill me-1"></i> TRANSACTIONAL CRUD
                </span>
            </div>
            <h1 class="h3 fw-bold text-dark mb-1">Database Records Result Grid</h1>
            <p class="text-muted small mb-0">
                Execute live SELECT, INSERT, UPDATE, and DELETE operations directly across your MySQL database (<code class="text-primary fw-bold">university_event_management</code>).
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold" onclick="refreshGrid()">
                <i class="bi bi-arrow-clockwise me-1" id="refreshSpinner"></i> Refresh Data
            </button>
            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold" onclick="exportGridCsv()">
                <i class="bi bi-download me-1"></i> Export CSV
            </button>
        </div>
    </div>

    <!-- MAIN RESULT GRID CONTAINER -->
    <div class="crud-grid-container">

        <!-- 1. TABLE SELECTOR TABS -->
        <div class="table-tabs-bar">
            @foreach (var tbl in Model.AvailableTables)
            {
                <a href="javascript:void(0)"
                   class="table-pill-btn @(Model.ActiveTable == tbl.Key ? "active" : "")"
                   onclick="switchTable('@tbl.Key')">
                    <i class="bi @tbl.Icon"></i>
                    <span>@tbl.DisplayName</span>
                    <span class="table-pill-count" id="count-@tbl.Key">@tbl.RecordCount</span>
                </a>
            }
        </div>

        <!-- 2. RESULT GRID TOOLBAR -->
        <div class="grid-toolbar">
            <!-- Left Action Buttons -->
            <div class="d-flex flex-wrap align-items-center gap-2">
                <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold shadow-sm d-inline-flex align-items-center gap-2" onclick="openAddRowModal()">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>Add Row</span>
                </button>

                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold d-inline-flex align-items-center gap-2" id="btnEditSelected" onclick="editSelectedRow()" disabled>
                    <i class="bi bi-pencil-square"></i>
                    <span>Edit Selected</span>
                </button>

                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-semibold d-inline-flex align-items-center gap-2" id="btnDeleteSelected" onclick="deleteSelectedRow()" disabled>
                    <i class="bi bi-trash3-fill"></i>
                    <span>Delete Selected</span>
                </button>

                <div class="vr mx-1 opacity-25 d-none d-md-block" style="height: 24px;"></div>

                <button type="button" class="btn btn-success btn-sm rounded-pill px-3 fw-bold shadow-sm d-inline-flex align-items-center gap-2" id="btnApplyChanges" onclick="applyBatchChanges()" style="display: none !important;">
                    <i class="bi bi-check2-circle"></i>
                    <span>Apply Changes</span>
                    <span class="badge bg-white text-success rounded-pill" id="pendingChangesBadge">0</span>
                </button>

                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold" id="btnRevertChanges" onclick="revertBatchChanges()" style="display: none !important;">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Revert
                </button>
            </div>

            <!-- Right Filter & Search -->
            <div class="d-flex align-items-center gap-2">
                <div class="input-group input-group-sm" style="max-width: 240px;">
                    <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0 ps-0" id="gridSearchInput" placeholder="Search in @Model.ActiveTable..." value="@Model.SearchQuery" onkeyup="handleSearchKey(event)" />
                    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                    {
                        <button class="btn btn-outline-secondary" type="button" onclick="clearSearch()"><i class="bi bi-x"></i></button>
                    }
                </div>

                <select class="form-select form-select-sm rounded-pill" id="pageSizeSelect" style="width: 100px;" onchange="changePageSize(this.value)">
                    <option value="10" selected="@(Model.PageSize == 10)">10 / pg</option>
                    <option value="25" selected="@(Model.PageSize == 25)">25 / pg</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50 / pg</option>
                    <option value="100" selected="@(Model.PageSize == 100)">100 / pg</option>
                </select>
            </div>
        </div>

        <!-- 3. INTERACTIVE DATA TABLE -->
        <div class="grid-table-wrapper">
            <table class="table table-hover crud-table align-middle" id="crudGridTable">
                <thead>
                    <tr>
                        <th style="width: 40px; text-align: center;">
                            <input type="checkbox" class="form-check-input" id="selectAllCheckbox" onchange="toggleSelectAll(this.checked)" />
                        </th>
                        <th style="width: 80px; text-align: center;">Actions</th>
                        @foreach (var col in Model.Columns)
                        {
                            <th>
                                <span>@col.DisplayName</span>
                                @if (col.IsPrimaryKey)
                                {
                                    <span class="pk-badge">PK</span>
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody id="gridTableBody">
                    @if (Model.Rows.Any())
                    {
                        @foreach (var row in Model.Rows)
                        {
                            var rowId = row.ContainsKey("id") ? row["id"]?.ToString() ?? "0" : "0";
                            <tr id="row-@rowId" data-id="@rowId" onclick="handleRowClick(event, '@rowId')">
                                <td style="text-align: center;" onclick="event.stopPropagation()">
                                    <input type="checkbox" class="form-check-input row-checkbox" data-id="@rowId" onchange="handleCheckboxChange()" />
                                </td>
                                <td style="text-align: center;" onclick="event.stopPropagation()">
                                    <div class="d-inline-flex gap-1">
                                        <button type="button" class="action-icon-btn" title="Edit Row" onclick="openEditRowModal('@rowId')">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="action-icon-btn btn-delete" title="Delete Row" onclick="confirmDeleteRow('@rowId')">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                                @foreach (var col in Model.Columns)
                                {
                                    var val = row.ContainsKey(col.Name) ? row[col.Name]?.ToString() : null;
                                    <td>
                                        @if (col.DataType == "enum" && !string.IsNullOrWhiteSpace(val))
                                        {
                                            var badgeClass = "status-" + val.ToLower().Replace(" ", "_");
                                            <span class="status-badge @badgeClass">@val</span>
                                        }
                                        else if (col.IsPrimaryKey)
                                        {
                                            <strong class="text-primary">#@val</strong>
                                        }
                                        else if (string.IsNullOrWhiteSpace(val))
                                        {
                                            <span class="text-muted opacity-50">NULL</span>
                                        }
                                        else
                                        {
                                            <span title="@val">@val</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(Model.Columns.Count + 2)" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-muted opacity-50"></i>
                                <strong>No records found in table '@Model.ActiveTable'</strong>
                                <p class="small mb-0">Click "+ Add Row" to insert the first record or adjust your search filter.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- 4. GRID FOOTER & PAGINATION -->
        <div class="grid-footer">
            <div class="text-muted small">
                Showing <strong>@((Model.CurrentPage - 1) * Model.PageSize + (Model.Rows.Any() ? 1 : 0))</strong> to <strong>@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords))</strong> of <strong>@Model.TotalRecords</strong> total records in <code class="text-primary fw-bold">@Model.ActiveTable</code>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Grid navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link rounded-pill me-1 px-3" href="javascript:void(0)" onclick="goToPage(@(Model.CurrentPage - 1))">&laquo; Prev</a>
                        </li>

                        @for (int p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); p++)
                        {
                            <li class="page-item @(Model.CurrentPage == p ? "active" : "")">
                                <a class="page-link rounded-circle mx-1 text-center" style="width: 32px; height: 32px; padding: 5px 0;" href="javascript:void(0)" onclick="goToPage(@p)">@p</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link rounded-pill ms-1 px-3" href="javascript:void(0)" onclick="goToPage(@(Model.CurrentPage + 1))">Next &raquo;</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>

    </div>

</div>

<!-- =====================================================
     DYNAMIC ADD / EDIT RECORD MODAL
     ===================================================== -->
<div class="modal fade" id="mutationRecordModal" tabindex="-1" aria-labelledby="mutationModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom px-4 py-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary-subtle text-primary p-2 rounded-circle">
                        <i class="bi bi-pencil-square fs-5"></i>
                    </span>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="mutationModalTitle">Insert Record</h5>
                        <small class="text-muted" id="mutationModalSubtitle">Table: @Model.ActiveTable</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="mutationRecordForm" onsubmit="submitRecordMutation(event)">
                    <input type="hidden" id="mutationRecordId" value="" />
                    <input type="hidden" id="mutationTableName" value="@Model.ActiveTable" />

                    <div class="row g-3" id="mutationFormFieldsContainer">
                        <!-- Dynamically populated fields -->
                    </div>

                    <div class="alert alert-danger d-none mt-3" id="mutationErrorAlert" role="alert"></div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm d-flex align-items-center gap-2" id="btnSaveRecord">
                            <i class="bi bi-check2-circle"></i>
                            <span>Save to MySQL</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- =====================================================
     DELETE CONFIRMATION MODAL
     ===================================================== -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-body p-4 text-center">
                <div class="rounded-circle bg-danger-subtle text-danger mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                    <i class="bi bi-exclamation-triangle-fill fs-3"></i>
                </div>
                <h5 class="fw-bold mb-2">Confirm Record Deletion</h5>
                <p class="small text-muted mb-4">
                    Are you sure you want to permanently delete record <strong id="deleteTargetRecordId" class="text-danger">#0</strong> from table <code class="fw-bold" id="deleteTargetTableName">events</code>? This will execute a live SQL <code class="text-danger">DELETE</code> query.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger btn-sm rounded-pill px-4 fw-bold shadow-sm" id="btnConfirmDeleteAction" onclick="executeDeleteRecord()">
                        <i class="bi bi-trash3-fill me-1"></i> Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =====================================================
     TOAST NOTIFICATION CONTAINER
     ===================================================== -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
    <div id="gridFeedbackToast" class="toast align-items-center text-bg-dark border-0 rounded-4 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2" id="gridToastMessage">
                <i class="bi bi-check2-circle text-success fs-5"></i>
                <span>Operation completed successfully.</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Grid State Variables
        var currentActiveTable = "@Model.ActiveTable";
        var currentPage = @Model.CurrentPage;
        var currentPageSize = @Model.PageSize;
        var currentSearch = "@(Model.SearchQuery ?? "")";
        var selectedRowIds = new Set();
        var pendingDeletions = new Set();
        var pendingEdits = {};
        var tableSchema = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Columns));
        var targetDeleteId = 0;

        function showToast(message, isSuccess = true) {
            var toastEl = document.getElementById('gridFeedbackToast');
            var msgEl = document.getElementById('gridToastMessage');
            if (msgEl) {
                var icon = isSuccess ? '<i class="bi bi-check-circle-fill text-success fs-5"></i>' : '<i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>';
                msgEl.innerHTML = icon + ' <span>' + message + '</span>';
            }
            if (toastEl && typeof bootstrap !== 'undefined') {
                var toast = new bootstrap.Toast(toastEl, { delay: 4000 });
                toast.show();
            }
        }

        function switchTable(tableName) {
            window.location.href = '/Admin/DatabaseRecords?table=' + encodeURIComponent(tableName) + '&page=1&pageSize=' + currentPageSize;
        }

        function goToPage(page) {
            window.location.href = '/Admin/DatabaseRecords?table=' + encodeURIComponent(currentActiveTable) + '&page=' + page + '&pageSize=' + currentPageSize + (currentSearch ? '&search=' + encodeURIComponent(currentSearch) : '');
        }

        function changePageSize(size) {
            window.location.href = '/Admin/DatabaseRecords?table=' + encodeURIComponent(currentActiveTable) + '&page=1&pageSize=' + size + (currentSearch ? '&search=' + encodeURIComponent(currentSearch) : '');
        }

        function handleSearchKey(event) {
            if (event.key === 'Enter') {
                var query = document.getElementById('gridSearchInput').value.trim();
                window.location.href = '/Admin/DatabaseRecords?table=' + encodeURIComponent(currentActiveTable) + '&page=1&pageSize=' + currentPageSize + '&search=' + encodeURIComponent(query);
            }
        }

        function clearSearch() {
            window.location.href = '/Admin/DatabaseRecords?table=' + encodeURIComponent(currentActiveTable) + '&page=1&pageSize=' + currentPageSize;
        }

        function refreshGrid() {
            var spinner = document.getElementById('refreshSpinner');
            if (spinner) spinner.classList.add('spin-animation');
            window.location.reload();
        }

        function exportGridCsv() {
            var table = document.getElementById("crudGridTable");
            var rows = [];
            for (var i = 0, row; row = table.rows[i]; i++) {
                var cols = [];
                for (var j = 2, col; col = row.cells[j]; j++) {
                    cols.push('"' + col.innerText.replace(/"/g, '""').trim() + '"');
                }
                rows.push(cols.join(','));
            }
            var csvString = rows.join('\n');
            var a = document.createElement('a');
            a.href = 'data:attachment/csv,' + encodeURIComponent(csvString);
            a.target = '_blank';
            a.download = currentActiveTable + '_export_' + new Date().toISOString().slice(0,10) + '.csv';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        // Selection Handlers
        function handleRowClick(event, rowId) {
            var tr = document.getElementById('row-' + rowId);
            var cb = tr.querySelector('.row-checkbox');
            if (cb) {
                cb.checked = !cb.checked;
                handleCheckboxChange();
            }
        }

        function toggleSelectAll(checked) {
            var cbs = document.querySelectorAll('.row-checkbox');
            cbs.forEach(function (cb) {
                cb.checked = checked;
            });
            handleCheckboxChange();
        }

        function handleCheckboxChange() {
            selectedRowIds.clear();
            var cbs = document.querySelectorAll('.row-checkbox');
            cbs.forEach(function (cb) {
                var rowId = cb.getAttribute('data-id');
                var tr = document.getElementById('row-' + rowId);
                if (cb.checked) {
                    selectedRowIds.add(rowId);
                    if (tr) tr.classList.add('row-selected');
                } else {
                    if (tr) tr.classList.remove('row-selected');
                }
            });

            var btnEdit = document.getElementById('btnEditSelected');
            var btnDelete = document.getElementById('btnDeleteSelected');
            if (btnEdit) btnEdit.disabled = selectedRowIds.size !== 1;
            if (btnDelete) btnDelete.disabled = selectedRowIds.size === 0;
        }

        // Mutation Modal Rendering
        function openAddRowModal() {
            document.getElementById('mutationModalTitle').innerText = 'Insert New Record into ' + currentActiveTable;
            document.getElementById('mutationModalSubtitle').innerText = 'Table: ' + currentActiveTable + ' • SQL INSERT';
            document.getElementById('mutationRecordId').value = '';
            document.getElementById('mutationTableName').value = currentActiveTable;
            document.getElementById('mutationErrorAlert').classList.add('d-none');

            renderMutationFormFields({});
            var modal = new bootstrap.Modal(document.getElementById('mutationRecordModal'));
            modal.show();
        }

        function editSelectedRow() {
            if (selectedRowIds.size === 1) {
                var id = Array.from(selectedRowIds)[0];
                openEditRowModal(id);
            }
        }

        function openEditRowModal(id) {
            document.getElementById('mutationModalTitle').innerText = 'Edit Record #' + id + ' in ' + currentActiveTable;
            document.getElementById('mutationModalSubtitle').innerText = 'Table: ' + currentActiveTable + ' • SQL UPDATE';
            document.getElementById('mutationRecordId').value = id;
            document.getElementById('mutationTableName').value = currentActiveTable;
            document.getElementById('mutationErrorAlert').classList.add('d-none');

            // Fetch record details via AJAX
            fetch('/Admin/GetRecord?table=' + encodeURIComponent(currentActiveTable) + '&id=' + id)
                .then(r => r.json())
                .then(res => {
                    if (res.success && res.data) {
                        renderMutationFormFields(res.data);
                        var modal = new bootstrap.Modal(document.getElementById('mutationRecordModal'));
                        modal.show();
                    } else {
                        showToast(res.message || "Failed to load record details.", false);
                    }
                })
                .catch(err => {
                    showToast("Error communicating with server.", false);
                });
        }

        function renderMutationFormFields(values) {
            var container = document.getElementById('mutationFormFieldsContainer');
            container.innerHTML = '';

            tableSchema.forEach(function (col) {
                if (col.IsPrimaryKey) return; // Skip primary key in insert/edit fields

                var colDiv = document.createElement('div');
                colDiv.className = col.DataType === 'text' ? 'col-12' : 'col-md-6';

                var label = document.createElement('label');
                label.className = 'form-label small fw-bold text-dark';
                label.innerHTML = col.DisplayName + (col.IsRequired ? ' <span class="text-danger">*</span>' : '');

                var val = values[col.Name] !== undefined && values[col.Name] !== null ? values[col.Name] : (col.DefaultValue || '');

                var inputElement;
                if (col.DataType === 'enum' && col.EnumOptions && col.EnumOptions.length > 0) {
                    inputElement = document.createElement('select');
                    inputElement.className = 'form-select form-select-sm rounded-3';
                    inputElement.name = col.Name;
                    inputElement.id = 'field_' + col.Name;
                    col.EnumOptions.forEach(function (opt) {
                        var option = document.createElement('option');
                        option.value = opt;
                        option.textContent = opt;
                        if (val && val.toUpperCase() === opt.toUpperCase()) option.selected = true;
                        inputElement.appendChild(option);
                    });
                } else if (col.DataType === 'datetime') {
                    inputElement = document.createElement('input');
                    inputElement.type = 'datetime-local';
                    inputElement.className = 'form-control form-control-sm rounded-3';
                    inputElement.name = col.Name;
                    inputElement.id = 'field_' + col.Name;
                    if (val) {
                        inputElement.value = val.replace(' ', 'T').substring(0, 16);
                    } else {
                        var now = new Date();
                        inputElement.value = now.toISOString().slice(0, 16);
                    }
                } else if (col.DataType === 'boolean') {
                    inputElement = document.createElement('select');
                    inputElement.className = 'form-select form-select-sm rounded-3';
                    inputElement.name = col.Name;
                    inputElement.id = 'field_' + col.Name;
                    inputElement.innerHTML = '<option value="true"' + (val === true || val === 'true' ? ' selected' : '') + '>True (Active)</option>' +
                                             '<option value="false"' + (val === false || val === 'false' ? ' selected' : '') + '>False (Inactive)</option>';
                } else if (col.DataType === 'number') {
                    inputElement = document.createElement('input');
                    inputElement.type = 'number';
                    inputElement.className = 'form-control form-control-sm rounded-3';
                    inputElement.name = col.Name;
                    inputElement.id = 'field_' + col.Name;
                    inputElement.value = val;
                } else {
                    inputElement = document.createElement('input');
                    inputElement.type = 'text';
                    inputElement.className = 'form-control form-control-sm rounded-3';
                    inputElement.name = col.Name;
                    inputElement.id = 'field_' + col.Name;
                    inputElement.value = val;
                }

                if (col.IsReadOnly) {
                    inputElement.disabled = true;
                }

                colDiv.appendChild(label);
                colDiv.appendChild(inputElement);
                container.appendChild(colDiv);
            });
        }

        function submitRecordMutation(event) {
            event.preventDefault();
            var recordId = document.getElementById('mutationRecordId').value;
            var isEdit = recordId && recordId.length > 0;
            var fields = {};

            tableSchema.forEach(function (col) {
                if (col.IsPrimaryKey) return;
                var el = document.getElementById('field_' + col.Name);
                if (el) {
                    fields[col.Name] = el.value;
                }
            });

            var payload = {
                table: currentActiveTable,
                id: isEdit ? parseInt(recordId) : null,
                fields: fields
            };

            var endpoint = isEdit ? '/Admin/UpdateRecord' : '/Admin/CreateRecord';

            fetch(endpoint, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    var modal = bootstrap.Modal.getInstance(document.getElementById('mutationRecordModal'));
                    if (modal) modal.hide();
                    showToast(res.message, true);
                    setTimeout(function () { window.location.reload(); }, 900);
                } else {
                    var errEl = document.getElementById('mutationErrorAlert');
                    errEl.textContent = res.message || "Failed to save record.";
                    errEl.classList.remove('d-none');
                }
            })
            .catch(err => {
                var errEl = document.getElementById('mutationErrorAlert');
                errEl.textContent = "Server communication error: " + err;
                errEl.classList.remove('d-none');
            });
        }

        // Delete Confirmation
        function deleteSelectedRow() {
            if (selectedRowIds.size > 0) {
                var id = Array.from(selectedRowIds)[0];
                confirmDeleteRow(id);
            }
        }

        function confirmDeleteRow(id) {
            targetDeleteId = id;
            document.getElementById('deleteTargetRecordId').innerText = '#' + id;
            document.getElementById('deleteTargetTableName').innerText = currentActiveTable;
            var modal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
            modal.show();
        }

        function executeDeleteRecord() {
            if (!targetDeleteId) return;

            fetch('/Admin/DeleteRecord', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ table: currentActiveTable, id: parseInt(targetDeleteId) })
            })
            .then(r => r.json())
            .then(res => {
                var modal = bootstrap.Modal.getInstance(document.getElementById('deleteConfirmModal'));
                if (modal) modal.hide();

                if (res.success) {
                    showToast(res.message, true);
                    setTimeout(function () { window.location.reload(); }, 900);
                } else {
                    showToast(res.message || "Failed to delete record.", false);
                }
            })
            .catch(err => {
                showToast("Server communication error: " + err, false);
            });
        }
    </script>
}
