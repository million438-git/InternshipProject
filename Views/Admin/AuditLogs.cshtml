@model HawassaUnifiedCampusEventManagementSystem.Models.AdminAuditLogsViewModel

@{
    Layout = "_SuperAdminLayout";
    ViewData["Title"] = "Security & Forensic Audit Trail";
}

<!-- =======================================================
     PAGE HEADER & TOP ACTION TOOLBAR
     ======================================================= -->
<div class="admin-page-header d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-decoration-none">SuperAdmin Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Audit Trail</li>
            </ol>
        </nav>
        <h1 class="h3 fw-bold text-dark mb-1">🛡️ Security & Forensic Audit Trail</h1>
        <p class="text-muted small mb-0">Immutable record of administrative operations, authentication events, user provisioning, role changes, and system governance.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Admin" asp-action="ExportAuditLogsCsv" 
           asp-route-search="@Model.SearchTerm"
           asp-route-entity="@Model.EntityFilter"
           asp-route-timeframe="@Model.Timeframe"
           class="btn btn-outline-success btn-sm d-inline-flex align-items-center gap-1 shadow-sm px-3"
           title="Export verified audit trail to CSV">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>
            <span>Export Audit CSV</span>
        </a>
        <a asp-controller="Admin" asp-action="SuperAdminDashboard" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
            <i class="bi bi-shield-lock me-1"></i>Security Console
        </a>
    </div>
</div>

<!-- =======================================================
     METRICS SUMMARY CARDS
     ======================================================= -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-primary-subtle text-primary"><i class="bi bi-journal-text"></i></div>
            <div>
                <div class="stat-num">@Model.TotalCount.ToString("N0")</div>
                <div class="stat-desc">Total Recorded Logs</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-info-subtle text-info"><i class="bi bi-clock-history"></i></div>
            <div>
                <div class="stat-num">@Model.TodayLogsCount.ToString("N0")</div>
                <div class="stat-desc">Actions Today</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-danger-subtle text-danger"><i class="bi bi-shield-exclamation"></i></div>
            <div>
                <div class="stat-num">@Model.SecurityActionsCount.ToString("N0")</div>
                <div class="stat-desc">Security Critical Actions</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-success-subtle text-success"><i class="bi bi-people-fill"></i></div>
            <div>
                <div class="stat-num">@Model.UniqueActorsCount</div>
                <div class="stat-desc">Unique Active Actors</div>
            </div>
        </div>
    </div>
</div>

<!-- =======================================================
     FILTERS & ADVANCED SEARCH BAR
     ======================================================= -->
<div class="admin-card p-3 mb-4">
    <div class="d-flex flex-wrap gap-2 mb-3 pb-2 border-bottom">
        <a asp-controller="Admin" asp-action="AuditLogs" class="btn btn-sm @(string.IsNullOrEmpty(Model.Timeframe) || Model.Timeframe == "ALL" ? "btn-dark" : "btn-light border")">
            All Time (@Model.TotalCount)
        </a>
        <a asp-controller="Admin" asp-action="AuditLogs" asp-route-timeframe="TODAY" class="btn btn-sm @(Model.Timeframe == "TODAY" ? "btn-info text-white" : "btn-light border")">
            <i class="bi bi-calendar-event me-1"></i>Today (@Model.TodayLogsCount)
        </a>
        <a asp-controller="Admin" asp-action="AuditLogs" asp-route-timeframe="LAST_24_HOURS" class="btn btn-sm @(Model.Timeframe == "LAST_24_HOURS" ? "btn-primary" : "btn-light border")">
            <i class="bi bi-clock me-1"></i>Last 24 Hours
        </a>
        <a asp-controller="Admin" asp-action="AuditLogs" asp-route-timeframe="LAST_7_DAYS" class="btn btn-sm @(Model.Timeframe == "LAST_7_DAYS" ? "btn-secondary" : "btn-light border")">
            <i class="bi bi-calendar-range me-1"></i>Last 7 Days
        </a>
    </div>

    <form method="get" class="row g-2 align-items-center">
        <input type="hidden" name="timeframe" value="@Model.Timeframe" />

        <div class="col-12 col-md-4">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="search" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search action, admin, email, IP, details..." />
            </div>
        </div>

        <div class="col-6 col-md-3">
            <select name="entity" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="ALL" selected="@(Model.EntityFilter == null || Model.EntityFilter == "ALL")">All Entity Scopes</option>
                <option value="USER" selected="@(Model.EntityFilter == "USER")">👤 User Accounts & Auth</option>
                <option value="EVENT" selected="@(Model.EntityFilter == "EVENT")">📅 Events & Schedules</option>
                <option value="ORGANIZATION" selected="@(Model.EntityFilter == "ORGANIZATION")">🏛️ Organizations & Clubs</option>
                <option value="ROLE" selected="@(Model.EntityFilter == "ROLE")">🔐 Roles & Permissions</option>
                <option value="VENUE" selected="@(Model.EntityFilter == "VENUE")">🏟️ Venues & Facilities</option>
                <option value="FACULTY" selected="@(Model.EntityFilter == "FACULTY")">🏢 Faculties & Colleges</option>
                <option value="DEPARTMENT" selected="@(Model.EntityFilter == "DEPARTMENT")">📚 Academic Departments</option>
                <option value="DATABASE" selected="@(Model.EntityFilter == "DATABASE")">🗄️ Database & Backups</option>
                <option value="SYSTEM" selected="@(Model.EntityFilter == "SYSTEM")">⚙️ System Configuration</option>
            </select>
        </div>

        <div class="col-6 col-md-2">
            <select name="pageSize" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="25" selected="@(Model.PageSize == 25)">25 per page</option>
                <option value="50" selected="@(Model.PageSize == 50)">50 per page</option>
                <option value="100" selected="@(Model.PageSize == 100)">100 per page</option>
                <option value="250" selected="@(Model.PageSize == 250)">250 per page</option>
            </select>
        </div>

        <div class="col-12 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary flex-grow-1">Filter Logs</button>
            <a asp-controller="Admin" asp-action="AuditLogs" class="btn btn-sm btn-light border" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<!-- =======================================================
     AUDIT LOGS TABLE
     ======================================================= -->
<div class="admin-card overflow-hidden">
    <div class="table-responsive">
        <table class="table admin-table align-middle mb-0" id="auditLogsTable">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Action Identifier</th>
                    <th>Actor / Administrator</th>
                    <th>Entity Scope</th>
                    <th>Remote IP</th>
                    <th>Audit Details</th>
                    <th class="text-end">Inspect</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Logs.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-shield-slash fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            <h5 class="fw-bold text-dark mb-1">No Audit Records Found</h5>
                            <p class="small text-muted mb-3">No activity logs match your filter criteria.</p>
                            <a asp-controller="Admin" asp-action="AuditLogs" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Filters
                            </a>
                        </td>
                    </tr>
                }
                @foreach (var log in Model.Logs)
                {
                    <tr>
                        <td>
                            <div class="small fw-semibold text-dark font-monospace">
                                @log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")
                            </div>
                            <span class="badge bg-light text-muted border" style="font-size: 10px;">@log.TimeAgoFormatted</span>
                        </td>
                        <td>
                            <span class="badge @log.BadgeClass border font-monospace px-2 py-1">
                                @log.Action
                            </span>
                        </td>
                        <td>
                            <div class="fw-semibold text-dark small">
                                <i class="bi bi-person-badge me-1 text-primary"></i>@log.UserName
                            </div>
                            @if (!string.IsNullOrEmpty(log.UserEmail))
                            {
                                <small class="text-muted font-monospace" style="font-size: 11px;">@log.UserEmail</small>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-secondary border font-monospace">
                                @(log.EntityType ?? "SYSTEM")
                                @if (log.EntityId.HasValue && log.EntityId.Value > 0)
                                {
                                    <span class="text-primary fw-bold ms-1">#@log.EntityId</span>
                                }
                            </span>
                        </td>
                        <td>
                            <code class="small text-muted font-monospace">@(log.IpAddress ?? "127.0.0.1")</code>
                        </td>
                        <td>
                            <div class="small text-dark text-truncate" style="max-width: 320px;" title="@log.Description">
                                @(log.Description ?? log.Action)
                            </div>
                        </td>
                        <td class="text-end">
                            <button type="button" 
                                    class="btn btn-sm btn-light border py-1 px-2 text-primary"
                                    data-log-id="@log.Id"
                                    data-log-action="@log.Action"
                                    data-log-timestamp="@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss UTC")"
                                    data-log-actor="@log.UserName"
                                    data-log-email="@(log.UserEmail ?? "N/A")"
                                    data-log-entity="@(log.EntityType ?? "SYSTEM")"
                                    data-log-entity-id="@(log.EntityId?.ToString() ?? "N/A")"
                                    data-log-ip="@(log.IpAddress ?? "127.0.0.1")"
                                    data-log-user-agent="@(log.UserAgent ?? "N/A")"
                                    data-log-description="@(log.Description ?? "")"
                                    data-log-old-values="@(log.OldValues ?? "")"
                                    data-log-new-values="@(log.NewValues ?? "")"
                                    onclick="openLogDetailsModalFromButton(this)"
                                    title="View Forensic Payload">
                                <i class="bi bi-search"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- =======================================================
         PAGINATION & RANGE SUMMARY
         ======================================================= -->
    @if (Model.TotalFilteredCount > 0)
    {
        <div class="p-3 bg-light border-top d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="small text-muted">
                Showing <strong>@(((Model.CurrentPage - 1) * Model.PageSize) + 1)</strong> to <strong>@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalFilteredCount))</strong> of <strong>@Model.TotalFilteredCount</strong> audit logs
            </div>
            
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Audit Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="AuditLogs" 
                               asp-route-page="@(Model.CurrentPage - 1)" 
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-search="@Model.SearchTerm" 
                               asp-route-entity="@Model.EntityFilter"
                               asp-route-timeframe="@Model.Timeframe">Previous</a>
                        </li>

                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            if (p == 1 || p == Model.TotalPages || (p >= Model.CurrentPage - 2 && p <= Model.CurrentPage + 2))
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="AuditLogs" 
                                       asp-route-page="@p" 
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-search="@Model.SearchTerm" 
                                       asp-route-entity="@Model.EntityFilter"
                                       asp-route-timeframe="@Model.Timeframe">@p</a>
                                </li>
                            }
                            else if (p == Model.CurrentPage - 3 || p == Model.CurrentPage + 3)
                            {
                                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                            }
                        }

                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="AuditLogs" 
                               asp-route-page="@(Model.CurrentPage + 1)" 
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-search="@Model.SearchTerm" 
                               asp-route-entity="@Model.EntityFilter"
                               asp-route-timeframe="@Model.Timeframe">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
</div>

<!-- =======================================================
     FORENSIC LOG DETAILS MODAL
     ======================================================= -->
<div class="modal fade" id="logDetailsModal" tabindex="-1" aria-labelledby="logDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="logDetailsModalLabel">
                    <i class="bi bi-shield-check me-2"></i>Forensic Audit Record Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="text-muted small fw-semibold">Action Identifier</label>
                        <div id="modalLogAction" class="font-monospace fw-bold text-primary fs-6"></div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small fw-semibold">Timestamp (UTC)</label>
                        <div id="modalLogTimestamp" class="font-monospace text-dark"></div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small fw-semibold">Actor / Admin</label>
                        <div id="modalLogActor" class="text-dark fw-semibold"></div>
                        <small id="modalLogEmail" class="text-muted"></small>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small fw-semibold">Entity Scope & ID</label>
                        <div id="modalLogEntity" class="font-monospace text-dark"></div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small fw-semibold">Client IP Address</label>
                        <div><code id="modalLogIp" class="text-dark"></code></div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small fw-semibold">User Agent / Device</label>
                        <div id="modalLogUserAgent" class="small text-muted font-monospace text-break"></div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="text-muted small fw-semibold">Audit Event Description</label>
                    <div id="modalLogDescription" class="p-3 bg-light rounded border text-dark font-monospace small"></div>
                </div>

                <div id="modalLogValuesSection" class="d-none">
                    <label class="text-muted small fw-semibold">State Payload Changes (Before / After)</label>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="small text-muted font-monospace">Old Values</label>
                            <pre id="modalLogOldValues" class="p-2 bg-light rounded border small text-break" style="max-height: 150px; overflow-y: auto;"></pre>
                        </div>
                        <div class="col-6">
                            <label class="small text-muted font-monospace">New Values</label>
                            <pre id="modalLogNewValues" class="p-2 bg-light rounded border small text-break" style="max-height: 150px; overflow-y: auto;"></pre>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openLogDetailsModalFromButton(button) {
            openLogDetailsModal(
                button.dataset.logId,
                button.dataset.logAction,
                button.dataset.logTimestamp,
                button.dataset.logActor,
                button.dataset.logEmail,
                button.dataset.logEntity,
                button.dataset.logEntityId,
                button.dataset.logIp,
                button.dataset.logUserAgent,
                button.dataset.logDescription,
                button.dataset.logOldValues,
                button.dataset.logNewValues
            );
        }

        function openLogDetailsModal(id, action, timestamp, actor, email, entity, entityId, ip, userAgent, description, oldValues, newValues) {
            document.getElementById('modalLogAction').innerText = action;
            document.getElementById('modalLogTimestamp').innerText = timestamp;
            document.getElementById('modalLogActor').innerText = actor;
            document.getElementById('modalLogEmail').innerText = email;
            document.getElementById('modalLogEntity').innerText = entity + (entityId !== 'N/A' ? ' #' + entityId : '');
            document.getElementById('modalLogIp').innerText = ip;
            document.getElementById('modalLogUserAgent').innerText = userAgent || 'N/A';
            document.getElementById('modalLogDescription').innerText = description || action;

            const valuesSec = document.getElementById('modalLogValuesSection');
            if ((oldValues && oldValues.trim() !== '') || (newValues && newValues.trim() !== '')) {
                valuesSec.classList.remove('d-none');
                document.getElementById('modalLogOldValues').innerText = oldValues || '(none)';
                document.getElementById('modalLogNewValues').innerText = newValues || '(none)';
            } else {
                valuesSec.classList.add('d-none');
            }

            var modal = new bootstrap.Modal(document.getElementById('logDetailsModal'));
            modal.show();
        }
    </script>
}
