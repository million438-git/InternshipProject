@model HawassaUnifiedCampusEventManagementSystem.Models.AdminFacultiesViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Faculties & Colleges Hierarchy";
}

<!-- =======================================================
     PAGE HEADER & CROSS-NAVIGATION TABS
     ======================================================= -->
<div class="admin-page-header d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-decoration-none">Admin Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Faculties & Colleges</li>
            </ol>
        </nav>
        <h1 class="h3 fw-bold text-dark mb-1">🏛️ University Academic Structure: Faculties & Colleges</h1>
        <p class="text-muted small mb-0">Manage university faculties, colleges, institutes, dean administration, and academic units.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 shadow-sm px-3" data-bs-toggle="modal" data-bs-target="#newFacultyModal">
            <i class="bi bi-plus-lg"></i>
            <span>Add Faculty / College</span>
        </button>
        <a asp-controller="Admin" asp-action="ExportFacultiesCsv" 
           asp-route-search="@Model.SearchTerm"
           class="btn btn-outline-success btn-sm d-inline-flex align-items-center gap-1 shadow-sm px-3"
           title="Export faculty roster to CSV spreadsheet">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>
            <span>Export CSV</span>
        </a>
    </div>
</div>

<!-- =======================================================
     HIERARCHY NAVIGATION TABS
     ======================================================= -->
<ul class="nav nav-pills mb-4 gap-2">
    <li class="nav-item">
        <a class="nav-link active fw-bold py-2 px-3 shadow-sm" asp-controller="Admin" asp-action="Faculties">
            <i class="bi bi-bank me-2"></i>Faculties & Colleges (@Model.TotalCount)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link bg-white border text-dark fw-semibold py-2 px-3" asp-controller="Admin" asp-action="Departments">
            <i class="bi bi-diagram-3 me-2 text-primary"></i>Academic Departments (@Model.TotalDepartmentsCount)
        </a>
    </li>
</ul>

<!-- =======================================================
     METRICS SUMMARY CARDS
     ======================================================= -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-primary-subtle text-primary"><i class="bi bi-bank"></i></div>
            <div>
                <div class="stat-num">@Model.TotalCount</div>
                <div class="stat-desc">Total Faculties & Colleges</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-success-subtle text-success"><i class="bi bi-check-circle"></i></div>
            <div>
                <div class="stat-num">@Model.ActiveCount</div>
                <div class="stat-desc">Active Academic Units</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-info-subtle text-info"><i class="bi bi-diagram-3"></i></div>
            <div>
                <div class="stat-num">@Model.TotalDepartmentsCount</div>
                <div class="stat-desc">Supervised Departments</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card h-100">
            <div class="stat-icon-box bg-warning-subtle text-warning-emphasis"><i class="bi bi-people-fill"></i></div>
            <div>
                <div class="stat-num">@Model.TotalStudentsCount</div>
                <div class="stat-desc">Enrolled Students & Staff</div>
            </div>
        </div>
    </div>
</div>

<!-- =======================================================
     FILTER & SEARCH BAR
     ======================================================= -->
<div class="admin-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-12 col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="search" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search faculty name, code, dean, email..." />
            </div>
        </div>

        <div class="col-6 col-md-3">
            <select name="sortBy" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="name_asc" selected="@(Model.SortBy == "name_asc" || string.IsNullOrEmpty(Model.SortBy))">Faculty Name (A-Z)</option>
                <option value="name_desc" selected="@(Model.SortBy == "name_desc")">Faculty Name (Z-A)</option>
                <option value="code" selected="@(Model.SortBy == "code")">Faculty Code</option>
                <option value="depts_desc" selected="@(Model.SortBy == "depts_desc")">Most Departments</option>
                <option value="newest" selected="@(Model.SortBy == "newest")">Newest Added</option>
            </select>
        </div>

        <div class="col-6 col-md-2">
            <select name="pageSize" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="10" selected="@(Model.PageSize == 10)">10 per page</option>
                <option value="20" selected="@(Model.PageSize == 20)">20 per page</option>
                <option value="50" selected="@(Model.PageSize == 50)">50 per page</option>
            </select>
        </div>

        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary flex-grow-1">Filter</button>
            <a asp-controller="Admin" asp-action="Faculties" class="btn btn-sm btn-light border" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<!-- =======================================================
     FACULTIES TABLE
     ======================================================= -->
<div class="admin-card overflow-hidden">
    <div class="table-responsive">
        <table class="table admin-table align-middle mb-0" id="facultiesTable">
            <thead>
                <tr>
                    <th>Faculty / College Name</th>
                    <th>Code</th>
                    <th>Dean of Faculty</th>
                    <th>Official Email</th>
                    <th>Academic Units</th>
                    <th>Enrolled Users</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Faculties.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-bank fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            <h5 class="fw-bold text-dark mb-1">No Faculties Found</h5>
                            <p class="small text-muted mb-3">No university faculties match your search query.</p>
                            <a asp-controller="Admin" asp-action="Faculties" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Filter
                            </a>
                        </td>
                    </tr>
                }
                @foreach (var f in Model.Faculties)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-dark fs-6">@f.Name</div>
                            <span class="text-muted small">Faculty ID: #@f.Id</span>
                        </td>
                        <td>
                            <span class="badge bg-secondary-subtle text-dark border font-monospace px-2 py-1">@(f.Code ?? "N/A")</span>
                        </td>
                        <td>
                            <div class="small fw-semibold text-dark">
                                <i class="bi bi-person-badge me-1 text-primary"></i>@(f.DeanName ?? "Not Appointed")
                            </div>
                        </td>
                        <td class="text-muted small">@(f.Email ?? "N/A")</td>
                        <td>
                            <a asp-controller="Admin" asp-action="Departments" asp-route-facultyId="@f.Id" class="badge bg-primary-subtle text-primary border border-primary-subtle text-decoration-none py-1 px-2">
                                <i class="bi bi-diagram-3 me-1"></i>@f.DepartmentCount Departments
                            </a>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border"><i class="bi bi-people me-1 text-success"></i>@f.EnrolledUsersCount Users</span>
                        </td>
                        <td>
                            @if (f.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle py-1 px-2 rounded-pill">
                                    <i class="bi bi-check-circle-fill me-1"></i>Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border py-1 px-2 rounded-pill">
                                    Inactive
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="dropdown d-inline-block">
                                <button class="btn btn-sm btn-light border dropdown-toggle py-1 px-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Manage
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <a asp-controller="Admin" asp-action="Departments" asp-route-facultyId="@f.Id" class="dropdown-item">
                                            <i class="bi bi-diagram-3 me-2 text-primary"></i>View Departments
                                        </a>
                                    </li>
                                    <li>
                                        <button type="button" class="dropdown-item" onclick="openEditFacultyModal('@f.Id', '@f.Name', '@f.Code', '@f.DeanName', '@f.Email', '@f.IsActive')">
                                            <i class="bi bi-pencil me-2 text-info"></i>Edit Faculty
                                        </button>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Admin" asp-action="FacultyDelete" method="post" onsubmit="return confirm('Delete faculty @f.Name? Child departments will be reassigned or unlinked.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@f.Id" />
                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Delete Faculty</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- =======================================================
         PAGINATION & RANGE SUMMARY
         ======================================================= -->
    @if (Model.TotalFilteredCount > 0)
    {
        <div class="p-3 bg-light border-top d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="small text-muted">
                Showing <strong>@(((Model.CurrentPage - 1) * Model.PageSize) + 1)</strong> to <strong>@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalFilteredCount))</strong> of <strong>@Model.TotalFilteredCount</strong> faculties
            </div>
            
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Faculties Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Faculties" 
                               asp-route-page="@(Model.CurrentPage - 1)" 
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-search="@Model.SearchTerm" 
                               asp-route-sortBy="@Model.SortBy">Previous</a>
                        </li>

                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            if (p == 1 || p == Model.TotalPages || (p >= Model.CurrentPage - 2 && p <= Model.CurrentPage + 2))
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Faculties" 
                                       asp-route-page="@p" 
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-search="@Model.SearchTerm" 
                                       asp-route-sortBy="@Model.SortBy">@p</a>
                                </li>
                            }
                            else if (p == Model.CurrentPage - 3 || p == Model.CurrentPage + 3)
                            {
                                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                            }
                        }

                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Faculties" 
                               asp-route-page="@(Model.CurrentPage + 1)" 
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-search="@Model.SearchTerm" 
                               asp-route-sortBy="@Model.SortBy">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
</div>

<!-- =======================================================
     ADD FACULTY MODAL
     ======================================================= -->
<div class="modal fade" id="newFacultyModal" tabindex="-1" aria-labelledby="newFacultyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="newFacultyModalLabel"><i class="bi bi-bank me-2"></i>Add Faculty / College</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Admin" asp-action="FacultyCreate" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Faculty / College Name *</label>
                        <input type="text" name="name" class="form-control form-control-sm" required placeholder="e.g. College of Natural and Computational Sciences" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Code / Acronym</label>
                        <input type="text" name="code" class="form-control form-control-sm font-monospace" placeholder="e.g. CNCS" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Dean of Faculty</label>
                        <input type="text" name="deanName" class="form-control form-control-sm" placeholder="e.g. Dr. Abebe Kebede" />
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-dark">Official Email</label>
                            <input type="email" name="email" class="form-control form-control-sm" placeholder="cncs@hu.edu.et" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-dark">Phone Number</label>
                            <input type="tel" name="phone" class="form-control form-control-sm" placeholder="+251 46 220 1234" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-3 fw-semibold">Save Faculty</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- =======================================================
     EDIT FACULTY MODAL
     ======================================================= -->
<div class="modal fade" id="editFacultyModal" tabindex="-1" aria-labelledby="editFacultyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="editFacultyModalLabel"><i class="bi bi-pencil-square me-2"></i>Edit Faculty Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Admin" asp-action="FacultyEdit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editFacultyId" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Faculty Name *</label>
                        <input type="text" name="name" id="editFacultyName" class="form-control form-control-sm" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Code / Acronym</label>
                        <input type="text" name="code" id="editFacultyCode" class="form-control form-control-sm font-monospace" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Dean of Faculty</label>
                        <input type="text" name="deanName" id="editFacultyDean" class="form-control form-control-sm" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Official Email</label>
                        <input type="email" name="email" id="editFacultyEmail" class="form-control form-control-sm" />
                    </div>
                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" name="isActive" id="editFacultyActive" value="true" />
                        <label class="form-check-label small fw-semibold text-dark" for="editFacultyActive">Academic Unit is Active</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-3 fw-semibold">Update Faculty</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditFacultyModal(id, name, code, dean, email, isActive) {
            document.getElementById('editFacultyId').value = id;
            document.getElementById('editFacultyName').value = name;
            document.getElementById('editFacultyCode').value = code || '';
            document.getElementById('editFacultyDean').value = dean || '';
            document.getElementById('editFacultyEmail').value = email || '';
            document.getElementById('editFacultyActive').checked = isActive === 'True' || isActive === true;

            var modal = new bootstrap.Modal(document.getElementById('editFacultyModal'));
            modal.show();
        }
    </script>
}
