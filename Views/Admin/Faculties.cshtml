@model HawassaUnifiedCampusEventManagementSystem.Models.AdminFacultiesViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Faculty Management";
}

<div class="admin-page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">Faculty & College Management</h1>
        <p class="text-muted small mb-0">Manage university faculties, colleges, institute divisions, and dean administration.</p>
    </div>
    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#newFacultyModal">
        <i class="bi bi-plus-lg"></i>
        <span>Add Faculty</span>
    </button>
</div>

<!-- =======================================================
     FACULTIES TABLE
     ======================================================= -->
<div class="admin-card overflow-hidden">
    <div class="table-responsive">
        <table class="table admin-table" id="facultiesTable">
            <thead>
                <tr>
                    <th>Faculty / College Name</th>
                    <th>Code</th>
                    <th>Dean of Faculty</th>
                    <th>Official Email</th>
                    <th>Departments</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model.Faculties)
                {
                    <tr>
                        <td class="fw-bold text-dark">@f.Name</td>
                        <td><span class="badge bg-secondary-subtle text-secondary font-monospace">@(f.Code ?? "N/A")</span></td>
                        <td>@(f.DeanName ?? "Not Assigned")</td>
                        <td class="text-muted small">@(f.Email ?? "N/A")</td>
                        <td>
                            <span class="badge bg-primary-subtle text-primary">@f.DepartmentCount Departments</span>
                        </td>
                        <td>
                            @if (f.IsActive)
                            {
                                <span class="badge-status badge-active">Active</span>
                            }
                            else
                            {
                                <span class="badge-status badge-suspended">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <button type="button" 
                                    class="btn btn-sm btn-light border text-primary py-1 px-2 me-1" 
                                    data-bs-toggle="modal" 
                                    data-bs-target="#editFacultyModal_@f.Id" 
                                    title="Edit Faculty">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <form asp-controller="Admin" asp-action="FacultyDelete" asp-route-id="@f.Id" method="post" class="d-inline" onsubmit="return confirm('Delete faculty \'@f.Name\'? Associated departments will be safely reassigned.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-light border text-danger py-1 px-2" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>

                            <!-- EDIT FACULTY MODAL -->
                            <div class="modal fade text-start" id="editFacultyModal_@f.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow">
                                        <div class="modal-header">
                                            <h5 class="modal-title fw-bold"><i class="bi bi-pencil me-1 text-primary"></i>Edit Faculty / College</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <form asp-controller="Admin" asp-action="FacultyEdit" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@f.Id" />
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Faculty / College Name</label>
                                                    <input type="text" name="name" class="form-control form-control-sm" required value="@f.Name" />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Faculty Code</label>
                                                    <input type="text" name="code" class="form-control form-control-sm" value="@f.Code" />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Dean Name</label>
                                                    <input type="text" name="deanName" class="form-control form-control-sm" value="@f.DeanName" />
                                                </div>
                                                <div class="row g-2 mb-3">
                                                    <div class="col-6">
                                                        <label class="form-label small fw-semibold">Email</label>
                                                        <input type="email" name="email" class="form-control form-control-sm" value="@f.Email" />
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label small fw-semibold">Status</label>
                                                        <select name="isActive" class="form-select form-select-sm">
                                                            <option value="true" selected="@(f.IsActive)">Active</option>
                                                            <option value="false" selected="@(!f.IsActive)">Inactive</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-sm btn-primary px-3">Save Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- =======================================================
     ADD FACULTY MODAL
     ======================================================= -->
<div class="modal fade" id="newFacultyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-bank me-1 text-primary"></i>Add University Faculty</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Admin" asp-action="FacultyCreate" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Faculty / College Name</label>
                        <input type="text" name="name" class="form-control form-control-sm" required placeholder="e.g. Faculty of Informatics & Technology" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Faculty Code</label>
                        <input type="text" name="code" class="form-control form-control-sm" placeholder="e.g. FIT" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Dean Name</label>
                        <input type="text" name="deanName" class="form-control form-control-sm" placeholder="e.g. Dr. Martha Tadesse" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Email</label>
                            <input type="email" name="email" class="form-control form-control-sm" placeholder="dean.fit@hawassa.edu.et" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Phone</label>
                            <input type="tel" name="phone" class="form-control form-control-sm" placeholder="+251 46 XXX XXXX" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary px-3">Add Faculty</button>
                </div>
            </form>
        </div>
    </div>
</div>
