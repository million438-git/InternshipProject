@{
    ViewData["Title"] = "About HUCEMS - Hawassa University";
}

<div class="bg-primary text-white py-5 mb-5" style="background: linear-gradient(135deg, #091e42 0%, #0f2d59 60%, #1e3a8a 100%) !important;">
    <div class="container py-3">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-white text-primary fw-bold px-3 py-2 rounded-pill mb-3">
                    <i class="bi bi-bank me-1"></i> Hawassa University Institutional Platform
                </span>
                <h1 class="display-5 fw-bold mb-3">About HUCEMS</h1>
                <p class="lead text-white-50 mb-0" style="max-width: 650px;">
                    The Hawassa Unified Campus Event Management System coordinates academic symposiums, research conferences, student activities, and auditorium reservations across all university campuses.
                </p>
            </div>
            <div class="col-lg-4 text-center d-none d-lg-block">
                <img src="~/images/hawassa-logo.png" alt="Hawassa University Crest" style="width: 140px; height: 140px; object-fit: contain; filter: drop-shadow(0 4px 12px rgba(0,0,0,0.3));" />
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    <!-- MISSION & VISION ROW -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-3 mb-3" style="width: 48px; height: 48px;">
                    <i class="bi bi-mortarboard fs-4"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">Academic Excellence</h4>
                <p class="text-muted small mb-0" style="line-height: 1.6;">
                    Centralizing university-wide research symposiums, departmental workshops, defense schedules, and guest lectures for students and scholars.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-success-subtle text-success rounded-3 mb-3" style="width: 48px; height: 48px;">
                    <i class="bi bi-people fs-4"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">Vibrant Student Life</h4>
                <p class="text-muted small mb-0" style="line-height: 1.6;">
                    Empowering student clubs, cultural associations, athletic teams, and community service organizations to organize approved campus events.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-info-subtle text-info-emphasis rounded-3 mb-3" style="width: 48px; height: 48px;">
                    <i class="bi bi-building-check fs-4"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">Resource Governance</h4>
                <p class="text-muted small mb-0" style="line-height: 1.6;">
                    Streamlining auditorium allocations, equipment availability, and administrative clearance across all 8 major university facilities.
                </p>
            </div>
        </div>
    </div>

    <!-- UNIVERSITY CAMPUSES -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5 mb-5 bg-light">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <span class="text-primary fw-bold text-uppercase small tracking-wide">Institutional Scope</span>
                <h3 class="fw-bold text-dark mb-3">Serving Hawassa University Campuses</h3>
                <p class="text-secondary mb-4" style="line-height: 1.6;">
                    Established as one of Ethiopia's premier higher education institutions, Hawassa University operates multiple specialized campuses. HUCEMS provides unified scheduling and event administration for:
                </p>
                <div class="row g-2">
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-2 p-2 bg-white rounded-3 border">
                            <i class="bi bi-geo-alt-fill text-danger"></i>
                            <span class="small fw-semibold">Main Campus</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-2 p-2 bg-white rounded-3 border">
                            <i class="bi bi-geo-alt-fill text-danger"></i>
                            <span class="small fw-semibold">Institute of Technology (IoT)</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-2 p-2 bg-white rounded-3 border">
                            <i class="bi bi-geo-alt-fill text-danger"></i>
                            <span class="small fw-semibold">College of Medicine & Health</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-2 p-2 bg-white rounded-3 border">
                            <i class="bi bi-geo-alt-fill text-danger"></i>
                            <span class="small fw-semibold">College of Agriculture (Wondo)</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="bg-white p-4 rounded-4 border shadow-sm">
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-shield-lock-fill text-primary me-2"></i>Institutional Access Policy</h5>
                    <p class="small text-muted mb-3" style="line-height: 1.6;">
                        To maintain event safety and coordinate campus venues, users register with university credentials for administrative verification. Once reviewed, accounts receive full access to host symposiums, reserve facilities, and participate in campus activities.
                    </p>
                    <div class="d-flex gap-2">
                        <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-primary px-3 rounded-pill">Register Account</a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-secondary px-3 rounded-pill">Sign In</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
