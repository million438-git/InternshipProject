
@{
    ViewData["Title"] = "About HUCEMS";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />

<main class="about-page">

    <!-- HERO SECTION -->
    <section class="about-hero">
        <div class="hero-background"></div>

        <div class="container about-hero-content">
            <div class="hero-badge d-inline-flex align-items-center gap-2">
                <img src="~/images/hawassa-logo.png" alt="Hawassa University Crest" style="width: 24px; height: 24px; object-fit: contain; border-radius: 50%;" />
                <span>Hawassa Unified Campus Event Management System</span>
            </div>

            <h1>
                Connecting Campus.
                <span>Creating Experiences.</span>
                Building Community.
            </h1>

            <p>
                HUCEMS is a centralized digital platform designed to help
                universities and campus communities discover, organize,
                manage, and participate in campus events efficiently.
            </p>

            <div class="hero-actions">
                <a asp-controller="Home" asp-action="Index" class="btn-primary">
                    <span>Explore Platform</span>
                    <i class="bi bi-arrow-right"></i>
                </a>

                <a asp-controller="Home" asp-action="Contact" class="btn-secondary">
                    Contact Us
                </a>
            </div>
        </div>

        <div class="hero-scroll">
            <span>Discover HUCEMS</span>
            <i class="bi bi-chevron-down"></i>
        </div>
    </section>


    <!-- INTRODUCTION -->
    <section class="about-intro section-padding">
        <div class="container">
            <div class="section-heading center-heading">
                <span class="section-label">ABOUT THE PLATFORM</span>
                <h2>One Platform for the Entire Campus</h2>
                <p>
                    HUCEMS brings campus events, announcements, organizations,
                    students, staff, and administrators together in one
                    organized digital environment.
                </p>
            </div>

            <div class="intro-grid">

                <div class="intro-card">
                    <div class="intro-icon">
                        <i class="bi bi-calendar-event"></i>
                    </div>

                    <h3>Event Management</h3>

                    <p>
                        Create, organize, publish, update, and manage campus
                        events from one centralized platform.
                    </p>
                </div>

                <div class="intro-card">
                    <div class="intro-icon">
                        <i class="bi bi-people"></i>
                    </div>

                    <h3>Campus Community</h3>

                    <p>
                        Help students, instructors, clubs, organizations,
                        and campus communities connect around meaningful
                        activities.
                    </p>
                </div>

                <div class="intro-card">
                    <div class="intro-icon">
                        <i class="bi bi-megaphone"></i>
                    </div>

                    <h3>Announcements</h3>

                    <p>
                        Share important campus announcements and information
                        with the right people at the right time.
                    </p>
                </div>

            </div>
        </div>
    </section>


    <!-- MISSION / VISION -->
    <section class="mission-section section-padding">
        <div class="container">

            <div class="mission-grid">

                <div class="mission-content">
                    <span class="section-label">OUR PURPOSE</span>

                    <h2>
                        Making Campus Life
                        <span>More Connected.</span>
                    </h2>

                    <p>
                        Universities generate thousands of activities,
                        meetings, seminars, workshops, competitions, clubs,
                        academic events, and social programs.
                    </p>

                    <p>
                        HUCEMS provides a structured digital environment where
                        these activities can be discovered and managed without
                        relying on disconnected communication channels.
                    </p>

                    <div class="mission-points">

                        <div class="mission-point">
                            <span class="point-icon">
                                <i class="bi bi-check-lg"></i>
                            </span>

                            <div>
                                <strong>Centralized Information</strong>
                                <p>
                                    Keep campus event information organized
                                    and accessible.
                                </p>
                            </div>
                        </div>

                        <div class="mission-point">
                            <span class="point-icon">
                                <i class="bi bi-check-lg"></i>
                            </span>

                            <div>
                                <strong>Better Communication</strong>
                                <p>
                                    Connect students, staff, organizations,
                                    and administrators.
                                </p>
                            </div>
                        </div>

                        <div class="mission-point">
                            <span class="point-icon">
                                <i class="bi bi-check-lg"></i>
                            </span>

                            <div>
                                <strong>Efficient Management</strong>
                                <p>
                                    Reduce manual processes and simplify
                                    event coordination.
                                </p>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="mission-visual">

                    <div class="visual-card main-visual-card">
                        <div class="visual-top">
                            <span class="status-indicator"></span>
                            <span>Campus Activity</span>
                        </div>

                        <div class="visual-calendar">
                            <div class="calendar-header">
                                <span>Campus Events</span>
                                <i class="bi bi-calendar3"></i>
                            </div>

                            <div class="event-row">
                                <div class="event-date">
                                    <strong>15</strong>
                                    <small>SEP</small>
                                </div>

                                <div>
                                    <strong>Technology Seminar</strong>
                                    <small>Hawassa University</small>
                                </div>
                            </div>

                            <div class="event-row">
                                <div class="event-date">
                                    <strong>20</strong>
                                    <small>SEP</small>
                                </div>

                                <div>
                                    <strong>Student Innovation Day</strong>
                                    <small>University Campus</small>
                                </div>
                            </div>

                            <div class="event-row">
                                <div class="event-date">
                                    <strong>25</strong>
                                    <small>SEP</small>
                                </div>

                                <div>
                                    <strong>Career Development Forum</strong>
                                    <small>Student Center</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="floating-card floating-card-one">
                        <i class="bi bi-people-fill"></i>
                        <div>
                            <strong>Community</strong>
                            <span>Connected</span>
                        </div>
                    </div>

                    <div class="floating-card floating-card-two">
                        <i class="bi bi-calendar-check"></i>
                        <div>
                            <strong>Events</strong>
                            <span>Organized</span>
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </section>


    <!-- FEATURES -->
    <section class="features-section section-padding">
        <div class="container">

            <div class="section-heading center-heading">
                <span class="section-label">WHAT WE PROVIDE</span>

                <h2>
                    Built for a Modern Campus
                </h2>

                <p>
                    HUCEMS combines event management, communication,
                    community interaction, and administrative tools into
                    one unified platform.
                </p>
            </div>

            <div class="features-grid">

                <article class="feature-card">
                    <div class="feature-number">01</div>

                    <div class="feature-icon">
                        <i class="bi bi-calendar2-week"></i>
                    </div>

                    <h3>Event Discovery</h3>

                    <p>
                        Discover upcoming academic, social, technological,
                        cultural, sports, and organizational events.
                    </p>
                </article>


                <article class="feature-card">
                    <div class="feature-number">02</div>

                    <div class="feature-icon">
                        <i class="bi bi-calendar-plus"></i>
                    </div>

                    <h3>Event Creation</h3>

                    <p>
                        Authorized users can create events with schedules,
                        locations, descriptions, attachments, and other
                        important information.
                    </p>
                </article>


                <article class="feature-card">
                    <div class="feature-number">03</div>

                    <div class="feature-icon">
                        <i class="bi bi-bell"></i>
                    </div>

                    <h3>Notifications</h3>

                    <p>
                        Keep users informed about important event changes,
                        announcements, reminders, and campus activities.
                    </p>
                </article>


                <article class="feature-card">
                    <div class="feature-number">04</div>

                    <div class="feature-icon">
                        <i class="bi bi-chat-dots"></i>
                    </div>

                    <h3>Community Interaction</h3>

                    <p>
                        Encourage communication and interaction between
                        members of the campus community.
                    </p>
                </article>


                <article class="feature-card">
                    <div class="feature-number">05</div>

                    <div class="feature-icon">
                        <i class="bi bi-shield-lock"></i>
                    </div>

                    <h3>Security & Permissions</h3>

                    <p>
                        Role-based access and permission management help
                        protect important campus information.
                    </p>
                </article>


                <article class="feature-card">
                    <div class="feature-number">06</div>

                    <div class="feature-icon">
                        <i class="bi bi-bar-chart"></i>
                    </div>

                    <h3>Administration</h3>

                    <p>
                        Administrators can manage users, events,
                        announcements, organizations, and platform activity.
                    </p>
                </article>

            </div>
        </div>
    </section>


    <!-- WHO IS IT FOR -->
    <section class="users-section section-padding">
        <div class="container">

            <div class="section-heading">
                <span class="section-label">FOR THE CAMPUS COMMUNITY</span>

                <h2>
                    Designed for Everyone
                </h2>

                <p>
                    HUCEMS supports different members of the university
                    ecosystem through appropriate tools and permissions.
                </p>
            </div>

            <div class="users-grid">

                <div class="user-card">
                    <div class="user-icon">
                        <i class="bi bi-mortarboard"></i>
                    </div>

                    <h3>Students</h3>

                    <p>
                        Find events, discover opportunities, participate in
                        activities, and stay connected with campus life.
                    </p>

                    <span class="user-link">
                        Student Experience
                        <i class="bi bi-arrow-right"></i>
                    </span>
                </div>


                <div class="user-card">
                    <div class="user-icon">
                        <i class="bi bi-person-workspace"></i>
                    </div>

                    <h3>Staff & Instructors</h3>

                    <p>
                        Organize academic activities, workshops, seminars,
                        meetings, and other university programs.
                    </p>

                    <span class="user-link">
                        Academic Community
                        <i class="bi bi-arrow-right"></i>
                    </span>
                </div>


                <div class="user-card">
                    <div class="user-icon">
                        <i class="bi bi-building"></i>
                    </div>

                    <h3>Organizations</h3>

                    <p>
                        Campus clubs and organizations can promote activities
                        and connect with interested participants.
                    </p>

                    <span class="user-link">
                        Organizations
                        <i class="bi bi-arrow-right"></i>
                    </span>
                </div>


                <div class="user-card">
                    <div class="user-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <h3>Administrators</h3>

                    <p>
                        Manage the platform, users, permissions, events,
                        announcements, and campus-wide information.
                    </p>

                    <span class="user-link">
                        Administration
                        <i class="bi bi-arrow-right"></i>
                    </span>
                </div>

            </div>
        </div>
    </section>


    <!-- VALUES -->
    <section class="values-section section-padding">

        <div class="container">

            <div class="values-grid">

                <div class="values-heading">
                    <span class="section-label">OUR VALUES</span>

                    <h2>
                        Technology With
                        <span>Purpose.</span>
                    </h2>

                    <p>
                        HUCEMS is built around principles that encourage
                        accessibility, collaboration, responsibility,
                        innovation, and secure digital interaction.
                    </p>
                </div>

                <div class="values-list">

                    <div class="value-item">
                        <span class="value-icon">
                            <i class="bi bi-lightbulb"></i>
                        </span>

                        <div>
                            <h3>Innovation</h3>
                            <p>
                                Using technology to create better ways of
                                organizing and experiencing campus life.
                            </p>
                        </div>
                    </div>

                    <div class="value-item">
                        <span class="value-icon">
                            <i class="bi bi-people"></i>
                        </span>

                        <div>
                            <h3>Community</h3>
                            <p>
                                Building stronger connections between people
                                and organizations.
                            </p>
                        </div>
                    </div>

                    <div class="value-item">
                        <span class="value-icon">
                            <i class="bi bi-universal-access"></i>
                        </span>

                        <div>
                            <h3>Accessibility</h3>
                            <p>
                                Making important campus information easier to
                                discover and access.
                            </p>
                        </div>
                    </div>

                    <div class="value-item">
                        <span class="value-icon">
                            <i class="bi bi-lock"></i>
                        </span>

                        <div>
                            <h3>Security</h3>
                            <p>
                                Protecting users, information, and platform
                                functionality through responsible access
                                control.
                            </p>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- STATISTICS -->
    <section class="stats-section">
        <div class="container">

            <div class="stats-grid">

                <div class="stat-item">
                    <span class="stat-number" data-target="1">0</span>
                    <span class="stat-plus">+</span>
                    <p>Unified Platform</p>
                </div>

                <div class="stat-item">
                    <span class="stat-number" data-target="6">0</span>
                    <span class="stat-plus">+</span>
                    <p>Core Features</p>
                </div>

                <div class="stat-item">
                    <span class="stat-number" data-target="4">0</span>
                    <span class="stat-plus">+</span>
                    <p>User Groups</p>
                </div>

                <div class="stat-item">
                    <span class="stat-number" data-target="24">0</span>
                    <span class="stat-plus">/7</span>
                    <p>Digital Access</p>
                </div>

            </div>

        </div>
    </section>


    <!-- FUTURE -->
    <section class="future-section section-padding">

        <div class="container">

            <div class="future-content">

                <span class="section-label">THE FUTURE</span>

                <h2>
                    Building the Future of
                    <span>Campus Digital Experience</span>
                </h2>

                <p>
                    HUCEMS is designed to grow with the campus community.
                    Future improvements can introduce smarter event
                    recommendations, advanced analytics, mobile experiences,
                    intelligent notifications, integrations, and additional
                    digital services.
                </p>

                <div class="future-actions">

                    <a asp-controller="Home" asp-action="Index" class="btn-primary">
                        Start Exploring
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- CTA -->
    <section class="about-cta">

        <div class="container">

            <div class="cta-content">

                <div class="cta-icon">
                    <i class="bi bi-calendar-heart"></i>
                </div>

                <div class="cta-text">
                    <span>READY TO GET STARTED?</span>

                    <h2>
                        Be Part of the Campus Community
                    </h2>

                    <p>
                        Discover events, connect with people, and participate
                        in the activities that make campus life meaningful.
                    </p>
                </div>

                <div class="cta-action">
                    <a asp-controller="Home" asp-action="Index" class="btn-light">
                        Explore Events
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

            </div>

        </div>

    </section>

</main>

<script src="~/js/about.js" asp-append-version="true"></script>

