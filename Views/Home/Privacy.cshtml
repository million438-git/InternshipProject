@{
    ViewData["Title"] = "Data Privacy & Terms | Hawassa University";
}

<!-- PAGE HEADER -->
<div class="bg-primary text-white py-5 mb-5" style="background: linear-gradient(135deg, #091e42 0%, #0f2d59 60%, #1e3a8a 100%) !important;">
    <div class="container py-3">
        <span class="badge bg-white text-primary fw-bold px-3 py-2 rounded-pill mb-3">
            <i class="bi bi-shield-check me-1"></i> Institutional Governance & Compliance
        </span>
        <h1 class="display-5 fw-bold mb-2">Privacy & Data Governance Policy</h1>
        <p class="lead text-white-50 mb-0" style="max-width: 650px;">
            Guidelines regarding user data collection, academic record protection, and responsible platform utilization for Hawassa University.
        </p>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
                <div class="d-flex align-items-center justify-content-between pb-3 border-bottom mb-4">
                    <div>
                        <h4 class="fw-bold text-dark mb-0">Hawassa University Event Platform Policy</h4>
                        <span class="small text-muted">Version 2.0 • Effective Date: January 2026</span>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                        Official Policy
                    </span>
                </div>

                <div class="privacy-content" style="line-height: 1.7; color: #334155;">
                    <h5 class="fw-bold text-dark mt-3 mb-2">1. Scope and Application</h5>
                    <p class="small text-secondary">
                        This policy applies to all students, academic faculty, administrative staff, student club representatives, and visitors accessing the Hawassa Unified Campus Event Management System (HUCEMS).
                    </p>

                    <h5 class="fw-bold text-dark mt-4 mb-2">2. Information Collection & Usage</h5>
                    <p class="small text-secondary">
                        HUCEMS collects and processes account credentials (university email, official full name, department/faculty affiliation, and student/employee ID) strictly for identity verification, event registration, auditorium reservation workflows, and official campus communications.
                    </p>

                    <h5 class="fw-bold text-dark mt-4 mb-2">3. Role-Based Access Governance</h5>
                    <p class="small text-secondary">
                        User accounts are created and verified through institutional administrative provisioning. Account privileges are assigned based on institutional roles (Student, Faculty, Staff, Organization Coordinator, Administrator, and SuperAdmin).
                    </p>

                    <h5 class="fw-bold text-dark mt-4 mb-2">4. Event RSVPs & Attendance Records</h5>
                    <p class="small text-secondary">
                        When an attendee RSVPs for a university event, attendance records and digital check-ins are retained to facilitate certificate issuance, venue capacity adherence, and department reporting.
                    </p>

                    <h5 class="fw-bold text-dark mt-4 mb-2">5. Data Protection & Security</h5>
                    <p class="small text-secondary">
                        All passwords are encrypted using secure PBKDF2 cryptographic hashing. Authentication sessions utilize encrypted HTTP-only cookies and signed JWT tokens to prevent unauthorized account access.
                    </p>

                    <h5 class="fw-bold text-dark mt-4 mb-2" id="terms">6. Terms of Service & Usage Conduct</h5>
                    <p class="small text-secondary">
                        By accessing HUCEMS, users agree to abide by Hawassa University student and faculty codes of conduct. Venue reservations and published events are subject to institutional approval and must serve academic, cultural, athletic, or student development objectives. Misuse of platform privileges, unauthorized ticket reservation scripts, or dissemination of misleading content is strictly prohibited.
                    </p>

                    <h5 class="fw-bold text-dark mt-4 mb-2">7. Contact for Privacy & Policy Inquiries</h5>
                    <p class="small text-secondary mb-0">
                        For questions regarding personal data, account status, or institutional policies, please reach out to the <strong>ICT Directorate & Campus Administration Desk</strong> via the <a asp-controller="Home" asp-action="Contact" class="text-primary fw-semibold">Contact & Support Desk</a>.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>