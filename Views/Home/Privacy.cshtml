@{
    ViewData["Title"] = "Data Privacy & Governance Policy | HUCEMS";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/privacy.css" asp-append-version="true" />
    <style>
        /* Scoped High-Contrast Styling for Privacy Page */
        .hucems-privacy-wrapper {
            background-color: var(--bg-body, #f8fafc);
            color: var(--text-main, #0f172a);
            min-height: calc(100vh - 140px);
            padding-bottom: 70px;
        }

        .privacy-hero-banner {
            background: linear-gradient(135deg, #090d16 0%, #1e1b4b 50%, #4338ca 100%);
            color: #ffffff !important;
            padding: 55px 0 65px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.12);
            position: relative;
            overflow: hidden;
        }

        .privacy-hero-banner * {
            color: #ffffff;
        }

        .privacy-hero-banner::after {
            content: "";
            position: absolute;
            right: -60px;
            bottom: -60px;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(6, 182, 212, 0.2) 0%, rgba(79, 70, 229, 0) 70%);
            pointer-events: none;
        }

        .privacy-badge-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 16px;
            border-radius: 30px;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            font-size: 0.82rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .privacy-header-title {
            font-family: 'Outfit', sans-serif;
            font-size: clamp(2rem, 4vw, 3rem);
            font-weight: 800;
            letter-spacing: -0.02em;
            margin: 14px 0 10px;
            line-height: 1.15;
        }

        .privacy-header-desc {
            font-size: 1.05rem;
            color: rgba(255, 255, 255, 0.8) !important;
            max-width: 720px;
            line-height: 1.6;
        }

        .privacy-meta-tags {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 12px;
            margin-top: 20px;
        }

        .meta-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 14px;
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            font-size: 0.82rem;
            font-weight: 600;
        }

        /* Pillars Grid */
        .pillar-card {
            background: var(--bg-card, #ffffff);
            border: 1px solid var(--border-color, #e2e8f0);
            border-radius: 16px;
            padding: 24px;
            height: 100%;
            box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .pillar-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 24px rgba(79, 70, 229, 0.1);
            border-color: #6366f1;
        }

        .pillar-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            margin-bottom: 14px;
        }

        /* Main Policy Card */
        .policy-card-item {
            background: var(--bg-card, #ffffff);
            border: 1px solid var(--border-color, #e2e8f0);
            border-radius: 18px;
            padding: clamp(24px, 3.5vw, 36px);
            margin-bottom: 24px;
            box-shadow: 0 4px 18px rgba(15, 23, 42, 0.03);
            scroll-margin-top: 100px;
        }

        [data-theme="dark"] .pillar-card,
        [data-theme="dark"] .policy-card-item,
        [data-theme="dark"] .toc-sticky-box {
            background-color: #121c32 !important;
            border-color: #1e2e4f !important;
            color: #f8fafc !important;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3) !important;
        }

        [data-theme="dark"] .policy-card-item h2,
        [data-theme="dark"] .policy-card-item h3,
        [data-theme="dark"] .policy-card-item h4,
        [data-theme="dark"] .pillar-card h3 {
            color: #f8fafc !important;
        }

        [data-theme="dark"] .policy-card-item p,
        [data-theme="dark"] .pillar-card p {
            color: #94a3b8 !important;
        }

        .policy-item-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 18px;
            padding-bottom: 14px;
            border-bottom: 1px solid var(--border-color, #e2e8f0);
        }

        .policy-index-badge {
            width: 36px;
            height: 36px;
            min-width: 36px;
            border-radius: 10px;
            background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%);
            color: #ffffff;
            font-weight: 800;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .policy-item-title {
            font-family: 'Outfit', sans-serif;
            font-size: 1.3rem;
            font-weight: 800;
            color: var(--text-main, #0f172a);
            margin: 0;
        }

        .policy-bullet-list {
            list-style: none;
            padding: 0;
            margin: 16px 0;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .policy-bullet-list li {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .policy-bullet-list li i {
            color: #10b981;
            font-size: 1.1rem;
            margin-top: 2px;
            flex-shrink: 0;
        }

        /* Callout Box */
        .policy-callout {
            border-radius: 12px;
            padding: 16px 18px;
            margin: 18px 0;
            border: 1px solid rgba(79, 70, 229, 0.2);
            background: rgba(79, 70, 229, 0.05);
            display: flex;
            gap: 14px;
            align-items: flex-start;
        }

        [data-theme="dark"] .policy-callout {
            background: rgba(99, 102, 241, 0.1);
            border-color: rgba(99, 102, 241, 0.25);
        }

        /* Rights Grid */
        .rights-box-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 14px;
            margin-top: 18px;
        }

        .right-box {
            padding: 16px;
            border-radius: 12px;
            border: 1px solid var(--border-color, #e2e8f0);
            background: var(--bg-elevated, #f8fafc);
        }

        [data-theme="dark"] .right-box {
            background: #172339;
            border-color: #1e2e4f;
        }

        /* Sticky Sidebar */
        .toc-sticky-box {
            position: sticky;
            top: 90px;
            background: var(--bg-card, #ffffff);
            border: 1px solid var(--border-color, #e2e8f0);
            border-radius: 18px;
            padding: 22px;
            box-shadow: 0 4px 18px rgba(15, 23, 42, 0.04);
        }

        .toc-link-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 9px 12px;
            border-radius: 8px;
            color: var(--text-muted, #64748b);
            font-size: 0.88rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.15s ease;
        }

        .toc-link-item:hover,
        .toc-link-item.active {
            background: rgba(79, 70, 229, 0.08);
            color: #4f46e5 !important;
            font-weight: 700;
        }

        [data-theme="dark"] .toc-link-item:hover,
        [data-theme="dark"] .toc-link-item.active {
            background: rgba(99, 102, 241, 0.15);
            color: #818cf8 !important;
        }

        /* DPO Banner */
        .dpo-contact-banner {
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%);
            border-radius: 18px;
            padding: 28px;
            color: #ffffff !important;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-top: 30px;
            box-shadow: 0 12px 30px rgba(30, 27, 75, 0.25);
        }

        .dpo-contact-banner * {
            color: #ffffff;
        }
    </style>
}

<div class="hucems-privacy-wrapper">

    <!-- =====================================================
         EXECUTIVE HERO BANNER
         ===================================================== -->
    <header class="privacy-hero-banner">
        <div class="container">
            <div class="privacy-badge-pill mb-2">
                <i class="bi bi-shield-check text-info"></i>
                <span>Hawassa University Official Policy Document</span>
            </div>
            <h1 class="privacy-header-title">Data Privacy & Platform Governance</h1>
            <p class="privacy-header-desc">
                Learn how the Hawassa Unified Campus Event Management System (HUCEMS) securely handles your institutional identity, event registrations, and participation records in strict compliance with university governance.
            </p>

            <div class="privacy-meta-tags">
                <span class="meta-tag"><i class="bi bi-calendar3 text-warning"></i> Effective: Academic Year 2026/2027</span>
                <span class="meta-tag"><i class="bi bi-patch-check-fill text-success"></i> Status: Official & Active</span>
                <span class="meta-tag"><i class="bi bi-shield-lock-fill text-info"></i> PBKDF2 / SHA-256 Encrypted</span>
                <span class="meta-tag"><i class="bi bi-people-fill text-primary-subtle"></i> Role-Based Access (RBAC)</span>
                <div class="ms-auto d-none d-lg-block">
                    <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 fw-bold" onclick="window.print()">
                        <i class="bi bi-printer me-1"></i> Print / PDF
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- =====================================================
         3 EXECUTIVE SUMMARY PILLARS
         ===================================================== -->
    <div class="container py-5">
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="pillar-card">
                    <div class="pillar-icon bg-primary-subtle text-primary">
                        <i class="bi bi-shield-slash-fill"></i>
                    </div>
                    <h3 class="h5 fw-bold mb-2">Zero Data Selling</h3>
                    <p class="small text-muted mb-0">Your institutional records and event history are strictly confidential and will never be monetized, sold, or shared with commercial entities.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="pillar-card">
                    <div class="pillar-icon bg-success-subtle text-success">
                        <i class="bi bi-lock-fill"></i>
                    </div>
                    <h3 class="h5 fw-bold mb-2">Cryptographic Security</h3>
                    <p class="small text-muted mb-0">Passwords and digital QR entry passes are cryptographically secured using PBKDF2 salting, JWT tokens, and anti-forgery verification.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="pillar-card">
                    <div class="pillar-icon bg-info-subtle text-info">
                        <i class="bi bi-person-check-fill"></i>
                    </div>
                    <h3 class="h5 fw-bold mb-2">Student & Faculty Ownership</h3>
                    <p class="small text-muted mb-0">You maintain full rights to view your event history, download verified certificates, update profile info, or request account deactivation.</p>
                </div>
            </div>
        </div>

        <!-- =====================================================
             TWO-COLUMN LAYOUT: STICKY NAV + POLICY ARTICLES
             ===================================================== -->
        <div class="row g-4 g-lg-5">

            <!-- LEFT: STICKY TABLE OF CONTENTS -->
            <div class="col-lg-4">
                <div class="toc-sticky-box">
                    <span class="d-block small fw-bold text-uppercase text-muted mb-3" style="letter-spacing: 0.06em;">Policy Index</span>
                    <nav class="d-flex flex-column gap-1" id="privacyTocNav">
                        <a href="#section-1" class="toc-link-item active"><i class="bi bi-1-circle"></i> 1. Information We Collect</a>
                        <a href="#section-2" class="toc-link-item"><i class="bi bi-2-circle"></i> 2. Purpose & Legal Basis</a>
                        <a href="#section-3" class="toc-link-item"><i class="bi bi-3-circle"></i> 3. QR Passes & Check-In</a>
                        <a href="#section-4" class="toc-link-item"><i class="bi bi-4-circle"></i> 4. User Rights & Portability</a>
                        <a href="#section-5" class="toc-link-item"><i class="bi bi-5-circle"></i> 5. Data Retention Timetable</a>
                        <a href="#section-6" class="toc-link-item"><i class="bi bi-6-circle"></i> 6. Security Infrastructure</a>
                        <a href="#section-7" class="toc-link-item"><i class="bi bi-7-circle"></i> 7. Data Protection Officer</a>
                    </nav>

                    <hr class="my-3 opacity-25" />

                    <div class="text-center pt-2">
                        <span class="d-block small text-muted mb-2">Need Help or Have Questions?</span>
                        <a asp-controller="Home" asp-action="Contact" class="btn btn-primary btn-sm rounded-pill w-100 fw-bold shadow-sm">
                            <i class="bi bi-headset me-1"></i> Contact Campus Helpdesk
                        </a>
                    </div>
                </div>
            </div>

            <!-- RIGHT: POLICY CONTENT ARTICLES -->
            <div class="col-lg-8">

                <!-- ARTICLE 1 -->
                <article class="policy-card-item" id="section-1">
                    <div class="policy-item-header">
                        <span class="policy-index-badge">1</span>
                        <h2 class="policy-item-title">Information We Collect</h2>
                    </div>
                    <p class="mb-3 text-muted">
                        HUCEMS collects only necessary data required to facilitate event ticketing, academic communication, and campus community engagement:
                    </p>
                    <ul class="policy-bullet-list">
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            <div><strong>Institutional Identity:</strong> Full Name, University Email (`@@hawassa.edu.et`), Student/Employee ID Number, Department, and Faculty affiliation.</div>
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            <div><strong>Event Registrations & Attendance:</strong> Event bookings, digital ticket references, session check-in timestamps, and seating allocations.</div>
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            <div><strong>System Security & Logs:</strong> Cryptographic password hashes (never plaintext), sign-in audit timestamps, and IP access logs for incident auditing.</div>
                        </li>
                    </ul>
                </article>

                <!-- ARTICLE 2 -->
                <article class="policy-card-item" id="section-2">
                    <div class="policy-item-header">
                        <span class="policy-index-badge">2</span>
                        <h2 class="policy-item-title">Purpose & Legal Basis of Processing</h2>
                    </div>
                    <p class="mb-3 text-muted">
                        All gathered data is processed strictly for academic, educational, and campus administration purposes:
                    </p>
                    <div class="policy-callout">
                        <i class="bi bi-info-circle-fill fs-5 text-primary flex-shrink-0"></i>
                        <div>
                            <strong class="d-block mb-1">Legitimate Educational Purpose</strong>
                            <span class="small opacity-85">Data is used to allocate auditorium seats, issue verified certificates of participation, manage club event proposals, and notify students of urgent campus schedule changes.</span>
                        </div>
                    </div>
                    <ul class="policy-bullet-list">
                        <li>
                            <i class="bi bi-arrow-right-circle-fill text-primary"></i>
                            <div>Issuing personalized digital QR tickets and managing door check-in validation.</div>
                        </li>
                        <li>
                            <i class="bi bi-arrow-right-circle-fill text-primary"></i>
                            <div>Enabling student organization leaders to host verified campus workshops and club activities.</div>
                        </li>
                        <li>
                            <i class="bi bi-arrow-right-circle-fill text-primary"></i>
                            <div>Broadcasting urgent institutional bulletins and academic notices.</div>
                        </li>
                    </ul>
                </article>

                <!-- ARTICLE 3 -->
                <article class="policy-card-item" id="section-3">
                    <div class="policy-item-header">
                        <span class="policy-index-badge">3</span>
                        <h2 class="policy-item-title">QR Passes & Check-In Verification</h2>
                    </div>
                    <p class="mb-3 text-muted">
                        The HUCEMS digital ticketing engine uses cryptographically signed, ephemeral tokens:
                    </p>
                    <ul class="policy-bullet-list">
                        <li>
                            <i class="bi bi-shield-check text-success"></i>
                            <div><strong>Safe Scanning:</strong> Door scanners read only the ticket registration token. No passwords, private emails, or academic grades are stored inside the barcode.</div>
                        </li>
                        <li>
                            <i class="bi bi-shield-check text-success"></i>
                            <div><strong>Duplicate Prevention:</strong> Once verified at venue doors, duplicate scans are automatically rejected to prevent unauthorized re-entry.</div>
                        </li>
                    </ul>
                </article>

                <!-- ARTICLE 4 -->
                <article class="policy-card-item" id="section-4">
                    <div class="policy-item-header">
                        <span class="policy-index-badge">4</span>
                        <h2 class="policy-item-title">User Rights & Data Portability</h2>
                    </div>
                    <p class="mb-3 text-muted">
                        Every student, faculty member, and staff user possesses guaranteed rights regarding their personal records:
                    </p>
                    <div class="rights-box-grid">
                        <div class="right-box">
                            <strong class="d-block text-primary mb-1"><i class="bi bi-eye-fill me-1"></i> Right to Access</strong>
                            <p class="small text-muted mb-0">View all past and upcoming event registrations and tickets via your personal Dashboard.</p>
                        </div>
                        <div class="right-box">
                            <strong class="d-block text-success mb-1"><i class="bi bi-pencil-square me-1"></i> Right to Rectify</strong>
                            <p class="small text-muted mb-0">Update contact numbers, bio, and academic details directly inside Profile Settings.</p>
                        </div>
                        <div class="right-box">
                            <strong class="d-block text-info mb-1"><i class="bi bi-download me-1"></i> Right to Export</strong>
                            <p class="small text-muted mb-0">Download verified participation certificates and attendance logs for academic resumes.</p>
                        </div>
                        <div class="right-box">
                            <strong class="d-block text-danger mb-1"><i class="bi bi-trash3-fill me-1"></i> Right to Deactivate</strong>
                            <p class="small text-muted mb-0">Request account de-identification and data removal upon graduating from the university.</p>
                        </div>
                    </div>
                </article>

                <!-- ARTICLE 5 -->
                <article class="policy-card-item" id="section-5">
                    <div class="policy-item-header">
                        <span class="policy-index-badge">5</span>
                        <h2 class="policy-item-title">Data Retention Timetable</h2>
                    </div>
                    <p class="mb-3 text-muted">
                        HUCEMS maintains records in strict alignment with Hawassa University academic cycles:
                    </p>
                    <ul class="policy-bullet-list">
                        <li>
                            <i class="bi bi-clock-history text-info"></i>
                            <div><strong>Active Student Accounts:</strong> Maintained throughout active enrollment plus 1 academic year post-graduation for alumni event access.</div>
                        </li>
                        <li>
                            <i class="bi bi-clock-history text-info"></i>
                            <div><strong>Event Transcripts & Certificates:</strong> Stored for 5 academic years to provide verified verification for employment and postgraduate applications.</div>
                        </li>
                    </ul>
                </article>

                <!-- ARTICLE 6 -->
                <article class="policy-card-item" id="section-6">
                    <div class="policy-item-header">
                        <span class="policy-index-badge">6</span>
                        <h2 class="policy-item-title">Security Infrastructure Safeguards</h2>
                    </div>
                    <p class="mb-3 text-muted">
                        HUCEMS is engineered with resilient enterprise cybersecurity safeguards:
                    </p>
                    <ul class="policy-bullet-list">
                        <li>
                            <i class="bi bi-shield-lock-fill text-primary"></i>
                            <div><strong>PBKDF2 Password Hashing:</strong> Passwords are cryptographically salted and hashed using ASP.NET Core Identity standards.</div>
                        </li>
                        <li>
                            <i class="bi bi-shield-lock-fill text-primary"></i>
                            <div><strong>Anti-CSRF Protection:</strong> All transactional state forms are protected by anti-forgery security tokens.</div>
                        </li>
                        <li>
                            <i class="bi bi-shield-lock-fill text-primary"></i>
                            <div><strong>Database Snapshot Vault:</strong> Regular automated system backups with isolated checkpoint restoration support.</div>
                        </li>
                    </ul>
                </article>

                <!-- ARTICLE 7 -->
                <article class="policy-card-item" id="section-7">
                    <div class="policy-item-header">
                        <span class="policy-index-badge">7</span>
                        <h2 class="policy-item-title">Data Protection Officer & Inquiries</h2>
                    </div>
                    <p class="mb-3 text-muted">
                        This policy is reviewed annually by the Hawassa University ICT Directorate and Office of Academic Affairs.
                    </p>

                    <div class="dpo-contact-banner">
                        <div>
                            <h3 class="h5 fw-bold mb-1"><i class="bi bi-shield-shaded me-2"></i>Campus Data Protection Officer (DPO)</h3>
                            <p class="small opacity-85 mb-0">Office of Information Communications Technology, Main Campus Admin Complex</p>
                            <span class="small fw-semibold mt-1 d-block opacity-75">Email: dpo@hawassauniversity.edu.et &bull; Phone: +251 (46) 220-4528</span>
                        </div>
                        <div>
                            <a asp-controller="Home" asp-action="Contact" class="btn btn-light rounded-pill fw-bold text-primary px-4 shadow">
                                <i class="bi bi-send-fill me-1"></i> Submit Privacy Inquiry
                            </a>
                        </div>
                    </div>
                </article>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script>
        // Smooth scroll and active link highlighting for Policy Table of Contents
        document.addEventListener("DOMContentLoaded", function () {
            var links = document.querySelectorAll('.toc-link-item');
            
            links.forEach(function (link) {
                link.addEventListener('click', function (e) {
                    var targetId = this.getAttribute('href');
                    if (targetId && targetId.startsWith('#')) {
                        var targetEl = document.querySelector(targetId);
                        if (targetEl) {
                            e.preventDefault();
                            targetEl.scrollIntoView({ behavior: 'smooth' });
                            links.forEach(function (l) { l.classList.remove('active'); });
                            this.classList.add('active');
                        }
                    }
                });
            });

            // Scrollspy tracking
            window.addEventListener('scroll', function () {
                var sections = document.querySelectorAll('.policy-card-item');
                var scrollPos = window.scrollY + 130;

                sections.forEach(function (sec) {
                    var top = sec.offsetTop;
                    var height = sec.offsetHeight;
                    var id = sec.getAttribute('id');
                    if (scrollPos >= top && scrollPos < top + height) {
                        links.forEach(function (l) {
                            if (l.getAttribute('href') === '#' + id) {
                                l.classList.add('active');
                            } else {
                                l.classList.remove('active');
                            }
                        });
                    }
                });
            });
        });
    </script>
}