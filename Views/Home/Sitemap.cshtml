@{
    ViewData["Title"] = "All Pages Directory & Sitemap | HUCEMS";
}

<div class="container py-5">
    <!-- PAGE HEADER -->
    <div class="text-center mb-5">
        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-semibold mb-2">
            <i class="bi bi-compass me-1"></i> Comprehensive Sitemap & Navigation Hub
        </span>
        <h1 class="display-5 fw-bold text-dark mb-2">All Pages Directory</h1>
        <p class="text-muted lead mx-auto" style="max-width: 680px;">
            Instant access to all modules, dashboards, public services, and administrative control centers across Hawassa University.
        </p>

        <!-- LIVE SEARCH BAR -->
        <div class="row justify-content-center mt-4">
            <div class="col-md-7 col-lg-6">
                <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden border">
                    <span class="input-group-text bg-white border-0 ps-4"><i class="bi bi-search text-muted"></i></span>
                    <input type="search" id="sitemapSearchInput" class="form-control border-0" placeholder="Search any page, module, or URL..." oninput="filterSitemapCards(this.value)" />
                    <button type="button" class="btn btn-primary px-4 fw-semibold" onclick="document.getElementById('sitemapSearchInput').value=''; filterSitemapCards('');">Reset</button>
                </div>
            </div>
        </div>
    </div>

    <!-- QUICK CATEGORY PILLS -->
    <div class="d-flex flex-wrap justify-content-center gap-2 mb-5 pb-3 border-bottom" id="categoryFilterPills">
        <button class="btn btn-sm btn-dark rounded-pill px-3 active" onclick="filterByCategory('ALL', this)">All Pages (46)</button>
        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="filterByCategory('PUBLIC', this)">Public & Portal (4)</button>
        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="filterByCategory('EVENTS', this)">Events & Discovery (9)</button>
        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="filterByCategory('CLUBS', this)">Clubs & Societies (4)</button>
        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="filterByCategory('BROADCASTS', this)">Broadcasts & Calendar (3)</button>
        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="filterByCategory('DASHBOARDS', this)">Role Dashboards (7)</button>
        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="filterByCategory('AUTH', this)">Auth & Identity (6)</button>
        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="filterByCategory('ADMIN', this)">Admin Control Center (21)</button>
