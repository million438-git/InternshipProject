<style>
    .sitemap-card {
        background: #ffffff;
        transition: all 0.25s ease-in-out;
        border: 1px solid rgba(0,0,0,0.06) !important;
    }
    .sitemap-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08) !important;
        border-color: #2563eb !important;
    }
</style>

<script>
    function filterSitemapCards(query) {
        var q = query.trim().toLowerCase();
        var cards = document.querySelectorAll('.sitemap-card-wrapper');
        var sections = document.querySelectorAll('.sitemap-section');

        cards.forEach(function(card) {
            var text = card.textContent.toLowerCase() + ' ' + (card.getAttribute('data-keywords') || '');
            if (!q || text.includes(q)) {
                card.classList.remove('d-none');
            } else {
                card.classList.add('d-none');
            }
        });

        // Hide empty sections
        sections.forEach(function(sec) {
            var cat = sec.getAttribute('data-category');
            var hasVisible = Array.from(document.querySelectorAll('.sitemap-card-wrapper[data-category="' + cat + '"]'))
                                  .some(c => !c.classList.contains('d-none'));
            if (hasVisible) {
                sec.classList.remove('d-none');
            } else {
                sec.classList.add('d-none');
            }
        });
    }

    function filterByCategory(category, btn) {
        // Update active button
        document.querySelectorAll('#categoryFilterPills button').forEach(b => {
            b.classList.remove('btn-dark', 'active');
            b.classList.add('btn-outline-primary');
        });
        btn.classList.remove('btn-outline-primary');
        btn.classList.add('btn-dark', 'active');

        var cards = document.querySelectorAll('.sitemap-card-wrapper');
        var sections = document.querySelectorAll('.sitemap-section');

        cards.forEach(function(card) {
            var cardCat = card.getAttribute('data-category');
            if (category === 'ALL' || cardCat === category) {
                card.classList.remove('d-none');
            } else {
                card.classList.add('d-none');
            }
        });

        sections.forEach(function(sec) {
            var secCat = sec.getAttribute('data-category');
            if (category === 'ALL' || secCat === category) {
                sec.classList.remove('d-none');
            } else {
                sec.classList.add('d-none');
            }
        });
    }
</script>
