@model HawassaUnifiedCampusEventManagementSystem.Models.ContactViewModel

@{
    ViewData["Title"] = "Contact & Campus Support Desk | HUCEMS";
}

<!-- PAGE HEADER -->
<div class="bg-primary text-white py-5 mb-5" style="background: linear-gradient(135deg, #091e42 0%, #0f2d59 60%, #1e3a8a 100%) !important;">
    <div class="container py-3">
        <span class="badge bg-white text-primary fw-bold px-3 py-2 rounded-pill mb-3">
            <i class="bi bi-headset me-1"></i> Campus Administration & Inquiries
        </span>
        <h1 class="display-5 fw-bold mb-2">Contact Administration Desk</h1>
        <p class="lead text-white-50 mb-0" style="max-width: 650px;">
            Have questions about upcoming campus events, venue reservations, or portal access? Our team is here to assist you.
        </p>
    </div>
</div>

<div class="container pb-5">
    <!-- SUCCESS ALERT -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4 rounded-3 p-3 d-flex align-items-center gap-3" role="alert">
            <i class="bi bi-check-circle-fill fs-3 text-success"></i>
            <div>
                <h6 class="fw-bold mb-0">Message Received</h6>
                <p class="small mb-0 text-success-emphasis">@TempData["SuccessMessage"]</p>
            </div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4 g-lg-5">
        <!-- LEFT: INQUIRY FORM -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <h3 class="fw-bold text-dark mb-1">Send an Inquiry</h3>
                <p class="text-muted small mb-4">Complete the form below to reach the event management desk.</p>

                <form asp-controller="Home" asp-action="Contact" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. Abebe Kebede" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="e.g. user@hawassa.edu.et" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Phone Number (Optional)</label>
                            <input asp-for="Phone" class="form-control" placeholder="+251 9XX XXXXXX" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Department / Faculty</label>
                            <input asp-for="Department" class="form-control" placeholder="e.g. Computer Science" />
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-semibold text-dark">Subject <span class="text-danger">*</span></label>
                            <input asp-for="Subject" class="form-control" placeholder="Brief summary of inquiry" required />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-semibold text-dark">Message <span class="text-danger">*</span></label>
                            <textarea asp-for="Message" rows="5" class="form-control" placeholder="Provide details regarding your inquiry or reservation request..." required></textarea>
                            <span asp-validation-for="Message" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2">
                                <i class="bi bi-send-fill"></i>
                                <span>Submit Inquiry</span>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- RIGHT: CAMPUS DESKS & DIRECT CONTACT -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-light mb-4">
                <h4 class="fw-bold text-dark mb-3">Campus Office Directory</h4>

                <div class="d-flex align-items-start gap-3 mb-3 pb-3 border-bottom">
                    <div class="bg-primary text-white rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-building fs-5"></i>
                    </div>
                    <div>
                        <strong class="d-block text-dark">Main Administration Desk</strong>
                        <p class="small text-muted mb-1">Student Affairs Building, 2nd Floor, Main Campus</p>
                        <span class="small text-primary fw-semibold"><i class="bi bi-telephone me-1"></i> +251 (46) 220-4528</span>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-3 mb-3 pb-3 border-bottom">
                    <div class="bg-info text-white rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-laptop fs-5"></i>
                    </div>
                    <div>
                        <strong class="d-block text-dark">ICT Directorate Support</strong>
                        <p class="small text-muted mb-1">ICT Center, Tech Campus, Hawassa</p>
                        <span class="small text-primary fw-semibold"><i class="bi bi-envelope me-1"></i> support@hawassa.edu.et</span>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-3">
                    <div class="bg-success text-white rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-clock fs-5"></i>
                    </div>
                    <div>
                        <strong class="d-block text-dark">Office Working Hours</strong>
                        <p class="small text-muted mb-0">Monday – Friday: 8:30 AM – 5:30 PM (EAT)</p>
                        <p class="small text-muted mb-0">Closed on public holidays & weekends</p>
                    </div>
                </div>
            </div>

            <!-- REGISTRATION POLICY NOTE -->
            <div class="p-4 rounded-4 bg-white border shadow-sm">
                <div class="d-flex align-items-center gap-2 mb-2 text-dark fw-bold">
                    <i class="bi bi-shield-check text-primary fs-5"></i>
                    <span>Account Issuance Guidance</span>
                </div>
                <p class="small text-muted mb-0" style="line-height: 1.5;">
                    If you are a newly admitted student or newly hired faculty member needing portal credentials, please verify with your department registrar. Account provisioning is managed by Campus Administration.
                </p>
            </div>
        </div>
    </div>

    <!-- FREQUENTLY ASKED QUESTIONS -->
    <div class="mt-5 pt-4 border-top">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-dark">Frequently Asked Questions</h3>
            <p class="text-muted small">Answers to common inquiries regarding event bookings and participation.</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="accordion shadow-sm rounded-4 overflow-hidden" id="faqAccordion">
                    <div class="accordion-item border-0 border-bottom">
                        <h2 class="accordion-header">
                            <button class="accordion-button fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                How can I RSVP and attend an upcoming campus event?
                            </button>
                        </h2>
                        <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-secondary small" style="line-height: 1.6;">
                                Navigate to the <strong>Events</strong> page, select any published event, and click "RSVP / Register for Event". You will receive an immediate confirmation and entry pass.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border-0 border-bottom">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                How do department coordinators reserve auditoriums or halls?
                            </button>
                        </h2>
                        <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-secondary small" style="line-height: 1.6;">
                                Log in with your faculty or staff account, go to <strong>Create Event</strong>, select the desired venue and schedule. The Campus Administration Desk will review and approve the reservation.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border-0">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                Who do I contact if I forgot my portal credentials?
                            </button>
                        </h2>
                        <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-secondary small" style="line-height: 1.6;">
                                You can use the self-service <a asp-controller="Account" asp-action="ForgotPassword" class="fw-semibold">Forgot Password</a> page, or submit an inquiry using the contact form above.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
