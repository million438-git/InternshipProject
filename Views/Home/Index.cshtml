@model HawassaUnifiedCampusEventManagementSystem.Models.HomeIndexViewModel

@{
    ViewData["Title"] = "Hawassa University - Campus Event Management System";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<!-- =======================================================
     1. HERO BANNER
     ======================================================= -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-4 py-4">
            <div class="col-lg-8">
                <div class="hero-badge">
                    <img src="~/images/hawassa-logo.png" alt="Hawassa University" style="width: 22px; height: 22px; object-fit: contain;" />
                    <span>HAWASSA UNIVERSITY • HUCEMS</span>
                </div>
                
                <h1 class="hero-title">
                    Connecting Campus Life, Academic Conferences & Student Events
                </h1>
                
                <p class="hero-lead">
                    The official university platform for discovering upcoming academic symposiums, workshops, student club activities, and campus hall bookings.
                </p>
                
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Events" asp-action="Index" class="hero-btn-primary">
                        Explore Events
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="hero-btn-outline">
                        Sign In to Portal
                    </a>
                    <a asp-controller="Calendar" asp-action="Index" class="hero-btn-outline">
                        Campus Calendar
                    </a>
                </div>
            </div>

            <div class="col-lg-4 d-none d-lg-block text-center">
                <div class="p-4 rounded-4 bg-white bg-opacity-10 border border-white border-opacity-15 text-start shadow-sm">
                    <div class="d-flex align-items-center gap-2 mb-3 text-white">
                        <i class="bi bi-info-circle-fill fs-5 text-info"></i>
                        <span class="fw-bold">Campus Access Notice</span>
                    </div>
                    <p class="small text-white text-opacity-75 mb-3" style="line-height: 1.5;">
                        Public event registration is open for campus attendees. Department staff and students can access their personalized schedule using issued university credentials.
                    </p>
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-sm btn-light w-100 fw-semibold text-primary">
                        Contact Administration Desk &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =======================================================
     2. QUICK STATS BAR
     ======================================================= -->
<div class="container">
    <div class="stats-banner">
        <div class="row g-3 divide-y divide-md-0">
            <div class="col-6 col-md-3 stat-item">
                <div class="stat-number">@Model.TotalActiveEvents</div>
                <div class="stat-label">Active Events</div>
            </div>
            <div class="col-6 col-md-3 stat-item">
                <div class="stat-number">@Model.TotalDepartments</div>
                <div class="stat-label">Academic Departments</div>
            </div>
            <div class="col-6 col-md-3 stat-item">
                <div class="stat-number">@Model.TotalClubs</div>
                <div class="stat-label">Student Clubs</div>
            </div>
            <div class="col-6 col-md-3 stat-item">
                <div class="stat-number">@Model.TotalVenues</div>
                <div class="stat-label">Campus Venues</div>
            </div>
        </div>
    </div>
</div>

<!-- =======================================================
     3. UPCOMING FEATURED EVENTS
     ======================================================= -->
<section class="py-5 mt-4">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
            <div class="section-header mb-0">
                <span class="section-tag">Campus Activities</span>
                <h2 class="section-title">Upcoming University Events</h2>
                <p class="section-subtitle">Discover academic, cultural, and sports events scheduled across Hawassa University campuses.</p>
            </div>
            <a asp-controller="Events" asp-action="Index" class="btn btn-outline-primary btn-sm fw-semibold mt-2 mt-md-0">
                View All Events &rarr;
            </a>
        </div>

        @if (Model.UpcomingEvents != null && Model.UpcomingEvents.Any())
        {
            <div class="row g-4">
                @foreach (var ev in Model.UpcomingEvents)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="event-item-card h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="event-img-container position-relative bg-light rounded-top overflow-hidden" style="height: 180px;">
                                    @if (!string.IsNullOrWhiteSpace(ev.ImageUrl))
                                    {
                                        <img src="@ev.ImageUrl" alt="@ev.Title" class="w-100 h-100 object-fit-cover" />
                                    }
                                    else
                                    {
                                        <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-primary-subtle text-primary">
                                            <i class="bi bi-calendar-event fs-1"></i>
                                        </div>
                                    }
                                    <div class="event-date-badge position-absolute top-0 start-0 m-3 bg-white text-dark rounded-3 px-2 py-1 text-center shadow-sm" style="min-width: 46px;">
                                        <span class="day fw-bold d-block fs-6 leading-none">@ev.StartDate.ToString("dd")</span>
                                        <span class="month small text-uppercase text-muted" style="font-size: 10px;">@ev.StartDate.ToString("MMM")</span>
                                    </div>
                                </div>
                                <div class="event-body p-3">
                                    <span class="badge bg-primary-subtle text-primary mb-2 align-self-start">@(ev.CategoryName ?? "Campus Event")</span>
                                    <h5 class="event-title fw-bold text-dark fs-6 mb-2">@ev.Title</h5>
                                    <p class="event-meta mb-2 small text-muted">
                                        <i class="bi bi-geo-alt me-1 text-danger"></i> @(ev.VenueName ?? "Main Campus")
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(ev.ShortDescription))
                                    {
                                        <p class="small text-muted mb-3" style="line-height: 1.5;">
                                            @ev.ShortDescription
                                        </p>
                                    }
                                </div>
                            </div>
                            <div class="event-footer px-3 pb-3 pt-2 border-top d-flex justify-content-between align-items-center">
                                <span class="small text-muted"><i class="bi bi-clock me-1"></i> @(ev.FormattedTime ?? ev.StartDate.ToString("hh:mm tt"))</span>
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.Id" class="btn btn-sm btn-primary px-3 rounded-pill fw-semibold">View Details</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="p-5 text-center bg-white rounded-4 border shadow-sm">
                <i class="bi bi-calendar-x text-muted display-4 mb-3 d-block"></i>
                <h5 class="fw-bold text-dark mb-1">No Upcoming Public Events Scheduled</h5>
                <p class="text-muted small mb-3">Upcoming university symposiums, student workshops, and activities will appear here once published.</p>
                <a asp-controller="Events" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-4">Browse Past & Ongoing Events</a>
            </div>
        }
    </div>
</section>

<!-- =======================================================
     4. EVENT CATEGORIES
     ======================================================= -->
<section class="py-5 bg-light border-top border-bottom">
    <div class="container">
        <div class="section-header text-center mx-auto" style="max-width: 600px;">
            <span class="section-tag">Explore Themes</span>
            <h2 class="section-title">Event Categories</h2>
            <p class="section-subtitle">Find conferences, workshops, and activities organized by campus departments.</p>
        </div>

        <div class="row g-3">
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Events" asp-action="Index" asp-route-category="Academic" class="category-card text-decoration-none">
                    <div class="category-icon-box bg-primary-subtle text-primary">
                        <i class="bi bi-mortarboard"></i>
                    </div>
                    <div class="category-title">Academic</div>
                    <div class="category-count">Conferences</div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Events" asp-action="Index" asp-route-category="Technology" class="category-card text-decoration-none">
                    <div class="category-icon-box bg-info-subtle text-info-emphasis">
                        <i class="bi bi-laptop"></i>
                    </div>
                    <div class="category-title">Technology</div>
                    <div class="category-count">Hackathons</div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Events" asp-action="Index" asp-route-category="Cultural" class="category-card text-decoration-none">
                    <div class="category-icon-box bg-warning-subtle text-warning-emphasis">
                        <i class="bi bi-palette"></i>
                    </div>
                    <div class="category-title">Cultural</div>
                    <div class="category-count">Festivals & Arts</div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Events" asp-action="Index" asp-route-category="Sports" class="category-card text-decoration-none">
                    <div class="category-icon-box bg-success-subtle text-success">
                        <i class="bi bi-trophy"></i>
                    </div>
                    <div class="category-title">Sports</div>
                    <div class="category-count">Tournaments</div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Events" asp-action="Index" asp-route-category="Workshop" class="category-card text-decoration-none">
                    <div class="category-icon-box bg-secondary-subtle text-secondary">
                        <i class="bi bi-journal-text"></i>
                    </div>
                    <div class="category-title">Workshops</div>
                    <div class="category-count">Skill Training</div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Events" asp-action="Categories" class="category-card text-decoration-none">
                    <div class="category-icon-box bg-dark-subtle text-dark">
                        <i class="bi bi-grid-3x3-gap"></i>
                    </div>
                    <div class="category-title">All Categories</div>
                    <div class="category-count">View Catalog</div>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- =======================================================
     5. LATEST CAMPUS ANNOUNCEMENTS
     ======================================================= -->
<section class="py-5">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
            <div class="section-header mb-0">
                <span class="section-tag">Official Notices</span>
                <h2 class="section-title">Campus Announcements</h2>
                <p class="section-subtitle">Stay informed about institutional circulars and administrative notices.</p>
            </div>
            <a asp-controller="Announcements" asp-action="Index" class="btn btn-outline-secondary btn-sm fw-semibold mt-2 mt-md-0">
                View All Announcements &rarr;
            </a>
        </div>

        @if (Model.LatestAnnouncements != null && Model.LatestAnnouncements.Any())
        {
            <div class="row g-3">
                @foreach (var ann in Model.LatestAnnouncements)
                {
                    <div class="col-md-6">
                        <div class="p-4 rounded-3 border bg-white shadow-sm h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge @(ann.Priority == "URGENT" || ann.Priority == "HIGH" ? "bg-danger" : "bg-primary")">@ann.Priority</span>
                                    <span class="small text-muted">@ann.DepartmentName • @ann.CreatedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                                <h5 class="fw-bold text-dark mb-2">@ann.Title</h5>
                                <p class="small text-secondary mb-3" style="line-height: 1.5;">
                                    @ann.Content
                                </p>
                            </div>
                            <a asp-controller="Announcements" asp-action="Details" asp-route-id="@ann.Id" class="text-primary small fw-semibold text-decoration-none">
                                Read Official Notice &rarr;
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="p-4 text-center bg-white rounded-3 border">
                <p class="text-muted small mb-0">No active circulars at this moment. All official bulletins will be broadcasted here.</p>
            </div>
        }
    </div>
</section>

<!-- =======================================================
     6. INSTITUTIONAL CALL TO ACTION BANNER
     ======================================================= -->
<section class="pb-5">
    <div class="container">
        <div class="portal-cta-banner">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <h3 class="fw-bold mb-2">Are you an Event Coordinator or Faculty Host?</h3>
                    <p class="mb-0 text-white-50" style="font-size: 1rem; line-height: 1.5;">
                        Log in with your university credentials to submit event proposals, reserve auditoriums, manage registrations, and broadcast circulars.
                    </p>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-light btn-lg px-4 fw-bold text-primary shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Portal
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>