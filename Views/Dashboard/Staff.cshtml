@model HawassaUnifiedCampusEventManagementSystem.Models.StaffDashboardViewModel

@{
    ViewData["Title"] = "Staff Dashboard | HUCEMS";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-page staff-theme py-4">
    <div class="container-fluid px-lg-4">

        <!-- =====================================================
             STAFF HERO BANNER & ROLE SWITCHER PREVIEW
             ===================================================== -->
        <div class="role-hero-banner staff-hero mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="hero-text">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-1 small text-white-50">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none"><i class="bi bi-house-door me-1"></i>Home</a></li>
                            <li class="breadcrumb-item active text-white" aria-current="page">Staff Operations Dashboard</li>
                        </ol>
                    </nav>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h1 class="hero-title h2 fw-bold text-white mb-0">Staff Operations Portal &bull; @Model.UserName</h1>
                        <span class="badge role-badge bg-white text-success fw-bold px-3 py-1 shadow-sm">
                            <i class="bi bi-briefcase-fill me-1"></i> UNIVERSITY STAFF
                        </span>
                    </div>
                    <p class="text-white-50 mb-0 small">
                        <i class="bi bi-building me-1"></i> Department: <span class="text-white fw-semibold">@Model.UserDepartment</span> &nbsp;•&nbsp; 
                        <i class="bi bi-person-badge me-1"></i> Employee ID: <span class="text-white fw-semibold">@Model.EmployeeId</span> &nbsp;•&nbsp;
                        <i class="bi bi-shield-check me-1"></i> Verified Staff Clearance
                    </p>
                </div>

                <div class="hero-actions d-flex flex-wrap align-items-center gap-2">
                    <a asp-controller="Events" asp-action="Create" class="btn btn-light shadow-sm d-inline-flex align-items-center gap-2">
                        <i class="bi bi-calendar-plus"></i>
                        <span>Schedule Dept Event</span>
                    </a>
                    <a asp-controller="Calendar" asp-action="Index" class="btn btn-outline-light d-inline-flex align-items-center gap-2">
                        <i class="bi bi-building-gear"></i>
                        <span>Venue Allocation</span>
                    </a>
                    <div class="dropdown">
                        <button class="btn btn-dark bg-dark-subtle border-0 text-white dropdown-toggle small px-2 py-2" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-arrow-left-right me-1"></i> Role Views
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li><h6 class="dropdown-header small">Switch Dashboard Preview</h6></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Student"><i class="bi bi-mortarboard me-2"></i>Student</a></li>
                            <li><a class="dropdown-item active" asp-controller="Dashboard" asp-action="Staff"><i class="bi bi-briefcase me-2"></i>Staff</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Faculty"><i class="bi bi-journal-bookmark me-2"></i>Faculty</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Organization"><i class="bi bi-people me-2"></i>Organization</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Admin"><i class="bi bi-shield-lock me-2"></i>Admin</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="SuperAdmin"><i class="bi bi-cpu me-2"></i>SuperAdmin</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- =====================================================
             STAFF STATS COUNTERS
             ===================================================== -->
        <section class="dashboard-stat-grid mb-4">
            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-success-subtle text-success rounded-3">
                        <i class="bi bi-calendar3-event-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Department Events</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.DepartmentEventsCount</strong>
                        <span class="text-success small d-block" style="font-size: 11px;">Active in Schedule</span>
                    </div>
                </div>
            </div>

            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-primary-subtle text-primary rounded-3">
                        <i class="bi bi-door-open-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Venue Bookings</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.VenueReservationsCount</strong>
                        <span class="badge bg-primary-subtle text-primary small mt-1">Halls & Labs</span>
                    </div>
                </div>
            </div>

            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-warning-subtle text-warning-emphasis rounded-3">
                        <i class="bi bi-list-task fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Operational Tasks</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.PendingTasksCount</strong>
                        <span class="badge bg-warning-subtle text-warning-emphasis small mt-1">Action Needed</span>
                    </div>
                </div>
            </div>

            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-secondary-subtle text-secondary rounded-3">
                        <i class="bi bi-projector-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">AV & Resources</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.ManagedEquipmentsCount</strong>
                        <span class="text-muted small d-block" style="font-size: 11px;">Not tracked in this system</span>
                    </div>
                </div>
            </div>
        </section>

        <div class="row g-4">
            <!-- =====================================================
                 LEFT & MAIN COLUMN
                 ===================================================== -->
            <div class="col-lg-8">

                <!-- OPERATIONAL TASKS & LOGISTICS CHECKLIST -->
                <div class="card shadow-sm border-0 mb-4 dashboard-main-card">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h5 fw-bold mb-0 text-dark">
                                <i class="bi bi-check2-square me-2 text-success"></i>Staff Operational Checklist & Logistics
                            </h2>
                            <small class="text-muted">Equipment readiness, stage setup & coordination duties</small>
                        </div>
                        <button class="btn btn-sm btn-outline-success"><i class="bi bi-plus-lg me-1"></i>New Task</button>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-flex flex-column gap-2">
                            @foreach (var task in Model.OperationalTasks)
                            {
                                <div class="p-3 border rounded-3 d-flex justify-content-between align-items-center @(task.IsCompleted ? "bg-light text-muted" : "bg-white")">
                                    <div class="d-flex align-items-center gap-3">
                                        <input class="form-check-input mt-0 fs-5" type="checkbox" checked="@(task.IsCompleted)" />
                                        <div>
                                            <span class="fw-semibold text-dark d-block @(task.IsCompleted ? "text-decoration-line-through text-muted" : "")">@task.Title</span>
                                            <small class="text-muted"><i class="bi bi-clock me-1"></i>Due by @task.DueDate.ToString("MMM dd, yyyy")</small>
                                        </div>
                                    </div>
                                    <span class="badge @(task.Priority == "High" ? "bg-danger-subtle text-danger" : task.Priority == "Medium" ? "bg-warning-subtle text-warning-emphasis" : "bg-secondary-subtle text-secondary")">
                                        @task.Priority Priority
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- DEPARTMENT VENUE RESERVATIONS -->
                <div class="card shadow-sm border-0 mb-4 dashboard-main-card">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h5 fw-bold mb-0 text-dark">
                                <i class="bi bi-building-check me-2 text-primary"></i>Upcoming Campus Venue Reservations
                            </h2>
                            <small class="text-muted">Assigned auditoriums, seminar halls, and ICT labs</small>
                        </div>
                        <a asp-controller="Calendar" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">Schedule Hall</a>
                    </div>
                    <div class="card-body p-3">
                        @if (Model.UpcomingVenueBookings != null && Model.UpcomingVenueBookings.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small text-uppercase">
                                        <tr>
                                            <th>Venue</th>
                                            <th>Purpose / Agenda</th>
                                            <th>Date & Slot</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var vb in Model.UpcomingVenueBookings)
                                        {
                                            <tr>
                                                <td class="fw-bold text-dark"><i class="bi bi-geo-alt me-1 text-danger"></i>@vb.VenueName</td>
                                                <td class="small">@vb.Purpose</td>
                                                <td class="small text-muted">@vb.ScheduledDate.ToString("MMM dd, yyyy") &bull; @vb.TimeSlot</td>
                                                <td>
                                                    <span class="badge @(vb.Status == "APPROVED" || vb.Status == "Confirmed" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning-emphasis")">
                                                        @vb.Status
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted small">
                                <i class="bi bi-building-check text-secondary fs-3 mb-2 d-block"></i>
                                No upcoming venue reservations scheduled at this time.
                            </div>
                        }
                    </div>
                </div>

                <!-- STAFF INTERNAL NOTICES -->
                <div class="card shadow-sm border-0 dashboard-announcements-card">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h5 fw-bold mb-0 text-dark">
                                <i class="bi bi-shield-exclamation me-2 text-warning-emphasis"></i>Staff Administrative Memos
                            </h2>
                            <small class="text-muted">Campus safety, facility updates, and HR memos</small>
                        </div>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-flex flex-column gap-3">
                            @foreach (var notice in Model.StaffAnnouncements)
                            {
                                <div class="p-3 bg-light rounded-3 border-start border-4 border-success">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h6 class="fw-bold text-dark mb-0">@notice.Title</h6>
                                        <span class="badge @(notice.Priority == "High" ? "bg-danger text-white" : "bg-secondary-subtle text-secondary") small">@notice.Priority</span>
                                    </div>
                                    <p class="small text-secondary mb-2">@notice.Content</p>
                                    <small class="text-muted"><i class="bi bi-building me-1"></i>Issued by @notice.AuthorName (@notice.DepartmentName)</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>

            <!-- =====================================================
                 RIGHT SIDEBAR COLUMN
                 ===================================================== -->
            <div class="col-lg-4">

                <!-- STAFF ACTIONS -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h2 class="h6 fw-bold mb-0 text-dark">
                            <i class="bi bi-grid-fill me-2 text-success"></i>Staff Quick Operations
                        </h2>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-grid gap-2">
                            <a asp-controller="Events" asp-action="Create" class="btn btn-success text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-plus-circle me-2"></i>Create Department Event</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                            <a asp-controller="Events" asp-action="MyEvents" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-calendar2-check me-2 text-primary"></i>Managed Events Queue</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                            <a asp-controller="Calendar" asp-action="Index" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-building me-2 text-warning"></i>Facility & Room Booking</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                            <a asp-controller="Account" asp-action="Profile" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-person-gear me-2 text-secondary"></i>Staff Profile & Access</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- STAFF NOTIFICATIONS -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <h2 class="h6 fw-bold mb-0 text-dark">
                            <i class="bi bi-bell-fill me-2 text-danger"></i>Logistics Feed
                        </h2>
                        <span class="badge bg-success-subtle text-success small">Live</span>
                    </div>
                    <div class="card-body p-3">
                        <div class="notification-list d-flex flex-column gap-2">
                            @foreach (var n in Model.Notifications)
                            {
                                <div class="p-2 rounded-2 border @(n.IsRead ? "bg-white" : "bg-success-subtle border-success-subtle")">
                                    <p class="small text-dark mb-1">@n.Message</p>
                                    <small class="text-muted" style="font-size: 11px;"><i class="bi bi-clock me-1"></i>@n.CreatedAt.ToString("MMM dd, hh:mm tt")</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- EQUIPMENT READINESS -->
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white border-bottom py-3">
                        <h2 class="h6 fw-bold mb-0 text-dark">
                            <i class="bi bi-hdd-network-fill me-2 text-info"></i>Campus Asset Checklist
                        </h2>
                    </div>
                    <div class="card-body p-3">
                        <ul class="list-group list-group-flush small">
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span><i class="bi bi-mic me-2 text-primary"></i>Wireless Mic Sets (Hall A)</span>
                                <span class="badge bg-success-subtle text-success">Tested & Ready</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span><i class="bi bi-projector me-2 text-primary"></i>4K Laser Projector (Lab 3)</span>
                                <span class="badge bg-success-subtle text-success">Calibrated</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span><i class="bi bi-wifi me-2 text-primary"></i>Event High-Density WiFi APs</span>
                                <span class="badge bg-success-subtle text-success">Online (5 GHz)</span>
                            </li>
                        </ul>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
