@model HawassaUnifiedCampusEventManagementSystem.Models.OrganizationDashboardViewModel

@{
    ViewData["Title"] = "Organization Dashboard | HUCEMS";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-page org-theme py-4">
    <div class="container-fluid px-lg-4">

        <!-- =====================================================
             ORGANIZATION HERO BANNER & ROLE SWITCHER PREVIEW
             ===================================================== -->
        <div class="role-hero-banner org-hero mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="hero-text">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-1 small text-white-50">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none"><i class="bi bi-house-door me-1"></i>Home</a></li>
                            <li class="breadcrumb-item active text-white" aria-current="page">Organizer Command Center</li>
                        </ol>
                    </nav>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h1 class="hero-title h2 fw-bold text-white mb-0">@Model.OrganizationName</h1>
                        <span class="badge role-badge bg-white text-dark fw-bold px-3 py-1 shadow-sm">
                            <i class="bi bi-people-fill me-1"></i> STUDENT ORGANIZATION
                        </span>
                    </div>
                    <p class="text-white-50 mb-0 small">
                        <i class="bi bi-person-circle me-1"></i> Lead: <span class="text-white fw-semibold">@Model.UserName</span> &nbsp;•&nbsp; 
                        <i class="bi bi-shield-check me-1"></i> Official Student Union Charter &bull; Hawassa University
                    </p>
                </div>

                <div class="hero-actions d-flex flex-wrap align-items-center gap-2">
                    <a asp-controller="Events" asp-action="Create" class="btn btn-light shadow-sm d-inline-flex align-items-center gap-2">
                        <i class="bi bi-plus-circle-fill text-warning"></i>
                        <span>Host New Event</span>
                    </a>
                    <a asp-controller="Events" asp-action="MyEvents" class="btn btn-outline-light d-inline-flex align-items-center gap-2">
                        <i class="bi bi-ticket-perforated"></i>
                        <span>Scan & Verify Passes</span>
                    </a>
                    <div class="dropdown">
                        <button class="btn btn-dark bg-dark-subtle border-0 text-white dropdown-toggle small px-2 py-2" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-arrow-left-right me-1"></i> Role Views
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li><h6 class="dropdown-header small">Switch Dashboard Preview</h6></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Student"><i class="bi bi-mortarboard me-2"></i>Student</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Staff"><i class="bi bi-briefcase me-2"></i>Staff</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Faculty"><i class="bi bi-journal-bookmark me-2"></i>Faculty</a></li>
                            <li><a class="dropdown-item active" asp-controller="Dashboard" asp-action="Organization"><i class="bi bi-people me-2"></i>Organization</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Admin"><i class="bi bi-shield-lock me-2"></i>Admin</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="SuperAdmin"><i class="bi bi-cpu me-2"></i>SuperAdmin</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- =====================================================
             ORGANIZATION STATS COUNTERS
             ===================================================== -->
        <section class="dashboard-stat-grid mb-4">
            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-warning-subtle text-warning-emphasis rounded-3">
                        <i class="bi bi-calendar2-star-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Hosted Events</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.HostedEventsCount</strong>
                        <span class="badge bg-warning-subtle text-warning-emphasis small mt-1">5 Published</span>
                    </div>
                </div>
            </div>

            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-success-subtle text-success rounded-3">
                        <i class="bi bi-person-check-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Total Attendees</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.TotalAttendeesCount</strong>
                        <span class="text-success small d-block" style="font-size: 11px;">+18% this month</span>
                    </div>
                </div>
            </div>

            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-primary-subtle text-primary rounded-3">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Active Members</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.ActiveMembersCount</strong>
                        <span class="text-primary small d-block" style="font-size: 11px;">Executive Committee</span>
                    </div>
                </div>
            </div>

            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-info-subtle text-info-emphasis rounded-3">
                        <i class="bi bi-shop-window fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Booth Bookings</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.BoothReservationsCount</strong>
                        <span class="text-info small d-block" style="font-size: 11px;">Quad Expo Space</span>
                    </div>
                </div>
            </div>
        </section>

        <div class="row g-4">
            <!-- =====================================================
                 LEFT & MAIN COLUMN
                 ===================================================== -->
            <div class="col-lg-8">

                <!-- LIVE REGISTRATION & ATTENDANCE ANALYTICS -->
                <div class="card shadow-sm border-0 mb-4 dashboard-main-card">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h5 fw-bold mb-0 text-dark">
                                <i class="bi bi-graph-up-arrow me-2 text-warning"></i>Live Event Registration & Attendance
                            </h2>
                            <small class="text-muted">Real-time attendee capacity and ticket scanning status</small>
                        </div>
                    </div>
                    <div class="card-body p-3">
                        @if (Model.AttendanceAnalytics != null && Model.AttendanceAnalytics.Any())
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var stat in Model.AttendanceAnalytics)
                                {
                                    var pct = stat.MaxCapacity > 0 ? (int)((double)stat.ConfirmedCount / stat.MaxCapacity * 100) : 0;
                                    <div class="p-3 border rounded-3 bg-light">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <h6 class="fw-bold text-dark mb-0">@stat.EventTitle</h6>
                                            <span class="badge bg-primary">@stat.ConfirmedCount / @stat.MaxCapacity Confirmed</span>
                                        </div>
                                        <div class="progress mb-2" style="height: 10px;">
                                            <div class="progress-bar bg-warning" role="progressbar" style="width: @pct%;" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <div class="d-flex justify-content-between small text-muted">
                                            <span><i class="bi bi-qr-code-scan me-1 text-success"></i>@stat.AttendedCount Check-ins Verified</span>
                                            <span>@pct% Capacity Filled</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted small">
                                <i class="bi bi-graph-up text-secondary fs-3 mb-2 d-block"></i>
                                No active event registrations recorded yet. Once attendees RSVP for your hosted events, live attendance statistics will display here.
                            </div>
                        }
                    </div>
                </div>

                <!-- ORGANIZATION EXECUTIVE COMMITTEE MEMBERS -->
                <div class="card shadow-sm border-0 mb-4 dashboard-main-card">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h5 fw-bold mb-0 text-dark">
                                <i class="bi bi-people me-2 text-primary"></i>Organizing Committee & Officers
                            </h2>
                            <small class="text-muted">Club officers, event coordinators, and stage leads</small>
                        </div>
                        <a asp-controller="Clubs" asp-action="MyClubs" class="btn btn-sm btn-outline-primary rounded-pill px-3">Manage Clubs</a>
                    </div>
                    <div class="card-body p-3">
                        @if (Model.OrganizationMembers != null && Model.OrganizationMembers.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small text-uppercase">
                                        <tr>
                                            <th>Name</th>
                                            <th>Role in Club</th>
                                            <th>Campus Email</th>
                                            <th>Joined</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var m in Model.OrganizationMembers)
                                        {
                                            <tr>
                                                <td class="fw-bold text-dark">
                                                    <i class="bi bi-person-circle me-1 text-secondary"></i>@m.FullName
                                                </td>
                                                <td><span class="badge bg-warning-subtle text-warning-emphasis">@m.RoleInOrg</span></td>
                                                <td class="small text-muted">@m.Email</td>
                                                <td class="small text-muted">@m.JoinedAt.ToString("MMM yyyy")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted small">
                                <i class="bi bi-people text-secondary fs-3 mb-2 d-block"></i>
                                No active roster members recorded for this organization account.
                            </div>
                        }
                    </div>
                </div>

            </div>

            <!-- =====================================================
                 RIGHT SIDEBAR COLUMN
                 ===================================================== -->
            <div class="col-lg-4">

                <!-- QUICK ACTIONS -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h2 class="h6 fw-bold mb-0 text-dark">
                            <i class="bi bi-grid-fill me-2 text-warning"></i>Organizer Toolkit
                        </h2>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-grid gap-2">
                            <a asp-controller="Events" asp-action="Create" class="btn btn-warning text-dark text-start d-flex align-items-center justify-content-between p-2 px-3 fw-bold">
                                <span><i class="bi bi-plus-circle-fill me-2"></i>Create New Event</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                            <a asp-controller="Clubs" asp-action="Index" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-stars me-2 text-warning"></i>Campus Clubs & Societies</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                            <a asp-controller="Clubs" asp-action="MyClubs" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-collection-fill me-2 text-primary"></i>My Managed Clubs</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                            <a asp-controller="Events" asp-action="MyEvents" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-card-checklist me-2 text-primary"></i>Attendee Registration List</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                            <a asp-controller="Calendar" asp-action="Index" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-calendar2-range me-2 text-success"></i>Book Auditorium / Booth</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                            <a asp-controller="Account" asp-action="Profile" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-building-gear me-2 text-secondary"></i>Organization Profile</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- ORGANIZER NOTIFICATIONS -->
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white border-bottom py-3">
                        <h2 class="h6 fw-bold mb-0 text-dark">
                            <i class="bi bi-bell-fill me-2 text-danger"></i>Host Notifications
                        </h2>
                    </div>
                    <div class="card-body p-3">
                        <div class="notification-list d-flex flex-column gap-2">
                            @foreach (var n in Model.Notifications)
                            {
                                <div class="p-2 rounded-2 border @(n.IsRead ? "bg-white" : "bg-warning-subtle border-warning-subtle")">
                                    <p class="small text-dark mb-1">@n.Message</p>
                                    <small class="text-muted" style="font-size: 11px;"><i class="bi bi-clock me-1"></i>@n.CreatedAt.ToString("MMM dd, hh:mm tt")</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
