@model HawassaUnifiedCampusEventManagementSystem.Models.FacultyDashboardViewModel

@{
    ViewData["Title"] = "Faculty Dashboard | HUCEMS";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-page faculty-theme py-4">
    <div class="container-fluid px-lg-4">

        <!-- =====================================================
             FACULTY HERO BANNER & ROLE SWITCHER PREVIEW
             ===================================================== -->
        <div class="role-hero-banner faculty-hero mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="hero-text">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-1 small text-white-50">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none"><i class="bi bi-house-door me-1"></i>Home</a></li>
                            <li class="breadcrumb-item active text-white" aria-current="page">Faculty & Academic Dashboard</li>
                        </ol>
                    </nav>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h1 class="hero-title h2 fw-bold text-white mb-0">Faculty Portal &bull; @Model.UserName</h1>
                        <span class="badge role-badge bg-white text-primary fw-bold px-3 py-1 shadow-sm">
                            <i class="bi bi-journal-bookmark-fill me-1"></i> FACULTY MEMBER
                        </span>
                    </div>
                    <p class="text-white-50 mb-0 small">
                        <i class="bi bi-mortarboard me-1"></i> Department: <span class="text-white fw-semibold">@Model.UserDepartment</span> &nbsp;•&nbsp; 
                        <i class="bi bi-person-badge me-1"></i> Faculty ID: <span class="text-white fw-semibold">@Model.EmployeeId</span> &nbsp;•&nbsp;
                        <i class="bi bi-people me-1"></i> Undergrad & Grad Mentorship
                    </p>
                </div>

                <div class="hero-actions d-flex flex-wrap align-items-center gap-2">
                    <a asp-controller="Events" asp-action="Create" class="btn btn-light shadow-sm d-inline-flex align-items-center gap-2">
                        <i class="bi bi-journal-plus"></i>
                        <span>Host Academic Seminar</span>
                    </a>
                    <a asp-controller="Calendar" asp-action="Index" class="btn btn-outline-light d-inline-flex align-items-center gap-2">
                        <i class="bi bi-clock-history"></i>
                        <span>Teaching Timetable</span>
                    </a>
                    <div class="dropdown">
                        <button class="btn btn-dark bg-dark-subtle border-0 text-white dropdown-toggle small px-2 py-2" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-arrow-left-right me-1"></i> Role Views
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li><h6 class="dropdown-header small">Switch Dashboard Preview</h6></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Student"><i class="bi bi-mortarboard me-2"></i>Student</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Staff"><i class="bi bi-briefcase me-2"></i>Staff</a></li>
                            <li><a class="dropdown-item active" asp-controller="Dashboard" asp-action="Faculty"><i class="bi bi-journal-bookmark me-2"></i>Faculty</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Organization"><i class="bi bi-people me-2"></i>Organization</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Admin"><i class="bi bi-shield-lock me-2"></i>Admin</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="SuperAdmin"><i class="bi bi-cpu me-2"></i>SuperAdmin</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- =====================================================
             FACULTY STATS COUNTERS
             ===================================================== -->
        <section class="dashboard-stat-grid mb-4">
            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-purple-subtle text-purple rounded-3">
                        <i class="bi bi-mortarboard-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Academic Symposia</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.AcademicConferencesCount</strong>
                        <span class="badge bg-purple-subtle text-purple small mt-1">Conferences</span>
                    </div>
                </div>
            </div>

            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-primary-subtle text-primary rounded-3">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Scheduled Lectures</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.ScheduledLecturesCount</strong>
                        <span class="text-primary small d-block" style="font-size: 11px;">This Week</span>
                    </div>
                </div>
            </div>

            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-warning-subtle text-warning-emphasis rounded-3">
                        <i class="bi bi-file-earmark-check-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Seminar Approvals</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.SeminarApprovalsCount</strong>
                        <span class="badge bg-warning-subtle text-warning-emphasis small mt-1">Review Required</span>
                    </div>
                </div>
            </div>

            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-success-subtle text-success rounded-3">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Enrolled Students</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.DepartmentStudentsCount</strong>
                        <span class="text-success small d-block" style="font-size: 11px;">Across 4 Courses</span>
                    </div>
                </div>
            </div>
        </section>

        <div class="row g-4">
            <!-- =====================================================
                 LEFT & MAIN COLUMN
                 ===================================================== -->
            <div class="col-lg-8">

                <!-- STUDENT SEMINAR / THESIS PROPOSALS AWAITING REVIEW -->
                <div class="card shadow-sm border-0 mb-4 dashboard-main-card">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h5 fw-bold mb-0 text-dark">
                                <i class="bi bi-mortarboard me-2 text-purple"></i>Student Research & Seminar Proposals
                            </h2>
                            <small class="text-muted">Proposals submitted by students needing faculty advisor endorsement</small>
                        </div>
                        <span class="badge bg-purple-subtle text-purple px-2 py-1">@Model.PendingStudentProposals.Count Pending</span>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-flex flex-column gap-3">
                            @foreach (var p in Model.PendingStudentProposals)
                            {
                                <div class="p-3 border rounded-3 bg-light d-flex justify-content-between align-items-center flex-wrap gap-3">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <h6 class="fw-bold text-dark mb-0">@p.EventTitle</h6>
                                            <span class="badge bg-warning-subtle text-warning-emphasis small">Awaiting Endorsement</span>
                                        </div>
                                        <p class="small text-muted mb-1"><i class="bi bi-person me-1"></i>Submitter: <strong>@p.SubmitterName</strong> &bull; <i class="bi bi-geo-alt me-1"></i>@p.Venue</p>
                                        <small class="text-muted"><i class="bi bi-calendar me-1"></i>Proposed Date: @p.EventDate.ToString("MMMM dd, yyyy")</small>
                                    </div>
                                    <div class="d-flex gap-2 flex-shrink-0">
                                        <button class="btn btn-sm btn-success px-3"><i class="bi bi-check-lg me-1"></i>Endorse</button>
                                        <button class="btn btn-sm btn-outline-danger px-3"><i class="bi bi-x-lg me-1"></i>Reject</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- WEEKLY TEACHING & SEMINAR TIMETABLE -->
                <div class="card shadow-sm border-0 mb-4 dashboard-main-card">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h5 fw-bold mb-0 text-dark">
                                <i class="bi bi-calendar3 me-2 text-primary"></i>Weekly Academic Schedule & Lectures
                            </h2>
                            <small class="text-muted">Active classes, lab reviews, and colloquiums</small>
                        </div>
                        <a asp-controller="Calendar" asp-action="Index" class="btn btn-sm btn-outline-primary">Open Calendar</a>
                    </div>
                    <div class="card-body p-3">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small text-uppercase">
                                    <tr>
                                        <th>Day</th>
                                        <th>Course / Session</th>
                                        <th>Time Slot</th>
                                        <th>Classroom / Lab</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in Model.WeeklyClassSchedule)
                                    {
                                        <tr>
                                            <td class="fw-bold text-dark">@s.Day</td>
                                            <td>
                                                <span class="badge bg-primary-subtle text-primary me-1">@s.CourseCode</span>
                                                <span class="small fw-semibold text-dark">@s.CourseTitle</span>
                                            </td>
                                            <td class="small text-muted"><i class="bi bi-clock me-1"></i>@s.Time</td>
                                            <td class="small text-secondary"><i class="bi bi-geo-alt me-1 text-danger"></i>@s.Room</td>
                                            <td><span class="badge bg-success-subtle text-success">Scheduled</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>

            <!-- =====================================================
                 RIGHT SIDEBAR COLUMN
                 ===================================================== -->
            <div class="col-lg-4">

                <!-- FACULTY ACTIONS -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h2 class="h6 fw-bold mb-0 text-dark">
                            <i class="bi bi-grid-fill me-2 text-purple"></i>Faculty Actions
                        </h2>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-grid gap-2">
                            <a asp-controller="Events" asp-action="Create" class="btn btn-primary text-start d-flex align-items-center justify-content-between p-2 px-3" style="background-color: #7c3aed; border-color: #7c3aed;">
                                <span><i class="bi bi-plus-circle me-2"></i>Publish Academic Lecture</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                            <a asp-controller="Events" asp-action="MyEvents" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-journal-text me-2 text-primary"></i>My Published Seminars</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                            <a asp-controller="Announcements" asp-action="Index" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-megaphone me-2 text-danger"></i>Campus Bulletins & Notices</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                            <a asp-controller="Account" asp-action="Profile" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-person-badge me-2 text-secondary"></i>Faculty Profile</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- FACULTY NOTIFICATIONS -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <h2 class="h6 fw-bold mb-0 text-dark">
                            <i class="bi bi-bell-fill me-2 text-danger"></i>Academic Alerts
                        </h2>
                        <span class="badge bg-purple-subtle text-purple small">Real-Time</span>
                    </div>
                    <div class="card-body p-3">
                        <div class="notification-list d-flex flex-column gap-2">
                            @foreach (var n in Model.Notifications)
                            {
                                <div class="p-2 rounded-2 border @(n.IsRead ? "bg-white" : "bg-purple-subtle border-purple-subtle")">
                                    <p class="small text-dark mb-1">@n.Message</p>
                                    <small class="text-muted" style="font-size: 11px;"><i class="bi bi-clock me-1"></i>@n.CreatedAt.ToString("MMM dd, hh:mm tt")</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- RESEARCH SYMPOSIUMS CALL -->
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white border-bottom py-3">
                        <h2 class="h6 fw-bold mb-0 text-dark">
                            <i class="bi bi-award-fill me-2 text-warning"></i>Research Colloquium
                        </h2>
                    </div>
                    <div class="card-body p-3">
                        @foreach (var r in Model.ResearchSymposiums)
                        {
                            <div class="border-start border-3 border-purple ps-2">
                                <h6 class="small fw-bold text-dark mb-1">@r.Title</h6>
                                <p class="small text-muted mb-1">@r.ShortDescription</p>
                                <small class="text-primary fw-semibold"><i class="bi bi-geo-alt me-1"></i>@r.VenueName &bull; @r.StartDate.ToString("MMM dd")</small>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
