@model HawassaUnifiedCampusEventManagementSystem.Models.SuperAdminDashboardViewModel

@{
    ViewData["Title"] = "SuperAdmin Dashboard | HUCEMS";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-page superadmin-theme py-4">
    <div class="container-fluid px-lg-4">

        <!-- =====================================================
             SUPER ADMIN HERO BANNER & ROLE SWITCHER PREVIEW
             ===================================================== -->
        <div class="role-hero-banner superadmin-hero mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="hero-text">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-1 small text-white-50">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none"><i class="bi bi-house-door me-1"></i>Home</a></li>
                            <li class="breadcrumb-item active text-white" aria-current="page">SuperAdmin Console</li>
                        </ol>
                    </nav>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h1 class="hero-title h2 fw-bold text-white mb-0">SuperAdmin Overview &bull; @Model.UserName</h1>
                        <span class="badge role-badge bg-white text-dark fw-bold px-3 py-1 shadow-sm">
                            <i class="bi bi-shield-lock-fill me-1"></i> SUPER ADMINISTRATOR
                        </span>
                    </div>
                    <p class="text-white-50 mb-0 small">
                        <i class="bi bi-hdd-network me-1"></i> Hawassa University Portal &nbsp;•&nbsp; 
                        <i class="bi bi-shield-check me-1"></i> Security: <span class="text-white fw-semibold">RBAC Governed</span> &nbsp;•&nbsp;
                        <i class="bi bi-clock-history me-1"></i> Server: <span class="text-white fw-semibold">Active</span>
                    </p>
                </div>

                <div class="hero-actions d-flex flex-wrap align-items-center gap-2">
                    <a asp-controller="Admin" asp-action="SuperAdmin" class="btn btn-warning text-dark fw-bold shadow-sm d-inline-flex align-items-center gap-2 rounded-pill px-3">
                        <i class="bi bi-shield-check"></i>
                        <span>SuperAdmin Console</span>
                    </a>
                    <a asp-controller="Admin" asp-action="UserApprovals" class="btn btn-outline-light d-inline-flex align-items-center gap-2 rounded-pill px-3">
                        <i class="bi bi-person-check"></i>
                        <span>User Approvals (@Model.PendingUserApprovalsCount)</span>
                    </a>
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-light d-inline-flex align-items-center gap-2 rounded-pill px-3" title="Campus Operations View">
                        <i class="bi bi-grid-1x2"></i>
                        <span>Operations View</span>
                    </a>
                </div>
            </div>
        </div>

        @if (Model.PendingUserApprovalsCount > 0)
        {
            <!-- PENDING USER APPROVALS ATTENTION BANNER -->
            <div class="alert alert-warning border border-warning shadow-sm d-flex flex-wrap align-items-center justify-content-between gap-3 p-3 rounded-3 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-warning text-dark rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px;">
                        <i class="bi bi-person-check-fill fs-4"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1 text-dark">Pending User Account Approvals (@Model.PendingUserApprovalsCount)</h6>
                        <p class="mb-0 text-secondary small">
                            Campus Administrators have registered new user accounts that require your SuperAdmin review and activation.
                        </p>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <form asp-controller="Admin" asp-action="ApproveAllPending" method="post" class="d-inline" 
                          data-confirm="Approve and activate ALL @Model.PendingUserApprovalsCount pending accounts at once? This will grant immediate system access to all waiting campus users."
                          data-confirm-title="Confirm Mass User Activation"
                          data-confirm-btn="Approve All Now"
                          data-confirm-danger="false">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button type="submit" class="btn btn-success fw-semibold shadow-sm d-inline-flex align-items-center gap-1">
                            <i class="bi bi-check-all fs-6"></i>
                            <span>Approve All (@Model.PendingUserApprovalsCount)</span>
                        </button>
                    </form>
                    <a asp-controller="Admin" asp-action="UserApprovals" class="btn btn-warning text-dark fw-bold px-3 shadow-sm d-inline-flex align-items-center gap-1">
                        <i class="bi bi-shield-check"></i>
                        <span>Dedicated Approvals Center</span>
                    </a>
                </div>
            </div>
        }

        <!-- =====================================================
             SUPER ADMIN STATS COUNTERS
             ===================================================== -->
        <section class="dashboard-stat-grid mb-4">
            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-dark text-white rounded-3">
                        <i class="bi bi-people fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Total Registered Users</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.TotalSystemUsersCount.ToString("N0")</strong>
                        <span class="badge bg-primary-subtle text-primary small mt-1">Campus Community</span>
                    </div>
                </div>
            </div>

            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-primary-subtle text-primary rounded-3">
                        <i class="bi bi-calendar2-range-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Total Campus Events</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.TotalPlatformEventsCount</strong>
                        <span class="text-muted small d-block" style="font-size: 11px;">Published & Scheduled</span>
                    </div>
                </div>
            </div>

            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-success-subtle text-success rounded-3">
                        <i class="bi bi-check2-circle fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">System Roles & RBAC</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.TotalSystemRolesCount</strong>
                        <span class="badge bg-success-subtle text-success small mt-1">100% Enforced</span>
                    </div>
                </div>
            </div>

            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-info-subtle text-info-emphasis rounded-3">
                        <i class="bi bi-shield-lock-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Security Logs Today</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.SecurityAlertsCount</strong>
                        <span class="text-secondary small d-block" style="font-size: 11px;">Audit Log Entries</span>
                    </div>
                </div>
            </div>
        </section>

        <div class="row g-4">
            <!-- =====================================================
                 LEFT & MAIN COLUMN
                 ===================================================== -->
            <div class="col-lg-8">

                @if (Model.PendingUsersList.Any())
                {
                    <!-- PENDING USERS AWAITING SUPERADMIN APPROVAL QUEUE -->
                    <div class="card shadow-sm border border-warning mb-4 dashboard-main-card">
                        <div class="card-header bg-warning bg-opacity-10 border-bottom border-warning-subtle py-3 d-flex justify-content-between align-items-center">
                            <div>
                                <h2 class="h5 fw-bold mb-0 text-dark">
                                    <i class="bi bi-person-check-fill me-2 text-warning"></i>Users Awaiting SuperAdmin Approval & Activation
                                </h2>
                                <small class="text-secondary">Provisioned by Campus Administrators &bull; Requires SuperAdmin activation to grant login access</small>
                            </div>
                            <a asp-controller="Admin" asp-action="UserApprovals" class="btn btn-sm btn-warning text-dark fw-semibold">
                                View Full Queue (@Model.PendingUsersList.Count)
                            </a>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small text-uppercase">
                                        <tr>
                                            <th>Applicant User</th>
                                            <th>Role & Department</th>
                                            <th>Registered By</th>
                                            <th class="text-end">Direct Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var user in Model.PendingUsersList.Take(5))
                                        {
                                            <tr class="table-warning bg-opacity-25">
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="admin-avatar bg-warning text-dark fw-bold" style="width: 34px; height: 34px; font-size: 13px;">
                                                            @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                                                        </div>
                                                        <div>
                                                            <div class="fw-semibold text-dark small">@user.FullName</div>
                                                            <div class="text-muted" style="font-size: 11px;">@@@user.Username &bull; @user.Email</div>
                                                            @if (!string.IsNullOrEmpty(user.StudentOrEmployeeId))
                                                            {
                                                                <span class="badge bg-light text-secondary border" style="font-size: 10px;">ID: @user.StudentOrEmployeeId</span>
                                                            }
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-primary-subtle text-primary border px-2 py-0" style="font-size: 11px;">@user.AccountType</span>
                                                    <div class="text-secondary" style="font-size: 11px;">@user.DepartmentName</div>
                                                </td>
                                                <td>
                                                    <div class="small fw-semibold text-dark">
                                                        <i class="bi bi-person-gear text-primary me-1"></i>@user.RegisteredByAdminName
                                                    </div>
                                                    <small class="text-muted" style="font-size: 11px;">@user.RegisteredAt.ToString("MMM dd, hh:mm tt")</small>
                                                </td>
                                                <td class="text-end">
                                                    <div class="d-inline-flex align-items-center gap-1">
                                                        <form asp-controller="Admin" asp-action="UserApprove" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@user.Id" />
                                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                            <button type="submit" class="btn btn-sm btn-success py-1 px-2 fw-semibold shadow-sm" title="Approve & Activate">
                                                                <i class="bi bi-check-lg me-1"></i>Approve
                                                            </button>
                                                        </form>
                                                        <form asp-controller="Admin" asp-action="UserReject" method="post" class="d-inline" onsubmit="return confirm('Reject registration for @user.FullName?');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@user.Id" />
                                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                            <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" title="Reject">
                                                                <i class="bi bi-x-lg"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                <!-- REAL-TIME AUDIT SECURITY LOGS STREAM -->
                <div class="card shadow-sm border-0 mb-4 dashboard-main-card">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h5 fw-bold mb-0 text-dark">
                                <i class="bi bi-terminal-split me-2 text-dark"></i>Security Audit Stream
                            </h2>
                            <small class="text-muted">High-priority authentication events, role escalations, and system mutations</small>
                        </div>
                        <a asp-controller="Admin" asp-action="AuditLogs" class="btn btn-sm btn-dark">
                            Full Audit Vault
                        </a>
                    </div>
                    <div class="card-body p-3">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-dark small text-uppercase">
                                    <tr>
                                        <th>Action / Event</th>
                                        <th>Initiator</th>
                                        <th>IP & Gateway</th>
                                        <th>Timestamp</th>
                                        <th>Severity</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.RealtimeAuditLogs)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark">@log.Action</td>
                                            <td class="small text-muted">@log.UserEmail</td>
                                            <td class="small text-secondary font-monospace">@log.IpAddress</td>
                                            <td class="small text-muted">@log.Timestamp.ToString("hh:mm:ss tt")</td>
                                            <td>
                                                <span class="badge @(log.Severity == "Warning" ? "bg-warning text-dark" : log.Severity == "Success" ? "bg-success" : "bg-info text-dark")">
                                                    @log.Severity
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- SYSTEM SERVICES STATUS & ENGINE HEALTH -->
                <div class="card shadow-sm border-0 mb-4 dashboard-main-card">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h5 fw-bold mb-0 text-dark">
                                <i class="bi bi-server me-2 text-primary"></i>Core Infrastructure & Subsystem Telemetry
                            </h2>
                            <small class="text-muted">Distributed services, database cluster and notification message queues</small>
                        </div>
                        <span class="badge bg-success text-white px-2 py-1"><i class="bi bi-check-all me-1"></i>All Online</span>
                    </div>
                    <div class="card-body p-3">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small text-uppercase">
                                    <tr>
                                        <th>Subsystem Name</th>
                                        <th>Operational State</th>
                                        <th>Response Latency</th>
                                        <th>Health Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in Model.SystemServicesStatus)
                                    {
                                        <tr>
                                            <td class="fw-bold text-dark"><i class="bi bi-hdd-network me-2 text-primary"></i>@s.ServiceName</td>
                                            <td class="small">@s.Status</td>
                                            <td class="small font-monospace text-muted">@s.Latency</td>
                                            <td><span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle-fill me-1"></i>Passed</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>

            <!-- =====================================================
                 RIGHT SIDEBAR COLUMN
                 ===================================================== -->
            <div class="col-lg-4">

                <!-- SUPER ADMIN CONTROLS -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h2 class="h6 fw-bold mb-0 text-dark">
                            <i class="bi bi-shield-lock-fill me-2 text-dark"></i>SuperAdmin Controls
                        </h2>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-grid gap-2">
                            <a asp-controller="Clubs" asp-action="Index" class="btn btn-dark text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-stars me-2 text-warning"></i>Campus Clubs & Societies</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                            <a asp-controller="Admin" asp-action="Settings" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-sliders me-2 text-primary"></i>Global Platform Settings</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                            <a asp-controller="Admin" asp-action="Roles" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-person-lock me-2 text-primary"></i>Role Permissions Matrix</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                            <a asp-controller="Admin" asp-action="AuditLogs" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-file-earmark-lock2 me-2 text-danger"></i>Full System Audit Logs</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                            <a asp-controller="Admin" asp-action="DatabaseManagement" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-cloud-arrow-down me-2 text-success"></i>Database Management & Snapshots</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- USER POPULATION BY ROLE -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h2 class="h6 fw-bold mb-0 text-dark">
                            <i class="bi bi-pie-chart-fill me-2 text-primary"></i>Campus Role Population
                        </h2>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-flex flex-column gap-2">
                            @foreach (var r in Model.RolesDistribution)
                            {
                                <div class="d-flex justify-content-between align-items-center p-2 rounded-2 bg-light">
                                    <span class="small fw-semibold text-dark">@r.RoleName</span>
                                    <span class="badge @r.BadgeClass">@r.UserCount.ToString("N0")</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- EMERGENCY CAMPUS BROADCAST -->
                <div class="card shadow-sm border-0 bg-dark text-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-broadcast text-danger fs-4"></i>
                            <h6 class="fw-bold mb-0 text-white">Emergency Broadcast</h6>
                        </div>
                        <p class="small text-white-50 mb-3">
                            Instant push notification and banner alert to all active campus devices across all roles.
                        </p>
                        <a asp-controller="Admin" asp-action="Notifications" class="btn btn-sm btn-outline-light w-100">
                            Broadcast Emergency Alert
                        </a>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
