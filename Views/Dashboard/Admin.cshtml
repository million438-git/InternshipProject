@model HawassaUnifiedCampusEventManagementSystem.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard | HUCEMS";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-page admin-theme py-4">
    <div class="container-fluid px-lg-4">

        <!-- =====================================================
             ADMIN HERO BANNER & ROLE SWITCHER PREVIEW
             ===================================================== -->
        <div class="role-hero-banner admin-hero mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="hero-text">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-1 small text-white-50">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none"><i class="bi bi-house-door me-1"></i>Home</a></li>
                            <li class="breadcrumb-item active text-white" aria-current="page">Admin Command Console</li>
                        </ol>
                    </nav>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h1 class="hero-title h2 fw-bold text-white mb-0">Campus Administration &bull; @Model.UserName</h1>
                        <span class="badge role-badge bg-white text-danger fw-bold px-3 py-1 shadow-sm">
                            <i class="bi bi-shield-lock-fill me-1"></i> CAMPUS ADMIN
                        </span>
                    </div>
                    <p class="text-white-50 mb-0 small">
                        <i class="bi bi-person-gear me-1"></i> Role: <span class="text-white fw-semibold">Event Administrator & Moderator</span> &nbsp;•&nbsp; 
                        <i class="bi bi-building me-1"></i> Hawassa University Unified Campus &bull; Full Operational Control
                    </p>
                </div>

                <div class="hero-actions d-flex flex-wrap align-items-center gap-2">
                    <a asp-controller="Admin" asp-action="RegisterUser" class="btn btn-primary shadow-sm d-inline-flex align-items-center gap-2">
                        <i class="bi bi-person-plus-fill"></i>
                        <span>Register User</span>
                    </a>
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-danger shadow-sm d-inline-flex align-items-center gap-2" style="background-color: #e11d48; border-color: #e11d48;">
                        <i class="bi bi-speedometer2"></i>
                        <span>Admin Control Center</span>
                    </a>
                    <a asp-controller="Admin" asp-action="Events" class="btn btn-outline-light d-inline-flex align-items-center gap-2">
                        <i class="bi bi-check-circle"></i>
                        <span>Event Approvals (@Model.PendingEventApprovalsCount)</span>
                    </a>
                    <div class="dropdown">
                        <button class="btn btn-dark bg-dark-subtle border-0 text-white dropdown-toggle small px-2 py-2" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-arrow-left-right me-1"></i> Role Views
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li><h6 class="dropdown-header small">Switch Dashboard Preview</h6></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Student"><i class="bi bi-mortarboard me-2"></i>Student</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Staff"><i class="bi bi-briefcase me-2"></i>Staff</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Faculty"><i class="bi bi-journal-bookmark me-2"></i>Faculty</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Organization"><i class="bi bi-people me-2"></i>Organization</a></li>
                            <li><a class="dropdown-item active" asp-controller="Dashboard" asp-action="Admin"><i class="bi bi-shield-lock me-2"></i>Admin</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="SuperAdmin"><i class="bi bi-cpu me-2"></i>SuperAdmin</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- =====================================================
             ADMIN STATS COUNTERS
             ===================================================== -->
        <section class="dashboard-stat-grid mb-4">
            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-warning-subtle text-warning-emphasis rounded-3">
                        <i class="bi bi-hourglass-split fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Pending Approvals</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.PendingEventApprovalsCount</strong>
                        <span class="badge bg-warning-subtle text-warning-emphasis small mt-1">Requires Review</span>
                    </div>
                </div>
            </div>

            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-primary-subtle text-primary rounded-3">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Total Registered Users</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.TotalUsersCount</strong>
                        <span class="text-primary small d-block" style="font-size: 11px;">Active Campus Community</span>
                    </div>
                </div>
            </div>

            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-success-subtle text-success rounded-3">
                        <i class="bi bi-building-fill-check fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Campus Venues</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.ActiveVenuesCount</strong>
                        <span class="badge bg-success-subtle text-success small mt-1">100% Operational</span>
                    </div>
                </div>
            </div>

            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-danger-subtle text-danger rounded-3">
                        <i class="bi bi-flag-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Reported Content</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.ReportedContentCount</strong>
                        <span class="text-danger small d-block" style="font-size: 11px;">Flagged comments</span>
                    </div>
                </div>
            </div>
        </section>

        <div class="row g-4">
            <!-- =====================================================
                 LEFT & MAIN COLUMN
                 ===================================================== -->
            <div class="col-lg-8">

                <!-- PENDING EVENT APPROVALS QUEUE -->
                <div class="card shadow-sm border-0 mb-4 dashboard-main-card">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h5 fw-bold mb-0 text-dark">
                                <i class="bi bi-shield-check me-2 text-warning"></i>Event Approval Queue
                            </h2>
                            <small class="text-muted">Proposals submitted by campus student organizations, faculty and staff</small>
                        </div>
                        <a asp-controller="Admin" asp-action="Events" class="btn btn-sm btn-outline-warning text-dark fw-semibold">
                            Full Approval Queue
                        </a>
                    </div>
                    <div class="card-body p-3">
                        @if (Model.PendingEventApprovals != null && Model.PendingEventApprovals.Any())
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var app in Model.PendingEventApprovals)
                                {
                                    <div class="p-3 border rounded-3 bg-light d-flex justify-content-between align-items-center flex-wrap gap-3">
                                        <div>
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <h6 class="fw-bold text-dark mb-0">@app.EventTitle</h6>
                                                <span class="badge bg-warning-subtle text-warning-emphasis">Pending Admin Review</span>
                                            </div>
                                            <p class="small text-muted mb-1">
                                                <i class="bi bi-person me-1 text-primary"></i>Organizer: <strong>@app.SubmitterName</strong> &bull; 
                                                <i class="bi bi-geo-alt me-1 text-danger"></i>@app.Venue
                                            </p>
                                            <small class="text-muted"><i class="bi bi-clock me-1"></i>Scheduled for: @app.EventDate.ToString("MMM dd, yyyy")</small>
                                        </div>
                                        <div class="d-flex gap-2 flex-shrink-0">
                                            <a asp-controller="Admin" asp-action="Events" class="btn btn-sm btn-primary px-3 rounded-pill">Review in Events Hub</a>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted small">
                                <i class="bi bi-check2-circle text-success fs-3 mb-2 d-block"></i>
                                All event proposals are processed. No pending approvals in the queue.
                            </div>
                        }
                    </div>
                </div>

                <!-- CAMPUS VENUES UTILIZATION -->
                <div class="card shadow-sm border-0 mb-4 dashboard-main-card">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h5 fw-bold mb-0 text-dark">
                                <i class="bi bi-building me-2 text-primary"></i>Campus Facility & Venue Capacity
                            </h2>
                            <small class="text-muted">Real-time status of major campus event venues</small>
                        </div>
                        <a asp-controller="Admin" asp-action="Venues" class="btn btn-sm btn-outline-primary">Manage Venues</a>
                    </div>
                    <div class="card-body p-3">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small text-uppercase">
                                    <tr>
                                        <th>Venue Name</th>
                                        <th>Capacity</th>
                                        <th>Building</th>
                                        <th>Status</th>
                                        <th>Bookings</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var v in Model.CampusVenuesStatus)
                                    {
                                        <tr>
                                            <td class="fw-bold text-dark"><i class="bi bi-geo-alt-fill me-1 text-danger"></i>@v.Name</td>
                                            <td class="small">@v.Capacity seats</td>
                                            <td class="small text-muted">@v.Building</td>
                                            <td>
                                                <span class="badge @(v.Status.Contains("Available") ? "bg-success-subtle text-success" : v.Status.Contains("Occupied") ? "bg-primary-subtle text-primary" : "bg-warning-subtle text-warning-emphasis")">
                                                    @v.Status
                                                </span>
                                            </td>
                                            <td><span class="badge bg-secondary-subtle text-secondary">@v.ScheduledEventsCount events</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>

            <!-- =====================================================
                 RIGHT SIDEBAR COLUMN
                 ===================================================== -->
            <div class="col-lg-4">

                <!-- ADMIN CONTROL TOOLS -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h2 class="h6 fw-bold mb-0 text-dark">
                            <i class="bi bi-sliders me-2 text-danger"></i>Admin Management Hub
                        </h2>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-grid gap-2">
                            <a asp-controller="Admin" asp-action="RegisterUser" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-person-plus-fill me-2 text-primary"></i>Register New Campus User</span>
                                <span class="badge bg-primary-subtle text-primary small">Provision</span>
                            </a>
                            <a asp-controller="Clubs" asp-action="Index" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-stars me-2 text-warning"></i>Campus Clubs & Societies</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                            <a asp-controller="Admin" asp-action="Users" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-people me-2 text-primary"></i>User Accounts Directory</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                            <a asp-controller="Admin" asp-action="Events" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-calendar-event me-2 text-success"></i>Global Events Moderator</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                            <a asp-controller="Admin" asp-action="Venues" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-building me-2 text-warning"></i>Venues & Allocations</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                            <a asp-controller="Admin" asp-action="Reports" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-file-earmark-bar-graph me-2 text-info"></i>Audit & Analytics Reports</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- CATEGORY BREAKDOWN -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h2 class="h6 fw-bold mb-0 text-dark">
                            <i class="bi bi-pie-chart-fill me-2 text-info"></i>Event Category Metrics
                        </h2>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-flex flex-column gap-2">
                            @foreach (var cat in Model.CategoryBreakdown)
                            {
                                <div class="d-flex justify-content-between align-items-center small">
                                    <span class="text-dark fw-semibold">&bull; @cat.CategoryName</span>
                                    <span class="badge rounded-pill bg-light text-dark border">@cat.EventCount Events</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- FLAGGED CONTENT ALERTS -->
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <h2 class="h6 fw-bold mb-0 text-dark">
                            <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>Moderation Alerts
                        </h2>
                        <span class="badge bg-danger-subtle text-danger small">@Model.RecentFlaggedContent.Count</span>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-flex flex-column gap-2">
                            @foreach (var rep in Model.RecentFlaggedContent)
                            {
                                <div class="p-2 border rounded-2 bg-light">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <strong class="small text-danger">@rep.ContentType</strong>
                                        <span class="badge bg-warning-subtle text-warning-emphasis small" style="font-size: 10px;">@rep.Status</span>
                                    </div>
                                    <p class="small text-dark mb-1">Reason: @rep.Reason</p>
                                    <small class="text-muted" style="font-size: 11px;">By @rep.ReportedBy &bull; @rep.CreatedAt.ToString("MMM dd, hh:mm tt")</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
