@model HawassaUnifiedCampusEventManagementSystem.Models.StudentDashboardViewModel

@{
    ViewData["Title"] = "Student Dashboard | HUCEMS";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-page student-theme py-4">
    <div class="container-fluid px-lg-4">

        <!-- =====================================================
             STUDENT HERO BANNER & ROLE SWITCHER PREVIEW
             ===================================================== -->
        <div class="role-hero-banner student-hero mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="hero-text">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-1 small text-white-50">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none"><i class="bi bi-house-door me-1"></i>Home</a></li>
                            <li class="breadcrumb-item active text-white" aria-current="page">Student Dashboard</li>
                        </ol>
                    </nav>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h1 class="hero-title h2 fw-bold text-white mb-0">Welcome back, @Model.UserName! 🎓</h1>
                        <span class="badge role-badge bg-white text-primary fw-bold px-3 py-1 shadow-sm">
                            <i class="bi bi-mortarboard-fill me-1"></i> STUDENT
                        </span>
                    </div>
                    <p class="text-white-50 mb-0 small">
                        <i class="bi bi-building me-1"></i> @Model.UserDepartment &nbsp;•&nbsp; 
                        <i class="bi bi-person-vcard me-1"></i> ID: <span class="text-white fw-semibold">@Model.StudentId</span> &nbsp;•&nbsp;
                        <i class="bi bi-award me-1"></i> Hawassa University Main Campus
                    </p>
                </div>

                <div class="hero-actions d-flex flex-wrap align-items-center gap-2">
                    <a asp-controller="Events" asp-action="Index" class="btn btn-light btn-hero-primary shadow-sm d-inline-flex align-items-center gap-2">
                        <i class="bi bi-compass"></i>
                        <span>Explore Events</span>
                    </a>
                    <a asp-controller="Calendar" asp-action="Index" class="btn btn-outline-light d-inline-flex align-items-center gap-2">
                        <i class="bi bi-calendar3"></i>
                        <span>My Schedule</span>
                    </a>
                    <!-- Quick Role Preview Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-dark bg-dark-subtle border-0 text-white dropdown-toggle small px-2 py-2" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-arrow-left-right me-1"></i> Role Views
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li><h6 class="dropdown-header small">Switch Dashboard Preview</h6></li>
                            <li><a class="dropdown-item active" asp-controller="Dashboard" asp-action="Student"><i class="bi bi-mortarboard me-2"></i>Student</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Staff"><i class="bi bi-briefcase me-2"></i>Staff</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Faculty"><i class="bi bi-journal-bookmark me-2"></i>Faculty</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Organization"><i class="bi bi-people me-2"></i>Organization</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Admin"><i class="bi bi-shield-lock me-2"></i>Admin</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="SuperAdmin"><i class="bi bi-cpu me-2"></i>SuperAdmin</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- =====================================================
             STUDENT STATS COUNTERS
             ===================================================== -->
        <section class="dashboard-stat-grid mb-4">
            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-primary-subtle text-primary rounded-3">
                        <i class="bi bi-ticket-perforated-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Registered Events</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.RegisteredEventsCount</strong>
                        <span class="badge bg-success-subtle text-success small mt-1"><i class="bi bi-check-circle me-1"></i>Active</span>
                    </div>
                </div>
            </div>

            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-success-subtle text-success rounded-3">
                        <i class="bi bi-check2-all fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Attended Sessions</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.AttendedEventsCount</strong>
                        <span class="text-muted small d-block" style="font-size: 11px;">This Academic Year</span>
                    </div>
                </div>
            </div>

            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-warning-subtle text-warning-emphasis rounded-3">
                        <i class="bi bi-mortarboard-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Workshops Enrolled</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.UpcomingWorkshopsCount</strong>
                        <span class="badge bg-warning-subtle text-warning-emphasis small mt-1">Active Workshops</span>
                    </div>
                </div>
            </div>

            <div class="dashboard-stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper bg-info-subtle text-info-emphasis rounded-3">
                        <i class="bi bi-patch-check-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="stat-label text-muted small d-block">Certificates Earned</span>
                        <strong class="stat-number fs-3 fw-bold text-dark">@Model.EarnedCertificatesCount</strong>
                        <span class="text-primary small d-block" style="font-size: 11px;">Verified digital badges</span>
                    </div>
                </div>
            </div>
        </section>

        <div class="row g-4">
            <!-- =====================================================
                 LEFT & MAIN COLUMN
                 ===================================================== -->
            <div class="col-lg-8">

                <!-- MY REGISTERED & UPCOMING EVENTS -->
                <div class="card shadow-sm border-0 mb-4 dashboard-main-card">
                    <div class="card-header bg-white border-bottom py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <h2 class="h5 fw-bold mb-0 text-dark">
                                <i class="bi bi-calendar-check-fill me-2 text-primary"></i>My Enrolled Campus Events
                            </h2>
                            <small class="text-muted">Your registered upcoming sessions & workshops</small>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <a asp-controller="Events" asp-action="Index" class="btn btn-sm btn-primary">
                                <i class="bi bi-plus-circle me-1"></i> Register More
                            </a>
                        </div>
                    </div>

                    <div class="card-body p-3">
                        <div class="event-list d-flex flex-column gap-3">
                            @foreach (var ev in Model.MyRegisteredEvents)
                            {
                                <article class="dashboard-event-item card border p-3 rounded-3 shadow-none hover-shadow transition">
                                    <div class="d-flex flex-wrap flex-md-nowrap align-items-center gap-3">
                                        
                                        <!-- DATE BADGE -->
                                        <div class="event-date-badge text-center rounded-3 p-2 bg-primary-subtle border border-primary-subtle flex-shrink-0" style="min-width: 70px;">
                                            <span class="d-block small text-uppercase fw-bold text-primary">@ev.StartDate.ToString("MMM")</span>
                                            <strong class="fs-4 d-block fw-bold text-dark">@ev.StartDate.Day</strong>
                                            <span class="d-block text-muted" style="font-size: 11px;">@ev.StartDate.ToString("ddd")</span>
                                        </div>

                                        <!-- EVENT INFO -->
                                        <div class="event-information flex-grow-1">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <span class="badge bg-primary text-white small px-2 py-1">
                                                    @ev.CategoryName
                                                </span>
                                                <span class="badge bg-success-subtle text-success small px-2 py-1">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Registered
                                                </span>
                                                <small class="text-muted"><i class="bi bi-clock me-1"></i>@ev.StartDate.ToString("hh:mm tt")</small>
                                            </div>

                                            <h3 class="h6 fw-bold text-dark mb-1">
                                                <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.Id" class="text-dark text-decoration-none hover-primary">
                                                    @ev.Title
                                                </a>
                                            </h3>

                                            @if (!string.IsNullOrEmpty(ev.ShortDescription))
                                            {
                                                <p class="text-muted small mb-2 text-truncate-2">@ev.ShortDescription</p>
                                            }

                                            <div class="d-flex flex-wrap align-items-center gap-3 text-muted small">
                                                <span><i class="bi bi-geo-alt-fill me-1 text-danger"></i>@ev.VenueName</span>
                                                <span><i class="bi bi-person-fill me-1 text-primary"></i>Hosted by @ev.OrganizerName</span>
                                            </div>
                                        </div>

                                        <!-- ACTION BUTTON -->
                                        <div class="flex-shrink-0 text-end">
                                            <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-primary px-3">
                                                Ticket / Pass <i class="bi bi-qr-code ms-1"></i>
                                            </a>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    </div>
                </div>

                <!-- RECOMMENDED CLUBS & COMMUNITIES -->
                <div class="card shadow-sm border-0 dashboard-announcements-card">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h5 fw-bold mb-0 text-dark">
                                <i class="bi bi-stars me-2 text-warning"></i>Explore Campus Clubs & Societies
                            </h2>
                            <small class="text-muted">Connect with student organizations at Hawassa University</small>
                        </div>
                        <a asp-controller="Community" asp-action="Index" class="btn btn-sm btn-outline-primary">Browse All</a>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-flex flex-column gap-3">
                            @foreach (var club in Model.RecommendedClubs)
                            {
                                <div class="p-3 bg-light rounded-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <h6 class="fw-bold mb-0 text-dark">@club.Name</h6>
                                            <span class="badge bg-info-subtle text-info-emphasis small">@club.Category</span>
                                        </div>
                                        <p class="small text-muted mb-0">@club.Description</p>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                        <span class="small text-muted me-2"><i class="bi bi-people me-1"></i>@club.MemberCount students</span>
                                        <button class="btn btn-sm btn-outline-primary px-3">Join Club</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>

            <!-- =====================================================
                 RIGHT SIDEBAR COLUMN
                 ===================================================== -->
            <div class="col-lg-4">

                <!-- STUDENT QUICK ACTIONS -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h2 class="h6 fw-bold mb-0 text-dark">
                            <i class="bi bi-grid-fill me-2 text-primary"></i>Student Quick Services
                        </h2>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-grid gap-2">
                            <a asp-controller="Events" asp-action="Create" class="btn btn-primary text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-plus-circle me-2"></i>Propose a Student Event</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                            <a asp-controller="Calendar" asp-action="Index" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-calendar2-week me-2 text-success"></i>My Event Calendar</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                            <a asp-controller="Community" asp-action="Index" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-chat-dots me-2 text-info"></i>Campus Discussion Board</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                            <a asp-controller="Account" asp-action="Profile" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-2 px-3">
                                <span><i class="bi bi-person-badge me-2 text-secondary"></i>Student Profile & ID</span>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- CAMPUS NOTIFICATIONS -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <h2 class="h6 fw-bold mb-0 text-dark">
                            <i class="bi bi-bell-fill me-2 text-danger"></i>Student Activity Feed
                        </h2>
                        <span class="badge bg-danger-subtle text-danger small">@Model.Notifications.Count unread</span>
                    </div>
                    <div class="card-body p-3">
                        <div class="notification-list d-flex flex-column gap-2">
                            @foreach (var n in Model.Notifications)
                            {
                                <div class="p-2 rounded-2 border @(n.IsRead ? "bg-white" : "bg-primary-subtle border-primary-subtle")">
                                    <p class="small text-dark mb-1">@n.Message</p>
                                    <small class="text-muted" style="font-size: 11px;"><i class="bi bi-clock me-1"></i>@n.CreatedAt.ToString("MMM dd, hh:mm tt")</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- ANNOUNCEMENTS HIGHLIGHT -->
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white border-bottom py-3">
                        <h2 class="h6 fw-bold mb-0 text-dark">
                            <i class="bi bi-megaphone-fill me-2 text-warning"></i>Official Campus Bulletins
                        </h2>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-flex flex-column gap-3">
                            @foreach (var a in Model.RecentAnnouncements.Take(2))
                            {
                                <div class="border-start border-3 border-warning ps-2">
                                    <h6 class="small fw-bold text-dark mb-1">@a.Title</h6>
                                    <p class="small text-muted mb-1 text-truncate-2">@a.Content</p>
                                    <small class="text-muted" style="font-size: 11px;">@a.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
