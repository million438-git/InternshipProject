@model HawassaUnifiedCampusEventManagementSystem.Models.DashboardViewModel

@{
    ViewData["Title"] = "Campus Dashboard | HUCEMS";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-page py-4">
    <div class="container-fluid px-lg-4">
        <!-- Role Redirection Notice if routed here directly -->
        <div class="alert alert-primary d-flex align-items-center justify-content-between p-3 rounded-3 shadow-sm mb-4">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-info-circle-fill fs-3 text-primary"></i>
                <div>
                    <h5 class="alert-heading fw-bold mb-0">Unified Campus Dashboard</h5>
                    <p class="small mb-0 text-muted">You are viewing the general campus dashboard for <strong>@Model.UserName</strong> (@Model.UserRole).</p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="@Model.UserRole" class="btn btn-primary btn-sm">Go to @Model.UserRole Dashboard</a>
            </div>
        </div>

        <div class="dashboard-header-wrapper mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h1 class="dashboard-title h2 fw-bold text-dark mb-1">
                        Welcome, @Model.UserName
                    </h1>
                    <div class="d-flex flex-wrap align-items-center gap-2 text-muted small">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                            <i class="bi bi-person-badge me-1"></i>@Model.UserRole
                        </span>
                        <span>•</span>
                        <span><i class="bi bi-building me-1"></i>@Model.UserDepartment</span>
                        <span>•</span>
                        <span><i class="bi bi-upc-scan me-1"></i>@Model.UserId</span>
                    </div>
                </div>

                @if (!User.IsInRole("Student") && !User.IsInRole("STUDENT") && 
                     (User.IsInRole("Faculty") || User.IsInRole("Staff") || User.IsInRole("Organization") || User.IsInRole("Club") || User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("FACULTY") || User.IsInRole("STAFF") || User.IsInRole("ORGANIZATION") || User.IsInRole("ADMIN") || User.IsInRole("SUPERADMIN")))
                {
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Events" asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm">
                            <i class="bi bi-plus-lg"></i>
                            <span>Create Event</span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>