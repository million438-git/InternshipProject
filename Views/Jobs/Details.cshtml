@model JobApplicationViewModel
@{
    var job = ViewBag.Job as JobPostingItem;
    ViewData["Title"] = job != null ? job.Title : "Job Details";
}

@section Styles {
    <link rel="stylesheet" href="~/css/jobs.css" asp-append-version="true" />
}

<div class="jobs-page py-5">
    <div class="container">

        <!-- BREADCRUMB -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Jobs" asp-action="Index">Careers & Jobs</a></li>
                <li class="breadcrumb-item active" aria-current="page">@(job?.Title ?? "Details")</li>
            </ol>
        </nav>

        <!-- ALERTS -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (job != null)
        {
            <div class="row g-4">
                <!-- =======================================================
                     JOB SPECIFICATION & OVERVIEW (LEFT COLUMN)
                     ======================================================= -->
                <div class="col-lg-8 col-12">
                    <div class="card border-0 rounded-4 p-4 p-md-5 shadow-sm mb-4" style="background: var(--bg-card, #ffffff);">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                            <div>
                                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 fw-bold mb-2">
                                    @job.JobType.Replace("_", " ")
                                </span>
                                <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1 mb-2">
                                    @job.WorkplaceType.Replace("_", " ")
                                </span>
                                <h1 class="h2 fw-bold text-dark mb-2">@job.Title</h1>
                                <p class="text-primary fw-semibold fs-5 mb-0">
                                    <i class="bi bi-building me-1"></i> @job.CompanyOrDepartment
                                </p>
                            </div>

                            @if (job.SalaryMin.HasValue && job.SalaryMax.HasValue)
                            {
                                <div class="bg-light p-3 rounded-4 border text-end">
                                    <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 10px;">Monthly Compensation</small>
                                    <span class="fs-4 fw-bold text-success">@job.SalaryMin.Value.ToString("N0") - @job.SalaryMax.Value.ToString("N0")</span>
                                    <small class="text-muted">@job.SalaryCurrency</small>
                                </div>
                            }
                        </div>

                        <hr class="my-4 opacity-25" />

                        <!-- DESCRIPTION -->
                        <div class="mb-5">
                            <h2 class="h5 fw-bold mb-3"><i class="bi bi-card-text text-primary me-2"></i>Opportunity Overview</h2>
                            <p class="text-muted" style="line-height: 1.8; font-size: 1.05rem;">
                                @job.Description
                            </p>
                        </div>

                        <!-- RESPONSIBILITIES -->
                        @if (!string.IsNullOrWhiteSpace(job.Responsibilities))
                        {
                            <div class="mb-5">
                                <h2 class="h5 fw-bold mb-3"><i class="bi bi-list-check text-primary me-2"></i>Key Responsibilities</h2>
                                <p class="text-muted" style="line-height: 1.8;">
                                    @job.Responsibilities
                                </p>
                            </div>
                        }

                        <!-- REQUIREMENTS -->
                        @if (!string.IsNullOrWhiteSpace(job.Requirements))
                        {
                            <div class="mb-4">
                                <h2 class="h5 fw-bold mb-3"><i class="bi bi-patch-check text-primary me-2"></i>Candidate Qualifications & Requirements</h2>
                                <p class="text-muted" style="line-height: 1.8;">
                                    @job.Requirements
                                </p>
                            </div>
                        }
                    </div>

                    <!-- APPLICATION FORM -->
                    <div class="card border-0 rounded-4 p-4 p-md-5 shadow-sm" id="applySection" style="background: var(--bg-card, #ffffff);">
                        <h2 class="h4 fw-bold mb-2"><i class="bi bi-send-check text-primary me-2"></i>Submit Your Application</h2>
                        <p class="text-muted small mb-4">Complete the fields below to apply directly to @job.CompanyOrDepartment.</p>

                        <form asp-action="Apply" asp-route-id="@job.Id" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="JobPostingId" />

                            <div class="row g-3">
                                <div class="col-md-6 col-12">
                                    <label asp-for="FullName" class="form-label fw-semibold small">Full Name *</label>
                                    <input asp-for="FullName" class="form-control" placeholder="e.g. Marta Alemu" required />
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 col-12">
                                    <label asp-for="Email" class="form-label fw-semibold small">University or Personal Email *</label>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="marta@hawassa.edu.et" required />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 col-12">
                                    <label asp-for="Phone" class="form-label fw-semibold small">Contact Phone *</label>
                                    <input asp-for="Phone" class="form-control" placeholder="+251 91 234 5678" required />
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 col-12">
                                    <label asp-for="StudentId" class="form-label fw-semibold small">Student ID / Employee ID</label>
                                    <input asp-for="StudentId" class="form-control" placeholder="e.g. HU/1423/14" />
                                </div>

                                <div class="col-md-6 col-12">
                                    <label asp-for="YearOfStudy" class="form-label fw-semibold small">Academic Year / Status</label>
                                    <select asp-for="YearOfStudy" class="form-select">
                                        <option value="1st Year">1st Year Undergraduate</option>
                                        <option value="2nd Year">2nd Year Undergraduate</option>
                                        <option value="3rd Year">3rd Year Undergraduate</option>
                                        <option value="4th Year / Senior">4th Year / Senior Undergraduate</option>
                                        <option value="Postgraduate / Master's">Postgraduate / Master's Student</option>
                                        <option value="Alumni / Graduate">Alumni / Graduate</option>
                                    </select>
                                </div>

                                <div class="col-md-6 col-12">
                                    <label asp-for="PortfolioUrl" class="form-label fw-semibold small">Portfolio / GitHub / LinkedIn URL</label>
                                    <input asp-for="PortfolioUrl" type="url" class="form-control" placeholder="https://linkedin.com/in/yourprofile" />
                                </div>

                                <div class="col-12">
                                    <label asp-for="CoverLetter" class="form-label fw-semibold small">Brief Statement / Why you are a great fit *</label>
                                    <textarea asp-for="CoverLetter" rows="4" class="form-control" 
                                              placeholder="Highlight your relevant coursework, technical skills, previous projects, and availability..." required></textarea>
                                    <span asp-validation-for="CoverLetter" class="text-danger small"></span>
                                </div>

                                <div class="col-12 mt-4">
                                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold rounded-pill shadow">
                                        <i class="bi bi-send-fill me-2"></i> Submit Application Now
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- =======================================================
                     SIDEBAR & KEY DATES (RIGHT COLUMN)
                     ======================================================= -->
                <div class="col-lg-4 col-12">
                    <div class="card border-0 rounded-4 p-4 shadow-sm mb-4" style="background: var(--bg-card, #ffffff);">
                        <h2 class="h5 fw-bold mb-4">Opportunity Details</h2>

                        <ul class="list-unstyled d-flex flex-column gap-3 mb-4">
                            <li class="d-flex align-items-center gap-3">
                                <div class="p-2 rounded-3 bg-primary-subtle text-primary">
                                    <i class="bi bi-geo-alt fs-5"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Location</small>
                                    <span class="fw-semibold">@job.Location</span>
                                </div>
                            </li>

                            <li class="d-flex align-items-center gap-3">
                                <div class="p-2 rounded-3 bg-info-subtle text-info">
                                    <i class="bi bi-clock-history fs-5"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Job Schedule</small>
                                    <span class="fw-semibold">@job.JobType.Replace("_", " ")</span>
                                </div>
                            </li>

                            <li class="d-flex align-items-center gap-3">
                                <div class="p-2 rounded-3 bg-warning-subtle text-warning">
                                    <i class="bi bi-calendar-x fs-5"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Application Deadline</small>
                                    <span class="fw-semibold text-danger">@(job.DeadlineAt?.ToString("MMM dd, yyyy") ?? "Open until filled")</span>
                                </div>
                            </li>

                            <li class="d-flex align-items-center gap-3">
                                <div class="p-2 rounded-3 bg-success-subtle text-success">
                                    <i class="bi bi-people fs-5"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Applicants</small>
                                    <span class="fw-semibold">@job.TotalApplicants Students Applied</span>
                                </div>
                            </li>
                        </ul>

                        <a href="#applySection" class="btn btn-primary w-100 fw-bold rounded-pill py-2">
                            Apply for this Position
                        </a>
                    </div>

                    <!-- CONTACT & INQUIRIES -->
                    <div class="card border-0 rounded-4 p-4 shadow-sm text-center" style="background: var(--bg-card, #ffffff);">
                        <i class="bi bi-headset text-primary mb-2" style="font-size: 2rem;"></i>
                        <h3 class="h6 fw-bold mb-1">Questions regarding this opening?</h3>
                        <p class="text-muted small mb-3">Reach out directly to the posting department coordinator.</p>
                        <a href="mailto:@job.ApplicationEmail" class="btn btn-sm btn-outline-secondary rounded-pill">
                            <i class="bi bi-envelope me-1"></i> @job.ApplicationEmail
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
