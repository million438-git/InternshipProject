@model JobCreateViewModel
@{
    ViewData["Title"] = "Post New Campus Career Opportunity";
}

@section Styles {
    <link rel="stylesheet" href="~/css/jobs.css" asp-append-version="true" />
}

<div class="jobs-page py-5">
    <div class="container" style="max-width: 850px;">

        <!-- BREADCRUMB -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Jobs" asp-action="Index">Careers & Jobs</a></li>
                <li class="breadcrumb-item active" aria-current="page">Post New Opportunity</li>
            </ol>
        </nav>

        <div class="card border-0 rounded-4 p-4 p-md-5 shadow-sm" style="background: var(--bg-card, #ffffff);">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="p-3 bg-primary-subtle text-primary rounded-4">
                    <i class="bi bi-briefcase-fill fs-3"></i>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1">Post Campus Career Opening</h1>
                    <p class="text-muted small mb-0">Publish an internship, work-study position, or assistantship for Hawassa University students.</p>
                </div>
            </div>

            <hr class="my-4 opacity-25" />

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Title" class="form-label fw-semibold small">Opportunity Title *</label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Software Engineering Intern" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 col-12">
                        <label asp-for="CompanyOrDepartment" class="form-label fw-semibold small">Hosting Department / Unit *</label>
                        <input asp-for="CompanyOrDepartment" class="form-control" placeholder="e.g. College of Informatics" required />
                        <span asp-validation-for="CompanyOrDepartment" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 col-12">
                        <label asp-for="Location" class="form-label fw-semibold small">Campus Location</label>
                        <input asp-for="Location" class="form-control" placeholder="e.g. Main Campus, Tech Center" />
                    </div>

                    <div class="col-md-6 col-12">
                        <label asp-for="JobType" class="form-label fw-semibold small">Employment Type *</label>
                        <select asp-for="JobType" class="form-select">
                            <option value="INTERNSHIP">Internship</option>
                            <option value="PART_TIME">Part-Time / Student Job</option>
                            <option value="FULL_TIME">Full-Time Staff</option>
                            <option value="VOLUNTEER">Volunteer</option>
                        </select>
                    </div>

                    <div class="col-md-6 col-12">
                        <label asp-for="WorkplaceType" class="form-label fw-semibold small">Workplace Type *</label>
                        <select asp-for="WorkplaceType" class="form-select">
                            <option value="ON_SITE">On-Site Campus</option>
                            <option value="HYBRID">Hybrid</option>
                            <option value="REMOTE">Remote</option>
                        </select>
                    </div>

                    <div class="col-md-6 col-12">
                        <label asp-for="SalaryMin" class="form-label fw-semibold small">Monthly Compensation (Min ETB)</label>
                        <input asp-for="SalaryMin" type="number" class="form-control" placeholder="4000" />
                    </div>

                    <div class="col-md-6 col-12">
                        <label asp-for="SalaryMax" class="form-label fw-semibold small">Monthly Compensation (Max ETB)</label>
                        <input asp-for="SalaryMax" type="number" class="form-control" placeholder="6500" />
                    </div>

                    <div class="col-md-6 col-12">
                        <label asp-for="ApplicationEmail" class="form-label fw-semibold small">Department Contact Email *</label>
                        <input asp-for="ApplicationEmail" type="email" class="form-control" placeholder="careers@hawassa.edu.et" required />
                        <span asp-validation-for="ApplicationEmail" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 col-12">
                        <label asp-for="DeadlineAt" class="form-label fw-semibold small">Application Deadline</label>
                        <input asp-for="DeadlineAt" type="date" class="form-control" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold small">Opportunity Overview *</label>
                        <textarea asp-for="Description" rows="4" class="form-control" placeholder="Describe the role, team, and objectives..." required></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Requirements" class="form-label fw-semibold small">Candidate Qualifications & Skills</label>
                        <textarea asp-for="Requirements" rows="3" class="form-control" placeholder="List required skills, department, CGPA, or coursework..."></textarea>
                    </div>

                    <div class="col-12">
                        <label asp-for="Responsibilities" class="form-label fw-semibold small">Key Responsibilities</label>
                        <textarea asp-for="Responsibilities" rows="3" class="form-control" placeholder="List core daily tasks and project milestones..."></textarea>
                    </div>

                    <div class="col-12 mt-4 d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">Cancel</a>
                        <button type="submit" class="btn btn-primary px-5 fw-bold rounded-pill shadow">
                            <i class="bi bi-check-lg me-1"></i> Publish Opportunity
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
