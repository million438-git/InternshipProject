@model JobListViewModel
@{
    ViewData["Title"] = "Campus Career & Student Employment";
}

@section Styles {
    <link rel="stylesheet" href="~/css/jobs.css" asp-append-version="true" />
}

<div class="jobs-page">

    <!-- =======================================================
         HERO BANNER
         ======================================================= -->
    <section class="jobs-hero">
        <div class="container text-center">
            <div class="jobs-hero-badge">
                <i class="bi bi-briefcase-fill me-1"></i> Hawassa University Career & Employment Hub
            </div>
            <h1 class="jobs-hero-title">
                Explore Student Jobs & Internships
            </h1>
            <p class="jobs-hero-subtitle mx-auto">
                Discover on-campus work-study positions, graduate assistantships, industry research internships, and department job openings across Hawassa University.
            </p>

            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("Faculty") || User.IsInRole("Staff") ||
                 User.IsInRole("ADMIN") || User.IsInRole("SUPERADMIN") || User.IsInRole("FACULTY") || User.IsInRole("STAFF"))
            {
                <div class="mt-4">
                    <a asp-action="Create" class="btn btn-primary px-4 py-2 fw-semibold rounded-pill shadow-sm">
                        <i class="bi bi-plus-circle me-1"></i> Post New Campus Opening
                    </a>
                </div>
            }
        </div>
    </section>

    <div class="container py-5">

        <!-- ALERTS -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- =======================================================
             SEARCH & FILTER BAR
             ======================================================= -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-5" style="background: var(--bg-card, #ffffff);">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-lg-5 col-md-12">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="search" class="form-control border-start-0" 
                               placeholder="Search job title, skills, department..." value="@Model.SearchQuery" />
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <select name="jobType" class="form-select">
                        <option value="">All Employment Types</option>
                        <option value="INTERNSHIP" selected="@(Model.SelectedJobType == "INTERNSHIP")">Internship</option>
                        <option value="PART_TIME" selected="@(Model.SelectedJobType == "PART_TIME")">Part-Time / Student Job</option>
                        <option value="FULL_TIME" selected="@(Model.SelectedJobType == "FULL_TIME")">Full-Time Staff</option>
                        <option value="VOLUNTEER" selected="@(Model.SelectedJobType == "VOLUNTEER")">Volunteer / Community</option>
                    </select>
                </div>

                <div class="col-lg-2 col-md-6">
                    <select name="workplaceType" class="form-select">
                        <option value="">All Locations</option>
                        <option value="ON_SITE" selected="@(Model.SelectedWorkplaceType == "ON_SITE")">On-Site Campus</option>
                        <option value="HYBRID" selected="@(Model.SelectedWorkplaceType == "HYBRID")">Hybrid</option>
                        <option value="REMOTE" selected="@(Model.SelectedWorkplaceType == "REMOTE")">Remote</option>
                    </select>
                </div>

                <div class="col-lg-2 col-md-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters">
                        <i class="bi bi-arrow-clockwise"></i>
                    </a>
                </div>
            </form>
        </div>

        <!-- =======================================================
             RESULTS HEADER
             ======================================================= -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h5 fw-bold mb-0">
                <span class="text-primary fw-extrabold">@Model.TotalActiveOpportunities</span> Active Opportunities Available
            </h2>
            <span class="text-muted small">Updated daily by university faculties</span>
        </div>

        <!-- =======================================================
             JOB CARDS GRID
             ======================================================= -->
        @if (Model.Jobs.Any())
        {
            <div class="row g-4">
                @foreach (var job in Model.Jobs)
                {
                    <div class="col-lg-6 col-12">
                        <div class="card h-100 border rounded-4 p-4 shadow-sm transition-hover" 
                             style="background: var(--bg-card, #ffffff); border-color: var(--border-color, #e2e8f0);">
                            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                <div>
                                    <span class="badge @(job.JobType == "INTERNSHIP" ? "bg-primary-subtle text-primary" : "bg-success-subtle text-success") rounded-pill px-3 py-1 fw-bold mb-2">
                                        @job.JobType.Replace("_", " ")
                                    </span>
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1 mb-2">
                                        @job.WorkplaceType.Replace("_", " ")
                                    </span>
                                    <h3 class="h5 fw-bold mb-1">
                                        <a asp-action="Details" asp-route-id="@job.Id" class="text-decoration-none text-dark hover-primary">
                                            @job.Title
                                        </a>
                                    </h3>
                                    <p class="text-primary fw-semibold small mb-0">
                                        <i class="bi bi-building me-1"></i> @job.CompanyOrDepartment
                                    </p>
                                </div>
                                <div class="text-end">
                                    @if (job.SalaryMin.HasValue && job.SalaryMax.HasValue)
                                    {
                                        <div class="fw-bold text-success fs-6">
                                            @job.SalaryMin.Value.ToString("N0") - @job.SalaryMax.Value.ToString("N0") <small class="text-muted fs-7">@job.SalaryCurrency/mo</small>
                                        </div>
                                    }
                                </div>
                            </div>

                            <p class="text-muted small mb-4 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.6;">
                                @job.Description
                            </p>

                            <hr class="my-3 opacity-25" />

                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <div class="small text-muted d-flex align-items-center gap-3">
                                    <span><i class="bi bi-geo-alt me-1"></i> @job.Location</span>
                                    <span><i class="bi bi-people me-1"></i> @job.TotalApplicants Applicants</span>
                                </div>
                                <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-sm btn-outline-primary px-3 rounded-pill fw-semibold">
                                    View Details & Apply <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-briefcase text-muted" style="font-size: 3.5rem;"></i>
                <h3 class="fw-bold mt-3">No Opportunities Found</h3>
                <p class="text-muted">Try adjusting your search criteria or explore other employment categories.</p>
                <a asp-action="Index" class="btn btn-primary rounded-pill px-4">View All Jobs</a>
            </div>
        }
    </div>
</div>
