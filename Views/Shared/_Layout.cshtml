@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta http-equiv="X-UA-Compatible"
          content="IE=edge" />

    <title>
        @ViewData["Title"] - HUCEMS
    </title>

    <meta name="description"
          content="Hawassa Unified Campus Event Management System - A centralized platform for campus events, community activities, announcements and student engagement." />

    <meta name="keywords"
          content="Hawassa University, HUCEMS, campus events, university events, student events, campus management, Ethiopia" />

    <meta name="author"
          content="Hawassa Unified Campus Event Management System" />

    <meta name="theme-color"
          content="#0f172a" />

    <!-- Theme Initialization Script (Prevents FOUC) -->
    <script>
        (function() {
            var saved = localStorage.getItem('hucems-theme');
            var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            var theme = saved ? saved : (prefersDark ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
            if (theme === 'dark') document.documentElement.classList.add('dark-theme');
        })();
    </script>


    <!-- Google Fonts: Plus Jakarta Sans & Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- =====================================================
         BOOTSTRAP
         ===================================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- =====================================================
         BOOTSTRAP ICONS
         ===================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- =====================================================
         GLOBAL CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <!-- =====================================================
         ACCOUNT CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/account.css"
          asp-append-version="true" />


    <!-- =====================================================
         RESPONSIVE CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/responsive.css"
          asp-append-version="true" />


    <!-- =====================================================
         PAGE SPECIFIC CSS
         ===================================================== -->

    @await RenderSectionAsync(
        "Styles",
        required: false
    )

</head>


<body>

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <header>

        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid px-3 px-xl-4">

                <!-- BRAND -->
                <a class="navbar-brand d-flex align-items-center gap-2 me-3"
                   asp-controller="Home"
                   asp-action="Index"
                   aria-label="HUCEMS Home">
                    <span class="brand-icon">🎓</span>
                    <span class="brand-text">HUCEMS</span>
                </a>

                <!-- MOBILE MENU TOGGLER -->
                <button class="navbar-toggler border-0 shadow-none"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- NAVIGATION CONTENT -->
                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- PRIMARY LINKS (LEFT) -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">

                        <!-- HOME -->
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
                               asp-controller="Home"
                               asp-action="Index">
                                <i class="bi bi-house-door"></i>
                                <span>Home</span>
                            </a>
                        </li>

                        <!-- EXPLORE EVENTS -->
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Events" && currentAction == "Index" ? "active" : "")"
                               asp-controller="Events"
                               asp-action="Index">
                                <i class="bi bi-calendar-event"></i>
                                <span>Explore Events</span>
                            </a>
                        </li>

                        <!-- CALENDAR -->
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Calendar" ? "active" : "")"
                               asp-controller="Calendar"
                               asp-action="Index">
                                <i class="bi bi-calendar3"></i>
                                <span>Event Calendar</span>
                            </a>
                        </li>

                        <!-- ANNOUNCEMENTS -->
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Announcements" ? "active" : "")"
                               asp-controller="Announcements"
                               asp-action="Index">
                                <i class="bi bi-megaphone"></i>
                                <span>Announcements</span>
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- DASHBOARD -->
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Dashboard" ? "active" : "")"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    <i class="bi bi-speedometer2"></i>
                                    <span>Dashboard</span>
                                </a>
                            </li>

                            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("ADMIN") || User.IsInRole("SUPERADMIN"))
                            {
                                <!-- ADMIN -->
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "Admin" ? "active" : "")"
                                       asp-controller="Admin"
                                       asp-action="Index">
                                        <i class="bi bi-shield-lock"></i>
                                        <span>Admin Console</span>
                                    </a>
                                </li>
                            }
                        }

                        <!-- MORE INFORMATION DROPDOWN -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(currentAction == "Contact" || currentAction == "Search" || currentAction == "About" || currentAction == "Privacy" ? "active" : "")"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                <i class="bi bi-grid-3x3-gap"></i>
                                <span>More</span>
                            </a>
                            <ul class="dropdown-menu shadow-lg rounded-4 p-2 mt-2">
                                <li>
                                    <a class="dropdown-item py-2 rounded-3" asp-controller="Events" asp-action="Search">
                                        <i class="bi bi-search me-2 text-primary fs-6"></i>Search Events & Venues
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 rounded-3 fw-semibold text-warning-emphasis" asp-controller="Home" asp-action="Contact">
                                        <i class="bi bi-headset me-2 text-warning fs-6"></i>Contact & Support Desk
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-1" /></li>
                                <li>
                                    <a class="dropdown-item py-2 rounded-3" asp-controller="Home" asp-action="About">
                                        <i class="bi bi-info-circle me-2 text-secondary fs-6"></i>About HUCEMS
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 rounded-3" asp-controller="Home" asp-action="Privacy">
                                        <i class="bi bi-shield-check me-2 text-success fs-6"></i>Privacy & Data Governance
                                    </a>
                                </li>
                            </ul>
                        </li>

                    </ul>

                    <!-- RIGHT ACTIONS & USER PROFILE (RIGHT) -->
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Faculty") || User.IsInRole("Staff") || User.IsInRole("Organization") || User.IsInRole("Club") || User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("FACULTY") || User.IsInRole("STAFF") || User.IsInRole("ORGANIZATION") || User.IsInRole("ADMIN") || User.IsInRole("SUPERADMIN"))
                            {
                                <!-- CREATE EVENT BUTTON -->
                                <li class="nav-item">
                                    <a class="btn btn-primary btn-sm px-3 rounded-pill fw-semibold shadow-sm d-inline-flex align-items-center gap-1"
                                       asp-controller="Events"
                                       asp-action="Create">
                                        <i class="bi bi-plus-circle"></i>
                                        <span>Create Event</span>
                                    </a>
                                </li>
                            }

                            <!-- THEME TOGGLE (DARK / LIGHT MODE) -->
                            <li class="nav-item">
                                <button type="button"
                                        class="theme-toggle-btn btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center"
                                        id="themeToggleBtn"
                                        style="width: 36px; height: 36px;"
                                        aria-label="Toggle Dark / Light Mode"
                                        title="Toggle Dark / Light Mode">
                                    <i class="bi bi-moon-stars-fill theme-icon-dark"></i>
                                    <i class="bi bi-sun-fill theme-icon-light"></i>
                                    <span class="visually-hidden">Toggle Theme</span>
                                </button>
                            </li>

                            <!-- USER ACCOUNT PROFILE PILL -->
                            <li class="nav-item dropdown user-nav-item">
                                <a class="nav-link dropdown-toggle d-inline-flex align-items-center gap-2 px-2 px-md-3 py-1 rounded-pill border shadow-sm user-profile-btn"
                                   style="background: var(--bg-card, #ffffff); border-color: var(--border-color, #e2e8f0); color: var(--text-main, #0f172a);"
                                   href="#"
                                   id="userNavProfileDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   data-bs-placement="bottom-end"
                                   data-bs-auto-close="true"
                                   aria-expanded="false">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white shadow-sm flex-shrink-0 user-avatar-badge"
                                         style="width: 28px; height: 28px; font-size: 12px; background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%);">
                                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <span class="fw-bold small d-none d-sm-inline text-truncate user-name-display" style="max-width: 110px;">
                                        @(User.Identity?.Name ?? "My Account")
                                    </span>
                                    @{
                                        var roleVal = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Student";
                                        var roleBadgeBg = roleVal switch {
                                            "SuperAdmin" => "bg-dark text-white",
                                            "Admin" => "bg-danger text-white",
                                            "Faculty" => "bg-purple text-white",
                                            "Staff" => "bg-success text-white",
                                            "Organization" => "bg-warning text-dark",
                                            _ => "bg-primary text-white"
                                        };
                                    }
                                    <span class="badge @roleBadgeBg small rounded-pill px-2 py-1 user-role-pill" style="font-size: 10px;">@roleVal</span>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow-lg rounded-4 p-2 mt-2 user-profile-dropdown" 
                                    aria-labelledby="userNavProfileDropdown"
                                    style="right: 0 !important; left: auto !important; min-width: 260px; max-width: min(320px, calc(100vw - 20px)); z-index: 1060;">
                                    <li class="dropdown-header small text-muted px-3 py-2">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span><i class="bi bi-person-check me-1"></i>Logged in as</span>
                                            <span class="badge @roleBadgeBg small" style="font-size: 10px;">@roleVal</span>
                                        </div>
                                        <div class="text-dark fw-bold fs-6 text-truncate" style="max-width: 220px;">@(User.Identity?.Name ?? "Student")</div>
                                    </li>
                                    <li><hr class="dropdown-divider my-1" /></li>
                                    <li>
                                        <a class="dropdown-item fw-semibold text-primary py-2 rounded-3"
                                           asp-controller="Dashboard"
                                           asp-action="Index">
                                            <i class="bi bi-speedometer2 me-2 text-primary"></i>
                                            @roleVal Dashboard
                                        </a>
                                    </li>
                                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("SUPERADMIN"))
                                    {
                                        <li>
                                            <a class="dropdown-item text-warning-emphasis fw-bold py-2 rounded-3"
                                               asp-controller="Admin"
                                               asp-action="DatabaseManagement">
                                               <i class="bi bi-shield-lock-fill me-2 text-warning"></i>
                                               SuperAdmin Security Vault
                                            </a>
                                        </li>
                                    }
                                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("ADMIN") || User.IsInRole("SUPERADMIN"))
                                    {
                                        <li>
                                            <a class="dropdown-item text-danger fw-semibold py-2 rounded-3"
                                               asp-controller="Admin"
                                               asp-action="Index">
                                                <i class="bi bi-shield-lock me-2 text-danger"></i>
                                                Admin Control Panel
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 rounded-3"
                                               asp-controller="Admin"
                                               asp-action="DatabaseManagement">
                                                <i class="bi bi-database-check me-2 text-info"></i>
                                                Database Recovery Vault
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item py-2 rounded-3"
                                           asp-controller="Account"
                                           asp-action="Profile">
                                            <i class="bi bi-person-gear me-2 text-secondary"></i>
                                            My Profile & Settings
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Faculty") || User.IsInRole("Staff") || User.IsInRole("Organization") || User.IsInRole("Club") || User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("FACULTY") || User.IsInRole("STAFF") || User.IsInRole("ORGANIZATION") || User.IsInRole("ADMIN") || User.IsInRole("SUPERADMIN"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 rounded-3"
                                               asp-controller="Events"
                                               asp-action="Create">
                                                <i class="bi bi-plus-circle me-2 text-success"></i>
                                                Create Event
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 rounded-3"
                                               asp-controller="Events"
                                               asp-action="MyEvents">
                                                <i class="bi bi-calendar-check me-2 text-info"></i>
                                                My Organized Events
                                            </a>
                                        </li>
                                    }
                                    
                                    <li><hr class="dropdown-divider my-1" /></li>
                                    <li>
                                        <a class="dropdown-item text-danger py-2 rounded-3 fw-semibold"
                                           asp-controller="Account"
                                           asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i>
                                            Logout
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <!-- GUEST STATE -->
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm px-3 rounded-pill fw-semibold"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm px-3 rounded-pill fw-semibold shadow-sm"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i>
                                    Register
                                </a>
                            </li>

                            <!-- THEME TOGGLE (DARK / LIGHT MODE) FOR GUEST -->
                            <li class="nav-item">
                                <button type="button"
                                        class="theme-toggle-btn btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center"
                                        id="themeToggleBtn"
                                        style="width: 36px; height: 36px;"
                                        aria-label="Toggle Dark / Light Mode"
                                        title="Toggle Dark / Light Mode">
                                    <i class="bi bi-moon-stars-fill theme-icon-dark"></i>
                                    <i class="bi bi-sun-fill theme-icon-light"></i>
                                    <span class="visually-hidden">Toggle Theme</span>
                                </button>
                            </li>
                        }
                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <main role="main">

        @RenderBody()

    </main>


    <!-- =====================================================
         ENTERPRISE CAMPUS FOOTER
         ===================================================== -->

    <footer class="site-footer">

        <!-- TOP EMERGENCY & LIVE STATUS BAR -->
        <div class="footer-top-bar border-bottom border-secondary border-opacity-10 py-3 mb-4">
            <div class="container">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 small fw-semibold d-inline-flex align-items-center gap-2">
                            <span class="spinner-grow spinner-grow-sm text-success" style="width: 8px; height: 8px;" role="status"></span>
                            HUCEMS Systems Operational
                        </span>
                        <span class="text-white-50 small d-none d-sm-inline">
                            <i class="bi bi-shield-check text-primary me-1"></i> Hawassa University Verified Portal
                        </span>
                    </div>

                    <div class="d-flex align-items-center gap-3 text-white-50 small">
                        <span class="d-flex align-items-center gap-1">
                            <i class="bi bi-telephone-fill text-warning"></i> Campus Security Desk: <strong class="text-white ms-1">+251 46 220 5411</strong>
                        </span>
                        <span class="d-none d-lg-inline text-secondary">|</span>
                        <a asp-controller="Home" asp-action="Contact" class="text-decoration-none text-info fw-semibold d-none d-lg-inline">
                            <i class="bi bi-headset me-1"></i>24/7 Help Desk
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="container">

            <div class="row g-4 pb-4">

                <!-- 1. UNIVERSITY & SYSTEM IDENTITY -->
                <div class="col-lg-4 col-md-6">
                    <div class="footer-brand mb-3 d-flex align-items-center gap-2">
                        <div class="footer-brand-logo bg-primary bg-gradient text-white rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; font-size: 22px;">
                            🎓
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold text-white fs-5 tracking-tight">HUCEMS</h5>
                            <small class="text-white-50 text-uppercase fw-semibold" style="font-size: 10px; letter-spacing: 1px;">Hawassa University</small>
                        </div>
                    </div>

                    <p class="text-white-50 small mb-3 lh-base">
                        The official unified digital campus event management platform connecting students, faculty, staff, and student organizations across all Hawassa University campuses.
                    </p>

                    <div class="footer-contact-list small text-white-50 d-flex flex-column gap-2 mb-3">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-geo-alt-fill text-danger flex-shrink-0 mt-1"></i>
                            <span>Main Campus, Bensa Road, Hawassa, Sidama Region, Ethiopia</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-envelope-fill text-primary flex-shrink-0"></i>
                            <a href="mailto:events@hawassa.edu.et" class="text-white-50 text-decoration-none hover-white">events@hawassa.edu.et</a>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-globe text-success flex-shrink-0"></i>
                            <a href="https://www.hu.edu.et" target="_blank" rel="noopener" class="text-white-50 text-decoration-none hover-white">www.hu.edu.et</a>
                        </div>
                    </div>

                    <!-- SOCIAL LINKS -->
                    <div class="d-flex gap-2 mt-2">
                        <a href="https://t.me/hawassa_university" target="_blank" rel="noopener" class="footer-social-btn" title="Telegram Channel">
                            <i class="bi bi-telegram"></i>
                        </a>
                        <a href="https://www.linkedin.com/school/hawassa-university/" target="_blank" rel="noopener" class="footer-social-btn" title="LinkedIn">
                            <i class="bi bi-linkedin"></i>
                        </a>
                        <a href="https://www.facebook.com/HawassaUniversityOfficial/" target="_blank" rel="noopener" class="footer-social-btn" title="Facebook">
                            <i class="bi bi-facebook"></i>
                        </a>
                        <a href="https://twitter.com/HawassaUni" target="_blank" rel="noopener" class="footer-social-btn" title="X (Twitter)">
                            <i class="bi bi-twitter-x"></i>
                        </a>
                        <a href="https://www.youtube.com/c/HawassaUniversityOfficial" target="_blank" rel="noopener" class="footer-social-btn" title="YouTube">
                            <i class="bi bi-youtube"></i>
                        </a>
                    </div>
                </div>

                <!-- 2. EVENTS & VENUE INFRASTRUCTURE -->
                <div class="col-lg-3 col-md-6 col-sm-6">
                    <h6 class="footer-col-title text-white fw-bold text-uppercase mb-3" style="font-size: 13px; letter-spacing: 0.8px;">
                        <i class="bi bi-calendar-event text-primary me-2"></i>Events & Venues
                    </h6>

                    <ul class="list-unstyled footer-nav-list small d-flex flex-column gap-2">
                        <li>
                            <a asp-controller="Events" asp-action="Index">
                                <i class="bi bi-chevron-right me-1 text-primary small"></i>Explore All Events
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Calendar" asp-action="Index">
                                <i class="bi bi-chevron-right me-1 text-primary small"></i>Interactive Campus Calendar
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Events" asp-action="Venues">
                                <i class="bi bi-chevron-right me-1 text-primary small"></i>Auditoriums & Venues Directory
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Events" asp-action="Search">
                                <i class="bi bi-chevron-right me-1 text-primary small"></i>Advanced Search & Filters
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Events" asp-action="Categories">
                                <i class="bi bi-chevron-right me-1 text-primary small"></i>Event Categories & Tracks
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Events" asp-action="Create">
                                <i class="bi bi-chevron-right me-1 text-primary small"></i>Host an Event / Reserve Hall
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Events" asp-action="MyEvents">
                                <i class="bi bi-chevron-right me-1 text-primary small"></i>My Event Registrations & Passes
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- 3. CAMPUS PORTALS & GOVERNANCE -->
                <div class="col-lg-3 col-md-6 col-sm-6">
                    <h6 class="footer-col-title text-white fw-bold text-uppercase mb-3" style="font-size: 13px; letter-spacing: 0.8px;">
                        <i class="bi bi-speedometer2 text-success me-2"></i>Portals & Governance
                    </h6>

                    <ul class="list-unstyled footer-nav-list small d-flex flex-column gap-2">
                        <li>
                            <a asp-controller="Announcements" asp-action="Index">
                                <i class="bi bi-chevron-right me-1 text-success small"></i>Campus Circulars & Bulletins
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-chevron-right me-1 text-success small"></i>Personalized Role Dashboard
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("ADMIN") || User.IsInRole("SUPERADMIN")))
                        {
                            <li>
                                <a asp-controller="Admin" asp-action="Index" class="fw-semibold text-warning">
                                    <i class="bi bi-shield-lock-fill me-1"></i>Admin Control Center
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Admin" asp-action="DatabaseManagement" class="text-info">
                                    <i class="bi bi-database-check me-1"></i>Database Vault & Snapshots
                                </a>
                            </li>
                        }
                        <li>
                            <a asp-controller="Account" asp-action="Login">
                                <i class="bi bi-chevron-right me-1 text-success small"></i>Verified Campus Login
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Account" asp-action="Register">
                                <i class="bi bi-chevron-right me-1 text-success small"></i>Student & Staff Registration
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- 4. INSTITUTIONAL TRUST & POLICIES -->
                <div class="col-lg-2 col-md-6">
                    <h6 class="footer-col-title text-white fw-bold text-uppercase mb-3" style="font-size: 13px; letter-spacing: 0.8px;">
                        <i class="bi bi-shield-check text-info me-2"></i>Trust & Legal
                    </h6>

                    <ul class="list-unstyled footer-nav-list small d-flex flex-column gap-2">
                        <li>
                            <a asp-controller="Home" asp-action="About">
                                <i class="bi bi-chevron-right me-1 text-info small"></i>About HUCEMS
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="Contact">
                                <i class="bi bi-chevron-right me-1 text-info small"></i>Contact Administration
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-chevron-right me-1 text-info small"></i>Privacy & Data Policy
                            </a>
                        </li>
                        <li>
                            <a href="/api/events" target="_blank">
                                <i class="bi bi-chevron-right me-1 text-info small"></i>Public Developer API
                            </a>
                        </li>
                        <li>
                            <a href="/Calendar" target="_blank">
                                <i class="bi bi-chevron-right me-1 text-info small"></i>iCal Calendar Feed
                            </a>
                        </li>
                    </ul>

                    <div class="mt-4 p-2 rounded-3 bg-white bg-opacity-5 border border-white border-opacity-10 text-center">
                        <small class="text-white-50 d-block mb-1" style="font-size: 11px;">Powered by Enterprise .NET 10</small>
                        <span class="badge bg-primary text-white rounded-pill px-2 py-1" style="font-size: 10px;">MySQL 8 Relational Core</span>
                    </div>
                </div>

            </div>

            <!-- FOOTER DIVIDER -->
            <hr class="border-secondary border-opacity-25 my-0" />

            <!-- FOOTER BOTTOM COPYRIGHT & METRICS -->
            <div class="py-3 d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 small text-white-50">
                <p class="mb-0 text-center text-md-start">
                    &copy; @DateTime.Now.Year <strong>Hawassa University Campus Event Management System (HUCEMS)</strong>. All rights reserved.
                </p>

                <div class="d-flex align-items-center gap-3">
                    <a asp-controller="Home" asp-action="About" class="text-white-50 text-decoration-none hover-white">About</a>
                    <span>•</span>
                    <a asp-controller="Home" asp-action="Privacy" class="text-white-50 text-decoration-none hover-white">Privacy</a>
                    <span>•</span>
                    <a asp-controller="Home" asp-action="Contact" class="text-white-50 text-decoration-none hover-white">Help Desk</a>
                    <span>•</span>
                    <a href="#top" class="text-primary text-decoration-none fw-semibold">
                        <i class="bi bi-arrow-up-circle-fill me-1"></i>Top
                    </a>
                </div>
            </div>

        </div>

    </footer>


    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script src="~/js/account.js"
            asp-append-version="true"></script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>