@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isAuthPage = currentController.Equals("Account", StringComparison.OrdinalIgnoreCase) && 
                     (currentAction.Equals("Login", StringComparison.OrdinalIgnoreCase) || 
                      currentAction.Equals("Register", StringComparison.OrdinalIgnoreCase) || 
                      currentAction.Equals("ForgotPassword", StringComparison.OrdinalIgnoreCase) || 
                      currentAction.Equals("ResetPassword", StringComparison.OrdinalIgnoreCase));
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta http-equiv="X-UA-Compatible"
          content="IE=edge" />

    <title>
        @ViewData["Title"] - HUCEMS
    </title>

    <meta name="description"
          content="Hawassa Unified Campus Event Management System - A centralized platform for campus events, community activities, announcements and student engagement." />

    <meta name="keywords"
          content="Hawassa University, HUCEMS, campus events, university events, student events, campus management, Ethiopia" />

    <meta name="author"
          content="Hawassa Unified Campus Event Management System" />

    <meta name="theme-color"
          content="#0f172a" />

    <!-- Theme Initialization Script (Prevents FOUC) -->
    <script>
        (function() {
            var saved = localStorage.getItem('hucems-theme');
            var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            var theme = saved ? saved : (prefersDark ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
            if (theme === 'dark') document.documentElement.classList.add('dark-theme');
        })();
    </script>


    <!-- Google Fonts: Plus Jakarta Sans & Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- =====================================================
         BOOTSTRAP
         ===================================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- =====================================================
         BOOTSTRAP ICONS
         ===================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- =====================================================
         GLOBAL CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <!-- =====================================================
         ACCOUNT CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/account.css"
          asp-append-version="true" />


    <!-- =====================================================
         RESPONSIVE CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/responsive.css"
          asp-append-version="true" />


    <!-- =====================================================
         PAGE SPECIFIC CSS
         ===================================================== -->

    @await RenderSectionAsync(
        "Styles",
        required: false
    )

</head>


<body>
    <!-- Skip to main content link for keyboard accessibility -->
    <a href="#main-content" class="visually-hidden-focusable btn btn-primary position-fixed top-0 start-0 m-3 z-3 shadow">
        Skip to main content
    </a>

@if (isAuthPage)
{
    <!-- =====================================================
         MINIMAL AUTH HEADER (NO UNWANTED TOGGLERS OR NAV CLUTTER)
         ===================================================== -->
    <header class="py-3 border-bottom bg-body">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="d-flex align-items-center gap-2 text-decoration-none" asp-controller="Home" asp-action="Index" aria-label="HUCEMS Home">
                <img src="~/images/hawassa-logo.png" alt="Hawassa University Crest" class="brand-logo-img" style="width: 38px; height: 38px; object-fit: contain; border-radius: 50%;" />
                <div class="d-flex flex-column leading-none">
                    <span class="brand-text fw-bold text-dark fs-6">HUCEMS</span>
                    <span class="brand-subtext text-muted" style="font-size: 9px; letter-spacing: 0.5px; margin-top: -3px;">HAWASSA UNIVERSITY</span>
                </div>
            </a>
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    Public Portal
                </a>
                <button type="button" class="theme-toggle-btn btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center" id="themeToggleBtn" style="width: 34px; height: 34px;" aria-label="Toggle Theme" title="Toggle Theme">
                    <i class="bi bi-moon-stars-fill theme-icon-dark"></i>
                    <i class="bi bi-sun-fill theme-icon-light"></i>
                    <span class="visually-hidden">Toggle Theme</span>
                </button>
            </div>
        </div>
    </header>
}
else
{
    <!-- =====================================================
         MAIN SITE HEADER
         ===================================================== -->

    <header>

        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid px-3 px-xl-4">

                <!-- BRAND -->
                <a class="navbar-brand d-flex align-items-center gap-2 me-3"
                   asp-controller="Home"
                   asp-action="Index"
                   aria-label="HUCEMS Home">
                    <img src="~/images/hawassa-logo.png" alt="Hawassa University Crest" class="brand-logo-img" style="width: 38px; height: 38px; object-fit: contain; border-radius: 50%;" />
                    <div class="d-flex flex-column leading-none">
                        <span class="brand-text fw-bold">HUCEMS</span>
                        <span class="brand-subtext text-muted d-none d-sm-inline" style="font-size: 9px; letter-spacing: 0.5px; margin-top: -3px;">HAWASSA UNIVERSITY</span>
                    </div>
                </a>

                <!-- MOBILE MENU TOGGLER -->
                <button class="navbar-toggler border-0 shadow-none"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- NAVIGATION CONTENT -->
                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- PRIMARY LINKS (LEFT) -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">

                        <!-- HOME -->
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <!-- EXPLORE EVENTS -->
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Events" && currentAction == "Index" ? "active" : "")"
                               asp-controller="Events"
                               asp-action="Index">
                                <span class="d-none d-xl-inline">Explore </span>Events
                            </a>
                        </li>

                        <!-- CLUBS & COMMUNITIES -->
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Clubs" ? "active" : "")"
                               asp-controller="Clubs"
                               asp-action="Index">
                                Clubs
                            </a>
                        </li>

                        <!-- CALENDAR -->
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Calendar" ? "active" : "")"
                               asp-controller="Calendar"
                               asp-action="Index">
                                <span class="d-none d-xl-inline">Event </span>Calendar
                            </a>
                        </li>

                        <!-- ANNOUNCEMENTS -->
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Announcements" ? "active" : "")"
                               asp-controller="Announcements"
                               asp-action="Index">
                                Announcements
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- DASHBOARD -->
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Dashboard" ? "active" : "")"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    Dashboard
                                </a>
                            </li>

                            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("ADMIN") || User.IsInRole("SUPERADMIN"))
                            {
                                <!-- ADMIN -->
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "Admin" ? "active" : "")"
                                       asp-controller="Admin"
                                       asp-action="Index">
                                        Admin<span class="d-none d-xxl-inline"> Console</span>
                                    </a>
                                </li>
                            }
                        }

                        <!-- MORE INFORMATION DROPDOWN -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(currentAction == "Contact" || currentAction == "Search" || currentAction == "About" || currentAction == "Privacy" ? "active" : "")"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                More
                            </a>
                            <ul class="dropdown-menu shadow-lg rounded-4 p-2 mt-2">
                                <li>
                                    <a class="dropdown-item py-2 rounded-3" asp-controller="Events" asp-action="Search">
                                        Search Events & Venues
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 rounded-3 fw-semibold text-warning-emphasis" asp-controller="Home" asp-action="Contact">
                                        Contact & Support Desk
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-1" /></li>
                                <li>
                                    <a class="dropdown-item py-2 rounded-3" asp-controller="Home" asp-action="About">
                                        About HUCEMS
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 rounded-3" asp-controller="Home" asp-action="Privacy">
                                        Privacy & Data Governance
                                    </a>
                                </li>
                            </ul>
                        </li>

                    </ul>

                    <!-- RIGHT ACTIONS & USER PROFILE (RIGHT) -->
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Faculty") || User.IsInRole("Staff") || User.IsInRole("Organization") || User.IsInRole("Club") || User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("FACULTY") || User.IsInRole("STAFF") || User.IsInRole("ORGANIZATION") || User.IsInRole("ADMIN") || User.IsInRole("SUPERADMIN"))
                            {
                                <!-- CREATE EVENT BUTTON -->
                                <li class="nav-item">
                                    <a class="btn btn-primary btn-sm px-3 rounded-pill fw-semibold shadow-sm"
                                       asp-controller="Events"
                                       asp-action="Create">
                                        Create Event
                                    </a>
                                </li>
                            }

                            <!-- NOTIFICATIONS BELL & DROPDOWN -->
                            <li class="nav-item dropdown notification-nav-item">
                                <a class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center position-relative notification-bell-btn"
                                   href="#"
                                   id="navNotificationDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   data-bs-auto-close="outside"
                                   aria-expanded="false"
                                   style="width: 36px; height: 36px;"
                                   title="Campus Alerts & Notifications">
                                    <i class="bi bi-bell-fill"></i>
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" id="navNotifBadge" style="font-size: 9px; padding: 0.25em 0.45em;">
                                        0
                                    </span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end shadow-lg rounded-4 p-0 mt-2 notification-dropdown"
                                     aria-labelledby="navNotificationDropdown"
                                     style="width: min(340px, calc(100vw - 24px)); z-index: 1060; border: 1px solid #e2e8f0;">
                                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light rounded-top-4">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-bell-fill text-warning fw-bold"></i>
                                            <strong class="text-dark small">Notifications</strong>
                                            <span class="badge bg-primary rounded-pill small" id="navNotifCountBadge" style="font-size: 10px;">0 new</span>
                                        </div>
                                        <button type="button" class="btn btn-link btn-sm text-decoration-none p-0 small fw-semibold text-primary" onclick="markAllNotificationsReadFromNav(event)">
                                            Mark all read
                                        </button>
                                    </div>
                                    <div class="notification-preview-list py-1" id="navNotifList" style="max-height: 280px; overflow-y: auto;">
                                        <div class="text-center py-4 text-muted small" id="navNotifLoading">
                                            <div class="spinner-border spinner-border-sm text-primary mb-1"></div>
                                            <div>Loading alerts...</div>
                                        </div>
                                    </div>
                                    <div class="p-2 border-top text-center bg-light rounded-bottom-4">
                                        <a asp-controller="Notifications" asp-action="Index" class="btn btn-sm btn-primary rounded-pill w-100 fw-semibold" style="font-size: 12px;">
                                            <i class="bi bi-inbox me-1"></i> Open Notification Center &rarr;
                                        </a>
                                    </div>
                                </div>
                            </li>

                            <!-- THEME TOGGLE (DARK / LIGHT MODE) -->
                            <li class="nav-item">
                                <button type="button"
                                        class="theme-toggle-btn btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center"
                                        id="themeToggleBtn"
                                        style="width: 36px; height: 36px;"
                                        aria-label="Toggle Dark / Light Mode"
                                        title="Toggle Dark / Light Mode">
                                    <i class="bi bi-moon-stars-fill theme-icon-dark"></i>
                                    <i class="bi bi-sun-fill theme-icon-light"></i>
                                    <span class="visually-hidden">Toggle Theme</span>
                                </button>
                            </li>

                            <!-- USER ACCOUNT PROFILE PILL -->
                            <li class="nav-item dropdown user-nav-item">
                                <a class="nav-link dropdown-toggle d-inline-flex align-items-center gap-2 px-2 px-md-3 py-1 rounded-pill border shadow-sm user-profile-btn"
                                   style="background: var(--bg-card, #ffffff); border-color: var(--border-color, #e2e8f0); color: var(--text-main, #0f172a);"
                                   href="#"
                                   id="userNavProfileDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   data-bs-placement="bottom-end"
                                   data-bs-auto-close="true"
                                   aria-expanded="false">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white shadow-sm flex-shrink-0 user-avatar-badge"
                                         style="width: 28px; height: 28px; font-size: 12px; background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%);">
                                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <span class="fw-bold small d-none d-sm-inline text-truncate user-name-display" style="max-width: 110px;">
                                        @(User.Identity?.Name ?? "My Account")
                                    </span>
                                    @{
                                        var roleVal = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Student";
                                        var roleBadgeBg = roleVal switch {
                                            "SuperAdmin" => "bg-dark text-white",
                                            "Admin" => "bg-danger text-white",
                                            "Faculty" => "bg-purple text-white",
                                            "Staff" => "bg-success text-white",
                                            "Organization" => "bg-warning text-dark",
                                            _ => "bg-primary text-white"
                                        };
                                    }
                                    <span class="badge @roleBadgeBg small rounded-pill px-2 py-1 user-role-pill" style="font-size: 10px;">@roleVal</span>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow-lg rounded-4 p-2 mt-2 user-profile-dropdown" 
                                     aria-labelledby="userNavProfileDropdown"
                                     style="right: 0 !important; left: auto !important; min-width: 260px; max-width: min(320px, calc(100vw - 20px)); z-index: 1060;">
                                    <li class="dropdown-header small text-muted px-3 py-2">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span><i class="bi bi-person-check me-1"></i>Logged in as</span>
                                            <span class="badge @roleBadgeBg small" style="font-size: 10px;">@roleVal</span>
                                        </div>
                                        <div class="text-dark fw-bold fs-6 text-truncate" style="max-width: 220px;">@(User.Identity?.Name ?? "Student")</div>
                                    </li>
                                    <li><hr class="dropdown-divider my-1" /></li>
                                    <li>
                                        <a class="dropdown-item fw-semibold text-primary py-2 rounded-3"
                                           asp-controller="Dashboard"
                                           asp-action="Index">
                                            <i class="bi bi-speedometer2 me-2 text-primary"></i>
                                            @roleVal Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 rounded-3"
                                           asp-controller="Notifications"
                                           asp-action="Index">
                                            <i class="bi bi-bell-fill me-2 text-warning"></i>
                                            Notifications & Alerts
                                        </a>
                                    </li>
                                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("SUPERADMIN"))
                                    {
                                        <li>
                                            <a class="dropdown-item text-warning-emphasis fw-bold py-2 rounded-3"
                                               asp-controller="Admin"
                                               asp-action="DatabaseManagement">
                                               <i class="bi bi-shield-lock-fill me-2 text-warning"></i>
                                               SuperAdmin Security Vault
                                            </a>
                                        </li>
                                    }
                                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("ADMIN") || User.IsInRole("SUPERADMIN"))
                                    {
                                        <li>
                                            <a class="dropdown-item text-danger fw-semibold py-2 rounded-3"
                                               asp-controller="Admin"
                                               asp-action="Index">
                                                <i class="bi bi-shield-lock me-2 text-danger"></i>
                                                Admin Control Panel
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 rounded-3"
                                               asp-controller="Admin"
                                               asp-action="DatabaseManagement">
                                                <i class="bi bi-database-check me-2 text-info"></i>
                                                Database Recovery Vault
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item py-2 rounded-3"
                                           asp-controller="Account"
                                           asp-action="Profile">
                                            <i class="bi bi-person-gear me-2 text-secondary"></i>
                                            My Profile & Settings
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 rounded-3"
                                           asp-controller="Clubs"
                                           asp-action="MyClubs">
                                            <i class="bi bi-people-fill me-2 text-primary"></i>
                                            My Clubs & Memberships
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 rounded-3"
                                           asp-controller="Clubs"
                                           asp-action="Interests">
                                            <i class="bi bi-heart-pulse-fill me-2 text-danger"></i>
                                            My Campus Interests
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Faculty") || User.IsInRole("Staff") || User.IsInRole("Organization") || User.IsInRole("Club") || User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("FACULTY") || User.IsInRole("STAFF") || User.IsInRole("ORGANIZATION") || User.IsInRole("ADMIN") || User.IsInRole("SUPERADMIN"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 rounded-3"
                                               asp-controller="Events"
                                               asp-action="Create">
                                                <i class="bi bi-plus-circle me-2 text-success"></i>
                                                Create Event
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 rounded-3"
                                               asp-controller="Clubs"
                                               asp-action="Create">
                                                <i class="bi bi-plus-square-dotted me-2 text-warning"></i>
                                                Charter New Club
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 rounded-3"
                                               asp-controller="Events"
                                               asp-action="MyEvents">
                                                <i class="bi bi-calendar-check me-2 text-info"></i>
                                                My Organized Events
                                            </a>
                                        </li>
                                    }
                                    
                                    <li><hr class="dropdown-divider my-1" /></li>
                                    <li>
                                        <a class="dropdown-item text-danger py-2 rounded-3 fw-semibold"
                                           asp-controller="Account"
                                           asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i>
                                            Logout
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <!-- GUEST STATE (LOGIN ONLY) -->
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm px-3 rounded-pill fw-semibold shadow-sm"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Sign In
                                </a>
                            </li>

                            <!-- THEME TOGGLE (DARK / LIGHT MODE) FOR GUEST -->
                            <li class="nav-item">
                                <button type="button"
                                        class="theme-toggle-btn btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center"
                                        id="themeToggleBtn"
                                        style="width: 36px; height: 36px;"
                                        aria-label="Toggle Dark / Light Mode"
                                        title="Toggle Dark / Light Mode">
                                    <i class="bi bi-moon-stars-fill theme-icon-dark"></i>
                                    <i class="bi bi-sun-fill theme-icon-light"></i>
                                    <span class="visually-hidden">Toggle Theme</span>
                                </button>
                            </li>
                        }
                    </ul>

                </div>

            </div>

        </nav>

    </header>
}


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <main id="main-content" role="main">

        @RenderBody()

    </main>


@if (!isAuthPage)
{
    <!-- =====================================================
         CLEAN MODERN ENTERPRISE CAMPUS FOOTER
         ===================================================== -->
    <footer class="site-footer" role="contentinfo">
        <div class="container py-5">
            <div class="row g-4 justify-content-between">
                
                <!-- 1. BRAND & IDENTITY COLUMN -->
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="~/images/hawassa-logo.png" alt="Hawassa University Official Crest" class="bg-white rounded-circle p-1 shadow-sm" style="width: 52px; height: 52px; object-fit: contain;" />
                        <div>
                            <h5 class="mb-0 fw-bold text-white tracking-tight fs-6">HAWASSA UNIVERSITY</h5>
                            <span class="text-white-50 text-uppercase fw-semibold" style="font-size: 11px; letter-spacing: 1.2px;">Unified Event Platform (HUCEMS)</span>
                        </div>
                    </div>
                    <p class="text-white-50 small mb-3" style="line-height: 1.6; max-width: 340px;">
                        The official unified platform for coordinating university academic conferences, departmental seminars, student club activities, and campus facilities.
                    </p>
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1 bg-white bg-opacity-10 rounded-pill border border-white border-opacity-10">
                        <span class="badge-pulse bg-success rounded-circle" style="width: 8px; height: 8px;"></span>
                        <span class="text-white small fw-medium" style="font-size: 11px;">● All Systems Operational</span>
                    </div>
                </div>

                <!-- 2. QUICK LINKS COLUMN -->
                <div class="col-6 col-md-3 col-lg-2">
                    <h6 class="text-white fw-bold text-uppercase mb-3 pb-2 border-bottom border-white border-opacity-10 footer-col-heading">
                        Quick Links
                    </h6>
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
                        <li>
                            <a asp-controller="Home" asp-action="Index" class="footer-nav-link p-0 text-white-50 hover-white d-inline-flex align-items-center gap-1">
                                <i class="bi bi-chevron-right text-primary" style="font-size: 10px;"></i>
                                <span>Home</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Events" asp-action="Index" class="footer-nav-link p-0 text-white-50 hover-white d-inline-flex align-items-center gap-1">
                                <i class="bi bi-chevron-right text-primary" style="font-size: 10px;"></i>
