@{
    ViewData["Title"] = "Forgot Password";
}

<link rel="stylesheet"
      href="~/css/forgot-password.css"
      asp-append-version="true" />

<div class="forgot-page">

    <div class="forgot-card">

        <div class="forgot-icon mb-2">
            <img src="~/images/hawassa-logo.png" alt="Hawassa University" style="width: 64px; height: 64px; object-fit: contain; border-radius: 50%;" />
        </div>

        <h1>Forgot Password?</h1>

        <p>
            Enter your university email address or username to receive a 6-digit security verification code to reset your password.
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="error-message">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Error
            </div>
        }

        <form asp-controller="Account"
              asp-action="ForgotPassword"
              method="post"
              id="forgotPasswordForm">

            @Html.AntiForgeryToken()

            <div class="form-group">

                <label>University Email Address or Username</label>

                <input type="text"
                       name="email"
                       id="forgotEmail"
                       placeholder="e.g. admin@hawassa.edu.et or username"
                       required />

            </div>

            <button type="submit"
                    class="forgot-button"
                    id="forgotButton">
                <i class="bi bi-shield-check me-1"></i> Send 6-Digit Verification Code
            </button>

        </form>

        <div class="forgot-footer">

            <a asp-action="Login">
                <i class="bi bi-arrow-left me-1"></i> Back to Login
            </a>

        </div>

    </div>

</div>

<script src="~/js/forgot-password.js"
        asp-append-version="true"></script>