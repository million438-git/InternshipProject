@{
    ViewData["Title"] = "Forgot Password";
}

<link rel="stylesheet"
      href="~/css/forgot-password.css"
      asp-append-version="true" />

<div class="forgot-page">

    <div class="forgot-card">

        <div class="forgot-icon mb-2">
            <img src="~/images/hawassa-logo.png" alt="Hawassa University" style="width: 64px; height: 64px; object-fit: contain; border-radius: 50%;" />
        </div>

        <h1>Forgot Password?</h1>

        <p>
            Enter your email address and we'll help you
            reset your password.
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="error-message">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Account"
              asp-action="ForgotPassword"
              method="post"
              id="forgotPasswordForm">

            @Html.AntiForgeryToken()

            <div class="form-group">

                <label>Email Address</label>

                <input type="email"
                       name="email"
                       id="forgotEmail"
                       placeholder="Enter your email"
                       required />

            </div>

            <button type="submit"
                    class="forgot-button"
                    id="forgotButton">

                Send Reset Link

            </button>

        </form>

        <div class="forgot-footer">

            <a asp-action="Login">
                Back to Login
            </a>

        </div>

    </div>

</div>

<script src="~/js/forgot-password.js"
        asp-append-version="true"></script>