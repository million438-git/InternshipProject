@{
    ViewData["Title"] = "Sign In | Hawassa University HUCEMS";

    // Decide which single notification to show (priority: error > success > info > event-creation prompt).
    // NOTE: detecting "Create" via ReturnUrl string is fragile — recommend the controller
    // set an explicit TempData/ViewBag flag instead (e.g. TempData["EventCreationPrompt"] = true).
    string? alertType = null;
    string? alertText = null;

    if (ViewBag.Error != null)
    {
        alertType = "danger";
        alertText = ViewBag.Error;
    }
    else if (TempData["ErrorMessage"] != null)
    {
        alertType = "danger";
        alertText = (string)TempData["ErrorMessage"]!;
    }
    else if (TempData["SuccessMessage"] != null)
    {
        alertType = "success";
        alertText = (string)TempData["SuccessMessage"]!;
    }
    else if (TempData["InfoMessage"] != null)
    {
        alertType = "info";
        alertText = (string)TempData["InfoMessage"]!;
    }
    else if (ViewBag.ReturnUrl != null && ((string)ViewBag.ReturnUrl).Contains("Create", StringComparison.OrdinalIgnoreCase))
    {
        alertType = "info";
        alertText = "<strong>Event Creation:</strong> Please sign in with your university account to submit campus events.";
    }

    var alertIcon = alertType switch
    {
        "danger" => "bi-exclamation-octagon-fill",
        "success" => "bi-check-circle-fill",
        _ => "bi-info-circle-fill"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="auth-page-container">

    <div class="auth-card-centered">

        <!-- UNIVERSITY BRANDING -->
        <div class="auth-brand-header">
            <img src="~/images/hawassa-logo.png" alt="Hawassa University Crest" class="auth-logo-img" />
            <h2 class="auth-university-title">Hawassa University</h2>
            <p class="auth-system-subtitle">Unified Campus Event Management System</p>
        </div>

        <div class="auth-divider" role="separator"></div>

        <!-- FORM HEADING -->
        <div class="auth-heading-group">
            <h1>Welcome Back</h1>
            <p>Sign in to continue to your campus account.</p>
        </div>

        <!-- NOTIFICATION (only one shown at a time) -->
        @if (alertType != null)
        {
            <div class="alert auth-alert auth-alert-@alertType" role="alert">
                <i class="bi @alertIcon auth-alert-icon" aria-hidden="true"></i>
                <div>@Html.Raw(alertText)</div>
            </div>
        }

        <!-- SIGN IN FORM -->
        <form asp-controller="Account"
              asp-action="Login"
              method="post"
              id="loginForm"
              autocomplete="on"
              novalidate>

            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <!-- EMAIL / USERNAME -->
            <div class="auth-input-group">
                <label for="email">Campus Email or Username</label>
                <div class="auth-input-box">
                    <i class="bi bi-envelope-at auth-input-icon" aria-hidden="true"></i>
                    <input type="text"
                           id="email"
                           name="email"
                           placeholder="Enter your university email or username"
                           autocomplete="username"
                           required
                           aria-required="true" />
                </div>
            </div>

            <!-- PASSWORD -->
            <div class="auth-input-group">
                <label for="password">Password</label>
                <div class="auth-input-box">
                    <i class="bi bi-lock auth-input-icon" aria-hidden="true"></i>
                    <input type="password"
                           id="password"
                           name="password"
                           placeholder="Enter your password"
                           autocomplete="current-password"
                           required
                           aria-required="true" />
                    <button type="button"
                            class="auth-password-toggle"
                            id="togglePasswordBtn"
                            aria-label="Toggle password visibility"
                            title="Toggle password visibility">
                        <i class="bi bi-eye" id="togglePasswordIcon" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            <!-- REMEMBER ME + FORGOT PASSWORD -->
            <div class="auth-options-row">
                <label class="auth-remember-label" for="rememberMe">
                    <input type="checkbox" id="rememberMe" name="rememberMe" value="true" />
                    <span>Keep me signed in</span>
                </label>

                <a asp-action="ForgotPassword" class="auth-forgot-link">
                    Forgot Password?
                </a>
            </div>

            <!-- SUBMIT BUTTON -->
            <button type="submit"
                    class="auth-submit-btn"
                    id="loginButton">
                <span id="btnText">Sign In</span>
                <span class="spinner-border spinner-border-sm d-none ms-2" id="btnSpinner" role="status" aria-hidden="true"></span>
            </button>

        </form>

        <!-- CREATE ACCOUNT LINK -->
        <div class="auth-card-footer">
            <p class="mb-0">
                Don't have an account?
                <a asp-action="Register">
                    Create an Account
                </a>
            </p>
        </div>

        <!-- COPYRIGHT FOOTER -->
        <div class="auth-page-copyright">
            &copy; @DateTime.UtcNow.Year Hawassa University. All rights reserved.
        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/login.js" asp-append-version="true"></script>
}
