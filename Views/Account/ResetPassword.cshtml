@{
    ViewData["Title"] = "Reset Password";
}

<link rel="stylesheet"
      href="~/css/reset-password.css"
      asp-append-version="true" />

<div class="reset-page">

    <div class="reset-card">

        <div class="reset-icon mb-2">
            <img src="~/images/hawassa-logo.png" alt="Hawassa University" style="width: 64px; height: 64px; object-fit: contain; border-radius: 50%;" />
        </div>

        <h1>Reset Password</h1>

        <p>
            Create a new password for your account.
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="error-message">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Account"
              asp-action="ResetPassword"
              method="post"
              id="resetPasswordForm">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="token"
                   value="@(ViewBag.Token ?? "")" />

            <div class="form-group">
                <label>Account Email</label>
                <input type="email"
                       name="email"
                       id="email"
                       value="@(ViewBag.Email ?? "")"
                       placeholder="Enter your account email"
                       required />
            </div>

            <div class="form-group">

                <label>New Password</label>

                <input type="password"
                       name="password"
                       id="newPassword"
                       placeholder="Enter new password"
                       required />

            </div>

            <div class="form-group">

                <label>Confirm Password</label>

                <input type="password"
                       name="confirmPassword"
                       id="confirmNewPassword"
                       placeholder="Confirm new password"
                       required />

                <span id="resetError"></span>

            </div>

            <button type="submit"
                    class="reset-button"
                    id="resetButton">
                <i class="bi bi-shield-lock me-1"></i> Reset Password
            </button>

        </form>

        <div class="reset-footer">
            <a asp-action="Login">
                <i class="bi bi-arrow-left me-1"></i> Back to Login
            </a>
        </div>

    </div>

</div>

<script src="~/js/reset-password.js"
        asp-append-version="true"></script>