@{
    ViewData["Title"] = "Reset Password";
}

<link rel="stylesheet"
      href="~/css/reset-password.css"
      asp-append-version="true" />

<div class="reset-page">

    <div class="reset-card">

        <div class="reset-icon mb-2">
            <img src="~/images/hawassa-logo.png" alt="Hawassa University" style="width: 64px; height: 64px; object-fit: contain; border-radius: 50%;" />
        </div>

        <h1>Reset Password</h1>

        <p>
            Enter the 6-digit verification code sent to your email along with your new strong password.
        </p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success d-flex align-items-center mb-3" style="font-size: 13px; border-radius: 8px;">
                <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
        }

        @if (ViewBag.DevCode != null)
        {
            <div class="alert alert-warning border border-warning d-flex align-items-center justify-content-between mb-3 p-2 px-3" style="background: #fffbeb; border-radius: 8px;">
                <div>
                    <strong class="text-warning-emphasis d-block" style="font-size: 12px;"><i class="bi bi-key-fill me-1"></i> Security Verification Code (OTP):</strong>
                    <span class="fs-4 fw-bold font-monospace text-dark letter-spacing-2" id="devOtpSpan">@ViewBag.DevCode</span>
                </div>
                <button type="button" class="btn btn-sm btn-outline-dark" onclick="document.getElementById('verificationCode').value = '@ViewBag.DevCode';">
                    <i class="bi bi-clipboard-check me-1"></i> Auto-Fill
                </button>
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="error-message">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Error
            </div>
        }

        <form asp-controller="Account"
              asp-action="ResetPassword"
              method="post"
              id="resetPasswordForm">

            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Account Email</label>
                <input type="email"
                       name="email"
                       id="email"
                       value="@(ViewBag.Email ?? "")"
                       placeholder="Enter your account email"
                       required />
            </div>

            <div class="form-group">
                <label>6-Digit Verification Code (OTP)</label>
                <input type="text"
                       name="verificationCode"
                       id="verificationCode"
                       value="@(ViewBag.DevCode ?? "")"
                       maxlength="6"
                       placeholder="Enter 6-digit code (e.g. 849201)"
                       class="font-monospace fw-bold fs-5 text-center"
                       required />
                <small class="text-muted" style="font-size: 11px;">Check your email inbox or security notification for the 6-digit code.</small>
            </div>

            <div class="form-group">
                <label>New Password</label>
                <input type="password"
                       name="password"
                       id="newPassword"
                       placeholder="Min 8 chars, 1 uppercase, 1 number, 1 symbol"
                       required />
                <small class="text-muted" style="font-size: 11px;">Must contain at least 8 characters, uppercase, lowercase, digit & symbol.</small>
            </div>

            <div class="form-group">
                <label>Confirm New Password</label>
                <input type="password"
                       name="confirmPassword"
                       id="confirmNewPassword"
                       placeholder="Re-enter your new password"
                       required />
                <span id="resetError"></span>
            </div>

            <button type="submit"
                    class="reset-button"
                    id="resetButton">
                <i class="bi bi-shield-lock-fill me-1"></i> Update & Set New Password
            </button>

        </form>

        <div class="reset-footer">
            <a asp-action="Login">
                <i class="bi bi-arrow-left me-1"></i> Back to Login
            </a>
        </div>

    </div>

</div>

<script src="~/js/reset-password.js"
        asp-append-version="true"></script>