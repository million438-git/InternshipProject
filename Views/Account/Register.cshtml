@{
    ViewData["Title"] = "Verified Campus Registration | HUCEMS";
    var departments = ViewBag.Departments as List<HawassaUnifiedCampusEventManagementSystem.Models.Department> ?? new List<HawassaUnifiedCampusEventManagementSystem.Models.Department>();
}

<link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />

<div class="register-page py-4">

    <div class="register-card shadow-lg" style="max-width: 680px;">

        <div class="register-icon mb-2">
            <img src="~/images/hawassa-logo.png" alt="Hawassa University" style="width: 64px; height: 64px; object-fit: contain; border-radius: 50%;" />
        </div>

        <h1>Verified Campus Registration</h1>

        <p class="register-description">
            Create your authenticated Hawassa University account with your official academic or organizational identity.
        </p>

        <!-- SECURITY NOTICE BANNER -->
        <div class="alert alert-warning py-2 px-3 mb-3 small rounded-3 border-0 d-flex align-items-center gap-2" style="background-color: #fffbeb; color: #92400e; border: 1px solid #fef3c7;">
            <i class="bi bi-shield-lock-fill fs-5 text-warning flex-shrink-0"></i>
            <div>
                <strong>Security Policy:</strong> Administrative and SuperAdmin accounts are protected and cannot be self-registered. Registration is strictly verified for Students, Staff, Faculty, and Clubs.
            </div>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 px-3 mb-3 rounded-3">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Account"
              asp-action="Register"
              method="post"
              id="registerForm">

            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <!-- 1. ACCOUNT ROLE SELECTOR -->
            <div class="form-group mb-3">
                <label class="fw-bold mb-2 text-dark">Select Your Campus Role</label>
                <div class="role-selector-grid">
                    <label class="role-option-card active" for="role_student">
                        <input type="radio" name="accountType" id="role_student" value="Student" checked onchange="toggleRoleFields('Student')" />
                        <div class="role-option-content">
                            <span class="role-icon">🎓</span>
                            <strong>Student</strong>
                            <small>Events & Tickets</small>
                        </div>
                    </label>

                    <label class="role-option-card" for="role_staff">
                        <input type="radio" name="accountType" id="role_staff" value="Staff" onchange="toggleRoleFields('Staff')" />
                        <div class="role-option-content">
                            <span class="role-icon">💼</span>
                            <strong>Staff</strong>
                            <small>Operations</small>
                        </div>
                    </label>

                    <label class="role-option-card" for="role_faculty">
                        <input type="radio" name="accountType" id="role_faculty" value="Faculty" onchange="toggleRoleFields('Faculty')" />
                        <div class="role-option-content">
                            <span class="role-icon">📚</span>
                            <strong>Faculty</strong>
                            <small>Academic Hub</small>
                        </div>
                    </label>

                    <label class="role-option-card" for="role_org">
                        <input type="radio" name="accountType" id="role_org" value="Organization" onchange="toggleRoleFields('Organization')" />
                        <div class="role-option-content">
                            <span class="role-icon">🌟</span>
                            <strong>Club / Org</strong>
                            <small>Host Events</small>
                        </div>
                    </label>
                </div>
            </div>

            <!-- 2. PRIMARY IDENTITY -->
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label for="fullName" class="form-label fw-semibold small text-muted mb-1">Full Legal Name *</label>
                    <input type="text"
                           class="form-control"
                           name="fullName"
                           id="fullName"
                           placeholder="e.g. Dawit Yohannes"
                           required />
                </div>
                <div class="col-md-6">
                    <label for="username" class="form-label fw-semibold small text-muted mb-1">Unique Username *</label>
                    <input type="text"
                           class="form-control"
                           name="username"
                           id="username"
                           placeholder="e.g. dawit_yohannes"
                           pattern="^[a-zA-Z0-9_.-]{3,30}$"
                           title="3-30 characters, letters, numbers, underscores"
                           required />
                </div>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label for="email" class="form-label fw-semibold small text-muted mb-1">University / Personal Email *</label>
                    <input type="email"
                           class="form-control"
                           name="email"
                           id="email"
                           placeholder="name@hawassa.edu.et"
                           required />
                </div>
                <div class="col-md-6">
                    <label for="phone" class="form-label fw-semibold small text-muted mb-1">Mobile Phone Number *</label>
                    <input type="tel"
                           class="form-control"
                           name="phone"
                           id="phone"
                           placeholder="e.g. +251 911 234567"
                           required />
                </div>
            </div>

            <!-- 3. DEPARTMENT SELECTOR -->
            <div class="mb-3" id="departmentGroup">
                <label for="departmentId" class="form-label fw-semibold small text-muted mb-1">Academic Department / Faculty *</label>
                <select class="form-select" name="departmentId" id="departmentId" required>
                    <option value="">-- Select Your University Department --</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d.id">@d.name (@d.code)</option>
                    }
                </select>
            </div>

            <!-- 4. DYNAMIC ROLE-SPECIFIC FIELDS -->
            <!-- STUDENT: Student ID -->
            <div class="mb-3" id="studentIdGroup">
                <label for="studentId" class="form-label fw-semibold small text-muted mb-1">Official Student ID Number *</label>
                <input type="text"
                       class="form-control"
                       name="studentId"
                       id="studentId"
                       placeholder="e.g. UGR/1234/16 or HU/45821/15" />
                <div class="form-text small">Enter the valid student ID issued by Hawassa University Registrar.</div>
            </div>

            <!-- STAFF / FACULTY: Employee ID -->
            <div class="mb-3 d-none" id="employeeIdGroup">
                <label for="employeeId" class="form-label fw-semibold small text-muted mb-1">Staff / Academic Employee ID *</label>
                <input type="text"
                       class="form-control"
                       name="employeeId"
                       id="employeeId"
                       placeholder="e.g. EMP-HU-1042 or FAC-HU-8091" />
                <div class="form-text small">Enter your official university employment ID card number.</div>
            </div>

            <!-- ORGANIZATION: Club Name & Type -->
            <div class="mb-3 d-none" id="orgNameGroup">
                <div class="row g-2 mb-2">
                    <div class="col-md-7">
                        <label for="organizationName" class="form-label fw-semibold small text-muted mb-1">Official Club / Organization Name *</label>
                        <input type="text"
                               class="form-control"
                               name="organizationName"
                               id="organizationName"
                               placeholder="e.g. Hawassa Tech Society" />
                    </div>
                    <div class="col-md-5">
                        <label for="organizationType" class="form-label fw-semibold small text-muted mb-1">Organization Type</label>
                        <select class="form-select" name="organizationType" id="organizationType">
                            <option value="CLUB">Student Club</option>
                            <option value="ASSOCIATION">Academic Association</option>
                            <option value="STUDENT_UNION">Student Union</option>
                            <option value="DEPARTMENT">Departmental Society</option>
                            <option value="OTHER">Other Campus Group</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label for="bio" class="form-label fw-semibold small text-muted mb-1">Club Mission / Purpose Description</label>
                    <textarea class="form-control" name="bio" id="bio" rows="2" placeholder="Briefly describe your club or organization's campus activities..."></textarea>
                </div>
            </div>

            <!-- 5. PASSWORD & CONFIRMATION -->
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label for="password" class="form-label fw-semibold small text-muted mb-1">Security Password (Min 8 Chars) *</label>
                    <input type="password"
                           class="form-control"
                           name="password"
                           id="password"
                           placeholder="Enter strong password"
                           minlength="8"
                           required />
                </div>
                <div class="col-md-6">
                    <label for="confirmPassword" class="form-label fw-semibold small text-muted mb-1">Confirm Security Password *</label>
                    <input type="password"
                           class="form-control"
                           name="confirmPassword"
                           id="confirmPassword"
                           placeholder="Confirm your password"
                           minlength="8"
                           required />
                </div>
            </div>

            <button type="submit"
                    class="register-button w-100 py-2 fw-bold shadow-sm mt-2"
                    id="registerButton">
                Register Verified Campus Account &rarr;
            </button>

        </form>

        <div class="register-footer mt-3 pt-3 border-top text-center">
            Already have a registered account?
            <a asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" class="fw-bold text-primary">
                Sign In to Portal
            </a>
        </div>

    </div>

</div>

<script src="~/js/register.js" asp-append-version="true"></script>
<script>
    function toggleRoleFields(role) {
        document.querySelectorAll('.role-option-card').forEach(el => el.classList.remove('active'));
        if (event && event.currentTarget) {
            event.currentTarget.closest('.role-option-card')?.classList.add('active');
        }

        const studentGrp = document.getElementById('studentIdGroup');
        const empGrp = document.getElementById('employeeIdGroup');
        const orgGrp = document.getElementById('orgNameGroup');

        if (studentGrp) studentGrp.classList.add('d-none');
        if (empGrp) empGrp.classList.add('d-none');
        if (orgGrp) orgGrp.classList.add('d-none');

        if (role === 'Student' && studentGrp) {
            studentGrp.classList.remove('d-none');
        } else if ((role === 'Staff' || role === 'Faculty') && empGrp) {
            empGrp.classList.remove('d-none');
        } else if (role === 'Organization' && orgGrp) {
            orgGrp.classList.remove('d-none');
        }
    }
</script>