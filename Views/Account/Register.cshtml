@using HawassaUnifiedCampusEventManagementSystem.Models
@{
    ViewData["Title"] = "Verified Campus Registration | HUCEMS";
    var departments = ViewBag.Departments as List<Department> ?? new List<Department>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
}

<div class="auth-page-container">

    <div class="auth-split-card">

        <!-- =====================================================
             LEFT SHOWCASE SIDEBAR
             ===================================================== -->
        <div class="auth-showcase-panel">

            <div class="auth-showcase-content">
                <div class="auth-brand-badge">
                    <img src="~/images/hawassa-logo.png" alt="Hawassa University Crest" class="auth-brand-logo" />
                    <div class="auth-brand-text">
                        <h6>HAWASSA UNIVERSITY</h6>
                        <small>Verified Portal Access</small>
                    </div>
                </div>

                <h1 class="auth-showcase-title">
                    Unified <span>Campus Event Portal</span>
                </h1>

                <p class="auth-showcase-desc">
                    Register with your university credentials to participate in academic symposiums, coordinate departmental seminars, and manage student club activities.
                </p>

                <div class="auth-feature-list">
                    <div class="auth-feature-item">
                        <div class="auth-feature-icon bg-primary text-white">
                            <i class="bi bi-mortarboard-fill" aria-hidden="true"></i>
                        </div>
                        <div class="auth-feature-text">Academic Seminars &amp; Conferences</div>
                    </div>

                    <div class="auth-feature-item">
                        <div class="auth-feature-icon bg-warning text-dark">
                            <i class="bi bi-people-fill" aria-hidden="true"></i>
                        </div>
                        <div class="auth-feature-text">Student Club &amp; Society Activities</div>
                    </div>

                    <div class="auth-feature-item">
                        <div class="auth-feature-icon bg-success text-white">
                            <i class="bi bi-shield-check" aria-hidden="true"></i>
                        </div>
                        <div class="auth-feature-text">Verified University Role Access</div>
                    </div>
                </div>
            </div>

            <div class="auth-showcase-footer">
                <span><i class="bi bi-shield-lock-fill text-warning me-1" aria-hidden="true"></i> Secure Authentication</span>
                <span>Hawassa University &copy; @DateTime.UtcNow.Year</span>
            </div>

        </div>

        <!-- Registration Form Panel -->
        <div class="auth-form-panel">

            <div class="auth-form-header">
                <h2>Verified Campus Registration</h2>
                <p>Select your campus role and complete your authenticated profile.</p>
            </div>

            @if (ViewBag.Error != null || TempData["ErrorMessage"] != null)
            {
                <div class="alert auth-alert auth-alert-danger" role="alert">
                    <i class="bi bi-exclamation-octagon-fill auth-alert-icon" aria-hidden="true"></i>
                    <div>@(ViewBag.Error ?? TempData["ErrorMessage"])</div>
                </div>
            }

            <form asp-controller="Account"
                  asp-action="Register"
                  method="post"
                  id="registerForm"
                  autocomplete="on">

                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <!-- 1. INTERACTIVE ROLE SELECTOR -->
                <div class="mb-3">
                    <label class="form-label fw-bold text-dark small mb-2 d-flex justify-content-between align-items-center">
                        <span>Select Your University Role *</span>
                        <span class="badge bg-primary-subtle text-primary" id="roleDescriptionBadge">Student Access</span>
                    </label>

                    <div class="role-picker-grid">
                        <label class="role-picker-card active" for="role_student">
                            <input type="radio" name="accountType" id="role_student" value="Student" checked />
                            <span class="role-picker-icon"><i class="bi bi-mortarboard fs-4" aria-hidden="true"></i></span>
                            <strong>Student</strong>
                            <small>Events &amp; RSVPs</small>
                        </label>

                        <label class="role-picker-card" for="role_faculty">
                            <input type="radio" name="accountType" id="role_faculty" value="Faculty" />
                            <span class="role-picker-icon"><i class="bi bi-journal-bookmark fs-4" aria-hidden="true"></i></span>
                            <strong>Faculty</strong>
                            <small>Academic Seminars</small>
                        </label>

                        <label class="role-picker-card" for="role_staff">
                            <input type="radio" name="accountType" id="role_staff" value="Staff" />
                            <span class="role-picker-icon"><i class="bi bi-briefcase fs-4" aria-hidden="true"></i></span>
                            <strong>Staff</strong>
                            <small>Campus Operations</small>
                        </label>

                        <label class="role-picker-card" for="role_org">
                            <input type="radio" name="accountType" id="role_org" value="Organization" />
                            <span class="role-picker-icon"><i class="bi bi-building fs-4" aria-hidden="true"></i></span>
                            <strong>Club / Org</strong>
                            <small>Host Activities</small>
                        </label>
                    </div>
                </div>

                <!-- 2. PRIMARY NAME & USERNAME -->
                <div class="row g-2">
                    <div class="col-md-6">
                        <div class="auth-input-group">
                            <label for="fullName">Full Legal Name *</label>
                            <div class="auth-input-box">
                                <i class="bi bi-person auth-input-icon" aria-hidden="true"></i>
                                <input type="text"
                                       name="fullName"
                                       id="fullName"
                                       placeholder="e.g. Dawit Yohannes"
                                       autocomplete="name"
                                       required
                                       aria-required="true" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="auth-input-group">
                            <label for="username">Unique Username *</label>
                            <div class="auth-input-box">
                                <i class="bi bi-at auth-input-icon" aria-hidden="true"></i>
                                <input type="text"
                                       name="username"
                                       id="username"
                                       placeholder="e.g. dawit_yohannes"
                                       pattern="^[a-zA-Z0-9_.-]{3,30}$"
                                       title="3-30 characters, alphanumeric"
                                       autocomplete="username"
                                       required
                                       aria-required="true" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. EMAIL & PHONE -->
                <div class="row g-2">
                    <div class="col-md-6">
                        <div class="auth-input-group">
                            <label for="email">Email Address *</label>
                            <div class="auth-input-box">
                                <i class="bi bi-envelope auth-input-icon" aria-hidden="true"></i>
                                <input type="email"
                                       name="email"
                                       id="email"
                                       placeholder="name@hawassa.edu.et"
                                       autocomplete="email"
                                       required
                                       aria-required="true" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="auth-input-group">
                            <label for="phone">Mobile Phone *</label>
                            <div class="auth-input-box">
                                <i class="bi bi-telephone auth-input-icon" aria-hidden="true"></i>
                                <input type="tel"
                                       name="phone"
                                       id="phone"
                                       placeholder="+251 911 234567"
                                       autocomplete="tel"
                                       required
                                       aria-required="true" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 4. ACADEMIC DEPARTMENT SELECTOR -->
                <div class="auth-input-group mb-3" id="departmentGroup">
                    <label for="departmentId">Academic Department / Faculty *</label>
                    <div class="auth-input-box">
                        <i class="bi bi-buildings auth-input-icon" aria-hidden="true"></i>
                        <select name="departmentId" id="departmentId" required aria-required="true">
                            <option value="">-- Select Your University Department --</option>
                            @foreach (var d in departments)
                            {
                                <option value="@d.id">@d.name (@d.code)</option>
                            }
                        </select>
                    </div>
                </div>

                <!--
                    5. DYNAMIC ROLE-SPECIFIC FIELDS
                    NOTE: these fields are intentionally NOT marked `required` in HTML even
                    though their labels show "*". They live inside role-conditional-field
                    containers toggled with the `d-none` class by register.js. A hidden field
                    with a native `required` attribute blocks form submission with an
                    "invalid form control is not focusable" error the moment a different
                    role is selected. Enforce requiredness for the active role in register.js
                    instead of adding `required` here.
                -->

                <!-- STUDENT ID -->
                <div class="auth-input-group role-conditional-field" id="studentIdGroup">
                    <label for="studentId">Official Student ID *</label>
                    <div class="auth-input-box">
                        <i class="bi bi-person-badge auth-input-icon" aria-hidden="true"></i>
                        <input type="text"
                               name="studentId"
                               id="studentId"
                               placeholder="e.g. UGR/1234/16 or HU/45821/15" />
                    </div>
                    <small class="text-muted auth-helper-text">Issued by Hawassa University Registrar Office.</small>
                </div>

                <!-- EMPLOYEE ID (Staff / Faculty) -->
                <div class="auth-input-group role-conditional-field d-none" id="employeeIdGroup">
                    <label for="employeeId">University Employee ID *</label>
                    <div class="auth-input-box">
                        <i class="bi bi-card-heading auth-input-icon" aria-hidden="true"></i>
                        <input type="text"
                               name="employeeId"
                               id="employeeId"
                               placeholder="e.g. EMP-HU-1042 or FAC-HU-8091" />
                    </div>
                    <small class="text-muted auth-helper-text">Official staff/faculty ID number.</small>
                </div>

                <!-- CLUB / ORGANIZATION FIELDS -->
                <div class="role-conditional-field d-none" id="orgGroup">
                    <div class="row g-2 mb-2">
                        <div class="col-md-7">
                            <div class="auth-input-group mb-0">
                                <label for="organizationName">Official Club / Organization Name *</label>
                                <div class="auth-input-box">
                                    <i class="bi bi-people auth-input-icon" aria-hidden="true"></i>
                                    <input type="text"
                                           name="organizationName"
                                           id="organizationName"
                                           placeholder="e.g. Hawassa Tech Society" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="auth-input-group mb-0">
                                <label for="organizationType">Organization Type</label>
                                <div class="auth-input-box">
                                    <i class="bi bi-tag auth-input-icon" aria-hidden="true"></i>
                                    <select name="organizationType" id="organizationType">
                                        <option value="CLUB">Student Club</option>
                                        <option value="ASSOCIATION">Academic Association</option>
                                        <option value="STUDENT_UNION">Student Union</option>
                                        <option value="DEPARTMENT">Departmental Society</option>
                                        <option value="OTHER">Other Campus Group</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="auth-input-group mb-3">
                        <label for="bio">Club Mission Description</label>
                        <div class="auth-input-box">
                            <i class="bi bi-pencil-square auth-input-icon" aria-hidden="true"></i>
                            <textarea name="bio" id="bio" rows="2" placeholder="Briefly summarize your club's goals and activities..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- 6. PASSWORD & CONFIRMATION WITH REAL-TIME STRENGTH METER -->
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <div class="auth-input-group mb-1">
                            <label for="password">Security Password *</label>
                            <div class="auth-input-box">
                                <i class="bi bi-shield-lock auth-input-icon" aria-hidden="true"></i>
                                <input type="password"
                                       name="password"
                                       id="password"
                                       placeholder="Min 8 characters"
                                       minlength="8"
                                       autocomplete="new-password"
                                       required
                                       aria-required="true" />
                                <button type="button" class="auth-password-toggle" id="toggleRegPasswordBtn" aria-label="Toggle password visibility" title="Toggle visibility">
                                    <i class="bi bi-eye" id="toggleRegPasswordIcon" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="auth-input-group mb-1">
                            <label for="confirmPassword">Confirm Password *</label>
                            <div class="auth-input-box">
                                <i class="bi bi-shield-check auth-input-icon" aria-hidden="true"></i>
                                <input type="password"
                                       name="confirmPassword"
                                       id="confirmPassword"
                                       placeholder="Re-type password"
                                       minlength="8"
                                       autocomplete="new-password"
                                       required
                                       aria-required="true" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- DYNAMIC PASSWORD STRENGTH & MATCH INDICATOR -->
                <div class="password-strength-container mb-3">
                    <div class="password-strength-meter">
                        <div class="password-strength-bar" id="strengthBar"></div>
                    </div>
                    <div class="password-strength-text">
                        <span id="strengthLabel">Password strength: Enter password</span>
                        <span id="matchLabel" class="d-none"></span>
                    </div>
                </div>

                <!-- SUBMIT BUTTON -->
                <button type="submit"
                        class="auth-submit-btn"
                        id="registerButton">
                    <span id="regBtnText">Register Verified Campus Account</span>
                    <i class="bi bi-arrow-right" id="regBtnArrow" aria-hidden="true"></i>
                    <span class="spinner-border spinner-border-sm d-none" id="regBtnSpinner" role="status" aria-hidden="true"></span>
                </button>

            </form>

            <div class="auth-form-footer">
                Already registered with Hawassa University?
                <a asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl">
                    Sign In to Portal &rarr;
                </a>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/register.js" asp-append-version="true"></script>
}
