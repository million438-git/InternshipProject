@model HawassaUnifiedCampusEventManagementSystem.Models.ClubListViewModel

@{
    ViewData["Title"] = "Campus Clubs & Societies | Hawassa University";
}

@section Styles {
    <link rel="stylesheet" href="~/css/clubs.css" asp-append-version="true" />
}

<div class="container py-4">

    <!-- =========================================================
         1. HERO BANNER & PLATFORM OVERVIEW
         ========================================================= -->
    <div class="clubs-hero mb-4">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <div class="clubs-hero-badge">
                    <i class="bi bi-stars"></i>
                    <span>Interest-Based Campus Communities</span>
                </div>
                <h1 class="display-6 fw-bold text-white mb-2">Campus Clubs & Societies</h1>
                <p class="text-white text-opacity-85 mb-4" style="max-width: 640px; line-height: 1.6;">
                    Discover student associations, technology societies, academic research guilds, and cultural communities across Hawassa University. Connect with peers, participate in hackathons, and shape campus life.
                </p>

                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <a asp-controller="Clubs" asp-action="Interests" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow-sm">
                        <i class="bi bi-sliders2 me-1"></i> Update My Interests
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Clubs" asp-action="MyClubs" class="btn btn-outline-light px-3 py-2 rounded-pill fw-semibold">
                            <i class="bi bi-collection-fill me-1"></i> My Memberships
                        </a>
                    }
                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("Faculty") || User.IsInRole("Staff") || User.IsInRole("Organization"))
                    {
                        <a asp-controller="Clubs" asp-action="Create" class="btn btn-light text-primary px-3 py-2 rounded-pill fw-semibold shadow-sm">
                            <i class="bi bi-plus-circle-fill me-1"></i> Charter New Club
                        </a>
                    }
                </div>

                <div class="clubs-stat-pill-group">
                    <div class="clubs-stat-pill">
                        <i class="bi bi-people-fill text-info"></i>
                        <span><strong>@Model.TotalActiveCount</strong> Active Communities</span>
                    </div>
                    <div class="clubs-stat-pill">
                        <i class="bi bi-tag-fill text-warning"></i>
                        <span><strong>@Model.AvailableCategories.Count</strong> Focus Topics</span>
                    </div>
                    <div class="clubs-stat-pill">
                        <i class="bi bi-shield-check text-success"></i>
                        <span>Verified University Charters</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 text-lg-end d-none d-lg-block">
                <div class="p-4 bg-white bg-opacity-10 border border-white border-opacity-15 rounded-4 text-start shadow-sm backdrop-blur">
                    <div class="d-flex align-items-center gap-2 mb-3 text-white">
                        <i class="bi bi-lightbulb-fill text-warning fs-5"></i>
                        <h6 class="fw-bold mb-0">How Club Discovery Works</h6>
                    </div>
                    <ol class="small text-white text-opacity-80 ps-3 mb-0" style="line-height: 1.7;">
                        <li><strong>Pick your topics:</strong> Technology, Academic Research, Debate, Sports, Arts, or Health.</li>
                        <li><strong>Topic matching:</strong> Relevant clubs are surfaced at the top of your catalog.</li>
                        <li><strong>Stay connected:</strong> Follow for event alerts or apply for official membership.</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <!-- =========================================================
         2. ADMIN GOVERNANCE BAR (Visible to Admins)
         ========================================================= -->
    @if (Model.IsUserAdmin)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-dark text-white p-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary text-white p-2 rounded-3">
                        <i class="bi bi-shield-lock-fill fs-5"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold text-white">Platform Administrator Club Governance Hub</h6>
                        <small class="text-white-50">Manage status verification, club charters, and membership integrity across campus.</small>
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <a asp-action="Create" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">
                        <i class="bi bi-plus-circle me-1"></i> Charter New Club
                    </a>
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-sm btn-outline-light rounded-pill px-3">
                        <i class="bi bi-speedometer2 me-1"></i> Admin Console
                    </a>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-3 pt-3 border-top border-secondary">
                <a asp-action="Index" asp-route-status="ALL" asp-route-search="@Model.SearchQuery" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-deptId="@Model.SelectedDepartmentId"
                   class="btn btn-sm @(Model.StatusFilter == "ALL" ? "btn-light fw-bold" : "btn-outline-secondary text-white-50") rounded-pill px-3">
                    All Statuses <span class="badge bg-secondary ms-1">@(Model.TotalActiveCount + Model.TotalPendingCount + Model.TotalSuspendedCount)</span>
                </a>
                <a asp-action="Index" asp-route-status="ACTIVE" asp-route-search="@Model.SearchQuery" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-deptId="@Model.SelectedDepartmentId"
                   class="btn btn-sm @(Model.StatusFilter == "ACTIVE" ? "btn-success fw-bold" : "btn-outline-secondary text-white-50") rounded-pill px-3">
                    <i class="bi bi-check-circle me-1"></i> Active / Verified <span class="badge bg-success ms-1">@Model.TotalActiveCount</span>
                </a>
                <a asp-action="Index" asp-route-status="PENDING" asp-route-search="@Model.SearchQuery" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-deptId="@Model.SelectedDepartmentId"
                   class="btn btn-sm @(Model.StatusFilter == "PENDING" ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-white-50") rounded-pill px-3">
                    <i class="bi bi-hourglass-split me-1"></i> Pending Verification <span class="badge bg-warning text-dark ms-1">@Model.TotalPendingCount</span>
                </a>
                <a asp-action="Index" asp-route-status="SUSPENDED" asp-route-search="@Model.SearchQuery" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-deptId="@Model.SelectedDepartmentId"
                   class="btn btn-sm @(Model.StatusFilter == "SUSPENDED" ? "btn-danger fw-bold" : "btn-outline-secondary text-white-50") rounded-pill px-3">
                    <i class="bi bi-slash-circle me-1"></i> Suspended / Inactive <span class="badge bg-danger ms-1">@Model.TotalSuspendedCount</span>
                </a>
            </div>
        </div>
    }

    <!-- =========================================================
         3. PERSONALIZATION NOTIFICATION BANNER
         ========================================================= -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        @if (Model.HasSelectedInterests)
        {
            <div class="alert alert-primary bg-primary-subtle border-primary-subtle rounded-4 p-3 mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3 shadow-sm">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-primary fs-5"></i>
                    <div>
                        <span class="fw-bold text-dark">Personalized Recommendations Active:</span>
                        <span class="text-muted small ms-1">
                            Matching your interests in <strong>@string.Join(", ", Model.UserInterestNames)</strong>
                        </span>
                    </div>
                </div>
                <a asp-controller="Clubs" asp-action="Interests" class="btn btn-sm btn-outline-primary fw-semibold px-3 rounded-pill">
                    Edit Interests &rarr;
                </a>
            </div>
        }
        else
        {
            <div class="alert alert-warning bg-warning-subtle border-warning-subtle rounded-4 p-3 mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3 shadow-sm">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle-fill text-warning-emphasis fs-5"></i>
                    <div>
                        <span class="fw-bold text-dark">Personalize your student community experience!</span>
                        <span class="text-muted small ms-1">Select your focus areas (Technology, Debate, Sports, Arts, Leadership) to receive relevant club recommendations.</span>
                    </div>
                </div>
                <a asp-controller="Clubs" asp-action="Interests" class="btn btn-sm btn-warning text-dark fw-semibold px-4 rounded-pill shadow-sm">
                    Select My Interests
                </a>
            </div>
        }
    }

    <!-- =========================================================
         4. SEARCH & TOPIC FILTER BAR
         ========================================================= -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 p-3 bg-white">
        <form method="get" asp-action="Index" class="row g-3 align-items-center">
            @if (!string.IsNullOrEmpty(Model.StatusFilter))
            {
                <input type="hidden" name="status" value="@Model.StatusFilter" />
            }
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.SearchQuery" class="form-control border-start-0 bg-light" placeholder="Search clubs by name, keywords, or focus..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="categoryId" class="form-select bg-light" onchange="this.form.submit()">
                    <option value="">All Categories & Interests</option>
                    @foreach (var cat in Model.AvailableCategories)
                    {
                        <option value="@cat.Value" selected="@(cat.Selected ? "selected" : null)">@cat.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="deptId" class="form-select bg-light" onchange="this.form.submit()">
                    <option value="">All Academic Departments</option>
                    @foreach (var d in Model.AvailableDepartments)
                    {
                        <option value="@d.Value" selected="@(d.Selected ? "selected" : null)">@d.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-1 d-grid">
                <button type="submit" class="btn btn-primary fw-semibold rounded-3">Filter</button>
            </div>
        </form>

        <!-- Quick Category Filter Pills -->
        <div class="d-flex flex-wrap gap-2 mt-3 pt-3 border-top">
            <a asp-action="Index" asp-route-status="@Model.StatusFilter" class="interest-pill @(Model.SelectedCategoryId == null ? "active" : "")">
                <i class="bi bi-grid"></i> All Topics
            </a>
            @foreach (var cat in Model.AvailableCategories.Take(8))
            {
                <a asp-action="Index" asp-route-categoryId="@cat.Value" asp-route-status="@Model.StatusFilter" class="interest-pill @(Model.SelectedCategoryId?.ToString() == cat.Value ? "active" : "")">
                    @cat.Text
                </a>
            }
        </div>
    </div>

    <!-- =========================================================
         5. RECOMMENDED CLUBS SECTION (Based on user interests)
         ========================================================= -->
    @if (Model.RecommendedClubs.Any() && Model.HasSelectedInterests && Model.StatusFilter != "SUSPENDED" && Model.StatusFilter != "PENDING")
    {
        <div class="mb-5">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                    <h2 class="h5 fw-bold text-dark mb-0">
                        <i class="bi bi-magic me-2 text-primary"></i>Recommended For You
                    </h2>
                    <p class="text-muted small mb-0">Student societies matching your active interests</p>
                </div>
            </div>

            <div class="row g-4">
                @foreach (var club in Model.RecommendedClubs)
                {
                    var targetId = !string.IsNullOrEmpty(club.Slug) ? club.Slug : club.Id.ToString();
                    var initials = !string.IsNullOrEmpty(club.ShortName) ? club.ShortName : (club.Name.Length > 2 ? club.Name.Substring(0, 2) : club.Name);

                    <div class="col-md-6 col-lg-4">
                        <div class="club-card">
                            <div class="club-card-header">
                                <div class="club-card-avatar-wrap">
                                    @if (!string.IsNullOrEmpty(club.LogoUrl))
                                    {
                                        <img src="@club.LogoUrl" alt="@club.Name" class="club-card-avatar" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                        <div class="club-avatar-fallback" style="display: none;">@initials</div>
                                    }
                                    else
                                    {
                                        <div class="club-avatar-fallback">@initials</div>
                                    }
                                </div>
                                <span class="badge bg-white bg-opacity-20 text-white border border-white border-opacity-25 rounded-pill px-2 py-1 small">
                                    <i class="bi bi-patch-check-fill me-1"></i>Verified
                                </span>
                            </div>

                            <div class="club-card-body">
                                @if (!string.IsNullOrEmpty(club.RecommendationReason))
                                {
                                    <div class="club-recommendation-tag">
                                        <i class="bi bi-stars"></i>
                                        <span>@club.RecommendationReason</span>
                                    </div>
                                }

                                <h3 class="club-card-title">
                                    <a asp-action="Details" asp-route-id="@targetId" class="text-dark text-decoration-none hover-primary">
                                        @club.Name
                                    </a>
                                </h3>

                                <p class="small text-muted mb-2">
                                    <i class="bi bi-building me-1 text-primary"></i>@(club.DepartmentName ?? club.FacultyName ?? "Hawassa University")
                                </p>

                                <p class="club-card-desc">@club.Description</p>

                                <div class="d-flex flex-wrap gap-1 mt-auto mb-2">
                                    @foreach (var tag in club.Interests.Take(3))
                                    {
                                        <span class="badge bg-light text-primary border rounded-pill px-2 py-1 small">
                                            <i class="bi @(tag.Icon ?? "bi-tag") me-1"></i>@tag.Name
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="club-card-footer">
                                <div class="d-flex align-items-center gap-3 small text-muted">
                                    <span><i class="bi bi-bell me-1 text-primary"></i><strong class="text-dark follower-count-@club.Id">@club.FollowerCount</strong></span>
                                    <span><i class="bi bi-people me-1 text-info"></i><strong class="text-dark">@club.MemberCount</strong> members</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-follow @(club.IsFollowing ? "btn-outline-secondary" : "btn-primary") px-3 rounded-pill fw-semibold"
                                                data-club-id="@club.Id"
                                                onclick="toggleFollow(@club.Id, this)">
                                            @(club.IsFollowing ? "Following" : "Follow")
                                        </button>
                                    }
                                    <a asp-action="Details" asp-route-id="@targetId" class="btn btn-sm btn-outline-primary px-3 rounded-pill">
                                        Explore
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- =========================================================
         6. ALL CLUBS & SOCIETIES CATALOG
         ========================================================= -->
    <div>
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h2 class="h5 fw-bold text-dark mb-0">
                    <i class="bi bi-grid-fill me-2 text-primary"></i>All Campus Communities (@Model.AllClubs.Count)
                </h2>
                <p class="text-muted small mb-0">Browse student associations, leadership clubs, and technical societies</p>
            </div>
        </div>

        @if (Model.AllClubs.Any())
        {
            <div class="row g-4">
                @foreach (var club in Model.AllClubs)
                {
                    var targetId = !string.IsNullOrEmpty(club.Slug) ? club.Slug : club.Id.ToString();
                    var initials = !string.IsNullOrEmpty(club.ShortName) ? club.ShortName : (club.Name.Length > 2 ? club.Name.Substring(0, 2) : club.Name);

                    <div class="col-md-6 col-lg-4">
                        <div class="club-card">
                            <div class="club-card-header">
                                <div class="club-card-avatar-wrap">
                                    @if (!string.IsNullOrEmpty(club.LogoUrl))
                                    {
                                        <img src="@club.LogoUrl" alt="@club.Name" class="club-card-avatar" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                        <div class="club-avatar-fallback" style="display: none;">@initials</div>
                                    }
                                    else
                                    {
                                        <div class="club-avatar-fallback">@initials</div>
                                    }
                                </div>

                                @if (Model.IsUserAdmin || club.Status != "ACTIVE")
                                {
                                    @if (club.Status == "ACTIVE")
                                    {
                                        <span class="badge bg-success shadow-sm rounded-pill px-2 py-1"><i class="bi bi-patch-check-fill me-1"></i>Active</span>
                                    }
                                    else if (club.Status == "PENDING")
                                    {
                                        <span class="badge bg-warning text-dark shadow-sm rounded-pill px-2 py-1"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger shadow-sm rounded-pill px-2 py-1"><i class="bi bi-slash-circle me-1"></i>@club.Status</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-white bg-opacity-20 text-white border border-white border-opacity-25 rounded-pill px-2 py-1 small">
                                        <i class="bi bi-patch-check-fill me-1"></i>Verified
                                    </span>
                                }
                            </div>

                            <div class="club-card-body">
                                <h3 class="club-card-title">
                                    <a asp-action="Details" asp-route-id="@targetId" class="text-dark text-decoration-none hover-primary">
                                        @club.Name
                                    </a>
                                </h3>

                                <p class="small text-muted mb-2">
                                    <i class="bi bi-building me-1 text-primary"></i>@(club.DepartmentName ?? club.FacultyName ?? "Hawassa University")
                                </p>

                                <p class="club-card-desc">@club.Description</p>

                                <div class="d-flex flex-wrap gap-1 mt-auto mb-2">
                                    @foreach (var tag in club.Interests.Take(3))
                                    {
                                        <span class="badge bg-light text-primary border rounded-pill px-2 py-1 small">
                                            <i class="bi @(tag.Icon ?? "bi-tag") me-1"></i>@tag.Name
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="club-card-footer">
                                <div class="d-flex align-items-center gap-3 small text-muted">
                                    <span><i class="bi bi-bell me-1 text-primary"></i><strong class="text-dark follower-count-@club.Id">@club.FollowerCount</strong></span>
                                    <span><i class="bi bi-people me-1 text-info"></i><strong class="text-dark">@club.MemberCount</strong> members</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    @if (User.Identity?.IsAuthenticated == true && club.Status == "ACTIVE")
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-follow @(club.IsFollowing ? "btn-outline-secondary" : "btn-primary") px-3 rounded-pill fw-semibold"
                                                data-club-id="@club.Id"
                                                onclick="toggleFollow(@club.Id, this)">
                                            @(club.IsFollowing ? "Following" : "Follow")
                                        </button>
                                    }
                                    <a asp-action="Details" asp-route-id="@targetId" class="btn btn-sm btn-outline-primary px-3 rounded-pill">
                                        Explore
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 bg-light rounded-4">
                <div class="d-inline-flex p-3 bg-white rounded-circle shadow-sm mb-3 text-muted">
                    <i class="bi bi-search fs-2"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">No Clubs Found</h5>
                <p class="text-muted small mb-3">Try adjusting your search query, department, or category topic filters.</p>
                <a asp-action="Index" class="btn btn-sm btn-primary rounded-pill px-4">Reset Filters</a>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script>
        async function toggleFollow(clubId, btn) {
            const isCurrentlyFollowing = btn.innerText.trim() === 'Following';
            const endpoint = isCurrentlyFollowing ? `/Clubs/Unfollow/${clubId}` : `/Clubs/Follow/${clubId}`;

            btn.disabled = true;

            try {
                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (response.ok) {
                    const data = await response.json();
                    if (data.isFollowing) {
                        btn.innerText = 'Following';
                        btn.classList.remove('btn-primary');
                        btn.classList.add('btn-outline-secondary');
                    } else {
                        btn.innerText = 'Follow';
                        btn.classList.remove('btn-outline-secondary');
                        btn.classList.add('btn-primary');
                    }

                    // Update follower counts across the page
                    document.querySelectorAll(`.follower-count-${clubId}`).forEach(el => {
                        el.innerText = data.followerCount;
                    });
                }
            } catch (err) {
                console.error(err);
            } finally {
                btn.disabled = false;
            }
        }
    </script>
}
