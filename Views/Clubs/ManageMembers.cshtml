@model HawassaUnifiedCampusEventManagementSystem.Models.ClubManageMembersViewModel

@{
    ViewData["Title"] = $"Manage Members - {Model.ClubName} | Hawassa University";
}

@section Styles {
    <link rel="stylesheet" href="~/css/clubs.css" asp-append-version="true" />
}

<div class="container py-4">

    <!-- BREADCRUMB -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Clubs" asp-action="Index">Clubs</a></li>
            <li class="breadcrumb-item"><a asp-controller="Clubs" asp-action="Details" asp-route-id="@Model.ClubSlug">@Model.ClubName</a></li>
            <li class="breadcrumb-item active" aria-current="page">Manage Applications & Members</li>
        </ol>
    </nav>

    <!-- HEADER DECK -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="badge bg-primary px-3 py-1 rounded-pill mb-2">
                    <i class="bi bi-shield-lock-fill me-1"></i> CLUB LEADER PORTAL
                </span>
                <h1 class="h3 fw-bold text-dark mb-1">@Model.ClubName &bull; Membership Roster</h1>
                <p class="text-muted small mb-0">Review incoming student membership requests and manage executive committee roles and permissions.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-action="Details" asp-route-id="@Model.ClubSlug" class="btn btn-outline-primary rounded-pill px-3">
                    <i class="bi bi-eye me-1"></i> Public Profile
                </a>
                <a asp-action="Edit" asp-route-id="@Model.ClubId" class="btn btn-light rounded-pill px-3">
                    <i class="bi bi-pencil-square me-1"></i> Edit Settings
                </a>
            </div>
        </div>
    </div>

    <!-- STATS CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-warning-subtle text-warning-emphasis rounded-3 fs-3">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Pending Requests</span>
                        <strong class="fs-4 fw-bold text-dark">@Model.PendingRequestsCount</strong>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-success-subtle text-success rounded-3 fs-3">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Official Active Members</span>
                        <strong class="fs-4 fw-bold text-dark">@Model.TotalMembersCount</strong>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-primary-subtle text-primary rounded-3 fs-3">
                        <i class="bi bi-bell-fill"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Total Followers</span>
                        <strong class="fs-4 fw-bold text-dark">@Model.FollowersCount</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PENDING MEMBERSHIP REQUESTS TABLE -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="h5 fw-bold text-dark mb-0">
                    <i class="bi bi-clock-history me-2 text-warning"></i>Pending Membership Applications (@Model.PendingRequestsCount)
                </h2>
                <small class="text-muted">Students awaiting leader review to join @Model.ClubName</small>
            </div>
        </div>

        <div class="card-body p-0">
            @if (Model.PendingRequests.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted small">
                            <tr>
                                <th class="ps-4">Applicant Student</th>
                                <th>Department</th>
                                <th>Applicant Note</th>
                                <th>Applied Date</th>
                                <th class="text-end pe-4">Decision Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in Model.PendingRequests)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar-initial rounded-circle bg-warning-subtle text-warning-emphasis fw-bold d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                                @(req.FullName.Length > 0 ? req.FullName.Substring(0, 1) : "U")
                                            </div>
                                            <div>
                                                <strong class="text-dark d-block">@req.FullName</strong>
                                                <small class="text-muted">@req.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@(req.DepartmentName ?? "Hawassa Student")</td>
                                    <td style="max-width: 250px;">
                                        <span class="small text-secondary">
                                            @(string.IsNullOrEmpty(req.RequestNotes) ? "No note attached." : req.RequestNotes)
                                        </span>
                                    </td>
                                    <td><small class="text-muted">@req.AppliedAt.ToString("MMM dd, yyyy HH:mm")</small></td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end align-items-center gap-2">
                                            <!-- APPROVE DROPDOWN WITH ROLE SELECTION -->
                                            <div class="btn-group">
                                                <form method="post" asp-action="ApproveMember" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="memberRecordId" value="@req.MemberRecordId" />
                                                    <input type="hidden" name="role" value="MEMBER" />
                                                    <button type="submit" class="btn btn-sm btn-success rounded-start-pill px-3 fw-semibold shadow-sm">
                                                        <i class="bi bi-check-lg me-1"></i> Approve
                                                    </button>
                                                </form>
                                                <button type="button" class="btn btn-sm btn-success dropdown-toggle dropdown-toggle-split rounded-end-pill px-2" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <span class="visually-hidden">Toggle Role Dropdown</span>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                                    <li><h6 class="dropdown-header small">Approve with Executive Role</h6></li>
                                                    <li>
                                                        <form method="post" asp-action="ApproveMember">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="memberRecordId" value="@req.MemberRecordId" />
                                                            <input type="hidden" name="role" value="MEMBER" />
                                                            <button type="submit" class="dropdown-item small"><i class="bi bi-person me-2"></i>Approve as Member</button>
                                                        </form>
                                                    </li>
                                                    <li>
                                                        <form method="post" asp-action="ApproveMember">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="memberRecordId" value="@req.MemberRecordId" />
                                                            <input type="hidden" name="role" value="OFFICER" />
                                                            <button type="submit" class="dropdown-item small"><i class="bi bi-award me-2 text-warning"></i>Approve as Officer</button>
                                                        </form>
                                                    </li>
                                                    <li>
                                                        <form method="post" asp-action="ApproveMember">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="memberRecordId" value="@req.MemberRecordId" />
                                                            <input type="hidden" name="role" value="SECRETARY" />
                                                            <button type="submit" class="dropdown-item small"><i class="bi bi-file-text me-2 text-info"></i>Approve as Secretary</button>
                                                        </form>
                                                    </li>
                                                    <li>
                                                        <form method="post" asp-action="ApproveMember">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="memberRecordId" value="@req.MemberRecordId" />
                                                            <input type="hidden" name="role" value="TREASURER" />
                                                            <button type="submit" class="dropdown-item small"><i class="bi bi-cash-coin me-2 text-success"></i>Approve as Treasurer</button>
                                                        </form>
                                                    </li>
                                                    <li>
                                                        <form method="post" asp-action="ApproveMember">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="memberRecordId" value="@req.MemberRecordId" />
                                                            <input type="hidden" name="role" value="ADMIN" />
                                                            <button type="submit" class="dropdown-item small"><i class="bi bi-shield-check me-2 text-primary"></i>Approve as Admin / Co-Lead</button>
                                                        </form>
                                                    </li>
                                                </ul>
                                            </div>

                                            <!-- REJECT FORM -->
                                            <form method="post" asp-action="RejectMember" class="d-inline" onsubmit="return confirm('Decline this student application?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="memberRecordId" value="@req.MemberRecordId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                    <i class="bi bi-x-lg me-1"></i> Reject
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-check2-circle fs-1 text-success d-block mb-2"></i>
                    <h6 class="fw-bold text-dark mb-1">No Pending Applications</h6>
                    <p class="text-muted small mb-0">All membership requests have been reviewed.</p>
                </div>
            }
        </div>
    </div>

    <!-- ACTIVE MEMBERS ROSTER -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="h5 fw-bold text-dark mb-0">
                    <i class="bi bi-people-fill me-2 text-primary"></i>Official Active Members (@Model.TotalMembersCount)
                </h2>
                <small class="text-muted">Approved roster and executive assignments for @Model.ClubName</small>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small">
                        <tr>
                            <th class="ps-4">Member Name</th>
                            <th>Email Address</th>
                            <th>Department</th>
                            <th>Club Role</th>
                            <th>Joined Date</th>
                            <th class="text-end pe-4">Role Management</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.ActiveMembers)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-initial rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                                            @(m.FullName.Length > 0 ? m.FullName.Substring(0, 1) : "M")
                                        </div>
                                        <strong class="text-dark">@m.FullName</strong>
                                    </div>
                                </td>
                                <td>@m.Email</td>
                                <td>@(m.DepartmentName ?? "Campus Member")</td>
                                <td>
                                    <span class="badge @(m.Role == "PRESIDENT" ? "bg-primary" : m.Role == "ADMIN" ? "bg-info text-dark" : m.Role == "OFFICER" ? "bg-warning text-dark" : m.Role == "SECRETARY" ? "bg-secondary" : m.Role == "TREASURER" ? "bg-success" : "bg-light text-dark border") px-3 py-1 fw-semibold">
                                        @m.Role
                                    </span>
                                </td>
                                <td><small class="text-muted">@m.AppliedAt.ToString("MMM dd, yyyy")</small></td>
                                <td class="text-end pe-4">
                                    @if (Model.IsPresidentOrAdmin && m.Role != "PRESIDENT")
                                    {
                                        <div class="dropdown d-inline-block">
                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle rounded-pill px-3" type="button" data-bs-toggle="dropdown">
                                                <i class="bi bi-gear me-1"></i> Role
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                                <li><h6 class="dropdown-header small">Change Role</h6></li>
                                                <li>
                                                    <form method="post" asp-action="UpdateMemberRole">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="memberRecordId" value="@m.MemberRecordId" />
                                                        <input type="hidden" name="role" value="MEMBER" />
                                                        <button type="submit" class="dropdown-item small @(m.Role == "MEMBER" ? "active" : "")">Regular Member</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form method="post" asp-action="UpdateMemberRole">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="memberRecordId" value="@m.MemberRecordId" />
                                                        <input type="hidden" name="role" value="OFFICER" />
                                                        <button type="submit" class="dropdown-item small @(m.Role == "OFFICER" ? "active" : "")">Officer</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form method="post" asp-action="UpdateMemberRole">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="memberRecordId" value="@m.MemberRecordId" />
                                                        <input type="hidden" name="role" value="SECRETARY" />
                                                        <button type="submit" class="dropdown-item small @(m.Role == "SECRETARY" ? "active" : "")">Secretary</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form method="post" asp-action="UpdateMemberRole">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="memberRecordId" value="@m.MemberRecordId" />
                                                        <input type="hidden" name="role" value="TREASURER" />
                                                        <button type="submit" class="dropdown-item small @(m.Role == "TREASURER" ? "active" : "")">Treasurer</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form method="post" asp-action="UpdateMemberRole">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="memberRecordId" value="@m.MemberRecordId" />
                                                        <input type="hidden" name="role" value="ADMIN" />
                                                        <button type="submit" class="dropdown-item small @(m.Role == "ADMIN" ? "active" : "")">Admin / Co-Lead</button>
                                                    </form>
                                                </li>
                                                <li><hr class="dropdown-divider" /></li>
                                                <li>
                                                    <form method="post" asp-action="RemoveMember" onsubmit="return confirm('Remove @m.FullName from the club membership roster?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="memberRecordId" value="@m.MemberRecordId" />
                                                        <button type="submit" class="dropdown-item small text-danger">
                                                            <i class="bi bi-person-x me-2"></i>Dismiss Member
                                                        </button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    }
                                    else if (m.Role == "PRESIDENT")
                                    {
                                        <span class="badge bg-primary-subtle text-primary px-3 py-1">President</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
