@model HawassaUnifiedCampusEventManagementSystem.Models.MyClubsViewModel

@{
    ViewData["Title"] = "My Campus Clubs & Memberships | Hawassa University";
}

@section Styles {
    <link rel="stylesheet" href="~/css/clubs.css" asp-append-version="true" />
}

<div class="container py-4">

    <!-- BREADCRUMB -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Clubs" asp-action="Index">Clubs & Communities</a></li>
            <li class="breadcrumb-item active" aria-current="page">My Clubs Hub</li>
        </ol>
    </nav>

    <!-- HEADER BANNER -->
    <div class="clubs-hero mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="h2 fw-bold text-white mb-1">My Campus Clubs & Memberships</h1>
                <p class="text-white text-opacity-80 mb-0 small">
                    Track communities you follow, active club memberships, and organizations you lead.
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Clubs" asp-action="Interests" class="btn btn-outline-light rounded-pill px-3 fw-semibold">
                    <i class="bi bi-sliders2 me-1"></i> Update Interests
                </a>
                <a asp-controller="Clubs" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                    <i class="bi bi-compass me-1"></i> Explore More Clubs
                </a>
            </div>
        </div>
    </div>

    <!-- CLUBS YOU LEAD / MANAGE (IF ANY) -->
    @if (Model.ManagedClubs.Any())
    {
        <div class="mb-4">
            <h2 class="h5 fw-bold text-dark mb-3">
                <i class="bi bi-award-fill me-2 text-warning"></i>Clubs You Lead
            </h2>
            <div class="row g-4">
                @foreach (var club in Model.ManagedClubs)
                {
                    var targetId = !string.IsNullOrEmpty(club.Slug) ? club.Slug : club.Id.ToString();
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-primary">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h3 class="h6 fw-bold mb-0">
                                    <a asp-action="Details" asp-route-id="@targetId" class="text-dark text-decoration-none hover-primary">@club.Name</a>
                                </h3>
                                <span class="badge bg-primary-subtle text-primary">President</span>
                            </div>
                            <p class="small text-muted mb-3">@(club.DepartmentName ?? "Hawassa University")</p>
                            <div class="d-flex gap-2 mt-auto">
                                <a asp-action="ManageMembers" asp-route-id="@club.Id" class="btn btn-sm btn-primary rounded-pill flex-grow-1">
                                    <i class="bi bi-people me-1"></i> Applications
                                </a>
                                <a asp-action="Edit" asp-route-id="@club.Id" class="btn btn-sm btn-light rounded-pill px-3">
                                    <i class="bi bi-gear"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- OFFICIAL MEMBERSHIPS -->
    <div class="mb-5">
        <h2 class="h5 fw-bold text-dark mb-3">
            <i class="bi bi-patch-check-fill me-2 text-success"></i>Official Club Memberships (@Model.MembershipClubs.Count)
        </h2>

        @if (Model.MembershipClubs.Any())
        {
            <div class="row g-4">
                @foreach (var club in Model.MembershipClubs)
                {
                    var targetId = !string.IsNullOrEmpty(club.Slug) ? club.Slug : club.Id.ToString();
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <img src="@(!string.IsNullOrEmpty(club.LogoUrl) ? club.LogoUrl : "https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=400&auto=format&fit=crop&q=80")"
                                     class="rounded-3" style="width: 48px; height: 48px; object-fit: cover;" alt="@club.Name" />
                                <div>
                                    <h3 class="h6 fw-bold mb-0">
                                        <a asp-action="Details" asp-route-id="@targetId" class="text-dark text-decoration-none hover-primary">@club.Name</a>
                                    </h3>
                                    <span class="badge @(club.MembershipStatus == "APPROVED" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning-emphasis") small mt-1">
                                        @(club.MembershipStatus == "APPROVED" ? $"Member ({club.MembershipRole})" : "Request Pending Review")
                                    </span>
                                </div>
                            </div>
                            <p class="small text-muted mb-3 flex-grow-1 text-truncate-2">@club.Description</p>
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                <a asp-action="Details" asp-route-id="@targetId" class="btn btn-sm btn-outline-primary px-3 rounded-pill">
                                    Club Room &rarr;
                                </a>
                                <form method="post" asp-action="CancelMembership" asp-route-id="@club.Id" onsubmit="return confirm('Cancel membership / leave @club.Name?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none small p-0">
                                        @(club.MembershipStatus == "APPROVED" ? "Leave Club" : "Cancel Request")
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-4 bg-light rounded-4">
                <i class="bi bi-people fs-2 text-muted d-block mb-2"></i>
                <h6 class="fw-bold text-dark mb-1">No Active Club Memberships</h6>
                <p class="text-muted small mb-3">Join student societies to access member-only workshops, projects, and hackathons.</p>
                <a asp-action="Index" class="btn btn-sm btn-primary rounded-pill px-4">Browse Campus Clubs</a>
            </div>
        }
    </div>

    <!-- CLUBS YOU FOLLOW -->
    <div>
        <h2 class="h5 fw-bold text-dark mb-3">
            <i class="bi bi-bell-fill me-2 text-primary"></i>Clubs You Follow (@Model.FollowedClubs.Count)
        </h2>

        @if (Model.FollowedClubs.Any())
        {
            <div class="row g-4">
                @foreach (var club in Model.FollowedClubs)
                {
                    var targetId = !string.IsNullOrEmpty(club.Slug) ? club.Slug : club.Id.ToString();
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <img src="@(!string.IsNullOrEmpty(club.LogoUrl) ? club.LogoUrl : "https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=400&auto=format&fit=crop&q=80")"
                                     class="rounded-3" style="width: 48px; height: 48px; object-fit: cover;" alt="@club.Name" />
                                <div>
                                    <h3 class="h6 fw-bold mb-0">
                                        <a asp-action="Details" asp-route-id="@targetId" class="text-dark text-decoration-none hover-primary">@club.Name</a>
                                    </h3>
                                    <small class="text-muted"><i class="bi bi-bell-fill text-warning me-1"></i>Receiving Event Updates</small>
                                </div>
                            </div>
                            <p class="small text-muted mb-3 flex-grow-1 text-truncate-2">@club.Description</p>
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                <a asp-action="Details" asp-route-id="@targetId" class="btn btn-sm btn-outline-primary px-3 rounded-pill">
                                    View Club
                                </a>
                                <form method="post" asp-action="Unfollow" asp-route-id="@club.Id">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                        Unfollow
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-4 bg-light rounded-4">
                <i class="bi bi-bell-slash fs-2 text-muted d-block mb-2"></i>
                <h6 class="fw-bold text-dark mb-1">You Are Not Following Any Clubs</h6>
                <p class="text-muted small mb-3">Following clubs keeps you posted on new workshops, symposiums, and sports competitions.</p>
                <a asp-action="Index" class="btn btn-sm btn-primary rounded-pill px-4">Find Clubs to Follow</a>
            </div>
        }
    </div>

</div>
