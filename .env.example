# Copy to .env (never commit .env) before `docker compose up`.
# JWT_SECRET_KEY must be at least 32 characters.

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=university_event_management

DATABASE_CONNECTION_STRING=Server=hucems-mysql;Port=3306;Database=university_event_management;Uid=root;Pwd=change-me;
JWT_SECRET_KEY=change-me-must-be-at-least-32-characters
